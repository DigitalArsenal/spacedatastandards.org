        b_.StartObject(5)
        return this
    def add_ALPHA(ALPHA:float):
        b_.PrependFloat64Slot(0, ALPHA, 0.0)
        return this
    def add_MIN_MISS_M(MIN_MISS_M:float):
        b_.PrependFloat64Slot(1, MIN_MISS_M, 0.0)
        return this
    def add_MAX_MISS_M(MAX_MISS_M:float):
        b_.PrependFloat64Slot(2, MAX_MISS_M, 0.0)
        return this
    def add_TCA_MIN_S(TCA_MIN_S:float):
        b_.PrependFloat64Slot(3, TCA_MIN_S, 0.0)
        return this
    def add_TCA_MAX_S(TCA_MAX_S:float):
        b_.PrependFloat64Slot(4, TCA_MAX_S, 0.0)
        return this
    def end():
        return b_.EndObject()

/// Result of a possibility-of-collision assessment.
class SCRPossibilityResult : flatbuffers.handle
    /// Possibility of collision, 0 to 1.
    def POSSIBILITY_COLLISION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, 0.0)
    /// Necessity of collision, 1 - possibility of no collision.
    def NECESSITY_COLLISION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    /// Necessity of no collision, 1 - POSSIBILITY_COLLISION.
    def NECESSITY_NO_COLLISION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Smallest and largest miss distance over all pairs, m.
    def MIN_MISS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    def MAX_MISS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// Earliest and latest closest approach, s from the common epoch (clamped
    /// to the half window).
    def TCA_MIN_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    def TCA_MAX_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// State pairs evaluated, and those with miss <= the combined radius.
    def PAIRS() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 18, 0)
    def COLLIDING_PAIRS() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 20, 0)
    /// One per requested alpha level, in order.
    def ALPHA_CUTS(i:int) -> SCRAlphaCut:
        return SCRAlphaCut { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 22) + i * 4) }
    def ALPHA_CUTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)

def GetRootAsSCRPossibilityResult(buf:string): return SCRPossibilityResult { buf, flatbuffers.indirect(buf, 0) }

struct SCRPossibilityResultBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(10)
        return this
    def add_POSSIBILITY_COLLISION(POSSIBILITY_COLLISION:float):
        b_.PrependFloat64Slot(0, POSSIBILITY_COLLISION, 0.0)
        return this
    def add_NECESSITY_COLLISION(NECESSITY_COLLISION:float):
        b_.PrependFloat64Slot(1, NECESSITY_COLLISION, 0.0)
        return this
    def add_NECESSITY_NO_COLLISION(NECESSITY_NO_COLLISION:float):
        b_.PrependFloat64Slot(2, NECESSITY_NO_COLLISION, 0.0)
        return this
    def add_MIN_MISS_M(MIN_MISS_M:float):
        b_.PrependFloat64Slot(3, MIN_MISS_M, 0.0)
        return this
    def add_MAX_MISS_M(MAX_MISS_M:float):
        b_.PrependFloat64Slot(4, MAX_MISS_M, 0.0)
        return this
    def add_TCA_MIN_S(TCA_MIN_S:float):
        b_.PrependFloat64Slot(5, TCA_MIN_S, 0.0)
        return this
    def add_TCA_MAX_S(TCA_MAX_S:float):
        b_.PrependFloat64Slot(6, TCA_MAX_S, 0.0)
        return this
    def add_PAIRS(PAIRS:int):
        b_.PrependUint64Slot(7, PAIRS, 0)
        return this
    def add_COLLIDING_PAIRS(COLLIDING_PAIRS:int):
        b_.PrependUint64Slot(8, COLLIDING_PAIRS, 0)
        return this
    def add_ALPHA_CUTS(ALPHA_CUTS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(9, ALPHA_CUTS)
        return this
    def end():
        return b_.EndObject()

def SCRPossibilityResultStartALPHACUTSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def SCRPossibilityResultCreateALPHACUTSVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

/// Conjunction Screening - exactly one arm is set.
class SCR : flatbuffers.handle
    def BLOCK() -> SCRBlock?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: SCRBlock { buf_, o } else: nil
    def GRID() -> SCRGrid?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: SCRGrid { buf_, o } else: nil
    def ROLES() -> SCRRoles?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: SCRRoles { buf_, o } else: nil
    def CANDIDATES() -> SCRCandidates?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: SCRCandidates { buf_, o } else: nil
    def EXCLUSIONS() -> SCRExclusions?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: SCRExclusions { buf_, o } else: nil
    def SEARCH_REPORT() -> SCRSearchReport?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: SCRSearchReport { buf_, o } else: nil
    def POSSIBILITY_REQUEST() -> SCRPossibilityRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 16)
        return if o: SCRPossibilityRequest { buf_, o } else: nil
    def POSSIBILITY_RESULT() -> SCRPossibilityResult?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: SCRPossibilityResult { buf_, o } else: nil

def GetRootAsSCR(buf:string): return SCR { buf, flatbuffers.indirect(buf, 0) }

