        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 4)
    def BOUNDS_MIN_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    /// Axis-aligned bounds, max x, y, z (3 values).
    def BOUNDS_MAX_M(i:int) -> float:
        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 4)
    def BOUNDS_MAX_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Total mass of the finest level: the integral of amplitude over space,
    /// AMPLITUDE_UNITS times cubic metres. Every level MUST match it within
    /// MASS_TOLERANCE.
    def MASS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
