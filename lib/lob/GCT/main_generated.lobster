/// The producer's reduction of the source fields to this tile's rectangle:
/// what a coarse tile draws as a continuous sheet before any Gaussian is
/// resolved. Samples are row-major with latitude as the outer index, cell
/// (i, j) centred at (LAT0_RAD + i * DLAT_RAD, LON0_RAD + j * DLON_RAD).
class GCTCoverGrid : flatbuffers.handle
    /// Latitude of the first row's cell centre, radians.
    def LAT0_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, 0.0)
    /// Longitude of the first column's cell centre, radians.
    def LON0_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    /// Latitude step between rows, radians (signed).
    def DLAT_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Longitude step between columns, radians (signed).
    def DLON_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Number of rows.
    def NLAT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 0)
    /// Number of columns.
    def NLON() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)
    /// Low-cloud cover fraction per cell, [0, 1]. NaN marks a missing cell.
    def LOW_COVER(i:int) -> float:
        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 4)
    def LOW_COVER_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Medium-cloud cover fraction per cell, [0, 1]. Absent when unstated.
    def MEDIUM_COVER(i:int) -> float:
        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 18) + i * 4)
    def MEDIUM_COVER_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// High-cloud cover fraction per cell, [0, 1]. Absent when unstated.
    def HIGH_COVER(i:int) -> float:
        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 20) + i * 4)
    def HIGH_COVER_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// Height of the low-cloud base per cell, metres above the ellipsoid
    /// (the lifting condensation level over the ground height).
    def BASE_HEIGHT_M(i:int) -> float:
        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 22) + i * 4)
    def BASE_HEIGHT_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    /// Height of the low-cloud top per cell, metres above the ellipsoid.
    def TOP_HEIGHT_M(i:int) -> float:
        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 24) + i * 4)
    def TOP_HEIGHT_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    /// Column optical depth per cell of the whole tile content along the
    /// vertical, dimensionless. Absent when unstated.
    def COLUMN_OPTICAL_DEPTH(i:int) -> float:
        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 26) + i * 4)
    def COLUMN_OPTICAL_DEPTH_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)

