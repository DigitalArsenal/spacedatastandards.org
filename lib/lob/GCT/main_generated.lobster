        return GCTLevel { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 12) + i * 4) }
    def LEVELS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// Axis-aligned bounds of the finest level's support in the variant
    /// frame, metres: min x, y, z (3 values).
