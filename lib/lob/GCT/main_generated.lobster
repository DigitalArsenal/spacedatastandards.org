/// Gaussian Cloud Tile: one quadtree tile of a volumetric field as a mass-conserving Gaussian mixture, rendering-ready, for one valid time.
class GCT : flatbuffers.handle
    /// Stable identifier of the whole tiled field this tile belongs to; equal
    /// across all tiles and levels of one (producer, source fields, valid
    /// time, geometric-error ladder).
    def FIELD_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Quadtree the keys are stated in.
    def TILING() -> gctTilingScheme:
        return gctTilingScheme(flatbuffers.field_int8(buf_, pos_, 6, 0))
    /// Tile level; 0 is a root.
    def LEVEL() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 8, 0)
    /// Tile column, eastward from longitude -180.
    def X() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 10, 0)
    /// Tile row, southward from latitude +90.
    def Y() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 0)
    /// Which of the four children exist (bits 0..3 as defined in the header).
    /// 0 on a leaf. A child that does not exist has no content anywhere
    /// beneath it — clear sky is never traversed.
    def CHILD_MASK() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 14, 0)
    /// Deepest level with content under this tile, when the producer knows
    /// it; 255 when unstated.
    def MAX_LEVEL() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 16, 255)
    /// How the tile relates to its children.
    def REFINE() -> gctRefinement:
        return gctRefinement(flatbuffers.field_int8(buf_, pos_, 18, 0))
    /// The cell the tile's content was merged on, metres: its geometric
    /// error. Children carry a smaller value than their parent.
    def GEOMETRIC_ERROR_M() -> float:
        return flatbuffers.field_float32(buf_, pos_, 20, 0.0)
    /// Bounding region of the content and every descendant's content, which
    /// may exceed the nominal tile rectangle. Radians, WGS84.
    def WEST_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    def SOUTH_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    def EAST_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    def NORTH_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    /// Lowest point of the region, metres above the WGS84 ellipsoid.
    def MIN_HEIGHT_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)
    /// Highest point of the region, metres above the WGS84 ellipsoid.
    def MAX_HEIGHT_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, 0.0)
    /// The tile's east-north-up frame: geodetic origin, radians and metres
    /// above the WGS84 ellipsoid. Instances and variants are stated in this
    /// frame.
    def ORIGIN_LON_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    def ORIGIN_LAT_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 0.0)
    def ORIGIN_HEIGHT_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 38, 0.0)
    /// Column-major 4x4 transform taking tile-frame points (metres) to WGS84
    /// Earth-centred Earth-fixed metres. Exactly 16 entries. Its rigid
    /// inverse takes ECEF points into the tile frame.
    def ENU_TO_ECEF(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 40) + i * 8)
    def ENU_TO_ECEF_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 40)
    /// Physical quantity every Gaussian amplitude measures.
    def FIELD_QUANTITY() -> gctFieldQuantity:
        return gctFieldQuantity(flatbuffers.field_int8(buf_, pos_, 42, 0))
    /// Producer's name for the quantity; required when FIELD_QUANTITY is
    /// OTHER.
    def FIELD_QUANTITY_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 44)
    /// Units of every amplitude, UCUM or CF style (e.g. "m-1", "kg kg-1").
    def AMPLITUDE_UNITS() -> string:
        return flatbuffers.field_string(buf_, pos_, 46)
    /// Relative tolerance on mass conservation between any two levels of a
    /// variant and between a tile and its children, e.g. 0.01.
    def MASS_TOLERANCE() -> float:
        return flatbuffers.field_float32(buf_, pos_, 48, 0.0)
    /// Variants placed in this tile.
    def VARIANTS(i:int) -> GCTVariant:
        return GCTVariant { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 50) + i * 4) }
    def VARIANTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 50)
    /// Placements of the variants in the tile frame.
    def INSTANCES(i:int) -> GCTInstance:
        return GCTInstance { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 52) + i * 4) }
    def INSTANCES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 52)
    /// The producer's reduction of the source fields to this tile, present on
    /// tiles whose GEOMETRIC_ERROR_M exceeds the cloud layer's thickness (the
    /// sheet a consumer draws before the Gaussians resolve) and optional
    /// elsewhere.
    def COVER() -> GCTCoverGrid?:
        let o = flatbuffers.field_table(buf_, pos_, 54)
        return if o: GCTCoverGrid { buf_, o } else: nil
    /// Time the field is valid at, Unix milliseconds UTC.
    def VALID_TIME_MS() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 56, 0)
    /// Initialisation time of the run the source fields came from, Unix
    /// milliseconds UTC. Present only for TIME_BASIS Initialization.
    def INIT_TIME_MS() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 58, 0)
    /// Forecast lead from INIT_TIME_MS, hours. Present only for TIME_BASIS
    /// Initialization.
    def LEAD_HOURS() -> float:
        return flatbuffers.field_float32(buf_, pos_, 60, 0.0)
    /// Which times the source publishes; governs INIT_TIME_MS and LEAD_HOURS.
    def TIME_BASIS() -> wxfTimeBasis:
        return wxfTimeBasis(flatbuffers.field_int8(buf_, pos_, 62, 0))
    /// Class of the model that produced the source fields.
    def MODEL_CLASS() -> wxfModelClass:
        return wxfModelClass(flatbuffers.field_int8(buf_, pos_, 64, 0))
    /// Producer-defined identifier of the source model.
    def MODEL_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 66)
    /// FIELD_ID of every `$WXF` (or other source record) the tile was derived
    /// from, including ones that contributed nothing, so a consumer can tell
    /// "not consulted" from "consulted and empty".
    def SOURCE_FIELD_IDS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 68) + i * 4)
    def SOURCE_FIELD_IDS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 68)
    /// Peer identifier of the node that produced and published this tile.
    def PRODUCER_PEER_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 70)
    /// Producer software and version that authored the Gaussians, e.g.
    /// "orbpro-gaussian-clouds 0.13.0".
    def PRODUCER_VERSION() -> string:
        return flatbuffers.field_string(buf_, pos_, 72)
    /// Producer conventions a consumer needs and this schema does not fix
    /// (the EROSION deck convention, the erosion and warp fields' definition).
    def PRODUCER_NOTES() -> string:
        return flatbuffers.field_string(buf_, pos_, 74)
    /// Unix milliseconds UTC when the tile was produced.
    def PRODUCED_AT_MS() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 76, 0)
    /// Seed the placement and authoring were derived from; with the source
    /// fields it reproduces the tile.
    def AUTHORING_SEED() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 78, 0)
    /// Licence class applicable to the derived tile at PRODUCED_AT_MS.
    def LICENSE_CLASS() -> wxfLicenseClass:
        return wxfLicenseClass(flatbuffers.field_int8(buf_, pos_, 80, 0))
    /// URL of the licence or terms the tile is offered under.
    def LICENSE_URL() -> string:
        return flatbuffers.field_string(buf_, pos_, 82)
    /// Citation the upstream publishers ask for.
    def CITATION() -> string:
        return flatbuffers.field_string(buf_, pos_, 84)

def GetRootAsGCT(buf:string): return GCT { buf, flatbuffers.indirect(buf, 0) }

