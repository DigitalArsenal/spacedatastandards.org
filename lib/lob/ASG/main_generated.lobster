/// Settings of a gated association. Every field has its default.
class ASGAssociationOptions : flatbuffers.handle
    /// Probability mass inside the chi-square gate, (0, 1).
    def GATE_PROBABILITY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, 0.9973)
    /// Correct predictions for light time.
    def LIGHT_TIME() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 6, 1))
    /// Minimum posterior for an unambiguous association, (0, 1].
    def MIN_POSTERIOR() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.99)
    /// Spatial density of clutter (false or new-object detections) in the
    /// posterior, per unit measurement volume; 0 = none.
    def CLUTTER_DENSITY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    def SCAN() -> asgScanGrouping:
        return asgScanGrouping(flatbuffers.field_uint8(buf_, pos_, 12, 0))
    /// Out-of-gate candidates reported per observation, 1 to 50.
    def MAX_CANDIDATES() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 14, 5)
    /// Report each candidate's predicted position, velocity and covariance.
    def GEOMETRY() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 1))

def GetRootAsASGAssociationOptions(buf:string): return ASGAssociationOptions { buf, flatbuffers.indirect(buf, 0) }

struct ASGAssociationOptionsBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(7)
        return this
    def add_GATE_PROBABILITY(GATE_PROBABILITY:float):
        b_.PrependFloat64Slot(0, GATE_PROBABILITY, 0.9973)
        return this
    def add_LIGHT_TIME(LIGHT_TIME:bool):
        b_.PrependBoolSlot(1, LIGHT_TIME, 1)
        return this
    def add_MIN_POSTERIOR(MIN_POSTERIOR:float):
        b_.PrependFloat64Slot(2, MIN_POSTERIOR, 0.99)
        return this
    def add_CLUTTER_DENSITY(CLUTTER_DENSITY:float):
        b_.PrependFloat64Slot(3, CLUTTER_DENSITY, 0.0)
        return this
    def add_SCAN(SCAN:asgScanGrouping):
        b_.PrependUint8Slot(4, SCAN, 0)
        return this
    def add_MAX_CANDIDATES(MAX_CANDIDATES:int):
        b_.PrependUint8Slot(5, MAX_CANDIDATES, 5)
        return this
    def add_GEOMETRY(GEOMETRY:bool):
        b_.PrependBoolSlot(6, GEOMETRY, 1)
        return this
    def end():
        return b_.EndObject()

/// Chi-square gate threshold for one number of degrees of freedom.
class ASGGateThreshold : flatbuffers.handle
    def DEGREES_OF_FREEDOM() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 4, 0)
    /// D2 threshold at the gate probability.
    def THRESHOLD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)

def GetRootAsASGGateThreshold(buf:string): return ASGGateThreshold { buf, flatbuffers.indirect(buf, 0) }

struct ASGGateThresholdBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(2)
        return this
    def add_DEGREES_OF_FREEDOM(DEGREES_OF_FREEDOM:int):
        b_.PrependUint8Slot(0, DEGREES_OF_FREEDOM, 0)
        return this
    def add_THRESHOLD(THRESHOLD:float):
        b_.PrependFloat64Slot(1, THRESHOLD, 0.0)
        return this
    def end():
        return b_.EndObject()

/// The evidence of one association run. The association list and the
/// uncorrelated list are OBSERVATIONS filtered by OUTCOME.
class ASGAssociationReport : flatbuffers.handle
    /// Method, e.g. "chi-square gate on S = H P H^T + R, global nearest
    /// neighbour per scan (Hungarian), gate as the non-assignment cost".
    def METHOD() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// The options the run used, defaults filled in.
    def OPTIONS() -> ASGAssociationOptions?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: ASGAssociationOptions { buf_, o } else: nil
    /// Gate thresholds by degrees of freedom.
    def GATE_THRESHOLDS(i:int) -> ASGGateThreshold:
        return ASGGateThreshold { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 8) + i * 4) }
    def GATE_THRESHOLDS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Earth orientation rows supplied.
    def EARTH_ORIENTATION_ROWS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 10, 0)
    /// Observations read.
    def OBSERVATION_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 0)
    /// Predicted objects (prediction blocks) read.
    def PREDICTION_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)
    /// Scans solved.
    def SCAN_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 16, 0)
    /// Observations associated.
    def ASSOCIATED_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 18, 0)
    /// Observations left uncorrelated.
    def UNCORRELATED_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 20, 0)
    /// Observations marked ambiguous.
    def AMBIGUOUS_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 22, 0)
    def OBSERVATIONS(i:int) -> ASGObservation:
        return ASGObservation { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 24) + i * 4) }
    def OBSERVATIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)

def GetRootAsASGAssociationReport(buf:string): return ASGAssociationReport { buf, flatbuffers.indirect(buf, 0) }

