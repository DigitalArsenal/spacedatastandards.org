/// Assignment - exactly one of the arms is set.
class ASG : flatbuffers.handle
    def PROBLEM() -> ASGProblem?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: ASGProblem { buf_, o } else: nil
    def SOLUTION() -> ASGSolution?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: ASGSolution { buf_, o } else: nil
    def ASSOCIATION_OPTIONS() -> ASGAssociationOptions?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: ASGAssociationOptions { buf_, o } else: nil
    def ASSOCIATION_REPORT() -> ASGAssociationReport?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: ASGAssociationReport { buf_, o } else: nil

def GetRootAsASG(buf:string): return ASG { buf, flatbuffers.indirect(buf, 0) }

