    /// Candidates by increasing D2: the best few plus every in-gate one. The
    /// first is the nearest (the one a UCT report names).
    def CANDIDATES(i:int) -> ASGCandidate:
        return ASGCandidate { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 30) + i * 4) }
    def CANDIDATES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    /// Index into CANDIDATES of the assigned object; -1 = uncorrelated.
    def ASSIGNED_CANDIDATE() -> int:
        return flatbuffers.field_int32(buf_, pos_, 32, -1)
    /// Sensor position at the observation time, GCRF, km (3 values).
    def SENSOR_POSITION_GCRF_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 34) + i * 8)
    def SENSOR_POSITION_GCRF_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    /// Sensor velocity, GCRF, km/s (3 values) for an Earth-fixed sensor; empty
    /// for an inertial sensor position, which carries no velocity.
    def SENSOR_VELOCITY_GCRF_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 36) + i * 8)
    def SENSOR_VELOCITY_GCRF_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 36)
    /// Unit line of sight from the sensor, GCRF (3 values); empty when the
    /// observation has no direction.
    def LINE_OF_SIGHT_GCRF(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 38) + i * 8)
    def LINE_OF_SIGHT_GCRF_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 38)

