/// Relative-motion detail.
class mplRelativeSolution : flatbuffers.handle
    /// Model reference, e.g. "Koenig-Guffanti-D'Amico ROE STM".
    def MODEL_REFERENCE() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Dynamics INITIAL_ROE was propagated with.
    def DYNAMICS() -> mplRelativeDynamics:
        return mplRelativeDynamics(flatbuffers.field_uint8(buf_, pos_, 6, 0))
    /// Dynamics of STATE_TRANSITION and DRAG_COLUMNS.
    def STM_DYNAMICS() -> mplRelativeDynamics:
        return mplRelativeDynamics(flatbuffers.field_uint8(buf_, pos_, 8, 0))
    /// 6x6 relative-orbital-element state transition matrix over DURATION_S,
    /// row-major (36 values), dimensionless (the ROE are dimensionless).
    def STATE_TRANSITION(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 8)
    def STATE_TRANSITION_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Drag sensitivity columns, row-major 6 x DRAG_COLUMN_COUNT: entry (i, k)
    /// is the change in ROE i at DURATION_S per unit of drag rate k, the rates
    /// being those of mplDifferentialDrag (1/s): k = 0 da-dot, 1 dex-dot, 2
    /// dey-dot. Unit: seconds (e.g. entry (0, 0) equals
    /// DURATION_S). J2DragEccentric gives one column (the da-dot column of the
    /// eccentric model), J2DragArbitrary three. Empty = no drag model.
    def DRAG_COLUMNS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def DRAG_COLUMNS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    def DRAG_COLUMN_COUNT() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 14, 0)
    /// Initial and propagated relative orbital elements (6 values each).
    def INITIAL_ROE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 8)
    def INITIAL_ROE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    def PROPAGATED_ROE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 18) + i * 8)
    def PROPAGATED_ROE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// CollisionAvoidance: miss distance the burn achieves, km.
    def ACHIEVED_MISS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    /// CollisionAvoidance: true when the required miss is reachable within the
    /// available delta-v.
    def FEASIBLE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 22, 0))
    /// ApproachCorridor: largest lateral deviation from the corridor axis, km,
    /// and whether it stays within the corridor.
    def CORRIDOR_DEVIATION_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    def WITHIN_CORRIDOR() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))

def GetRootAsmplRelativeSolution(buf:string): return mplRelativeSolution { buf, flatbuffers.indirect(buf, 0) }

