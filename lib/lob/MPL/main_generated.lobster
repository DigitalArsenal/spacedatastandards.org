    reverse(v_) e_: b_.PrependFloat64(e_)
    return b_.EndVector(v_.length)

/// Solver evidence for an arc or a plan.
class mplSolver : flatbuffers.handle
    /// True when the solver met its tolerance.
    def CONVERGED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 4, 0))
    /// Iterations used.
    def ITERATIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    /// Solver status as text, e.g. "success", "max-iterations".
    def STATUS_TEXT() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    /// Final residual, in the solver's own measure (time of flight in s for
    /// Lambert; position error in km for targeting).
    def RESIDUAL() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// The residual the solver had to meet, same unit; 0 = not stated.
    def RESIDUAL_TOLERANCE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)

def GetRootAsmplSolver(buf:string): return mplSolver { buf, flatbuffers.indirect(buf, 0) }

struct mplSolverBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(5)
        return this
    def add_CONVERGED(CONVERGED:bool):
        b_.PrependBoolSlot(0, CONVERGED, 0)
        return this
    def add_ITERATIONS(ITERATIONS:int):
        b_.PrependUint32Slot(1, ITERATIONS, 0)
        return this
    def add_STATUS_TEXT(STATUS_TEXT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, STATUS_TEXT)
        return this
    def add_RESIDUAL(RESIDUAL:float):
        b_.PrependFloat64Slot(3, RESIDUAL, 0.0)
        return this
    def add_RESIDUAL_TOLERANCE(RESIDUAL_TOLERANCE:float):
        b_.PrependFloat64Slot(4, RESIDUAL_TOLERANCE, 0.0)
        return this
    def end():
        return b_.EndObject()

/// One arc of a plan: a coast or transfer between burns, or a leg, phase or
/// segment of a relative-motion plan.
class mplArc : flatbuffers.handle
    /// Label within the plan, e.g. "transfer", "leg 2".
    def NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    def ROLE() -> mplArcRole:
        return mplArcRole(flatbuffers.field_uint8(buf_, pos_, 6, 0))
    /// Seconds from the plan's start to the arc's start.
    def START_OFFSET_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Duration of the arc, s (time of flight for a transfer).
    def DURATION_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Revolutions completed on the arc (Lambert revolution count, phasing
    /// revolutions); 0 = less than one.
    def REVOLUTIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 0)
    def BRANCH() -> mplLambertBranch:
        return mplLambertBranch(flatbuffers.field_uint8(buf_, pos_, 14, 0))
    def CONIC() -> mplConic:
        return mplConic(flatbuffers.field_uint8(buf_, pos_, 16, 0))
    /// Semi-major axis of the arc's conic, km; 0 = not representable
    /// (parabola) or not computed.
    def SEMI_MAJOR_AXIS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// Eccentricity of the arc's conic.
    def ECCENTRICITY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    /// Periapsis radius from the body centre, km. Reported, never a refusal: an
    /// arc may pass below the body surface, and the consumer screens.
    def PERIAPSIS_RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// Apoapsis radius, km; 0 = none (parabolic or hyperbolic).
    def APOAPSIS_RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    /// Period of the arc's orbit, s; 0 = not closed or not computed.
    def PERIOD_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    /// State at the arc's start (position and velocity just after the burn
    /// that starts it). Inertial (km, km/s) unless STATE_AXES says relative.
    def START_STATE() -> ephemerisDataLine?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: ephemerisDataLine { buf_, o } else: nil
    /// State at the arc's end (just before the burn that ends it).
    def END_STATE() -> ephemerisDataLine?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: ephemerisDataLine { buf_, o } else: nil
    /// Axes of START_STATE and END_STATE.
    def STATE_AXES() -> mplAxes:
        return mplAxes(flatbuffers.field_uint8(buf_, pos_, 32, 1))
    /// Delta-v of the burns that start and end this arc, km/s; 0 = not
    /// computed.
    def DELTA_V_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    /// Universal variable z of a Lambert solution (dimensionless); 0 elsewhere.
    def LAMBERT_Z() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 0.0)
    def SOLVER() -> mplSolver?:
        let o = flatbuffers.field_table(buf_, pos_, 38)
        return if o: mplSolver { buf_, o } else: nil
    /// Sampled states along the arc; empty = not sampled.
    def TRAJECTORY() -> mplTrajectory?:
        let o = flatbuffers.field_table(buf_, pos_, 40)
        return if o: mplTrajectory { buf_, o } else: nil

def GetRootAsmplArc(buf:string): return mplArc { buf, flatbuffers.indirect(buf, 0) }

