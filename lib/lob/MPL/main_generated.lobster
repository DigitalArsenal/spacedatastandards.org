/// Closed-loop rendezvous detail. Samples are column-major and parallel,
/// one entry (or three, for vectors) per sample, all in the target's RIC
/// axes.
class mplRendezvousSolution : flatbuffers.handle
    /// Model reference, e.g. "HCW drift + quintic brake + feedback-linearized
    /// PD".
    def MODEL_REFERENCE() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Mean motion of the target, rad/s.
    def MEAN_MOTION_RAD_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    /// Drift-leg initial velocity (solved or given), km/s, 3 values.
    def INITIAL_VELOCITY_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 8) + i * 8)
    def INITIAL_VELOCITY_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Per-axis proportional (1/s^2) and derivative (1/s) gains, 3 values each.
    def KP_PER_S2(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 8)
    def KP_PER_S2_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    def KD_PER_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def KD_PER_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// End of the drift and of the braking phase, and the total time, s from
    /// the start.
    def DRIFT_END_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    def BRAKE_END_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    def TOTAL_TIME_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// Control effort and tracking metrics.
    def MAX_CONTROL_ACCELERATION_KM_S2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    def SATURATED_STEPS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 22, 0)
    def MAX_POSITION_ERROR_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    def RMS_POSITION_ERROR_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    def MAX_POSITION_ERROR_DRIFT_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    def MAX_POSITION_ERROR_BRAKE_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)
    def MAX_POSITION_ERROR_HOLD_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, 0.0)
    def FINAL_POSITION_ERROR_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    def FINAL_VELOCITY_ERROR_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 0.0)
    /// Sample times, s from the start.
    def SAMPLE_TIME_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 38) + i * 8)
    def SAMPLE_TIME_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 38)
    def SAMPLE_PHASE(i:int) -> mplRendezvousPhase:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 40) + i * 1)
    def SAMPLE_PHASE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 40)
    /// Actual and reference relative position (km) and velocity (km/s), 3
    /// values per sample.
    def POSITION_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 42) + i * 8)
    def POSITION_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 42)
    def VELOCITY_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 44) + i * 8)
    def VELOCITY_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 44)
    def REFERENCE_POSITION_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 46) + i * 8)
    def REFERENCE_POSITION_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 46)
    def REFERENCE_VELOCITY_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 48) + i * 8)
    def REFERENCE_VELOCITY_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 48)
    /// Reference and commanded control acceleration, km/s^2, 3 per sample.
    def REFERENCE_ACCELERATION_KM_S2(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 50) + i * 8)
    def REFERENCE_ACCELERATION_KM_S2_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 50)
    def CONTROL_ACCELERATION_KM_S2(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 52) + i * 8)
    def CONTROL_ACCELERATION_KM_S2_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 52)
    /// Tracking error magnitudes per sample.
    def POSITION_ERROR_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 54) + i * 8)
    def POSITION_ERROR_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 54)
    def VELOCITY_ERROR_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 56) + i * 8)
    def VELOCITY_ERROR_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 56)

def GetRootAsmplRendezvousSolution(buf:string): return mplRendezvousSolution { buf, flatbuffers.indirect(buf, 0) }

