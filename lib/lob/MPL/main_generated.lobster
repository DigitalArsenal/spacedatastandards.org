/// An option the planner weighed: another revolution count or branch of a
/// Lambert problem, or the other phasing direction. Lets a consumer show the
/// road not taken beside the chosen plan.
class mplOption : flatbuffers.handle
    /// Label, e.g. "catchUp", "1 rev high".
    def NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// True for the option the plan carries.
    def SELECTED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 6, 0))
    def REVOLUTIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    def BRANCH() -> mplLambertBranch:
        return mplLambertBranch(flatbuffers.field_uint8(buf_, pos_, 10, 0))
    def DIRECTION() -> mplPhasingDirection:
        return mplPhasingDirection(flatbuffers.field_uint8(buf_, pos_, 12, 0))
    /// Phase angle this option closes, deg (signed).
    def PHASE_ANGLE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// Magnitude of each burn, km/s, in burn order.
    def BURN_DELTA_V_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 8)
    def BURN_DELTA_V_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Total delta-v, km/s.
    def TOTAL_DELTA_V_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// Total time, s.
    def TOTAL_TIME_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    /// Semi-major axis of the option's transfer or phasing orbit, km.
    def SEMI_MAJOR_AXIS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// True when the option's orbit was clamped to the body's floor.
    def CLAMPED_TO_FLOOR() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 24, 0))
    /// True when the option met the delta-v budget.
    def WITHIN_BUDGET() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))

def GetRootAsmplOption(buf:string): return mplOption { buf, flatbuffers.indirect(buf, 0) }

