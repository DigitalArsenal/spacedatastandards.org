/// Orbit-geometry questions (OrbitGeometry, AnomalyConversion,
/// TimeOfFlight, OrbitSampling, DeltaVTransform).
class mplGeometryRequest : flatbuffers.handle
    /// The orbit asked about (all but AnomalyConversion).
    def ORBIT() -> mplOrbit?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: mplOrbit { buf_, o } else: nil
    /// OrbitGeometry: evaluate at this true anomaly, deg; NaN = at the orbit's
    /// own epoch (or after ELAPSED_S). Not together with HAS_ELAPSED.
    def AT_TRUE_ANOMALY_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, nan)
    /// OrbitGeometry: coast this long from the orbit's epoch first, s (signed);
    /// read only when HAS_ELAPSED.
    def ELAPSED_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// True when ELAPSED_S is stated (0 is then a real zero-length coast);
    /// false = no coast.
    def HAS_ELAPSED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 10, 0))
    /// OrbitGeometry: a burn to apply at the evaluated point;
    /// DeltaVTransform: the delta-v to rotate (its AXES is the source axes).
    def BURN() -> mplBurn?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: mplBurn { buf_, o } else: nil
    /// DeltaVTransform: axes to rotate the delta-v into.
    def TO_AXES() -> mplAxes:
        return mplAxes(flatbuffers.field_uint8(buf_, pos_, 14, 0))
    /// AnomalyConversion: eccentricity.
    def ECCENTRICITY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// AnomalyConversion: the anomaly to convert, deg.
    def ANOMALY_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    def ANOMALY_KIND() -> mplAnomalyKind:
        return mplAnomalyKind(flatbuffers.field_uint8(buf_, pos_, 20, 0))
    /// TimeOfFlight and OrbitSampling: start true anomaly, deg.
    def FROM_TRUE_ANOMALY_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// TimeOfFlight: end true anomaly, deg.
    def TO_TRUE_ANOMALY_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    /// TimeOfFlight: whole revolutions to add.
    def REVOLUTIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 26, 0)
    /// OrbitSampling: signed sweep from FROM_TRUE_ANOMALY_DEG, deg, at most one
    /// revolution; read only when HAS_SWEEP.
    def SWEEP_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    /// True when SWEEP_DEG is stated; false = one full revolution forward.
    def HAS_SWEEP() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 30, 0))
    /// OrbitSampling: samples, endpoints included.
    def SAMPLE_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 32, 0)

def GetRootAsmplGeometryRequest(buf:string): return mplGeometryRequest { buf, flatbuffers.indirect(buf, 0) }

