/// Phasing detail: the phase geometry and the floor guard.
class mplPhasingSolution : flatbuffers.handle
    /// Phase angle the plan closes, deg (signed).
    def PHASE_ANGLE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, 0.0)
    /// Phase angle the flown (possibly clamped) phasing orbit delivers, deg.
    def ACHIEVED_PHASE_ANGLE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    /// Semi-major axis and period the unclamped plan would have needed.
    def REQUESTED_SEMI_MAJOR_AXIS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    def REQUESTED_PERIOD_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Lowest radius the phasing orbit's far apse may reach, km (body radius
    /// plus margin).
    def FLOOR_RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// True when the phasing orbit was raised to the floor.
    def CLAMPED_TO_FLOOR() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 14, 0))
    /// Radius of the phasing orbit's far apse (the apse opposite the burn
    /// point: its apoapsis when raised, its periapsis when lowered), km.
    def FAR_APSE_RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// The radius the plan was flown at (the chaser's semi-major axis), km.
    def PHASING_RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// PhasingToTarget: relative phase angle, deg, in (-180, 180]; positive
    /// when the target leads. The relative mean argument of latitude plus the
    /// RAAN difference times cos(chaser inclination).
    def RELATIVE_PHASE_ANGLE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    /// The catch-up angle, in (0, 360], and the fall-behind angle, in
    /// [-360, 0), deg.
    def CATCH_UP_ANGLE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    def FALL_BEHIND_ANGLE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    /// The direction the plan flies.
    def DIRECTION() -> mplPhasingDirection:
        return mplPhasingDirection(flatbuffers.field_uint8(buf_, pos_, 26, 0))
    /// The chaser's and target's elements as used (with their mean arguments
    /// of latitude).
    def CHASER() -> mplElements?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: mplElements { buf_, o } else: nil
    def TARGET() -> mplElements?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: mplElements { buf_, o } else: nil
    def RAAN_DIFFERENCE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, 0.0)
    def INCLINATION_DIFFERENCE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    /// Angle between the two orbit normals, deg.
    def PLANE_ANGLE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 0.0)
    /// Target minus chaser semi-major axis, km.
    def SEMI_MAJOR_AXIS_DIFFERENCE_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 38, 0.0)
    /// Verdicts, each beside the tolerance that produced it (none refuses).
    def COPLANAR() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 40, 0))
    def COPLANAR_TOLERANCE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 42, 0.0)
    def NEAR_CIRCULAR() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 44, 0))
    def ECCENTRICITY_TOLERANCE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 46, 0.0)
    def CO_ORBITAL() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 48, 0))
    /// The co-orbital tolerance applied, as an absolute length, km, and as a
    /// fraction of the chaser's semi-major axis (the same threshold both ways).
    def CO_ORBITAL_TOLERANCE_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 50, 0.0)
    def CO_ORBITAL_TOLERANCE_FRACTION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 52, 0.0)
    /// Recommended revolution count, and whether the count came from the
    /// caller instead.
    def RECOMMENDED_REVOLUTIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 54, 0)
    def REVOLUTIONS_FROM_CALLER() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 56, 0))
    /// Largest revolution count searched (after clamping).
    def MAX_REVOLUTIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 58, 0)
    /// The budget applied, km/s, and whether the plan met it.
    def DELTA_V_BUDGET_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 60, 0.0)
    def WITHIN_BUDGET() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 62, 0))

def GetRootAsmplPhasingSolution(buf:string): return mplPhasingSolution { buf, flatbuffers.indirect(buf, 0) }

