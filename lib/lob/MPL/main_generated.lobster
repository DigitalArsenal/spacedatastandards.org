/// The question: which problem and its inputs. Only the sub-table matching
/// PROBLEM is read.
class mplRequest : flatbuffers.handle
    /// Gravitational parameter of the central body, km^3/s^2; 0 = Earth
    /// (398600.4418).
    def MU_KM3_S2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, 0.0)
    def TRANSFER() -> mplTransferRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: mplTransferRequest { buf_, o } else: nil
    def LAMBERT() -> mplLambertRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: mplLambertRequest { buf_, o } else: nil
    def PHASING() -> mplPhasingRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: mplPhasingRequest { buf_, o } else: nil
    def RELATIVE() -> mplRelativeRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: mplRelativeRequest { buf_, o } else: nil
    def RENDEZVOUS() -> mplRendezvousRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: mplRendezvousRequest { buf_, o } else: nil
    def GEOMETRY() -> mplGeometryRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 16)
        return if o: mplGeometryRequest { buf_, o } else: nil

def GetRootAsmplRequest(buf:string): return mplRequest { buf, flatbuffers.indirect(buf, 0) }

