/// Orbit-geometry detail.
class mplGeometrySolution : flatbuffers.handle
    /// OrbitGeometry: the inertial state at the evaluated point (after BURN).
    def STATE() -> ephemerisDataLine?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: ephemerisDataLine { buf_, o } else: nil
    /// OrbitGeometry: elements at the point (all anomalies and derived fields
    /// filled); AnomalyConversion: the three anomalies.
    def ELEMENTS() -> mplElements?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: mplElements { buf_, o } else: nil
    /// Distance from the body centre, km.
    def RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// The RIC axes at the point, before the burn, as three inertial unit
    /// vectors R, I, C (9 values, row by row).
    def RIC_BASIS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 8)
    def RIC_BASIS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// The VNC axes at the point, before the burn: V, N, C (9 values).
    def VNC_BASIS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def VNC_BASIS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// TimeOfFlight: forward time between the anomalies, s.
    def TIME_OF_FLIGHT_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// DeltaVTransform: the rotated delta-v (its AXES the target axes).
    def BURN() -> mplBurn?:
        let o = flatbuffers.field_table(buf_, pos_, 16)
        return if o: mplBurn { buf_, o } else: nil

def GetRootAsmplGeometrySolution(buf:string): return mplGeometrySolution { buf, flatbuffers.indirect(buf, 0) }

