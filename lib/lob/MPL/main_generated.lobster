/// Maneuver Plan - one planning request and the plan that answers it.
class MPL : flatbuffers.handle
    /// Identifier of the plan; empty = not assigned.
    def ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Unix milliseconds the request was made (or the plan produced).
    def CREATED_AT_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 6, 0)
    /// Identifier of the planning service or tool that answered.
    def PLANNER() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def PROBLEM() -> mplProblem:
        return mplProblem(flatbuffers.field_uint8(buf_, pos_, 10, 0))
    /// Unix milliseconds of the plan's start (offset 0); 0 = the plan is in
    /// relative time only.
    def PLAN_EPOCH_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 12, 0)
    /// The maneuvering object (chaser) and, for relative problems, the target.
    def OBJECT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    def TARGET_OBJECT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)
    /// Inertial frame of every inertial state and Inertial-axes vector; empty =
    /// the central body's GCRF/EME2000.
    def REFERENCE_FRAME() -> RFM?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: RFM { buf_, o } else: nil
    def REQUEST() -> mplRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 20)
        return if o: mplRequest { buf_, o } else: nil
    def STATUS() -> mplStatus:
        return mplStatus(flatbuffers.field_uint8(buf_, pos_, 22, 0))
    /// Stable machine-readable reason when STATUS is not Solved, e.g.
    /// "invalid-parameter", "no-solution"; empty otherwise.
    def ERROR_CODE() -> string:
        return flatbuffers.field_string(buf_, pos_, 24)
    def ERROR_MESSAGE() -> string:
        return flatbuffers.field_string(buf_, pos_, 26)
    /// The burns, in time order.
    def BURNS(i:int) -> mplBurn:
        return mplBurn { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 28) + i * 4) }
    def BURNS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    /// The arcs, in time order.
    def ARCS(i:int) -> mplArc:
        return mplArc { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 30) + i * 4) }
    def ARCS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    /// Total delta-v: the sum of burn magnitudes (the propellant budget), km/s.
    def TOTAL_DELTA_V_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, 0.0)
    /// Time from the plan's start to its end, s.
    def TOTAL_TIME_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    /// Propellant for the whole plan, kg; 0 = not computed.
    def TOTAL_DELTA_MASS_KG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 0.0)
    /// Solver evidence for the plan as a whole.
    def SOLVER() -> mplSolver?:
        let o = flatbuffers.field_table(buf_, pos_, 38)
        return if o: mplSolver { buf_, o } else: nil
    /// Options weighed, including the selected one.
    def OPTIONS(i:int) -> mplOption:
        return mplOption { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 40) + i * 4) }
    def OPTIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 40)
    /// The whole plan's sampled trajectory; empty = not sampled.
    def TRAJECTORY() -> mplTrajectory?:
        let o = flatbuffers.field_table(buf_, pos_, 42)
        return if o: mplTrajectory { buf_, o } else: nil
    def PHASING() -> mplPhasingSolution?:
        let o = flatbuffers.field_table(buf_, pos_, 44)
        return if o: mplPhasingSolution { buf_, o } else: nil
    def RELATIVE() -> mplRelativeSolution?:
        let o = flatbuffers.field_table(buf_, pos_, 46)
        return if o: mplRelativeSolution { buf_, o } else: nil
    def RENDEZVOUS() -> mplRendezvousSolution?:
        let o = flatbuffers.field_table(buf_, pos_, 48)
        return if o: mplRendezvousSolution { buf_, o } else: nil
    def GEOMETRY() -> mplGeometrySolution?:
        let o = flatbuffers.field_table(buf_, pos_, 50)
        return if o: mplGeometrySolution { buf_, o } else: nil

def GetRootAsMPL(buf:string): return MPL { buf, flatbuffers.indirect(buf, 0) }

struct MPLBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(24)
        return this
    def add_ID(ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, ID)
        return this
    def add_CREATED_AT_MS(CREATED_AT_MS:int):
        b_.PrependInt64Slot(1, CREATED_AT_MS, 0)
        return this
    def add_PLANNER(PLANNER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, PLANNER)
        return this
    def add_PROBLEM(PROBLEM:mplProblem):
        b_.PrependUint8Slot(3, PROBLEM, 0)
        return this
    def add_PLAN_EPOCH_MS(PLAN_EPOCH_MS:int):
        b_.PrependInt64Slot(4, PLAN_EPOCH_MS, 0)
        return this
    def add_OBJECT_ID(OBJECT_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(5, OBJECT_ID)
        return this
    def add_TARGET_OBJECT_ID(TARGET_OBJECT_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(6, TARGET_OBJECT_ID)
        return this
    def add_REFERENCE_FRAME(REFERENCE_FRAME:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(7, REFERENCE_FRAME)
        return this
    def add_REQUEST(REQUEST:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(8, REQUEST)
        return this
    def add_STATUS(STATUS:mplStatus):
        b_.PrependUint8Slot(9, STATUS, 0)
        return this
    def add_ERROR_CODE(ERROR_CODE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(10, ERROR_CODE)
        return this
    def add_ERROR_MESSAGE(ERROR_MESSAGE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(11, ERROR_MESSAGE)
        return this
    def add_BURNS(BURNS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(12, BURNS)
        return this
    def add_ARCS(ARCS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(13, ARCS)
        return this
    def add_TOTAL_DELTA_V_KM_S(TOTAL_DELTA_V_KM_S:float):
        b_.PrependFloat64Slot(14, TOTAL_DELTA_V_KM_S, 0.0)
        return this
    def add_TOTAL_TIME_S(TOTAL_TIME_S:float):
        b_.PrependFloat64Slot(15, TOTAL_TIME_S, 0.0)
        return this
    def add_TOTAL_DELTA_MASS_KG(TOTAL_DELTA_MASS_KG:float):
        b_.PrependFloat64Slot(16, TOTAL_DELTA_MASS_KG, 0.0)
        return this
    def add_SOLVER(SOLVER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(17, SOLVER)
        return this
    def add_OPTIONS(OPTIONS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(18, OPTIONS)
        return this
    def add_TRAJECTORY(TRAJECTORY:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(19, TRAJECTORY)
        return this
    def add_PHASING(PHASING:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(20, PHASING)
        return this
    def add_RELATIVE(RELATIVE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(21, RELATIVE)
        return this
    def add_RENDEZVOUS(RENDEZVOUS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(22, RENDEZVOUS)
        return this
    def add_GEOMETRY(GEOMETRY:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(23, GEOMETRY)
        return this
    def end():
        return b_.EndObject()

def MPLStartBURNSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def MPLCreateBURNSVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

def MPLStartARCSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def MPLCreateARCSVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

def MPLStartOPTIONSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def MPLCreateOPTIONSVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)
