        b_.PrependUOffsetTRelativeSlot(0, POSITION_KM)
        return this
    def add_VELOCITY_KM_S(VELOCITY_KM_S:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, VELOCITY_KM_S)
        return this
    def add_TIME_OF_FLIGHT_S(TIME_OF_FLIGHT_S:float):
        b_.PrependFloat64Slot(2, TIME_OF_FLIGHT_S, 0.0)
        return this
    def end():
        return b_.EndObject()

def mplWaypointStartPOSITIONKMVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(8, n_, 8)
def mplWaypointCreatePOSITIONKMVector(b_:flatbuffers.builder, v_:[float]):
    b_.StartVector(8, v_.length, 8)
    reverse(v_) e_: b_.PrependFloat64(e_)
    return b_.EndVector(v_.length)

def mplWaypointStartVELOCITYKMSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(8, n_, 8)
def mplWaypointCreateVELOCITYKMSVector(b_:flatbuffers.builder, v_:[float]):
    b_.StartVector(8, v_.length, 8)
    reverse(v_) e_: b_.PrependFloat64(e_)
    return b_.EndVector(v_.length)

/// Relative-motion planning about a reference orbit
/// (RelativeStateTransition, RelativeWaypoints, CollisionAvoidance,
/// ApproachCorridor).
class mplRelativeRequest : flatbuffers.handle
    /// The reference (target, chief) orbit.
    def REFERENCE() -> mplElements?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: mplElements { buf_, o } else: nil
    /// Chaser state relative to the reference, RIC, km and km/s.
    def RELATIVE_STATE() -> ephemerisDataLine?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: ephemerisDataLine { buf_, o } else: nil
    /// Dynamics of propagation and targeting: RelativeStateTransition
    /// propagates INITIAL_ROE with these (J2 on or off; the drag model is
    /// DRAG); the targeting problems plan with them.
    def DYNAMICS() -> mplRelativeDynamics:
        return mplRelativeDynamics(flatbuffers.field_uint8(buf_, pos_, 8, 2))
    /// RelativeStateTransition: dynamics of the state transition matrix
    /// returned, chosen independently of DYNAMICS (e.g. a Keplerian matrix
    /// beside a J2 propagation). J2DragEccentric and J2DragArbitrary also
    /// return the drag columns.
    def STM_DYNAMICS() -> mplRelativeDynamics:
        return mplRelativeDynamics(flatbuffers.field_uint8(buf_, pos_, 10, 2))
    /// Differential drag; empty = none.
    def DRAG() -> mplDifferentialDrag?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: mplDifferentialDrag { buf_, o } else: nil
    /// RelativeStateTransition: propagation time, s.
    def DURATION_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// RelativeStateTransition: quasi-nonsingular relative orbital elements to
    /// propagate (da, dlambda, dex, dey, dix, diy), dimensionless; empty = the
    /// transition matrix only.
    def INITIAL_ROE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 8)
    def INITIAL_ROE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// RelativeWaypoints: the waypoints, in order.
    def WAYPOINTS(i:int) -> mplWaypoint:
        return mplWaypoint { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def WAYPOINTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Targeting: velocity to arrive with at every waypoint without its own,
    /// RIC, km/s, 3 values; empty = free.
    def TARGET_VELOCITY_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 20) + i * 8)
    def TARGET_VELOCITY_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// Targeting iteration limit; 0 = default.
    def MAX_ITERATIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 22, 0)
    /// Targeting position tolerance, km; 0 = default.
    def POSITION_TOLERANCE_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    /// Targeting velocity tolerance, km/s; 0 = default.
    def VELOCITY_TOLERANCE_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    /// Shortest and longest leg time the planner may choose, in reference
    /// orbits; 0 = default.
    def LEG_TIME_LOWER_ORBITS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    def LEG_TIME_UPPER_ORBITS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)
    /// States sampled per leg in the answer's trajectory; 0 = default.
    def SAMPLES_PER_LEG() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 32, 0)
    /// CollisionAvoidance: required miss distance, km.
    def MISS_DISTANCE_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    /// CollisionAvoidance: time from now to closest approach, s.
    def TIME_TO_CLOSEST_APPROACH_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 0.0)
    /// CollisionAvoidance: delta-v available, km/s; read only when
    /// HAS_MAX_DELTA_V. When stated, 0 = unlimited.
    def MAX_DELTA_V_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 38, 0.0)
    /// True when MAX_DELTA_V_KM_S is stated; false = the planner's default
    /// limit.
    def HAS_MAX_DELTA_V() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 40, 0))
    /// CollisionAvoidance: prefer radial burns (they preserve the period).
    def PREFER_RADIAL() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 42, 0))
    /// CollisionAvoidance: the conjunction being avoided, when the request
    /// comes from a conjunction data message.
    def CONJUNCTION() -> CDM?:
        let o = flatbuffers.field_table(buf_, pos_, 44)
        return if o: CDM { buf_, o } else: nil
    /// ApproachCorridor: the corridor axis.
    def APPROACH_AXIS() -> mplApproachAxis:
        return mplApproachAxis(flatbuffers.field_uint8(buf_, pos_, 46, 0))
    /// ApproachCorridor: point to reach, RIC, km, 3 values.
    def APPROACH_TARGET_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 48) + i * 8)
    def APPROACH_TARGET_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 48)
    /// ApproachCorridor: speed at the target point, km/s.
    def APPROACH_SPEED_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 50, 0.0)
    /// ApproachCorridor: half-width of the safety corridor, km.
    def CORRIDOR_HALF_WIDTH_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 52, 0.0)

def GetRootAsmplRelativeRequest(buf:string): return mplRelativeRequest { buf, flatbuffers.indirect(buf, 0) }

