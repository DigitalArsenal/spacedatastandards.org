/// Classical transfer and plane change between circular orbits (Hohmann,
/// BiElliptic, PlaneChange, CombinedTransfer).
class mplTransferRequest : flatbuffers.handle
    /// Radius of the initial circular orbit, km (also the orbit radius of a
    /// PlaneChange).
    def INITIAL_RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, 0.0)
    /// Radius of the final circular orbit, km.
    def FINAL_RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    /// Apoapsis radius of the intermediate orbit of a BiElliptic transfer, km.
    def INTERMEDIATE_RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Orbital speed at the burn of a PlaneChange, km/s.
    def SPEED_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Inclination change, deg (signed).
    def INCLINATION_CHANGE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)

def GetRootAsmplTransferRequest(buf:string): return mplTransferRequest { buf, flatbuffers.indirect(buf, 0) }

