        b_.PrependFloat64Slot(1, FINAL_RADIUS_KM, 0.0)
        return this
    def add_INTERMEDIATE_RADIUS_KM(INTERMEDIATE_RADIUS_KM:float):
        b_.PrependFloat64Slot(2, INTERMEDIATE_RADIUS_KM, 0.0)
        return this
    def add_SPEED_KM_S(SPEED_KM_S:float):
        b_.PrependFloat64Slot(3, SPEED_KM_S, 0.0)
        return this
    def add_INCLINATION_CHANGE_DEG(INCLINATION_CHANGE_DEG:float):
        b_.PrependFloat64Slot(4, INCLINATION_CHANGE_DEG, 0.0)
        return this
    def end():
        return b_.EndObject()

/// Lambert problem (Lambert, LambertMinimumDeltaV). DEPARTURE and ARRIVAL
/// give the two positions; their velocities, when given, are the velocities
/// of the orbits being left and joined, and make the result's burns real
/// delta-v (LambertMinimumDeltaV requires them, since ranking needs a cost).
class mplLambertRequest : flatbuffers.handle
    /// Departure position (and the departing orbit's velocity), inertial.
    def DEPARTURE() -> ephemerisDataLine?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: ephemerisDataLine { buf_, o } else: nil
    /// Arrival position (and the arrival orbit's velocity), inertial.
    def ARRIVAL() -> ephemerisDataLine?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: ephemerisDataLine { buf_, o } else: nil
    /// True when DEPARTURE and ARRIVAL carry orbit velocities; false = position
    /// only (the result then gives the transfer velocities, not delta-v).
    def ENDPOINT_VELOCITIES() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 8, 0))
    /// Time of flight, s.
    def TIME_OF_FLIGHT_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// True for a prograde (short-way in the direction of motion) transfer.
    def PROGRADE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 12, 1))
    /// Revolution count of a Lambert problem; the largest count ranked by
    /// LambertMinimumDeltaV.
    def REVOLUTIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)
    /// Lambert: the arc to return when REVOLUTIONS >= 1 (Unspecified = Low).
    /// LambertMinimumDeltaV: narrows the ranking to one branch (Unspecified =
    /// rank both).
    def BRANCH() -> mplLambertBranch:
        return mplLambertBranch(flatbuffers.field_uint8(buf_, pos_, 16, 0))

def GetRootAsmplLambertRequest(buf:string): return mplLambertRequest { buf, flatbuffers.indirect(buf, 0) }

struct mplLambertRequestBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(7)
        return this
    def add_DEPARTURE(DEPARTURE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, DEPARTURE)
        return this
    def add_ARRIVAL(ARRIVAL:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, ARRIVAL)
        return this
    def add_ENDPOINT_VELOCITIES(ENDPOINT_VELOCITIES:bool):
        b_.PrependBoolSlot(2, ENDPOINT_VELOCITIES, 0)
        return this
    def add_TIME_OF_FLIGHT_S(TIME_OF_FLIGHT_S:float):
        b_.PrependFloat64Slot(3, TIME_OF_FLIGHT_S, 0.0)
        return this
    def add_PROGRADE(PROGRADE:bool):
        b_.PrependBoolSlot(4, PROGRADE, 1)
        return this
    def add_REVOLUTIONS(REVOLUTIONS:int):
        b_.PrependUint32Slot(5, REVOLUTIONS, 0)
        return this
    def add_BRANCH(BRANCH:mplLambertBranch):
        b_.PrependUint8Slot(6, BRANCH, 0)
        return this
    def end():
        return b_.EndObject()

/// Phasing (Phasing, PhasingToTarget).
class mplPhasingRequest : flatbuffers.handle
    /// Phasing: radius of the chaser's circular orbit, km.
    def ORBIT_RADIUS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, 0.0)
    /// Phasing: phase angle to close, deg; positive when the target leads.
    def PHASE_ANGLE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    /// Revolutions on the phasing orbit; read only when HAS_REVOLUTIONS.
    def REVOLUTIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    /// True when REVOLUTIONS is stated (0 is then a real request for zero
    /// revolutions, which a planner may refuse); false = recommend the
    /// smallest count that neither clamps to the floor nor exceeds the budget
    /// (Phasing: the planner's default count).
    def HAS_REVOLUTIONS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 10, 0))
    /// Largest revolution count a recommendation may use; 0 = the planner's
    /// default (a planner searches at least one revolution).
    def MAX_REVOLUTIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 0)
    /// PhasingToTarget: the chaser's orbit.
    def CHASER() -> mplOrbit?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: mplOrbit { buf_, o } else: nil
    /// PhasingToTarget: the target's orbit.
    def TARGET() -> mplOrbit?:
        let o = flatbuffers.field_table(buf_, pos_, 16)
        return if o: mplOrbit { buf_, o } else: nil
    def DIRECTION() -> mplPhasingDirection:
        return mplPhasingDirection(flatbuffers.field_uint8(buf_, pos_, 18, 0))
    /// Delta-v budget, km/s; 0 = DELTA_V_BUDGET_FRACTION of the chaser's
    /// circular speed.
    def DELTA_V_BUDGET_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    /// Budget as a fraction of the chaser's circular speed; 0 = the planner's
    /// default (0.01).
    def DELTA_V_BUDGET_FRACTION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// Largest angle between the two orbit normals still called coplanar, deg;
    /// read only when HAS_COPLANAR_TOLERANCE (false = the planner's default).
    def COPLANAR_TOLERANCE_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    def HAS_COPLANAR_TOLERANCE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))
    /// Largest eccentricity still called near-circular; read only when
    /// HAS_ECCENTRICITY_TOLERANCE (false = the planner's default).
    def ECCENTRICITY_TOLERANCE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    def HAS_ECCENTRICITY_TOLERANCE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 30, 0))
    /// Largest semi-major-axis difference still called co-orbital, in the unit
    /// CO_ORBITAL_TOLERANCE_BASIS states (km, or a fraction of the chaser's
    /// semi-major axis); read only when HAS_CO_ORBITAL_TOLERANCE (false = the
    /// planner's default).
    def CO_ORBITAL_TOLERANCE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, 0.0)
    def CO_ORBITAL_TOLERANCE_BASIS() -> mplToleranceBasis:
        return mplToleranceBasis(flatbuffers.field_uint8(buf_, pos_, 34, 0))
    def HAS_CO_ORBITAL_TOLERANCE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 36, 0))

def GetRootAsmplPhasingRequest(buf:string): return mplPhasingRequest { buf, flatbuffers.indirect(buf, 0) }

