    def add_HAS_COPLANAR_TOLERANCE(HAS_COPLANAR_TOLERANCE:bool):
        b_.PrependBoolSlot(11, HAS_COPLANAR_TOLERANCE, 0)
        return this
    def add_ECCENTRICITY_TOLERANCE(ECCENTRICITY_TOLERANCE:float):
        b_.PrependFloat64Slot(12, ECCENTRICITY_TOLERANCE, 0.0)
        return this
    def add_HAS_ECCENTRICITY_TOLERANCE(HAS_ECCENTRICITY_TOLERANCE:bool):
        b_.PrependBoolSlot(13, HAS_ECCENTRICITY_TOLERANCE, 0)
        return this
    def add_CO_ORBITAL_TOLERANCE(CO_ORBITAL_TOLERANCE:float):
        b_.PrependFloat64Slot(14, CO_ORBITAL_TOLERANCE, 0.0)
        return this
    def add_CO_ORBITAL_TOLERANCE_BASIS(CO_ORBITAL_TOLERANCE_BASIS:mplToleranceBasis):
        b_.PrependUint8Slot(15, CO_ORBITAL_TOLERANCE_BASIS, 0)
        return this
    def add_HAS_CO_ORBITAL_TOLERANCE(HAS_CO_ORBITAL_TOLERANCE:bool):
        b_.PrependBoolSlot(16, HAS_CO_ORBITAL_TOLERANCE, 0)
        return this
    def end():
        return b_.EndObject()

/// A differential-drag model for relative motion.
class mplDifferentialDrag : flatbuffers.handle
    /// Which drag model; J2DragEccentric or J2DragArbitrary.
    def MODEL() -> mplRelativeDynamics:
        return mplRelativeDynamics(flatbuffers.field_uint8(buf_, pos_, 4, 3))
    /// Differential drag rates of the dimensionless relative orbital
    /// elements, 1/s: of the relative semi-major axis da (multiply by the
    /// reference semi-major axis for a length rate), and of the relative
    /// eccentricity-vector components dex and dey. DA_DOT_PER_S alone for
    /// J2DragEccentric; all three for J2DragArbitrary.
    def DA_DOT_PER_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    def DEX_DOT_PER_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    def DEY_DOT_PER_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)

def GetRootAsmplDifferentialDrag(buf:string): return mplDifferentialDrag { buf, flatbuffers.indirect(buf, 0) }

struct mplDifferentialDragBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(4)
        return this
    def add_MODEL(MODEL:mplRelativeDynamics):
        b_.PrependUint8Slot(0, MODEL, 3)
        return this
    def add_DA_DOT_PER_S(DA_DOT_PER_S:float):
        b_.PrependFloat64Slot(1, DA_DOT_PER_S, 0.0)
        return this
    def add_DEX_DOT_PER_S(DEX_DOT_PER_S:float):
        b_.PrependFloat64Slot(2, DEX_DOT_PER_S, 0.0)
        return this
    def add_DEY_DOT_PER_S(DEY_DOT_PER_S:float):
        b_.PrependFloat64Slot(3, DEY_DOT_PER_S, 0.0)
        return this
    def end():
        return b_.EndObject()

/// One relative waypoint.
class mplWaypoint : flatbuffers.handle
    /// Position relative to the reference orbit, RIC, km, 3 values.
    def POSITION_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 4) + i * 8)
    def POSITION_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 4)
    /// Velocity to arrive with, RIC, km/s, 3 values; empty = free.
    def VELOCITY_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 6) + i * 8)
    def VELOCITY_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    /// Time of flight of the leg to this waypoint, s; 0 = the planner chooses.
    def TIME_OF_FLIGHT_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)

def GetRootAsmplWaypoint(buf:string): return mplWaypoint { buf, flatbuffers.indirect(buf, 0) }

struct mplWaypointBuilder:
    b_:flatbuffers.builder
    def start():
