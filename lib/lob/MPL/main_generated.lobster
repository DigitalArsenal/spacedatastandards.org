        return this
    def add_SEMI_MAJOR_AXIS_KM(SEMI_MAJOR_AXIS_KM:float):
        b_.PrependFloat64Slot(9, SEMI_MAJOR_AXIS_KM, 0.0)
        return this
    def add_CLAMPED_TO_FLOOR(CLAMPED_TO_FLOOR:bool):
