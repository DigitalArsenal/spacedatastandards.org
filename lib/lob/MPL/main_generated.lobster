/// Closed-loop rendezvous in the target's RIC axes: a free-drift leg to a
/// brake point, a fifth-order braking profile to a hold point, and a hold,
/// tracked by a feedback controller and propagated on a truth model.
class mplRendezvousRequest : flatbuffers.handle
    /// The target's orbit.
    def REFERENCE() -> mplElements?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: mplElements { buf_, o } else: nil
    /// Chaser's starting position, RIC, km, 3 values.
    def INITIAL_POSITION_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 6) + i * 8)
    def INITIAL_POSITION_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    /// Chaser's starting velocity, RIC, km/s, 3 values; empty = solve it so
    /// the drift leg reaches BRAKE_POINT_KM after DRIFT_DURATION_S.
    def INITIAL_VELOCITY_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 8) + i * 8)
    def INITIAL_VELOCITY_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Brake gate, RIC, km, 3 values.
    def BRAKE_POINT_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 8)
    def BRAKE_POINT_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Hold point reached with zero relative velocity, RIC, km, 3 values.
    def HOLD_POINT_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def HOLD_POINT_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    def DRIFT_DURATION_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    def BRAKE_DURATION_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// Hold after braking, s; 0 = none.
    def HOLD_DURATION_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// Closed-loop natural frequency, rad/s; 0 = ten times the mean motion.
    def BANDWIDTH_RAD_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    /// Closed-loop damping ratio; read only when HAS_DAMPING_RATIO (false = 1,
    /// critically damped).
    def DAMPING_RATIO() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    def HAS_DAMPING_RATIO() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 24, 0))
    /// Proportional gain, 1/s^2; read only when HAS_KP (false = from the
    /// bandwidth).
    def KP_PER_S2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    def HAS_KP() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 28, 0))
    /// Derivative gain, 1/s; read only when HAS_KD (false = from the damping
    /// ratio).
    def KD_PER_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)
    def HAS_KD() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 32, 0))
    /// Apply the reference acceleration as feedforward.
    def FEEDFORWARD() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 34, 1))
    /// Cancel the Coriolis coupling of the relative dynamics.
    def COMPENSATE_CORIOLIS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 36, 1))
    /// Cancel the gravity-gradient coupling.
    def COMPENSATE_GRAVITY_GRADIENT() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 38, 1))
    /// Command saturation, km/s^2; 0 = unlimited.
    def MAX_ACCELERATION_KM_S2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 40, 0.0)
    /// Integration step and control period, s; 0 = 1 s.
    def TIME_STEP_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 42, 0.0)
    /// Log every Nth step to the answer's samples (the last step always); 0 =
    /// default.
    def OUTPUT_EVERY() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 44, 0)
    /// Include J2 in the truth gravity.
    def INCLUDE_J2() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 46, 0))

def GetRootAsmplRendezvousRequest(buf:string): return mplRendezvousRequest { buf, flatbuffers.indirect(buf, 0) }

