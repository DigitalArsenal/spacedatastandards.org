        return this
    def add_RADIUS_KM(RADIUS_KM:float):
        b_.PrependFloat64Slot(2, RADIUS_KM, 0.0)
        return this
    def add_RIC_BASIS(RIC_BASIS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, RIC_BASIS)
        return this
    def add_VNC_BASIS(VNC_BASIS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, VNC_BASIS)
        return this
    def add_TIME_OF_FLIGHT_S(TIME_OF_FLIGHT_S:float):
        b_.PrependFloat64Slot(5, TIME_OF_FLIGHT_S, 0.0)
        return this
    def add_BURN(BURN:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(6, BURN)
        return this
    def end():
        return b_.EndObject()

