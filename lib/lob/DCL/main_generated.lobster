/// Density Calibration - a density-model correction, how it was fitted, and
/// the densities, decays, energies and drag work computed with it.
class DCL : flatbuffers.handle
    /// Identifier of the record; empty = not assigned.
    def ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Unix milliseconds the record was produced.
    def CREATED_AT_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 6, 0)
    /// Identifier of the producing service or tool.
    def PRODUCER() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def PRODUCT() -> dclProduct:
        return dclProduct(flatbuffers.field_uint8(buf_, pos_, 10, 0))
    /// The density model and version (JB08 2008, NRLMSIS00E 2000, ...).
    def ATMOSPHERE() -> ATM?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: ATM { buf_, o } else: nil
    /// JB2008 drivers: daily solar indices and the hourly Dst-derived
    /// exospheric temperature change (DTC_HOURLY_K).
    def JB2008_DRIVERS() -> PRWJB2008IndicesTable?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: PRWJB2008IndicesTable { buf_, o } else: nil
    /// NRLMSISE-00 drivers: daily space weather.
    def SPACE_WEATHER(i:int) -> SPW:
        return SPW { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def SPACE_WEATHER_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Geopotential for the energy: field name (e.g. "EGM2008"), degree and
    /// order, central-term GM (m^3/s^2; 0 = 3.986004418e14) and the Earth's
    /// rotation rate (rad/s; 0 = 7.292115e-5).
    def GRAVITY_FIELD() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    def GRAVITY_DEGREE() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 20, 0)
    def GRAVITY_ORDER() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 22, 0)
    def GM_M3_S2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    def EARTH_ROTATION_RAD_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    /// Drag work: ballistic coefficient Cd A / m, m^2/kg; 0 = 1.
    def BALLISTIC_COEFFICIENT_M2_KG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    def SETTINGS() -> dclSettings?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: dclSettings { buf_, o } else: nil
    /// The correction: applied (an input) or estimated (a result).
    def CORRECTION() -> dclCorrection?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: dclCorrection { buf_, o } else: nil
    def STATUS() -> dclStatus:
        return dclStatus(flatbuffers.field_uint8(buf_, pos_, 34, 0))
    /// Stable machine-readable reason when STATUS is not Solved, e.g.
    /// "invalid-request", "invalid-correction", "integration-failed".
    def ERROR_CODE() -> string:
        return flatbuffers.field_string(buf_, pos_, 36)
    def ERROR_MESSAGE() -> string:
        return flatbuffers.field_string(buf_, pos_, 38)
    /// DensityEvaluation and DensityCalibration: the points.
    def POINTS() -> dclPoints?:
        let o = flatbuffers.field_table(buf_, pos_, 40)
        return if o: dclPoints { buf_, o } else: nil
    /// OrbitalDecay and DecayCalibration: the objects.
    def OBJECTS(i:int) -> dclObject:
        return dclObject { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 42) + i * 4) }
    def OBJECTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 42)
    /// DecayCalibration: the overall fit, the correction's level at each
    /// altitude node, the iteration history, the correlation of the level
    /// with the precision-weighted mean ln B (near -1 = the level is not
    /// determined), and the formal sigma of the mean level, K.
    def FIT() -> dclFitStatistics?:
        let o = flatbuffers.field_table(buf_, pos_, 44)
        return if o: dclFitStatistics { buf_, o } else: nil
    def LEVELS(i:int) -> dclLevel:
        return dclLevel { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 46) + i * 4) }
    def LEVELS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 46)
    def HISTORY(i:int) -> dclIteration:
        return dclIteration { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 48) + i * 4) }
    def HISTORY_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 48)
    def LEVEL_LN_B_CORRELATION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 50, nan)
    def MEAN_LEVEL_SIGMA_K() -> float:
        return flatbuffers.field_float64(buf_, pos_, 52, nan)
    /// OrbitalEnergy and DragWork: the states and their results.
    def STATES() -> dclStates?:
        let o = flatbuffers.field_table(buf_, pos_, 54)
        return if o: dclStates { buf_, o } else: nil

def GetRootAsDCL(buf:string): return DCL { buf, flatbuffers.indirect(buf, 0) }

