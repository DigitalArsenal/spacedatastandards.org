/// States for energy and drag work: an $OEM ephemeris block (GCRF, km,
/// km/s) and, parallel to its states, the Earth-orientation values used to
/// turn each into Earth-fixed axes, with the results per state.
class dclStates : flatbuffers.handle
    def EPHEMERIS() -> ephemerisDataBlock?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: ephemerisDataBlock { buf_, o } else: nil
    /// UT1 - UTC, s, and polar motion, arcsec, per state; empty = 0.
    def DUT1_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 6) + i * 8)
    def DUT1_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    def POLAR_MOTION_X_ARCSEC(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 8) + i * 8)
    def POLAR_MOTION_X_ARCSEC_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    def POLAR_MOTION_Y_ARCSEC(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 8)
    def POLAR_MOTION_Y_ARCSEC_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Energy: the Jacobi integral C = |v|^2 / 2 + U(r) - omega . (r x v),
    /// J/kg, and its kinetic, potential and rotational parts.
    def ENERGY_J_KG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def ENERGY_J_KG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    def KINETIC_J_KG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 8)
    def KINETIC_J_KG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    def POTENTIAL_J_KG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 8)
    def POTENTIAL_J_KG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    def ROTATIONAL_J_KG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 18) + i * 8)
    def ROTATIONAL_J_KG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Energy: dC/dr (J/kg/m) and dC/dv (m/s) in GCRF, 6 values per state;
    /// empty = not asked for.
    def ENERGY_GRADIENT(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 20) + i * 8)
    def ENERGY_GRADIENT_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// Speed relative to the co-rotating atmosphere, m/s.
    def RELATIVE_SPEED_M_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 22) + i * 8)
    def RELATIVE_SPEED_M_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    /// WGS84 geodetic point of each state.
    def LATITUDE_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 24) + i * 8)
    def LATITUDE_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    def LONGITUDE_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 26) + i * 8)
    def LONGITUDE_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)
    def ALTITUDE_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 28) + i * 8)
    def ALTITUDE_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    /// Drag work: density, kg/m^3, and drag power -B density |v_r|^3 / 2,
    /// W/kg.
    def DENSITY_KG_M3(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 30) + i * 8)
    def DENSITY_KG_M3_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    def DRAG_POWER_W_KG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 32) + i * 8)
    def DRAG_POWER_W_KG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 32)
    /// Drag work between consecutive states (one fewer than the states), and
    /// its running sum from the first state (one per state), J/kg.
    def DRAG_WORK_J_KG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 34) + i * 8)
    def DRAG_WORK_J_KG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    def CUMULATIVE_DRAG_WORK_J_KG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 36) + i * 8)
    def CUMULATIVE_DRAG_WORK_J_KG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 36)
    /// Indices of the states refused.
    def REFUSED(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 38) + i * 4)
    def REFUSED_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 38)

