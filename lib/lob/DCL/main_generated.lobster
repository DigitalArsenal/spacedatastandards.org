/// One iteration of a decay calibration.
class dclIteration : flatbuffers.handle
    def ITERATION() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 4, 0)
    def CHI_SQUARE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    def OBSERVATIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    /// Largest step in the correction (K), in any ln B, and in any chain offset
    /// (m).
    def MAX_STEP_K() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    def MAX_STEP_LN_B() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    def MAX_STEP_OFFSET_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)

def GetRootAsdclIteration(buf:string): return dclIteration { buf, flatbuffers.indirect(buf, 0) }

