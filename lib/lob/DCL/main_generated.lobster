/// A refused element set.
class dclRefusal : flatbuffers.handle
    /// Index of the set in ELEMENT_SETS.
    def INDEX() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 4, 0)
    /// Why, e.g. "deep-space", "sgp4-init", "mean-motion-or-eccentricity".
    def REASON() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)

def GetRootAsdclRefusal(buf:string): return dclRefusal { buf, flatbuffers.indirect(buf, 0) }

struct dclRefusalBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(2)
        return this
    def add_INDEX(INDEX:int):
        b_.PrependUint32Slot(0, INDEX, 0)
        return this
    def add_REASON(REASON:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, REASON)
        return this
    def end():
        return b_.EndObject()

/// One object's element-set history and its decay.
class dclObject : flatbuffers.handle
    /// Identifier (catalog number or designator).
    def ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// The element sets, in epoch order; each needs EPOCH, MEAN_MOTION,
    /// ECCENTRICITY, INCLINATION, RA_OF_ASC_NODE, ARG_OF_PERICENTER,
    /// MEAN_ANOMALY and BSTAR.
    def ELEMENT_SETS(i:int) -> OMM:
        return OMM { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 6) + i * 4) }
    def ELEMENT_SETS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    /// Ballistic coefficient B = Cd A / m, m^2/kg (forward model input, or the
    /// fitted value); 0 = 1 m^2/kg in a request.
    def BALLISTIC_COEFFICIENT_M2_KG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Forward model with a single set: integrate it alone over this span, s;
    /// 0 = to the next set.
    def SPAN_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Prior on ln B (mean, and sigma; sigma 0 = no prior).
    def LN_B_PRIOR_MEAN() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    def LN_B_PRIOR_SIGMA() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// Result: false when the object's trajectory could not be integrated.
    def OK() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 0))
    /// Result: why the object was left out of a calibration; empty = used.
    def SKIPPED_REASON() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    /// Result: sets refused, with the reason.
    def REFUSED(i:int) -> dclRefusal:
        return dclRefusal { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 20) + i * 4) }
    def REFUSED_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// Result per set, parallel to ELEMENT_SETS: mean (Brouwer) semi-major
    /// axis and perigee height, km, eccentricity, the cumulative drag decay
    /// from the start of the set's chain, m (NaN = not in a chain), and the
    /// fit residual, m (NaN = none) and whether it was used.
    def SET_TIME_MS(i:int) -> int:
        return read_int64_le(buf_, buf_.flatbuffers.field_vector(pos_, 22) + i * 8)
    def SET_TIME_MS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    def SET_MEAN_SEMI_MAJOR_AXIS_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 24) + i * 8)
    def SET_MEAN_SEMI_MAJOR_AXIS_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    def SET_PERIGEE_HEIGHT_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 26) + i * 8)
    def SET_PERIGEE_HEIGHT_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)
    def SET_ECCENTRICITY(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 28) + i * 8)
    def SET_ECCENTRICITY_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    def SET_CUMULATIVE_DECAY_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 30) + i * 8)
    def SET_CUMULATIVE_DECAY_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    def SET_RESIDUAL_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 32) + i * 8)
    def SET_RESIDUAL_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 32)
    def SET_USED(i:int) -> bool:
        return read_int8_le(buf_, buf_.flatbuffers.field_vector(pos_, 34) + i * 1)
    def SET_USED_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    /// Result per integrated segment (set epoch to the next): span, drag change
    /// in mean semi-major axis (m) and mean geodetic height (km).
    def SEGMENT_FROM_MS(i:int) -> int:
        return read_int64_le(buf_, buf_.flatbuffers.field_vector(pos_, 36) + i * 8)
    def SEGMENT_FROM_MS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 36)
    def SEGMENT_TO_MS(i:int) -> int:
        return read_int64_le(buf_, buf_.flatbuffers.field_vector(pos_, 38) + i * 8)
    def SEGMENT_TO_MS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 38)
    def SEGMENT_DECAY_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 40) + i * 8)
    def SEGMENT_DECAY_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 40)
    def SEGMENT_MEAN_ALTITUDE_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 42) + i * 8)
    def SEGMENT_MEAN_ALTITUDE_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 42)
    /// Result: mean geodetic height along the trajectory, km.
    def MEAN_ALTITUDE_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 44, 0.0)
    /// Calibration result: ln B, its formal sigma (NaN = not computed), the
    /// object's robust residual scale (m), chains of sets, sets in chains.
    def LN_B() -> float:
        return flatbuffers.field_float64(buf_, pos_, 46, 0.0)
    def LN_B_SIGMA() -> float:
        return flatbuffers.field_float64(buf_, pos_, 48, nan)
    def RESIDUAL_SCALE_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 50, 0.0)
    def CHAINS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 52, 0)
    def SETS_IN_CHAINS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 54, 0)
    /// Calibration result: first and last set used.
    def FIRST_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 56, 0)
    def LAST_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 58, 0)
    /// Calibration result: observed and modelled drop in mean semi-major axis
    /// over the chains, m.
    def OBSERVED_DECAY_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 60, 0.0)
    def MODEL_DECAY_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 62, 0.0)
    /// Calibration result: residual RMS before and after (m), sets used.
    def FIT() -> dclFitStatistics?:
        let o = flatbuffers.field_table(buf_, pos_, 64)
        return if o: dclFitStatistics { buf_, o } else: nil
    /// Result, when asked for: the trajectory points, column-major. TEME
    /// position and velocity (km, km/s, 6 per point), geodetic point, density
    /// and the drag-decay factor q = (a^2 / mu) |v_r| (v . v_r), m^2/s, so that
    /// da/dt = -B density q.
    def SAMPLE_TIME_MS(i:int) -> int:
        return read_int64_le(buf_, buf_.flatbuffers.field_vector(pos_, 66) + i * 8)
    def SAMPLE_TIME_MS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 66)
    def SAMPLE_TEME_STATE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 68) + i * 8)
    def SAMPLE_TEME_STATE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 68)
    def SAMPLE_LATITUDE_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 70) + i * 8)
    def SAMPLE_LATITUDE_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 70)
    def SAMPLE_LONGITUDE_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 72) + i * 8)
    def SAMPLE_LONGITUDE_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 72)
    def SAMPLE_ALTITUDE_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 74) + i * 8)
    def SAMPLE_ALTITUDE_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 74)
    def SAMPLE_DENSITY_KG_M3(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 76) + i * 8)
    def SAMPLE_DENSITY_KG_M3_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 76)
    def SAMPLE_DECAY_FACTOR_M2_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 78) + i * 8)
    def SAMPLE_DECAY_FACTOR_M2_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 78)

