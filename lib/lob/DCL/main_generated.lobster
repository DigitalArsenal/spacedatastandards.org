        b_.PrependFloat64Slot(1, CHI_SQUARE, 0.0)
        return this
    def add_OBSERVATIONS(OBSERVATIONS:int):
        b_.PrependUint32Slot(2, OBSERVATIONS, 0)
        return this
    def add_MAX_STEP_K(MAX_STEP_K:float):
        b_.PrependFloat64Slot(3, MAX_STEP_K, 0.0)
        return this
    def add_MAX_STEP_LN_B(MAX_STEP_LN_B:float):
        b_.PrependFloat64Slot(4, MAX_STEP_LN_B, 0.0)
        return this
    def add_MAX_STEP_OFFSET_M(MAX_STEP_OFFSET_M:float):
        b_.PrependFloat64Slot(5, MAX_STEP_OFFSET_M, 0.0)
        return this
    def end():
        return b_.EndObject()

/// Settings of a calibration or a forward model.
class dclSettings : flatbuffers.handle
    /// Calibration span.
    def FROM_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 4, 0)
    def TO_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 6, 0)
    /// DensityCalibration: harmonic degree, 0-8.
    def DEGREE() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 8, 0)
    /// DensityCalibration: bin length, s; 0 = 3 h.
    def BIN_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// DensityCalibration: sigma of a log-density residual; 0 = 0.1.
    def LOG_DENSITY_SIGMA() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// DensityCalibration: prior sigma of the coefficients of each degree, K
    /// (DEGREE + 1 values); empty = 100 K each.
    def PRIOR_SIGMA_K(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 8)
    def PRIOR_SIGMA_K_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    /// DensityCalibration: fewest points for a bin to be fitted; 0 = 30.
    def MIN_POINTS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 16, 0)
    /// Iteration limit; 0 = 10.
    def MAX_ITERATIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 18, 0)
    /// Robust edit threshold in robust sigmas (1.4826 MAD); 0 = 4.
    def EDIT_SIGMA() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    /// DecayCalibration: spacing of the correction's time nodes, s, and its
    /// altitude nodes, km (empty = global).
    def NODE_STEP_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    def NODE_ALTITUDES_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 24) + i * 8)
    def NODE_ALTITUDES_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    /// DecayCalibration priors: random walk between consecutive nodes,
    /// K per square-root day; the mean level of each altitude node, K; the tie
    /// between neighbouring altitude nodes, K. 0 = 30, 150, 100.
    def RANDOM_WALK_K_PER_SQRT_DAY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    def MEAN_LEVEL_K() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    def ALTITUDE_DIFFERENCE_K() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)
    /// Decay: integration step along each trajectory, s (1-600); 0 = 60.
    def STEP_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, 0.0)
    /// Decay: sets further apart than this start a new chain, s; 0 = 3 days.
    def MAX_GAP_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    /// DecayCalibration: floor of each object's residual scale, m; 0 = 1.
    def RESIDUAL_FLOOR_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 0.0)
    /// DecayCalibration: iterations in which scales and edits are re-estimated
    /// before being held; 0 = 4.
    def REWEIGHT_ITERATIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 38, 0)
    /// DecayCalibration convergence: every step below these; 0 = 0.5 K,
    /// 0.001, 0.1 m.
    def TOLERANCE_K() -> float:
        return flatbuffers.field_float64(buf_, pos_, 40, 0.0)
    def TOLERANCE_LN_B() -> float:
        return flatbuffers.field_float64(buf_, pos_, 42, 0.0)
    def TOLERANCE_OFFSET_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 44, 0.0)
    /// DecayCalibration: fewest sets in chains for an object to be used; 0 =
    /// 5.
    def MIN_SETS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 46, 0)
    /// Ask for the derivative d ln(density)/dT, the Sun diagnostics, the
    /// per-set residuals, the trajectory samples, the energy gradient.
    def WANT_DERIVATIVE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 48, 0))
    def WANT_SUN_DIAGNOSTICS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 50, 0))
    def WANT_RESIDUALS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 52, 0))
    def WANT_SAMPLES() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 54, 0))
    def WANT_GRADIENT() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 56, 0))

def GetRootAsdclSettings(buf:string): return dclSettings { buf, flatbuffers.indirect(buf, 0) }

