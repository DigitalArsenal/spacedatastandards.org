/// Pointing and Power Scenario - a scenario, and the telemetry a run of it
/// produced.
class PPS : flatbuffers.handle
    /// Identifier of the run; empty = not assigned.
    def RUN_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Unix milliseconds the run was made.
    def CREATED_AT_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 6, 0)
    /// Identifier of the simulator that ran it.
    def PROVIDER() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def SCENARIO() -> ppsScenario?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: ppsScenario { buf_, o } else: nil
    def STATUS() -> ppsStatus:
        return ppsStatus(flatbuffers.field_uint8(buf_, pos_, 12, 0))
    /// Stable machine-readable reason for InvalidRequest or Failed.
    def ERROR_CODE() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    def ERROR_MESSAGE() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)
    /// Products the telemetry carries.
    def PRODUCTS(i:int) -> ppsProduct:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 18) + i * 1)
    def PRODUCTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Modelling assumptions and simplifications of the run, as text.
    def ASSUMPTIONS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 20) + i * 4)
    def ASSUMPTIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    def TELEMETRY() -> ppsTelemetry?:
        let o = flatbuffers.field_table(buf_, pos_, 22)
        return if o: ppsTelemetry { buf_, o } else: nil

def GetRootAsPPS(buf:string): return PPS { buf, flatbuffers.indirect(buf, 0) }

struct PPSBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(10)
        return this
    def add_RUN_ID(RUN_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, RUN_ID)
        return this
    def add_CREATED_AT_MS(CREATED_AT_MS:int):
        b_.PrependInt64Slot(1, CREATED_AT_MS, 0)
        return this
    def add_PROVIDER(PROVIDER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, PROVIDER)
        return this
    def add_SCENARIO(SCENARIO:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, SCENARIO)
        return this
    def add_STATUS(STATUS:ppsStatus):
        b_.PrependUint8Slot(4, STATUS, 0)
        return this
    def add_ERROR_CODE(ERROR_CODE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(5, ERROR_CODE)
        return this
    def add_ERROR_MESSAGE(ERROR_MESSAGE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(6, ERROR_MESSAGE)
        return this
    def add_PRODUCTS(PRODUCTS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(7, PRODUCTS)
        return this
    def add_ASSUMPTIONS(ASSUMPTIONS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(8, ASSUMPTIONS)
        return this
    def add_TELEMETRY(TELEMETRY:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(9, TELEMETRY)
        return this
    def end():
        return b_.EndObject()

