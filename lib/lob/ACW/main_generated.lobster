/// A simulated sensor hosted by a ground station or an observer trajectory.
class ACWSensor : flatbuffers.handle
    def SENSOR_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// ACWGroundStation.STATION_ID or ACWObserverTrajectory.OBSERVER_ID of the
    /// host.
    def HOST_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def PHENOMENOLOGY() -> acwSensorPhenomenology:
        return acwSensorPhenomenology(flatbuffers.field_uint8(buf_, pos_, 8, 0))
    /// The measurements each observation carries, one error model per
    /// measurement type (noise, bias, bias uncertainty, correlation time,
    /// media and light-time options).
    def ERROR_MODELS(i:int) -> MEMErrorModel:
        return MEMErrorModel { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 10) + i * 4) }
    def ERROR_MODELS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Visibility for this sensor, the constraints its ACCESS windows were
    /// computed with. When absent, ACWRequest.CONSTRAINTS apply.
    def CONSTRAINTS() -> ACWConstraintSet?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: ACWConstraintSet { buf_, o } else: nil
    /// Seconds between observations within a track.
    def OBSERVATION_INTERVAL_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// Longest track, seconds; 0 tracks the whole access window.
    def TRACK_DURATION_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// Shortest time between the end of one track of a target and the start
    /// of the next, seconds.
    def REVISIT_INTERVAL_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// Targets tracked at once.
    def MAX_SIMULTANEOUS_TRACKS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 20, 1)
    /// RADAR: signal-to-noise ratio, dB, of a REFERENCE_RCS_M2 target at
    /// REFERENCE_RANGE_M; SNR scales with RCS and with range to the -4th power.
    def REFERENCE_SNR_DB() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    def REFERENCE_RANGE_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    def REFERENCE_RCS_M2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 1.0)
    /// RADAR and PASSIVE_RF: smallest detected signal-to-noise ratio, dB.
    def DETECTION_THRESHOLD_DB() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    /// PASSIVE_RF: receiver figure of merit, dB/K, and noise bandwidth, hertz.
    def RECEIVER_G_OVER_T_DB_PER_K() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)
    def RECEIVER_BANDWIDTH_HZ() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, 0.0)
    /// OPTICAL: faintest magnitude detected, in the band of EOO.MAG; 0 applies
    /// no magnitude limit.
    def LIMITING_MAGNITUDE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    /// OPTICAL: highest Sun elevation at the host for a detection, radians
    /// (ground-based darkness); requires SUN_STATES. Observations scheduled
    /// in brighter sky are lost.
    def MAX_HOST_SUN_ELEVATION_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 0.0)
    /// Uncorrelated detections per hour of tracking, reported with UCT set.
    def FALSE_ALARM_RATE_PER_HOUR() -> float:
        return flatbuffers.field_float64(buf_, pos_, 38, 0.0)
    /// RADAR: transmitted carrier frequency, hertz. A DOPPLER error model
    /// measures the echo's two-way shift relative to it, reported as $RDO
    /// DOPPLER with DOPPLER_FREQUENCY set to this value.
    def TRANSMIT_FREQUENCY_HZ() -> float:
        return flatbuffers.field_float64(buf_, pos_, 40, 0.0)

