/// One access-window compute request.
class ACWRequest : flatbuffers.handle
    def OPERATION() -> acwOperationCode:
        return acwOperationCode(flatbuffers.field_int8(buf_, pos_, 4, 0))
    /// Candidate ground stations.
    def GROUND_STATIONS(i:int) -> ACWGroundStation:
        return ACWGroundStation { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 6) + i * 4) }
    def GROUND_STATIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    /// Pre-sampled target Earth-fixed Cartesian states.
    def STATES(i:int) -> ACWStateSample:
        return ACWStateSample { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 8) + i * 4) }
    def STATES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Optional target station id. Empty means all stations when supported.
    def TARGET_STATION_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// Optional caller override for minimum elevation, radians.
    def MIN_ELEVATION_OVERRIDE_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// Optional trace/correlation identifier.
    def TRACE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Optional azimuth-dependent minimum elevation mask.
    def ELEVATION_MASK(i:int) -> ACWElevationMaskPoint:
        return ACWElevationMaskPoint { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def ELEVATION_MASK_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Optional apparent-elevation refraction model.
    def REFRACTION_MODEL() -> ACWRefractionModel?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: ACWRefractionModel { buf_, o } else: nil
    /// Optional constraint composition. When absent the legacy behaviour holds:
    /// every ground station's MIN_ELEVATION_RAD (or the override) plus
    /// ELEVATION_MASK, all required.
    def CONSTRAINTS() -> ACWConstraintSet?:
        let o = flatbuffers.field_table(buf_, pos_, 20)
        return if o: ACWConstraintSet { buf_, o } else: nil
    /// Optional moving observers (satellite-to-satellite access). Each observer
    /// is evaluated against STATES like a ground station.
    def OBSERVERS(i:int) -> ACWObserverTrajectory:
        return ACWObserverTrajectory { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 22) + i * 4) }
    def OBSERVERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    /// Sample-only or root-refined window edges.
    def EVALUATION_MODE() -> acwEvaluationMode:
        return acwEvaluationMode(flatbuffers.field_int8(buf_, pos_, 24, 0))
    /// Edge refinement tolerance for CONTINUOUS, seconds.
    def ROOT_TOLERANCE_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.1)
    /// Sun states in the STATES frame and time scale, required by
    /// SUN_EXCLUSION and TARGET_LIGHTING constraints; interpolated to sample epochs.
    def SUN_STATES(i:int) -> ACWStateSample:
        return ACWStateSample { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 28) + i * 4) }
    def SUN_STATES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    /// Moon states in the STATES frame and time scale, required by MOON_EXCLUSION.
    def MOON_STATES(i:int) -> ACWStateSample:
        return ACWStateSample { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 30) + i * 4) }
    def MOON_STATES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    /// Targets to observe (SIMULATE_OBSERVATIONS).
    def TARGETS(i:int) -> ACWTarget:
        return ACWTarget { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 32) + i * 4) }
    def TARGETS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 32)
    /// Sensors that observe them (SIMULATE_OBSERVATIONS).
    def SENSORS(i:int) -> ACWSensor:
        return ACWSensor { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 34) + i * 4) }
    def SENSORS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    /// Where each sensor can see each target (SIMULATE_OBSERVATIONS); a pair
    /// without an entry is never observed.
    def ACCESS(i:int) -> ACWSensorAccess:
        return ACWSensorAccess { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 36) + i * 4) }
    def ACCESS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 36)
    /// Earth orientation parameters for celestial directions (right ascension
    /// and declination). When absent, polar motion, UT1-UTC and celestial pole
    /// offsets are zero.
    def EARTH_ORIENTATION(i:int) -> EOP:
        return EOP { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 38) + i * 4) }
    def EARTH_ORIENTATION_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 38)
    /// Seed for measurement noise, biases and false alarms; one seed
    /// reproduces the same observations.
    def RANDOM_SEED() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 40, 0)
    /// Simulation span as Julian Dates in TT; 0 uses the span of the target
    /// states.
    def START_JULIAN_DATE_TT() -> float:
        return flatbuffers.field_float64(buf_, pos_, 42, 0.0)
    def END_JULIAN_DATE_TT() -> float:
        return flatbuffers.field_float64(buf_, pos_, 44, 0.0)

