class OrbitDetermination : flatbuffers.handle
    /// Unique identifier for the orbit determination.
    def OD_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Identifier of the previous orbit determination.
    def OD_PREV_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Algorithm used for orbit determination.
    def OD_ALGORITHM() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    /// Method used for orbit determination.
    def OD_METHOD() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// Epoch of the orbit determination.
    def OD_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// Time tag of the orbit determination.
    def OD_TIME_TAG() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Process noise model used.
    def OD_PROCESS_NOISE() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)
    /// Covariance reduction techniques used.
    def OD_COV_REDUCTION() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    /// Noise models used.
    def OD_NOISE_MODELS() -> string:
        return flatbuffers.field_string(buf_, pos_, 20)
    /// Types of observations used (e.g., RANGE, DOPPLER).
    def OD_OBSERVATIONS_TYPE(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 22) + i * 4)
    def OD_OBSERVATIONS_TYPE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    /// Number of observations used.
    def OD_OBSERVATIONS_USED() -> int:
        return flatbuffers.field_int32(buf_, pos_, 24, 0)
    /// Number of tracks used.
    def OD_TRACKS_USED() -> int:
        return flatbuffers.field_int32(buf_, pos_, 26, 0)
    /// Data weighting scheme used.
    def OD_DATA_WEIGHTING() -> string:
        return flatbuffers.field_string(buf_, pos_, 28)
    /// Convergence criteria used.
    def OD_CONVERGENCE_CRITERIA() -> string:
        return flatbuffers.field_string(buf_, pos_, 30)
    /// Parameters estimated during orbit determination.
    def OD_EST_PARAMETERS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 32) + i * 4)
    def OD_EST_PARAMETERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 32)
    /// A priori data used for orbit determination.
    def OD_APRIORI_DATA() -> string:
        return flatbuffers.field_string(buf_, pos_, 34)
    /// Residuals from the orbit determination.
    def OD_RESIDUALS() -> string:
        return flatbuffers.field_string(buf_, pos_, 36)
    /// Estimator class provenance: batch fit vs sequential filter (EKF/UKF).
    def OD_ESTIMATOR() -> estimatorCategory:
        return estimatorCategory(flatbuffers.field_int8(buf_, pos_, 38, 0))
    /// RMS of post-fit residuals for this solution. In the unit of the residuals the
    /// observation types state: arcsec for RADEC angles. A position RMS in km is
    /// OCMFitStatistics.FIT_RMS_KM.
    def OD_RESIDUAL_RMS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 40, 0.0)
    /// Post-fit residual series, one entry per accepted observation.
    def OD_RESIDUALS_SERIES(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 42) + i * 8)
    def OD_RESIDUALS_SERIES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 42)
    /// Epochs aligned with OD_RESIDUALS_SERIES (UNIX timestamp) [numeric seconds
    /// since 1970-01-01T00:00:00 UTC].
    def OD_RESIDUAL_EPOCHS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 44) + i * 8)
    def OD_RESIDUAL_EPOCHS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 44)
    /// OD_ID of the batch baseline solution a filtered solution derives from and
    /// is compared against (empty for batch solutions).
    def OD_BATCH_BASELINE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 46)
    /// Post-fit residual RMS of the batch baseline, for direct batch-vs-filter
    /// comparison.
    def OD_BATCH_BASELINE_RMS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 48, 0.0)
    /// Specific energy dissipation rate in W/kg: energy removed from the orbit
    /// by non-conservative forces, averaged during the OD (CCSDS 502.0-B-3 SEDR).
    def SEDR() -> float:
        return flatbuffers.field_float64(buf_, pos_, 50, 0.0)
    /// Weighted RMS residual ratio of a batch OD (CCSDS 502.0-B-3 WEIGHTED_RMS).
    def WEIGHTED_RMS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 52, 0.0)
    /// Dynamical-model parameters of the solution with their values, solved for or held. An
    /// IN_TRACK_ACCELERATION entry means the empirical in-track thrust is part of the force model.
    /// OD_DYNAMIC_PARAMETERS names every COV_PARAMETERS row, and SOLVED_FOR is truthful: true for every
    /// row of the covariance, false for a parameter the determination held.
    def OD_DYNAMIC_PARAMETERS(i:int) -> OCMDynamicParameter:
        return OCMDynamicParameter { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 54) + i * 4) }
    def OD_DYNAMIC_PARAMETERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 54)
    /// DAYS_SINCE_FIRST_OBS (CCSDS 502.0-B-3), NaN when not stated.
    def DAYS_SINCE_FIRST_OBS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 56, nan)
    /// DAYS_SINCE_LAST_OBS, NaN when not stated.
    def DAYS_SINCE_LAST_OBS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 58, nan)
    /// RECOMMENDED_OD_SPAN in days, NaN when not stated.
    def RECOMMENDED_OD_SPAN() -> float:
        return flatbuffers.field_float64(buf_, pos_, 60, nan)
    /// ACTUAL_OD_SPAN in days, NaN when not stated.
    def ACTUAL_OD_SPAN() -> float:
        return flatbuffers.field_float64(buf_, pos_, 62, nan)
    /// OBS_AVAILABLE; OD_OBSERVATIONS_USED is OBS_USED.
    def OBS_AVAILABLE() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 64, 0)
    /// TRACKS_AVAILABLE; OD_TRACKS_USED is TRACKS_USED.
    def TRACKS_AVAILABLE() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 66, 0)
    /// MAXIMUM_OBS_GAP in days, NaN when not stated.
    def MAXIMUM_OBS_GAP() -> float:
        return flatbuffers.field_float64(buf_, pos_, 68, nan)
