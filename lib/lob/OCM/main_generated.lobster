        return this
    def add_COV_SCALE_MAX(COV_SCALE_MAX:float):
        b_.PrependFloat64Slot(9, COV_SCALE_MAX, nan)
        return this
    def add_COV_CONFIDENCE(COV_CONFIDENCE:float):
        b_.PrependFloat64Slot(10, COV_CONFIDENCE, nan)
        return this
    def add_COV_TYPE(COV_TYPE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(11, COV_TYPE)
        return this
    def add_COV_ORDERING(COV_ORDERING:covarianceOrdering):
        b_.PrependInt8Slot(12, COV_ORDERING, 0)
        return this
    def add_COV_UNITS(COV_UNITS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(13, COV_UNITS)
        return this
    def add_LINES(LINES:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(14, LINES)
        return this
    def add_COV_REALISM(COV_REALISM:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(15, COV_REALISM)
        return this
    def end():
        return b_.EndObject()

def OCMCovarianceBlockStartLINESVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def OCMCovarianceBlockCreateLINESVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

def OCMCovarianceBlockStartCOVREALISMVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def OCMCovarianceBlockCreateCOVREALISMVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

class UserDefinedParameters : flatbuffers.handle
    /// Name of the user-defined parameter.
    def PARAM_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Value of the user-defined parameter.
    def PARAM_VALUE() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)

def GetRootAsUserDefinedParameters(buf:string): return UserDefinedParameters { buf, flatbuffers.indirect(buf, 0) }

struct UserDefinedParametersBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(2)
        return this
    def add_PARAM_NAME(PARAM_NAME:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, PARAM_NAME)
        return this
    def add_PARAM_VALUE(PARAM_VALUE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, PARAM_VALUE)
        return this
    def end():
        return b_.EndObject()

/// Orbit Comprehensive Message
class OCM : flatbuffers.handle
    /// Header section of the OCM.
    def HEADER() -> Header?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: Header { buf_, o } else: nil
    /// Metadata section of the OCM.
    def METADATA() -> Metadata?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: Metadata { buf_, o } else: nil
    /// Trajectory state representation type.
    /// Determines how orbit state data is parameterized in this message.
    /// For CARTESIAN_PV/CARTESIAN_PVA, use STATE_DATA array.
    /// For POLYNOMIAL_POS/POLYNOMIAL_OE, use the corresponding polynomial record arrays.
    def TRAJ_TYPE() -> trajectoryType:
        return trajectoryType(flatbuffers.field_int8(buf_, pos_, 8, 0))
    /// Legacy trajectory type string for backward compatibility and extended types
    /// (e.g., "PROPAGATED", "ESTIMATED", "FILTERED").
    def TRAJ_TYPE_DESCRIPTION() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// Time interval between state vectors in seconds; required without STATE_EPOCHS.
    def STATE_STEP_SIZE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// Number of components per state vector.
    /// 6 = position + velocity (X, Y, Z, X_DOT, Y_DOT, Z_DOT)
    /// 9 = position + velocity + acceleration (adds X_DDOT, Y_DDOT, Z_DDOT)
    /// 6 or 7 for the element sets named by TRAJ_TYPE.
    def STATE_VECTOR_SIZE() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 14, 6)
    /// State data as row-major array of doubles.
    /// Layout: [X0, Y0, Z0, X_DOT0, Y_DOT0, Z_DOT0, X1, Y1, Z1, ...]
    /// Time reconstruction uses STATE_EPOCHS when present, otherwise START_TIME + i * STATE_STEP_SIZE.
    /// Length must be divisible by STATE_VECTOR_SIZE.
    /// Units: km, km/s and km/s**2, in TRAJ_REF_FRAME about CENTER_NAME.
    /// Empty when MEAN_ELEMENTS, RPO_GEOMETRY or RPO_INSPECTION is present.
    def STATE_DATA(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 8)
    def STATE_DATA_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Covariance data as a flat array, one N x N matrix per epoch, N = COV_SIZE, aligned with the STATE_DATA epochs.
    /// COV_ORDERING gives the values per epoch: N(N+1)/2 for LTM and UTM, N*N for FULL, LTMWCC and UTMWCC. Entry [i,j]
    /// has the product of the units of state elements i and j (km**2, km**2/s, km**2/s**2 for a position-velocity
    /// state), and of COV_UNITS for the parameter rows. Without COV_TYPE, COV_ORDERING and COV_SIZE: 21 elements per
    /// epoch, the lower triangle of the 6x6 position and velocity covariance.
    def COVARIANCE_DATA(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 18) + i * 8)
    def COVARIANCE_DATA_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Polynomial position records.
    /// Used when TRAJ_TYPE is POLYNOMIAL_POS. Each record covers a time segment
    /// with polynomial coefficients for X, Y, Z position (and optionally velocity).
    /// See PPE schema for record structure and evaluation procedure.
    def POLYNOMIAL_POSITION_RECORDS(i:int) -> PPEPositionRecord:
        return PPEPositionRecord { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 20) + i * 4) }
    def POLYNOMIAL_POSITION_RECORDS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// Polynomial orbital element records.
    /// Used when TRAJ_TYPE is POLYNOMIAL_OE. Each record covers a time segment
    /// with polynomial coefficients for classical orbital elements.
    /// See PPE schema for record structure and evaluation procedure.
    def POLYNOMIAL_OE_RECORDS(i:int) -> PPEOrbitalElementRecord:
        return PPEOrbitalElementRecord { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 22) + i * 4) }
    def POLYNOMIAL_OE_RECORDS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    /// Physical properties of the space object.
    def PHYSICAL_PROPERTIES() -> PhysicalProperties?:
        let o = flatbuffers.field_table(buf_, pos_, 24)
        return if o: PhysicalProperties { buf_, o } else: nil
    /// Maneuver data.
    def MANEUVER_DATA(i:int) -> Maneuver:
        return Maneuver { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 26) + i * 4) }
    def MANEUVER_DATA_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)
    /// Perturbations parameters used.
    def PERTURBATIONS() -> Perturbations?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: Perturbations { buf_, o } else: nil
    /// Orbit determination data.
    def ORBIT_DETERMINATION() -> OrbitDetermination?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: OrbitDetermination { buf_, o } else: nil
    /// CCSDS 502.0-B-3 USER_DEFINED_x of a foreign message. SDN producers never write it and
    /// SDN readers never read it.
    def USER_DEFINED_PARAMETERS(i:int) -> UserDefinedParameters:
        return UserDefinedParameters { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 32) + i * 4) }
    def USER_DEFINED_PARAMETERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 32)
    /// Origin of TRAJ_REF_FRAME (EARTH, MOON, ...) (CCSDS 502.0-B-3 CENTER_NAME).
    def CENTER_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 34)
    /// Reference frame of STATE_DATA and the polynomial records; for MEAN_ELEMENTS, the
    /// frame of the elements (CCSDS 502.0-B-3 TRAJ_REF_FRAME).
    def TRAJ_REF_FRAME() -> RFM?:
        let o = flatbuffers.field_table(buf_, pos_, 36)
        return if o: RFM { buf_, o } else: nil
    /// Epoch of TRAJ_REF_FRAME when it is not intrinsic to the frame
    /// (CCSDS 502.0-B-3 TRAJ_FRAME_EPOCH).
    def TRAJ_FRAME_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 38)
    /// Reference frame of COVARIANCE_DATA (CCSDS 502.0-B-3 COV_REF_FRAME). COV_REF_FRAME UVW is the frame of a
    /// local-orbital covariance: U radial, V along-track, W cross-track, the velocity rows on the same axes.
    def COV_REF_FRAME() -> RFM?:
        let o = flatbuffers.field_table(buf_, pos_, 40)
        return if o: RFM { buf_, o } else: nil
    /// Orbit revolution number at the first state (CCSDS 502.0-B-3 ORB_REVNUM).
    def ORB_REVNUM() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 42, 0)
    /// For element sets: OSCULATING, or the mean-element theory used (BROUWER,
    /// KOZAI, ...) (CCSDS 502.0-B-3 ORB_AVERAGING). Absent means OSCULATING.
    def ORB_AVERAGING() -> string:
        return flatbuffers.field_string(buf_, pos_, 44)
    /// Whether COVARIANCE_DATA's coverage was measured against independent
    /// reference states: Calibrated only when every COV_REALISM entry is.
    def COV_CALIBRATION() -> covarianceCalibration:
        return covarianceCalibration(flatbuffers.field_int8(buf_, pos_, 46, 0))
    /// Identifier of that calibration evidence (a report or record).
    def COV_CALIBRATION_REFERENCE() -> string:
        return flatbuffers.field_string(buf_, pos_, 48)
    /// Absolute epoch per STATE_DATA row in METADATA.TIME_SYSTEM (CCSDS 502.0-B-3
    /// section 6.2.4). When nonempty, length equals STATE_DATA.length /
    /// STATE_VECTOR_SIZE and these epochs override START_TIME + i * STATE_STEP_SIZE.
    /// Absent or empty retains the uniform grid; COVARIANCE_DATA shares these epochs.
    def STATE_EPOCHS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 50) + i * 4)
    def STATE_EPOCHS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 50)
    /// Element set of the state block of COVARIANCE_DATA (CCSDS 502.0-B-3 COV_TYPE): a SANA orbital element set
    /// (CARTP, CARTPV, CARTPVA, ADBARV, KEPLERIAN, EQUINOCTIAL ...) or a covariance representation (SIG3EIGVEC3 and
    /// TSIG3EIGVEC3 give 13 and 14 values per epoch whatever COV_SIZE says). Absent means CARTPV.
    def COV_TYPE() -> string:
        return flatbuffers.field_string(buf_, pos_, 52)
    /// Order of the covariance values at each epoch (CCSDS 502.0-B-3 COV_ORDERING). COV_ORDERING LTM is the only ordering
    /// the product writers (lib/js/PROD) accept.
    def COV_ORDERING() -> covarianceOrdering:
        return covarianceOrdering(flatbuffers.field_int8(buf_, pos_, 54, 0))
    /// Dimension N of the covariance matrix at each epoch: the rows of the state block (6 for CARTPV) plus the rows
    /// COV_PARAMETERS names.
    def COV_SIZE() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 56, 6)
    /// Names of the covariance rows after the state block, by their names in ORBIT_DETERMINATION.OD_DYNAMIC_PARAMETERS.
    /// COV_PARAMETERS lists only the parameters the orbit determination solved for, in the fixed order DRAG_AREA_OVER_MASS,
    /// DRAG_AREA_OVER_MASS_RATE, SRP_AREA_OVER_MASS, IN_TRACK_ACCELERATION, OUTGASSING_ACCELERATION (a VCM's B, BDOT, AGOM
    /// and T are the first four): COV_SIZE - 6 entries, no row for a parameter the determination held.
    def COV_PARAMETERS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 58) + i * 4)
    def COV_PARAMETERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 58)
    /// Units of the standard deviation of each diagonal element (CCSDS 502.0-B-3 COV_UNITS): COV_UNITS has exactly
    /// COV_SIZE entries, km and km/s for the state rows, then m**2/kg, m**2/kg/s, m**2/kg, m/s**2 and km/s**2 for the
    /// parameter rows COV_PARAMETERS names; "n/a" for a dimensionless one.
    def COV_UNITS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 60) + i * 4)
    def COV_UNITS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 60)
    /// Every trajectory state time history of the message (CCSDS 502.0-B-3 TRAJ_START
    /// blocks), in message order. TRAJ_TYPE, STATE_DATA and the fields that go with
    /// them above state the first block's CARTPV or CARTPVA states.
    def TRAJECTORY_BLOCKS(i:int) -> OCMTrajectoryBlock:
        return OCMTrajectoryBlock { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 62) + i * 4) }
    def TRAJECTORY_BLOCKS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 62)
    /// Every covariance time history of the message (COV_START blocks), in message
    /// order. COVARIANCE_DATA and the fields that go with it above state the first
    /// block when it is one line.
    def COVARIANCE_BLOCKS(i:int) -> OCMCovarianceBlock:
        return OCMCovarianceBlock { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 64) + i * 4) }
    def COVARIANCE_BLOCKS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 64)
    /// Where the message's data comes from and the terms it travels under.
    def PROVENANCE() -> PVN?:
        let o = flatbuffers.field_table(buf_, pos_, 66)
        return if o: PVN { buf_, o } else: nil
    /// Realism of COVARIANCE_DATA: one entry per epoch, in the order of the
    /// STATE_DATA epochs, or one entry for every epoch.
    def COV_REALISM(i:int) -> CVR:
        return CVR { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 68) + i * 4) }
    def COV_REALISM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 68)
    /// The mean element set this message carries, under the theory it names. STATE_DATA is
    /// empty when this is present; no state travels beside a set.
    def MEAN_ELEMENTS() -> OCMMeanElements?:
        let o = flatbuffers.field_table(buf_, pos_, 70)
        return if o: OCMMeanElements { buf_, o } else: nil
    /// What propagates COVARIANCE_DATA beyond its epoch (mean element sets).
    def COV_PROPAGATION() -> OCMCovariancePropagation?:
        let o = flatbuffers.field_table(buf_, pos_, 72)
        return if o: OCMCovariancePropagation { buf_, o } else: nil
    /// The covariance rows after the state block, typed, in the order of COV_PARAMETERS:
    /// every reader keys on these, never on the COV_PARAMETERS strings.
    def COV_PARAMETER_KINDS(i:int) -> prwDynamicParameter:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 74) + i * 1)
    def COV_PARAMETER_KINDS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 74)
    /// Basis of the trajectory STATE_DATA states, the first block's TRAJ_BASIS
    /// (CCSDS 502.0-B-3 TRAJ_BASIS).
    def TRAJ_BASIS() -> ocmTrajectoryBasis:
        return ocmTrajectoryBasis(flatbuffers.field_uint8(buf_, pos_, 76, 0))
    /// The element sets the trajectory was computed from, one per object whose
    /// elements it used.
    def SEED_SETS(i:int) -> OCMSeedSet:
        return OCMSeedSet { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 78) + i * 4) }
    def SEED_SETS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 78)
    /// Integrator settings of a solution made from a legacy VCM.
    def INTEGRATOR() -> OCMIntegrator?:
        let o = flatbuffers.field_table(buf_, pos_, 80)
        return if o: OCMIntegrator { buf_, o } else: nil
    /// Relative-motion geometry; STATE_DATA is empty when this is present.
    def RPO_GEOMETRY() -> OCMRelativeGeometry?:
        let o = flatbuffers.field_table(buf_, pos_, 82)
        return if o: OCMRelativeGeometry { buf_, o } else: nil
    /// Inspection geometry; STATE_DATA is empty when this is present.
    def RPO_INSPECTION() -> OCMInspectionGeometry?:
        let o = flatbuffers.field_table(buf_, pos_, 84)
        return if o: OCMInspectionGeometry { buf_, o } else: nil

def GetRootAsOCM(buf:string): return OCM { buf, flatbuffers.indirect(buf, 0) }

