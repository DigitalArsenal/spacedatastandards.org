    /// Standard identifier (e.g., "OMM", "CDM", "CAT")
    def standard() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    /// Wide record type, for a standard numbered in RecordTypeExtended
    /// (ordinals 256 and up) because union RecordType has no room for it.
    /// value is then NONE. Readers dispatch on standard or EXTENDED_TYPE.
    def EXTENDED_TYPE() -> RecordTypeExtended:
        return RecordTypeExtended(flatbuffers.field_uint16(buf_, pos_, 10, 0))
    /// The record's root FlatBuffer, with its file identifier, when
    /// EXTENDED_TYPE is set.
    def EXTENDED_VALUE(i:int) -> int:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 1)
    def EXTENDED_VALUE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)

def GetRootAsRecord(buf:string): return Record { buf, flatbuffers.indirect(buf, 0) }

struct RecordBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(5)
        return this
    def add_value_type(value_type:RecordType):
        b_.PrependUint8Slot(0, value_type, 0)
        return this
    def add_value(value:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, value)
        return this
    def add_standard(standard:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, standard)
        return this
    def add_EXTENDED_TYPE(EXTENDED_TYPE:RecordTypeExtended):
        b_.PrependUint16Slot(3, EXTENDED_TYPE, 0)
        return this
    def add_EXTENDED_VALUE(EXTENDED_VALUE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, EXTENDED_VALUE)
        return this
    def end():
        return b_.EndObject()

def RecordStartEXTENDEDVALUEVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(1, n_, 1)
def RecordCreateEXTENDEDVALUEVector(b_:flatbuffers.builder, v_:[int]):
    b_.StartVector(1, v_.length, 1)
    reverse(v_) e_: b_.PrependUint8(e_)
    return b_.EndVector(v_.length)

/// Collection of Standard Records
class REC : flatbuffers.handle
    /// Schema version identifier
    def version() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Array of heterogeneous records from any supported standard
    def RECORDS(i:int) -> Record:
        return Record { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 6) + i * 4) }
    def RECORDS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)

def GetRootAsREC(buf:string): return REC { buf, flatbuffers.indirect(buf, 0) }

struct RECBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(2)
        return this
    def add_version(version:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, version)
        return this
    def add_RECORDS(RECORDS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, RECORDS)
        return this
    def end():
        return b_.EndObject()

def RECStartRECORDSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def RECCreateRECORDSVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)
