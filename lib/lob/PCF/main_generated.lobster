        return this
    def add_RELATIVE_TOLERANCE(RELATIVE_TOLERANCE:float):
        b_.PrependFloat64Slot(5, RELATIVE_TOLERANCE, 1.0e-12)
        return this
    def add_MAXIMUM_STEPS(MAXIMUM_STEPS:int):
        b_.PrependUint32Slot(6, MAXIMUM_STEPS, 100000)
        return this
    def end():
        return b_.EndObject()

def PCFIntegratorSettingsStartABSOLUTETOLERANCESVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(8, n_, 8)
def PCFIntegratorSettingsCreateABSOLUTETOLERANCESVector(b_:flatbuffers.builder, v_:[float]):
    b_.StartVector(8, v_.length, 8)
    reverse(v_) e_: b_.PrependFloat64(e_)
    return b_.EndVector(v_.length)

/// The forces a propagator applies, shared by $PCF and $PRW. Flags default to
/// off unless stated: a force is active only when selected. No implied support
/// for coefficients, drag models or bodies the provider cannot supply; a
/// provider refuses what it cannot apply, by name.
class PCFForceModel : flatbuffers.handle
    /// Gravity field. Default INFER_FLAGS (the ENABLE_ flags decide).
    def GRAVITY_CHOICE() -> pcfGravitySelection:
        return pcfGravitySelection(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    /// Central-body point-mass term. Default true.
    def ENABLE_POINT_MASS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 6, 1))
    /// Gravitational parameter of the central body, m3/s2; required positive
    /// when a central gravity term is enabled. Default 0.
    def GRAVITATIONAL_PARAMETER() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// J2 zonal term. Default true.
    def ENABLE_J2() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 10, 1))
    /// J3 zonal term. Default false.
    def ENABLE_J3() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 12, 0))
    /// J4 zonal term. Default false.
    def ENABLE_J4() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 14, 0))
    /// Zonal terms above J4. Default false.
    def ENABLE_HIGHER_ZONALS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 0))
    /// Highest field degree; dimensionless. Absent selects the explicitly
    /// reported model default.
    def MAXIMUM_DEGREE() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 18, 0)
    /// True when MAXIMUM_DEGREE carries a value; false (the default) means absent.
    def HAS_MAXIMUM_DEGREE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 20, 0))
    /// Highest field order; dimensionless. Absent selects the explicitly
    /// reported model default.
    def MAXIMUM_ORDER() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 22, 0)
    /// True when MAXIMUM_ORDER carries a value; false (the default) means absent.
    def HAS_MAXIMUM_ORDER() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 24, 0))
    /// Third-body gravity of THIRD_BODY_IDS. Default false.
    def ENABLE_THIRD_BODY() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))
    /// NAIF IDs; explicit vector, e.g. [10,301]. Empty (the default) means no
    /// third bodies.
    def THIRD_BODY_IDS(i:int) -> int:
        return read_int32_le(buf_, buf_.flatbuffers.field_vector(pos_, 28) + i * 4)
    def THIRD_BODY_IDS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    /// Solar radiation pressure. Default false.
    def ENABLE_SRP() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 30, 0))
    /// Atmospheric drag. Default false.
    def ENABLE_DRAG() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 32, 0))
    /// Spacecraft mass, kg. Default 1000.
    def INITIAL_MASS_KG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 1000.0)
    /// Cross-section area, m2. Default 10.
    def AREA_M2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 10.0)
    /// Radiation-pressure coefficient Cr, dimensionless. Default 1.5.
    def REFLECTIVITY_COEFFICIENT() -> float:
        return flatbuffers.field_float64(buf_, pos_, 38, 1.5)
    /// Drag coefficient Cd, dimensionless. Default 2.2.
    def DRAG_COEFFICIENT() -> float:
        return flatbuffers.field_float64(buf_, pos_, 40, 2.2)
    /// Atmosphere model. Default NRLMSISE00.
    def ATMOSPHERE_MODEL() -> pcfAtmosphereFamily:
        return pcfAtmosphereFamily(flatbuffers.field_uint8(buf_, pos_, 42, 1))
    /// Space weather held for the arc when WEATHER_SOURCE selects it. Default
    /// absent.
    def WEATHER() -> PCFSpaceWeather?:
        let o = flatbuffers.field_table(buf_, pos_, 44)
        return if o: PCFSpaceWeather { buf_, o } else: nil
    /// Actual configured source name, e.g. an analytic series or a planetary SPK
    /// kernel. Required; no default.
    def EPHEMERIS_SOURCE() -> string:
        return flatbuffers.field_string(buf_, pos_, 46)
    /// Solid Earth tides. Their field is Earth-fixed, so a provider needs Earth
    /// orientation (the request's Earth orientation rows) to apply them. Default
    /// NONE.
    def SOLID_TIDES() -> pcfSolidTideModel:
        return pcfSolidTideModel(flatbuffers.field_uint8(buf_, pos_, 48, 0))
    /// Post-Newtonian terms. Default NONE.
    def RELATIVITY() -> pcfRelativityTerms:
        return pcfRelativityTerms(flatbuffers.field_uint8(buf_, pos_, 50, 0))
    /// Constant acceleration along the in-track axis, m/s2: T of RTN,
    /// N cross rhat with N = unit(r cross v) (the "in-track thrust" of a VCM).
    /// Default absent.
    def IN_TRACK_ACCELERATION_M_S2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 52, 0.0)
    /// True when IN_TRACK_ACCELERATION_M_S2 carries a value; false (the default)
    /// means absent.
    def HAS_IN_TRACK_ACCELERATION_M_S2() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 54, 0))
    /// Rate of change of the drag ballistic coefficient Cd*A/m, m2/kg/s (the
    /// BDOT of a VCM). Drag uses Cd*A/m + rate * (t - initial epoch). Default
    /// absent.
    def DRAG_AREA_OVER_MASS_RATE_M2_KG_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 56, 0.0)
    /// True when DRAG_AREA_OVER_MASS_RATE_M2_KG_S carries a value; false (the
    /// default) means absent.
    def HAS_DRAG_AREA_OVER_MASS_RATE_M2_KG_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 58, 0))
    /// Highest degree of the tesseral and sectorial terms (order >= 1); the
    /// zonals run to MAXIMUM_DEGREE. A VCM's "mmZ,nnT" is MAXIMUM_DEGREE mm,
    /// MAXIMUM_ORDER nn and MAXIMUM_TESSERAL_DEGREE nn. Default absent.
    def MAXIMUM_TESSERAL_DEGREE() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 60, 0)
    /// True when MAXIMUM_TESSERAL_DEGREE carries a value; false (the default)
    /// means absent.
    def HAS_MAXIMUM_TESSERAL_DEGREE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 62, 0))
    /// Solar radiation pressure model family. Default CANNONBALL.
    def RADIATION_PRESSURE_MODEL() -> pcfRadiationPressureFamily:
        return pcfRadiationPressureFamily(flatbuffers.field_uint8(buf_, pos_, 64, 0))
    /// Spacecraft block; required when RADIATION_PRESSURE_MODEL is GNSS_BOX_WING.
    /// Default UNSPECIFIED.
    def GNSS_BLOCK() -> pcfGnssSpacecraftBlock:
        return pcfGnssSpacecraftBlock(flatbuffers.field_uint8(buf_, pos_, 66, 0))
    /// ECOM2 coefficients; absent (the default) means no ECOM2 term.
    def ECOM2() -> PCFEcom2?:
        let o = flatbuffers.field_table(buf_, pos_, 68)
        return if o: PCFEcom2 { buf_, o } else: nil
    /// Earth radiation pressure (albedo and infrared). It reads the Sun's
    /// position from the ephemeris source. Default NONE.
    def EARTH_RADIATION() -> pcfEarthRadiationModel:
        return pcfEarthRadiationModel(flatbuffers.field_uint8(buf_, pos_, 70, 0))
    /// Angular size of the Earth surface elements it sums, degrees. Default 15.
    def EARTH_RADIATION_RESOLUTION_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 72, 15.0)
    /// Isotropic Cr*A/m, m2/kg, the Earth's radiation acts on. Absent, it is the
    /// cannonball's REFLECTIVITY_COEFFICIENT * AREA_M2 / INITIAL_MASS_KG, and
    /// fitting SRP_AREA_OVER_MASS scales both.
    def EARTH_RADIATION_AREA_OVER_MASS_M2_KG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 74, 0.0)
    /// True when EARTH_RADIATION_AREA_OVER_MASS_M2_KG carries a value; false (the
    /// default) means absent.
    def HAS_EARTH_RADIATION_AREA_OVER_MASS_M2_KG() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 76, 0))
    /// Ocean tides. Their field is Earth-fixed, so a provider needs Earth
    /// orientation (the request's Earth orientation rows) to apply them. Default
    /// NONE.
    def OCEAN_TIDES() -> pcfOceanTideModel:
        return pcfOceanTideModel(flatbuffers.field_uint8(buf_, pos_, 78, 0))
    /// Truncation of the ocean tide field, degree. Default 30.
    def OCEAN_TIDE_MAXIMUM_DEGREE() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 80, 30)
    /// Truncation of the ocean tide field, order. Default 30.
    def OCEAN_TIDE_MAXIMUM_ORDER() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 82, 30)
    /// Central body, a NAIF ID. The gravity field, atmosphere, tides and third
    /// bodies are those of this body. Default 399 (Earth).
    def CENTRAL_BODY_NAIF_ID() -> int:
        return flatbuffers.field_int32(buf_, pos_, 84, 399)
    /// Where the Sun, Moon and planets are read from. Default UNSPECIFIED (the
    /// source named in EPHEMERIS_SOURCE).
    def EPHEMERIS_KIND() -> pcfEphemerisKind:
        return pcfEphemerisKind(flatbuffers.field_uint8(buf_, pos_, 86, 0))
    /// Shadow model of the radiation-pressure and Earth-radiation terms. Default
    /// UNSPECIFIED (the provider's: conical).
    def SHADOW_MODEL() -> evlShadowModel:
        return evlShadowModel(flatbuffers.field_uint8(buf_, pos_, 88, 0))
    /// Where the space weather comes from. Default UNSPECIFIED (inferred).
    def WEATHER_SOURCE() -> pcfWeatherSource:
        return pcfWeatherSource(flatbuffers.field_uint8(buf_, pos_, 90, 0))
    /// What happens past the last space weather row. Default UNSPECIFIED (the
    /// provider's rule).
    def WEATHER_EXTENSION() -> pcfWeatherExtension:
        return pcfWeatherExtension(flatbuffers.field_uint8(buf_, pos_, 92, 0))
    /// Correction applied to the atmosphere model's density. Default NONE.
    def DENSITY_CORRECTION() -> pcfDensityCorrection:
        return pcfDensityCorrection(flatbuffers.field_uint8(buf_, pos_, 94, 0))
    /// Past the last density-correction node the log-density scale relaxes to
    /// its trailing mean with this time constant, hours; 0 holds the last node.
    /// Absent, the provider's rule (the numerical propagator holds; the advanced
    /// mean-element propagator relaxes with 48 h).
    def DENSITY_CORRECTION_RELAXATION_HOURS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 96, 0.0)
    /// True when DENSITY_CORRECTION_RELAXATION_HOURS carries a value; false (the
    /// default) means absent.
    def HAS_DENSITY_CORRECTION_RELAXATION_HOURS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 98, 0))
    /// Neutral wind in the drag relative velocity. Default NONE.
    def NEUTRAL_WIND() -> pcfNeutralWind:
        return pcfNeutralWind(flatbuffers.field_uint8(buf_, pos_, 100, 0))
    /// Empirical along-track terms of the averaged theories. Absent (the
    /// default): the theory's own.
    def EMPIRICAL_TERMS() -> PCFEmpiricalTerms?:
        let o = flatbuffers.field_table(buf_, pos_, 102)
        return if o: PCFEmpiricalTerms { buf_, o } else: nil
    /// Highest degree of the harmonic field of the third body that has one (the
    /// Moon's on an Earth orbiter, the Earth's on a lunar orbiter); dimensionless.
    /// The field's acceleration at the frame origin is subtracted. Default 0:
    /// third bodies are point masses only.
    def THIRD_BODY_MAXIMUM_DEGREE() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 104, 0)
    /// Highest order of that field; dimensionless. Default 0.
    def THIRD_BODY_MAXIMUM_ORDER() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 106, 0)

def GetRootAsPCFForceModel(buf:string): return PCFForceModel { buf, flatbuffers.indirect(buf, 0) }

