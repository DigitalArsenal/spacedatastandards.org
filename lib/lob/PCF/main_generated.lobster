/// Instantaneous space weather, held for an arc when WEATHER_SOURCE selects it.
/// The TIM epoch is UTC; flux is in SFU (1e-22 W/m2/Hz).
class PCFSpaceWeather : flatbuffers.handle
    /// Epoch the values apply to. Required; no default.
    def EPOCH() -> TIMInstant:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return TIMInstant { buf_, assert o }
    /// Daily F10.7 solar radio flux, SFU. Default 150.
    def F107() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 150.0)
    /// Centered 81-day average of F10.7, SFU. Default 150.
    def F107_AVERAGE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 150.0)
    /// Conventional daily Ap index value, dimensionless (not an acceleration).
    /// Default 15.
    def AP_INDEX() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 15.0)
    /// Conventional three-hour Kp index value, dimensionless (not an
    /// acceleration). Default 3.
    def KP_INDEX() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 3.0)

