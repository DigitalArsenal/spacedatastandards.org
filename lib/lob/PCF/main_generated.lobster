/// Integrator and its settings, shared by $PCF and $PRW. Units are SI. A scalar
/// legacy tolerance must be expanded by the adapter.
class PCFIntegratorSettings : flatbuffers.handle
    /// Algorithm. Default UNSPECIFIED (the provider's own).
    def ALGORITHM() -> pcfIntegratorAlgorithm:
        return pcfIntegratorAlgorithm(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    /// First step, seconds; the fixed step of RK4. Default 60.
    def INITIAL_STEP_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 60.0)
    /// Smallest step an adaptive algorithm may take, seconds. Default 1.
    def MINIMUM_STEP_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 1.0)
    /// Largest step, seconds. Default 3600.
    def MAXIMUM_STEP_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 3600.0)
    /// Six or seven positive tolerances, respectively m, m/s and optional kg.
    /// Required; no default.
    def ABSOLUTE_TOLERANCES(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def ABSOLUTE_TOLERANCES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// Relative tolerance, dimensionless. Default 1e-12.
    def RELATIVE_TOLERANCE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 1.0e-12)
    /// Most steps one propagation may take. Default 100000.
    def MAXIMUM_STEPS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 16, 100000)

def GetRootAsPCFIntegratorSettings(buf:string): return PCFIntegratorSettings { buf, flatbuffers.indirect(buf, 0) }

