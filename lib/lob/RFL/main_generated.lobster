/// RF Link Sample
class RFL : flatbuffers.handle
    /// Stable identifier of this sample set.
    def RFL_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Display name.
    def NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Analysis or scenario grouping identifier shared with the `$ACI` and
    /// `$CVP` products derived from this set.
    def SCENARIO_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    /// Link definitions. SAMPLE_LINK_INDEXES index into this vector.
    def LINKS(i:int) -> RFLLink:
        return RFLLink { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 10) + i * 4) }
    def LINKS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Number of samples. Every present metric array MUST have exactly this
    /// many entries.
    def SAMPLE_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 0)
    /// Index into LINKS for each sample.
    def SAMPLE_LINK_INDEXES(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 4)
    def SAMPLE_LINK_INDEXES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    /// Sample epochs, seconds since 1970-01-01T00:00:00 in TIME_SYSTEM. Samples
    /// need not be uniformly spaced and need not be grouped by link, but MUST be
    /// non-decreasing within each link.
    def SAMPLE_EPOCHS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 8)
    def SAMPLE_EPOCHS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Time scale SAMPLE_EPOCHS are expressed in. Defaults to UTC explicitly:
    /// `timingStandard` ordinal 0 is GMST, so an unset field would otherwise
    /// decode as sidereal time.
    def TIME_SYSTEM() -> timingStandard:
        return timingStandard(flatbuffers.field_int8(buf_, pos_, 18, 11))
    /// Access state per sample.
    def ACCESS_STATES(i:int) -> rflAccessState:
        return read_int8_le(buf_, buf_.flatbuffers.field_vector(pos_, 20) + i * 1)
    def ACCESS_STATES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// Slant range, metres.
    def RANGE_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 22) + i * 8)
    def RANGE_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    /// Range rate, metres per second; positive is opening.
    def RANGE_RATE_M_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 24) + i * 8)
    def RANGE_RATE_M_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    /// Azimuth at the receiving endpoint, degrees east of north [0-360).
    def AZIMUTH_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 26) + i * 8)
    def AZIMUTH_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)
    /// Elevation at the receiving endpoint, degrees above the local horizon.
    def ELEVATION_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 28) + i * 8)
    def ELEVATION_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    /// Azimuth at the transmitting endpoint, degrees east of north [0-360).
    def TRANSMIT_AZIMUTH_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 30) + i * 8)
    def TRANSMIT_AZIMUTH_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    /// Elevation at the transmitting endpoint, degrees.
    def TRANSMIT_ELEVATION_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 32) + i * 8)
    def TRANSMIT_ELEVATION_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 32)
    /// One-way Doppler shift of the carrier at the receiving endpoint, hertz;
    /// positive is closing. Hertz, not the MHz used for frequencies elsewhere in
    /// this record — a shift of a few kHz on a GHz carrier is destroyed by an
    /// MHz encoding.
    def DOPPLER_SHIFT_HZ(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 34) + i * 8)
    def DOPPLER_SHIFT_HZ_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    /// Doppler rate, hertz per second.
    def DOPPLER_RATE_HZ_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 36) + i * 8)
    def DOPPLER_RATE_HZ_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 36)
    /// Effective isotropic radiated power toward the receiver, dBW.
    def EIRP_DBW(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 38) + i * 8)
    def EIRP_DBW_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 38)
    /// Transmit antenna gain in the direction of the receiver, dBi.
    def TRANSMIT_ANTENNA_GAIN_DBI(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 40) + i * 8)
    def TRANSMIT_ANTENNA_GAIN_DBI_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 40)
    /// Receive antenna gain in the direction of the transmitter, dBi.
    def RECEIVE_ANTENNA_GAIN_DBI(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 42) + i * 8)
    def RECEIVE_ANTENNA_GAIN_DBI_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 42)
    /// Free-space path loss, dB.
    def FREE_SPACE_PATH_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 44) + i * 8)
    def FREE_SPACE_PATH_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 44)
    /// Gaseous (oxygen and water vapour) absorption, dB.
    def GASEOUS_ABSORPTION_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 46) + i * 8)
    def GASEOUS_ABSORPTION_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 46)
    /// Rain attenuation, dB.
    def RAIN_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 48) + i * 8)
    def RAIN_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 48)
    /// Cloud and fog attenuation, dB.
    def CLOUD_FOG_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 50) + i * 8)
    def CLOUD_FOG_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 50)
    /// Tropospheric or ionospheric scintillation, dB.
    def SCINTILLATION_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 52) + i * 8)
    def SCINTILLATION_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 52)
    /// Terrain diffraction and blockage, dB.
    def TERRAIN_DIFFRACTION_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 54) + i * 8)
    def TERRAIN_DIFFRACTION_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 54)
    /// Total loss from 3D obstacles on the path, dB. The per-obstacle detail —
    /// which object, which material, at what angle, through how much of it — is
    /// in OBSTRUCTIONS.
    def OBSTRUCTION_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 56) + i * 8)
    def OBSTRUCTION_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 56)
    /// Polarization mismatch, dB.
    def POLARIZATION_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 58) + i * 8)
    def POLARIZATION_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 58)
    /// Antenna pointing error, dB.
    def POINTING_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 60) + i * 8)
    def POINTING_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 60)
    /// Implementation and hardware losses, dB.
    def IMPLEMENTATION_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 62) + i * 8)
    def IMPLEMENTATION_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 62)
    /// Total of all path terms actually applied, dB. Published as its own column
    /// rather than left to the consumer to sum: a producer that applied a term
    /// this schema has no column for MUST still report an honest total, and the
    /// discrepancy against the itemised columns is then visible.
    def TOTAL_PATH_LOSS_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 64) + i * 8)
    def TOTAL_PATH_LOSS_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 64)
    /// Received carrier power at the receiver input, dBW.
    def RECEIVED_POWER_DBW(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 66) + i * 8)
    def RECEIVED_POWER_DBW_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 66)
    /// Receiving system noise temperature, kelvin.
    def SYSTEM_NOISE_TEMPERATURE_K(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 68) + i * 8)
    def SYSTEM_NOISE_TEMPERATURE_K_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 68)
    /// Receiving system figure of merit G/T, dB/K.
    def GAIN_TO_NOISE_TEMPERATURE_DB_PER_K(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 70) + i * 8)
    def GAIN_TO_NOISE_TEMPERATURE_DB_PER_K_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 70)
    /// Carrier-to-noise-density ratio C/N0, dB-Hz.
    def CARRIER_TO_NOISE_DENSITY_DBHZ(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 72) + i * 8)
    def CARRIER_TO_NOISE_DENSITY_DBHZ_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 72)
    /// Carrier-to-noise ratio C/N in the occupied bandwidth, dB.
    def CARRIER_TO_NOISE_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 74) + i * 8)
    def CARRIER_TO_NOISE_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 74)
    /// Energy per bit to noise density Eb/N0, dB.
    def ENERGY_PER_BIT_TO_NOISE_DENSITY_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 76) + i * 8)
    def ENERGY_PER_BIT_TO_NOISE_DENSITY_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 76)
    /// Bit error rate as a probability [0-1], NOT an exponent and NOT a
    /// percentage. 1e-6 is encoded 1e-6.
    def BIT_ERROR_RATE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 78) + i * 8)
    def BIT_ERROR_RATE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 78)
    /// Link margin against the link's stated threshold, dB. Meaningless without
    /// RFLLink.THRESHOLD_TERM / THRESHOLD_VALUE / THRESHOLD_COMPARISON.
    def LINK_MARGIN_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 80) + i * 8)
    def LINK_MARGIN_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 80)
    /// Achievable channel capacity, bits per second.
    def CHANNEL_CAPACITY_BPS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 82) + i * 8)
    def CHANNEL_CAPACITY_BPS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 82)
    /// Aggregate received interfering power, dBW.
    def INTERFERENCE_POWER_DBW(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 84) + i * 8)
    def INTERFERENCE_POWER_DBW_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 84)
    /// Carrier to noise-plus-interference ratio C/(N+I), dB.
    def CARRIER_TO_NOISE_PLUS_INTERFERENCE_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 86) + i * 8)
    def CARRIER_TO_NOISE_PLUS_INTERFERENCE_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 86)
    /// Signal to interference-plus-noise ratio, dB.
    def SIGNAL_TO_INTERFERENCE_PLUS_NOISE_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 88) + i * 8)
    def SIGNAL_TO_INTERFERENCE_PLUS_NOISE_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 88)
    /// Per-contribution interference detail, sparse.
    def INTERFERENCE_CONTRIBUTIONS(i:int) -> RFLInterferenceContribution:
        return RFLInterferenceContribution { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 90) + i * 4) }
    def INTERFERENCE_CONTRIBUTIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 90)
    /// Per-interaction obstacle detail, sparse. Each entry names the `$RFS`
    /// material it went through, reflected off or was blocked by.
    def OBSTRUCTIONS(i:int) -> RFLObstruction:
        return RFLObstruction { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 92) + i * 4) }
    def OBSTRUCTIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 92)
    /// The single condition that bound the link at each sample.
    def LIMITING_CONSTRAINTS(i:int) -> rflConstraint:
        return read_int8_le(buf_, buf_.flatbuffers.field_vector(pos_, 94) + i * 1)
    def LIMITING_CONSTRAINTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 94)
    /// Verbatim description required when a LIMITING_CONSTRAINTS entry is OTHER.
    def LIMITING_CONSTRAINT_NOTE() -> string:
        return flatbuffers.field_string(buf_, pos_, 96)
    /// Provenance of the whole set. Required: an unattributed budget is not
    /// publishable.
    def PROVENANCE() -> RFLProvenance:
        let o = flatbuffers.field_table(buf_, pos_, 98)
        return RFLProvenance { buf_, assert o }
    /// Unix ms this record was serialized.
    def COMPUTED_AT() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 100, 0)
    /// `$EPM` identifier of the producing node.
    def PRODUCER_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 102)
    /// Ed25519 signature by the producing `$EPM` over the size-prefixed
    /// FlatBuffer projection with both 64-byte signature payloads zeroed while
    /// preserving their vectors and offsets.
    def SIGNATURE(i:int) -> int:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 104) + i * 1)
    def SIGNATURE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 104)
    /// Ed25519 signature by the producing `$EPM` over canonical JSON with IDL
    /// field order, IDL capitalization, no insignificant whitespace, and both
    /// signature fields omitted.
    def CANONICAL_JSON_SIGNATURE(i:int) -> int:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 106) + i * 1)
    def CANONICAL_JSON_SIGNATURE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 106)
    /// Index into the selected link's RFLLink.MODCOD_SET for each sample.
    /// SELECTED_MODCOD_VALID distinguishes index 0 from no selection.
    def SELECTED_MODCOD_INDEX(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 108) + i * 4)
    def SELECTED_MODCOD_INDEX_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 108)
    def SELECTED_MODCOD_VALID(i:int) -> bool:
        return read_int8_le(buf_, buf_.flatbuffers.field_vector(pos_, 110) + i * 1)
    def SELECTED_MODCOD_VALID_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 110)
    /// Spectral efficiency delivered by the selected entry, bit/s/Hz.
    def SPECTRAL_EFFICIENCY_BPS_HZ(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 112) + i * 8)
    def SPECTRAL_EFFICIENCY_BPS_HZ_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 112)
    /// Delivered information rate after adaptive selection, bits per second.
    def ACHIEVED_DATA_RATE_BPS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 114) + i * 8)
    def ACHIEVED_DATA_RATE_BPS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 114)
    /// Margin above the selected entry's threshold, dB.
    def ACM_MARGIN_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 116) + i * 8)
    def ACM_MARGIN_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 116)
    /// Symbol energy to noise spectral density, dB.
    def ENERGY_PER_SYMBOL_TO_NOISE_DENSITY_DB(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 118) + i * 8)
    def ENERGY_PER_SYMBOL_TO_NOISE_DENSITY_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 118)
    /// Decoded block error probability [0-1].
    def BLOCK_ERROR_RATE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 120) + i * 8)
    def BLOCK_ERROR_RATE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 120)

def GetRootAsRFL(buf:string): return RFL { buf, flatbuffers.indirect(buf, 0) }

