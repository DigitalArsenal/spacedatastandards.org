/// Exact validated SDS and representation contract bound into a signed flow
/// edge. CANONICAL_TYPE and ALIGNED_TYPE describe the same logical schema;
/// ALIGNED_TYPE carries its fixed layout in TAB.FlatBufferTypeRef.
class PLGFlowEdgeContract : flatbuffers.handle
    /// Canonical SDS identity carried by the edge. NOT `required`: an edge may
    /// be opaque by design (see OPAQUE), and a signer must never be forced to
    /// invent an identity to satisfy the schema. A contract MUST carry exactly
    /// one of CANONICAL_TYPE or OPAQUE = true; a contract with neither, or with
    /// both, is invalid and MUST be rejected by the compiler that signs the flow.
    def CANONICAL_TYPE() -> FlatBufferTypeRef?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: FlatBufferTypeRef { buf_, o } else: nil
    def ALIGNED_TYPE() -> FlatBufferTypeRef?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: FlatBufferTypeRef { buf_, o } else: nil
    def CANONICAL_FALLBACK_AVAILABLE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 8, 1))
    def ALIGNED_ELIGIBLE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 10, 0))
    def ROUTE_POLICY() -> flowEdgeRoutePolicy:
        return flowEdgeRoutePolicy(flatbuffers.field_uint8(buf_, pos_, 12, 0))
    /// The edge carries bytes with no SDS identity BY DESIGN — an
    /// application-blind host-capability adapter (an HTTP body, a raw file
    /// chunk) or a timer TICK frame with no payload at all. This is a deliberate
    /// signed assertion of opacity, which is why it is an explicit flag rather
    /// than an absent CANONICAL_TYPE: a missing type must stay distinguishable
    /// from a declared-opaque one. An opaque edge is ineligible for the aligned
    /// route, so ALIGNED_ELIGIBLE MUST be false when OPAQUE is true.
    def OPAQUE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 14, 0))

def GetRootAsPLGFlowEdgeContract(buf:string): return PLGFlowEdgeContract { buf, flatbuffers.indirect(buf, 0) }

struct PLGFlowEdgeContractBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(6)
        return this
    def add_CANONICAL_TYPE(CANONICAL_TYPE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, CANONICAL_TYPE)
        return this
    def add_ALIGNED_TYPE(ALIGNED_TYPE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, ALIGNED_TYPE)
        return this
    def add_CANONICAL_FALLBACK_AVAILABLE(CANONICAL_FALLBACK_AVAILABLE:bool):
        b_.PrependBoolSlot(2, CANONICAL_FALLBACK_AVAILABLE, 1)
        return this
    def add_ALIGNED_ELIGIBLE(ALIGNED_ELIGIBLE:bool):
        b_.PrependBoolSlot(3, ALIGNED_ELIGIBLE, 0)
        return this
    def add_ROUTE_POLICY(ROUTE_POLICY:flowEdgeRoutePolicy):
        b_.PrependUint8Slot(4, ROUTE_POLICY, 0)
        return this
    def add_OPAQUE(OPAQUE:bool):
        b_.PrependBoolSlot(5, OPAQUE, 0)
        return this
    def end():
        return b_.EndObject()

/// One directed edge wiring a producer output port to a consumer input port.
class PLGFlowEdge : flatbuffers.handle
    /// Stable edge identifier
    def EDGE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Source node id
    def FROM_NODE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Source output port id
    def FROM_PORT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    /// Destination node id
    def TO_NODE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// Destination input port id
    def TO_PORT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// Exact identity/layout and compile-time representation policy. NOT
    /// `required`: marking a NEW field of an EXISTING table required makes the
    /// FlatBuffers verifier reject every $PLG buffer written before 1.0.13,
    /// which is a breaking change to a ratified standard. Presence is enforced
    /// where it belongs — the flow compiler MUST refuse to SIGN a flow whose
    /// edges lack a CONTRACT, and a verifier MUST reject a signed flow edge
    /// without one. Buffers predating 1.0.13 stay readable and stay unsigned.
    def CONTRACT() -> PLGFlowEdgeContract?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: PLGFlowEdgeContract { buf_, o } else: nil

def GetRootAsPLGFlowEdge(buf:string): return PLGFlowEdge { buf, flatbuffers.indirect(buf, 0) }

