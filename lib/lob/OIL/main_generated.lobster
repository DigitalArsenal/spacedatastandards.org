/// existing values.
enum oilLinkStatus:
    /// Not stated.
    oilLinkStatus_Unspecified = 0
    /// Declared by a source and not yet tested.
    oilLinkStatus_Candidate = 1
    /// Proposed for testing (for example paired with trajectories to compare).
    oilLinkStatus_Proposed = 2
    /// Repeats an earlier declaration of the same pair (DUPLICATE_OF names it).
    oilLinkStatus_Duplicate = 3
    /// One side is declared against more than one identifier on the other.
    oilLinkStatus_Conflicting = 4
    /// The declaration could not be read as a valid pairing (an impossible
    /// date, a malformed identifier); kept with its text as evidence.
    oilLinkStatus_Invalid = 5
    /// Tested and bound: the identities are joined.
    oilLinkStatus_Bound = 6
    /// Tested and refused.
    oilLinkStatus_Rejected = 7

/// Shape of a group of identifiers declared against each other that is not
