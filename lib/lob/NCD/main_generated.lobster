        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 18) + i * 4)
    def COMMENT_AREA_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Reference frame name as the container itself spells it, before any
    /// mapping onto $RFM.
    def NATIVE_FRAME_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 20)
    /// Integer reference frame code as the container stores it.
    def NATIVE_FRAME_ID() -> int:
        return flatbuffers.field_int32(buf_, pos_, 22, 0)
    /// Time system as the container itself spells it, before any mapping onto
    /// the ratified time-scale vocabulary.
    def NATIVE_TIME_SYSTEM() -> string:
        return flatbuffers.field_string(buf_, pos_, 24)
    /// Descriptors of the container's segments, in file order. Empty for a
    /// single-span container.
    def SEGMENTS(i:int) -> NCDSegmentDescriptor:
        return NCDSegmentDescriptor { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 26) + i * 4) }
    def SEGMENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)
    /// Header block when FORMAT is SP3_C or SP3_D.
    def SP3_HEADER() -> NCDSP3Header?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: NCDSP3Header { buf_, o } else: nil
    /// Parameters when FORMAT is SCENARIO_EPOCH_EPHEMERIS_TEXT or
    /// SCENARIO_EPOCH_ATTITUDE_TEXT.
    def SCENARIO_CONTAINER() -> NCDScenarioEpochContainer?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: NCDScenarioEpochContainer { buf_, o } else: nil
    /// Header words when FORMAT is CODE_500.
    def CODE_500_HEADER() -> NCDCode500Header?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: NCDCode500Header { buf_, o } else: nil
    /// Total coverage start across all segments, ISO 8601.
    def START_TIME() -> string:
        return flatbuffers.field_string(buf_, pos_, 34)
    /// Total coverage stop across all segments, ISO 8601.
    def STOP_TIME() -> string:
        return flatbuffers.field_string(buf_, pos_, 36)
    /// Length of the described container in bytes.
    def SOURCE_BYTE_LENGTH() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 38, 0)
    /// SHA-256 of the described container's exact bytes, lowercase hex. This is
    /// what makes the descriptor checkable: a consumer can prove the descriptor
    /// belongs to the file it holds.
    def SOURCE_SHA256() -> string:
        return flatbuffers.field_string(buf_, pos_, 40)
    /// Content identifier of the described container when it is addressed by
    /// content rather than by path.
    def SOURCE_CID() -> string:
        return flatbuffers.field_string(buf_, pos_, 42)

def GetRootAsNCD(buf:string): return NCD { buf, flatbuffers.indirect(buf, 0) }

struct NCDBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(20)
        return this
    def add_FORMAT(FORMAT:ncdContainerFormat):
        b_.PrependUint8Slot(0, FORMAT, 0)
        return this
    def add_PROVIDER_DEFINED_FORMAT_NAME(PROVIDER_DEFINED_FORMAT_NAME:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, PROVIDER_DEFINED_FORMAT_NAME)
        return this
    def add_FORMAT_VERSION(FORMAT_VERSION:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, FORMAT_VERSION)
        return this
    def add_PRODUCER(PRODUCER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, PRODUCER)
        return this
    def add_CREATION_DATE(CREATION_DATE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, CREATION_DATE)
        return this
    def add_ORIGINATOR(ORIGINATOR:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(5, ORIGINATOR)
        return this
    def add_INTERNAL_FILE_NAME(INTERNAL_FILE_NAME:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(6, INTERNAL_FILE_NAME)
        return this
    def add_COMMENT_AREA(COMMENT_AREA:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(7, COMMENT_AREA)
        return this
    def add_NATIVE_FRAME_NAME(NATIVE_FRAME_NAME:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(8, NATIVE_FRAME_NAME)
        return this
    def add_NATIVE_FRAME_ID(NATIVE_FRAME_ID:int):
        b_.PrependInt32Slot(9, NATIVE_FRAME_ID, 0)
        return this
    def add_NATIVE_TIME_SYSTEM(NATIVE_TIME_SYSTEM:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(10, NATIVE_TIME_SYSTEM)
        return this
    def add_SEGMENTS(SEGMENTS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(11, SEGMENTS)
        return this
    def add_SP3_HEADER(SP3_HEADER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(12, SP3_HEADER)
        return this
    def add_SCENARIO_CONTAINER(SCENARIO_CONTAINER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(13, SCENARIO_CONTAINER)
        return this
    def add_CODE_500_HEADER(CODE_500_HEADER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(14, CODE_500_HEADER)
        return this
    def add_START_TIME(START_TIME:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(15, START_TIME)
        return this
    def add_STOP_TIME(STOP_TIME:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(16, STOP_TIME)
        return this
    def add_SOURCE_BYTE_LENGTH(SOURCE_BYTE_LENGTH:int):
        b_.PrependUint64Slot(17, SOURCE_BYTE_LENGTH, 0)
        return this
    def add_SOURCE_SHA256(SOURCE_SHA256:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(18, SOURCE_SHA256)
        return this
    def add_SOURCE_CID(SOURCE_CID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(19, SOURCE_CID)
        return this
    def end():
        return b_.EndObject()

def NCDStartCOMMENTAREAVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def NCDCreateCOMMENTAREAVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

def NCDStartSEGMENTSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def NCDCreateSEGMENTSVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)
