    def SPECTRAL_DENSITY_M2_S3_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Interval over which each noise increment enters, seconds.
    def DISCRETIZATION_SECONDS() -> float:
