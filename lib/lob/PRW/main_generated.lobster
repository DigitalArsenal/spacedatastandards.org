/// Finite thrust. RTN=(rhat, N cross rhat, N), N=unit(r cross v).
/// VNC=(vhat, unit(r cross v), vhat cross unit(r cross v)).
class PRWFiniteBurn : flatbuffers.handle
    def START() -> PRWBurnBoundary:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return PRWBurnBoundary { buf_, assert o }
