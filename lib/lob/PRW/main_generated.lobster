/// Identity/state at one epoch. FRM state is m/m/s with named frame/time scale.
class PRWResidentState : flatbuffers.handle
    def INSTANCE() -> PRWInstance?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: PRWInstance { buf_, o } else: nil
    def ENTITY_HANDLE() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    def CATALOG_NUMBER() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    def OBJECT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    def STATE() -> FRMStateVector:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return FRMStateVector { buf_, assert o }
    def COORDINATE_SYSTEM() -> RFMCoordinateSystem:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return RFMCoordinateSystem { buf_, assert o }
    def COVARIANCE() -> PRWStateMatrix?:
        let o = flatbuffers.field_table(buf_, pos_, 16)
        return if o: PRWStateMatrix { buf_, o } else: nil
    /// Optional initial dynamical mass in kg; distinct from a missing mass.
    def MASS_KG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// True when MASS_KG carries a value; false means absent.
    def HAS_MASS_KG() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 20, 0))
    /// Explicit SI concepts Cd*A/m and Cr*A/m. Do not infer these from legacy
    /// ignored/underspecified coefficients; require a caller-provided mapping.
    def DRAG_AREA_OVER_MASS_M2_KG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// True when DRAG_AREA_OVER_MASS_M2_KG carries a value; false means absent.
    def HAS_DRAG_AREA_OVER_MASS_M2_KG() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 24, 0))
    def SRP_AREA_OVER_MASS_M2_KG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    /// True when SRP_AREA_OVER_MASS_M2_KG carries a value; false means absent.
    def HAS_SRP_AREA_OVER_MASS_M2_KG() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 28, 0))
    def VALID() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 30, 1))
    /// Process noise for COVARIANCE: on input, what propagation adds; on
    /// output, what the propagated COVARIANCE includes. Absent means none.
    def PROCESS_NOISE() -> PRWProcessNoise?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: PRWProcessNoise { buf_, o } else: nil
    /// Rate of change of DRAG_AREA_OVER_MASS_M2_KG, m2/kg/s, from STATE's epoch
    /// (the BDOT of a VCM).
    def DRAG_AREA_OVER_MASS_RATE_M2_KG_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    /// True when DRAG_AREA_OVER_MASS_RATE_M2_KG_S carries a value; false means absent.
    def HAS_DRAG_AREA_OVER_MASS_RATE_M2_KG_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 36, 0))
    /// Constant in-track acceleration, m/s2, as PCFForceModel's.
    def IN_TRACK_ACCELERATION_M_S2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 38, 0.0)
    /// True when IN_TRACK_ACCELERATION_M_S2 carries a value; false means absent.
    def HAS_IN_TRACK_ACCELERATION_M_S2() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 40, 0))

