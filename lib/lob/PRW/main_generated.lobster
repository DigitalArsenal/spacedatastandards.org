/// Fixed endpoint propagation. Provider selected by the host's connected port.
class PRWExecutionRequest : flatbuffers.handle
    def INITIAL() -> PRWResidentState:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return PRWResidentState { buf_, assert o }
    def TARGET_EPOCH() -> TIMInstant:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return TIMInstant { buf_, assert o }
    def INTEGRATOR() -> PRWIntegratorSettings:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return PRWIntegratorSettings { buf_, assert o }
    def FORCES() -> PRWForceConfiguration:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return PRWForceConfiguration { buf_, assert o }
    def INCLUDE_STM() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 12, 0))
    def STM_TECHNIQUE() -> prwDerivativeTechnique:
        return prwDerivativeTechnique(flatbuffers.field_uint8(buf_, pos_, 14, 1))
    def DENSITY_TREATMENT() -> prwDensityTreatment:
        return prwDensityTreatment(flatbuffers.field_uint8(buf_, pos_, 16, 1))
    def INITIAL_COVARIANCE() -> PRWStateMatrix?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: PRWStateMatrix { buf_, o } else: nil
    def INITIAL_MASS_COVARIANCE() -> PRWStateMatrix?:
        let o = flatbuffers.field_table(buf_, pos_, 20)
        return if o: PRWStateMatrix { buf_, o } else: nil
    def SAMPLE_EPOCHS(i:int) -> TIMInstant:
        return TIMInstant { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 22) + i * 4) }
    def SAMPLE_EPOCHS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    def IMPULSES(i:int) -> PRWImpulse:
        return PRWImpulse { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 24) + i * 4) }
    def IMPULSES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    /// Explicitly selects 7-state integration even if FINITE_BURNS is empty.
    def INCLUDE_MASS_DYNAMICS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))
    def FINITE_BURNS(i:int) -> PRWFiniteBurn:
        return PRWFiniteBurn { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 28) + i * 4) }
    def FINITE_BURNS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    /// Process noise added to the propagated covariance. Absent means none.
    def PROCESS_NOISE() -> PRWProcessNoise?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: PRWProcessNoise { buf_, o } else: nil
    /// Model parameters appended, in this order and without repeats, to
    /// INITIAL_COVARIANCE and to every sample's STM and COVARIANCE, so a
    /// covariance carries their uncertainty and correlation (a VCM's 7x7 to
