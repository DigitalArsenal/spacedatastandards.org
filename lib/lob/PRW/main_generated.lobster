    def STOP_BY_EVENT() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 12, 0))
    def START_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// True when START_SECONDS carries a value; false means absent.
    def HAS_START_SECONDS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 0))
    def STOP_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// True when STOP_SECONDS carries a value; false means absent.
    def HAS_STOP_SECONDS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 20, 0))
    def START_EPOCH() -> TIMInstant?:
        let o = flatbuffers.field_table(buf_, pos_, 22)
        return if o: TIMInstant { buf_, o } else: nil
    def STOP_EPOCH() -> TIMInstant?:
        let o = flatbuffers.field_table(buf_, pos_, 24)
        return if o: TIMInstant { buf_, o } else: nil
    /// Integral of thrust acceleration magnitude, m/s; not vector net delta-v.
    def DELTA_V_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    def PROPELLANT_KG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)

