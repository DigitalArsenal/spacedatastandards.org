/// Row-major square matrix on [x,y,z,vx,vy,vz,(mass)], then the execution
/// request's DYNAMIC_PARAMETERS in order, SI units (prwDynamicParameter).
/// Covariance entries have row*column units; STM entries row/column units;
/// an STM's parameter rows are the identity (parameters are constant).
class PRWStateMatrix : flatbuffers.handle
    def DIMENSION() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 4, 0)
    def VALUES(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 6) + i * 8)
    def VALUES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)

def GetRootAsPRWStateMatrix(buf:string): return PRWStateMatrix { buf, flatbuffers.indirect(buf, 0) }

