        return if o: FRMVector3 { buf_, o } else: nil
    /// Direction-component change per second, not radians/second.
    def DIRECTION_RATE() -> FRMVector3?:
        let o = flatbuffers.field_table(buf_, pos_, 24)
        return if o: FRMVector3 { buf_, o } else: nil
    def THROTTLE(i:int) -> PRWThrottlePoint:
        return PRWThrottlePoint { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 26) + i * 4) }
    def THROTTLE_length() -> int:
