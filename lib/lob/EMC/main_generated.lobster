    /// 1-sigma uncertainty of the permittivity and conductivity values, in the
    /// units of the quantity they qualify.
    def RELATIVE_PERMITTIVITY_SIGMA() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    def CONDUCTIVITY_SIGMA_S_PER_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    /// Licence terms. Empty means UNKNOWN TERMS — never public domain, never a
    /// grant to redistribute.
    def LICENSE() -> string:
        return flatbuffers.field_string(buf_, pos_, 28)
    def NON_COMMERCIAL_ONLY() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 30, 0))
    def CITATION() -> string:
        return flatbuffers.field_string(buf_, pos_, 32)

def GetRootAsRFSProvenance(buf:string): return RFSProvenance { buf, flatbuffers.indirect(buf, 0) }

