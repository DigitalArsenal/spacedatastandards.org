def RFSStartFREQUENCYSAMPLESVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def RFSCreateFREQUENCYSAMPLESVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

