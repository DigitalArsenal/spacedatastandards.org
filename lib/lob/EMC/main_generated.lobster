/// RF Surface Material
class RFS : flatbuffers.handle
    /// Stable identifier of this material. Joined by
    /// `$RFL.RFLObstruction.MATERIAL_ID` and `$CVP.CVPObstacleRef.MATERIAL_ID`.
    def MATERIAL_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Name as its source states it, verbatim.
    def NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def MATERIAL_CLASS() -> rfsMaterialClass:
        return rfsMaterialClass(flatbuffers.field_int8(buf_, pos_, 8, 0))
    /// Free-text description of the surface, not of its vendor.
    def DESCRIPTION() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// Frequency range over which this record's parameters are valid,
    /// megahertz. A solver MUST refuse to evaluate outside it rather than
    /// extrapolate.
    def FREQUENCY_MIN_MHZ() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    def FREQUENCY_MAX_MHZ() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// relative permittivity = PERMITTIVITY_COEFFICIENT_A * f^PERMITTIVITY_EXPONENT_B
    def PERMITTIVITY_COEFFICIENT_A() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    def PERMITTIVITY_EXPONENT_B() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// conductivity [S/m] = CONDUCTIVITY_COEFFICIENT_C * f^CONDUCTIVITY_EXPONENT_D
    def CONDUCTIVITY_COEFFICIENT_C() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    def CONDUCTIVITY_EXPONENT_D() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// Frequency the scalar values below are stated at, megahertz. Without it
    /// they are uninterpretable.
    def REFERENCE_FREQUENCY_MHZ() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    def RELATIVE_PERMITTIVITY_REAL() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    /// Loss term, stated as a POSITIVE magnitude.
    def RELATIVE_PERMITTIVITY_IMAGINARY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    def CONDUCTIVITY_S_PER_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)
    def LOSS_TANGENT() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, 0.0)
    /// 1.0 and 0.0 for non-magnetic materials — stated, not assumed.
    def RELATIVE_PERMEABILITY_REAL() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, 0.0)
    def RELATIVE_PERMEABILITY_IMAGINARY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 0.0)
    /// Power reflected at normal incidence as a ratio [0-1].
    def REFLECTIVITY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 38, 0.0)
    /// Reflection loss at normal incidence, dB (positive).
    def REFLECTION_LOSS_DB() -> float:
        return flatbuffers.field_float64(buf_, pos_, 40, 0.0)
    /// Thickness the transmission and penetration losses are stated for, metres.
    /// A transmission loss without a thickness cannot be rescaled.
    def THICKNESS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 42, 0.0)
    /// Loss through THICKNESS_M at normal incidence, dB (positive).
    def TRANSMISSION_LOSS_DB() -> float:
        return flatbuffers.field_float64(buf_, pos_, 44, 0.0)
    /// Attenuation inside the material, dB per metre.
    def ATTENUATION_DB_PER_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 46, 0.0)
    /// Fraction of incident power absorbed at normal incidence [0-1].
    def ABSORPTION_COEFFICIENT() -> float:
        return flatbuffers.field_float64(buf_, pos_, 48, 0.0)
    /// RMS surface roughness, metres. Roughness is what decides whether a
    /// surface is a mirror or a scatterer at a given wavelength.
    def SURFACE_ROUGHNESS_RMS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 50, 0.0)
    /// Correlation length of the roughness, metres.
    def ROUGHNESS_CORRELATION_LENGTH_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 52, 0.0)
    def SCATTERING_CLASS() -> rfsScatteringClass:
        return rfsScatteringClass(flatbuffers.field_int8(buf_, pos_, 54, 0))
    /// Fraction of non-absorbed power leaving diffusely [0-1].
    def DIFFUSE_SCATTERING_COEFFICIENT() -> float:
        return flatbuffers.field_float64(buf_, pos_, 56, 0.0)
    /// Backscatter coefficient, dB.
    def BACKSCATTER_COEFFICIENT_DB() -> float:
        return flatbuffers.field_float64(buf_, pos_, 58, 0.0)
    /// Temperature the properties were evaluated at, kelvin.
    def TEMPERATURE_K() -> float:
        return flatbuffers.field_float64(buf_, pos_, 60, 0.0)
    /// Volumetric moisture content [0-1]. Wet concrete and dry concrete are
    /// different materials at RF.
    def MOISTURE_CONTENT_FRACTION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 62, 0.0)
    /// Salinity, practical salinity units, for water surfaces.
    def SALINITY_PSU() -> float:
        return flatbuffers.field_float64(buf_, pos_, 64, 0.0)
    /// Per-frequency samples. Where present and covering the frequency, these
    /// take precedence over the power law.
    def FREQUENCY_SAMPLES(i:int) -> RFSFrequencySample:
        return RFSFrequencySample { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 66) + i * 4) }
    def FREQUENCY_SAMPLES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 66)
    /// Angular and polarization dependence.
    def REFLECTION_TABLE(i:int) -> RFSReflectionEntry:
        return RFSReflectionEntry { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 68) + i * 4) }
    def REFLECTION_TABLE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 68)
    /// Geometry this material is attached to. A record may attach one material
    /// to several obstacles.
    def GEOMETRY(i:int) -> RFSGeometryRef:
        return RFSGeometryRef { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 70) + i * 4) }
    def GEOMETRY_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 70)
    /// Provenance. Required.
    def PROVENANCE() -> RFSProvenance:
        let o = flatbuffers.field_table(buf_, pos_, 72)
        return RFSProvenance { buf_, assert o }
    /// Unix ms this record was serialized.
    def COMPUTED_AT() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 74, 0)
    /// `$EPM` identifier of the producing node.
    def PRODUCER_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 76)
    /// Ed25519 signature by the producing `$EPM`.
    def SIGNATURE(i:int) -> int:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 78) + i * 1)
    def SIGNATURE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 78)

def GetRootAsRFS(buf:string): return RFS { buf, flatbuffers.indirect(buf, 0) }

