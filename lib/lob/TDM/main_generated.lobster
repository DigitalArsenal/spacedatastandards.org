    def add_TRANSMIT_DELAY_2(TRANSMIT_DELAY_2:float):
        b_.PrependFloat64Slot(59, TRANSMIT_DELAY_2, 0.0)
        return this
    def add_TRANSMIT_DELAY_3(TRANSMIT_DELAY_3:float):
        b_.PrependFloat64Slot(60, TRANSMIT_DELAY_3, 0.0)
        return this
    def add_TRANSMIT_DELAY_4(TRANSMIT_DELAY_4:float):
        b_.PrependFloat64Slot(61, TRANSMIT_DELAY_4, 0.0)
