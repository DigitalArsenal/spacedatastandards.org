        return this
    def add_EXECUTION_ERROR_FRACTION(EXECUTION_ERROR_FRACTION:float):
        b_.PrependFloat64Slot(3, EXECUTION_ERROR_FRACTION, 0.0)
        return this
    def add_CYCLES(CYCLES:int):
        b_.PrependUint32Slot(4, CYCLES, 0)
        return this
    def add_ANNUAL_DELTA_V_KM_S(ANNUAL_DELTA_V_KM_S:float):
        b_.PrependFloat64Slot(5, ANNUAL_DELTA_V_KM_S, 0.0)
        return this
    def add_MEAN_CYCLE_DELTA_V_KM_S(MEAN_CYCLE_DELTA_V_KM_S:float):
        b_.PrependFloat64Slot(6, MEAN_CYCLE_DELTA_V_KM_S, 0.0)
        return this
    def add_MAX_CYCLE_DELTA_V_KM_S(MAX_CYCLE_DELTA_V_KM_S:float):
        b_.PrependFloat64Slot(7, MAX_CYCLE_DELTA_V_KM_S, 0.0)
        return this
    def add_CYCLE_DELTA_V_KM_S(CYCLE_DELTA_V_KM_S:flatbuffers.offset):
