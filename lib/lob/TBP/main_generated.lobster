/// Station-keeping budget for a periodic orbit.
class tbpStationKeeping : flatbuffers.handle
    /// The orbit kept (its INITIAL_STATE, PERIOD and JACOBI at least).
    def ORBIT() -> tbpPeriodicOrbit?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: tbpPeriodicOrbit { buf_, o } else: nil
    def STRATEGY() -> tbpStationKeepingStrategy:
        return tbpStationKeepingStrategy(flatbuffers.field_uint8(buf_, pos_, 6, 0))
    /// Navigation (orbit knowledge) error, km, 1 sigma.
    def NAVIGATION_ERROR_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Maneuver execution error, fraction of each burn, 1 sigma.
    def EXECUTION_ERROR_FRACTION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Station-keeping cycles simulated.
    def CYCLES() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 0)
    /// Result: delta-v per year, km/s.
    def ANNUAL_DELTA_V_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// Result: mean and largest delta-v per cycle, km/s.
    def MEAN_CYCLE_DELTA_V_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    def MAX_CYCLE_DELTA_V_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// Result: delta-v of each cycle, km/s.
    def CYCLE_DELTA_V_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 20) + i * 8)
    def CYCLE_DELTA_V_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// Result: true when the orbit stays bounded over the simulation.
    def BOUNDED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 22, 0))

def GetRootAstbpStationKeeping(buf:string): return tbpStationKeeping { buf, flatbuffers.indirect(buf, 0) }

