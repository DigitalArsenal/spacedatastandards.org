/// Options for a propagation.
class tbpPropagationRequest : flatbuffers.handle
    def INITIAL_STATE() -> tbpState?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: tbpState { buf_, o } else: nil
    /// Non-dimensional duration (negative = backwards).
    def DURATION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    /// Non-dimensional integration step; 0 = default.
    def STEP() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Samples in the answer, endpoints included; 0 = default.
    def OUTPUT_POINTS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 10, 0)
    /// Also propagate the state transition matrix.
    def STATE_TRANSITION() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 12, 0))

def GetRootAstbpPropagationRequest(buf:string): return tbpPropagationRequest { buf, flatbuffers.indirect(buf, 0) }

struct tbpPropagationRequestBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(5)
        return this
    def add_INITIAL_STATE(INITIAL_STATE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, INITIAL_STATE)
        return this
    def add_DURATION(DURATION:float):
        b_.PrependFloat64Slot(1, DURATION, 0.0)
        return this
    def add_STEP(STEP:float):
        b_.PrependFloat64Slot(2, STEP, 0.0)
        return this
    def add_OUTPUT_POINTS(OUTPUT_POINTS:int):
        b_.PrependUint32Slot(3, OUTPUT_POINTS, 0)
        return this
    def add_STATE_TRANSITION(STATE_TRANSITION:bool):
        b_.PrependBoolSlot(4, STATE_TRANSITION, 0)
        return this
    def end():
        return b_.EndObject()

/// A transfer into the system.
class tbpTransfer : flatbuffers.handle
    def KIND() -> tbpTransferKind:
        return tbpTransferKind(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    /// Altitude of the circular parking orbit about the larger primary, km.
    def PARKING_ALTITUDE_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    /// Altitude of the final orbit about the smaller primary, km.
    def TARGET_ALTITUDE_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Inclination of the transfer plane, deg.
    def INCLINATION_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// PeriodicOrbitInsertion: the orbit to insert into.
    def TARGET_ORBIT() -> tbpPeriodicOrbit?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: tbpPeriodicOrbit { buf_, o } else: nil
    /// Targeter limits; 0 = default.
    def MAX_ITERATIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)
    def TOLERANCE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// Result: convergence of the targeter.
    def CONVERGED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 18, 0))
    /// Result: departure and arrival burns (their DELTA_V in the axes they
    /// state, km/s; offsets in seconds from departure).
    def BURNS(i:int) -> mplBurn:
        return mplBurn { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 20) + i * 4) }
    def BURNS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// Result: total delta-v, km/s, and time of flight, s.
    def TOTAL_DELTA_V_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    def TIME_OF_FLIGHT_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    /// Result: the transfer trajectory; empty = not sampled.
    def TRAJECTORY() -> tbpTrajectory?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: tbpTrajectory { buf_, o } else: nil

def GetRootAstbpTransfer(buf:string): return tbpTransfer { buf, flatbuffers.indirect(buf, 0) }

