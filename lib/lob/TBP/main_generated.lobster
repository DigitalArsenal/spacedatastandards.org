/// A state converted between the synodic and inertial frames. The inertial
/// frame is centred on the barycentre with its X axis along the synodic X
/// axis at REFERENCE_EPOCH_MS (elapsed time 0) and Z along the system's
/// angular momentum.
class tbpFrameConversion : flatbuffers.handle
    def DIRECTION() -> tbpConversionDirection:
        return tbpConversionDirection(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    /// Unix milliseconds when the two frames are aligned; 0 = relative time
    /// only.
    def REFERENCE_EPOCH_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 6, 0)
    /// Seconds from the alignment to the state.
    def ELAPSED_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// The synodic state (input or result), non-dimensional.
    def SYNODIC() -> tbpState?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: tbpState { buf_, o } else: nil
    /// The inertial state (input or result): km and km/s, 6 values.
    def INERTIAL(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def INERTIAL_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)

def GetRootAstbpFrameConversion(buf:string): return tbpFrameConversion { buf, flatbuffers.indirect(buf, 0) }

struct tbpFrameConversionBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(5)
        return this
    def add_DIRECTION(DIRECTION:tbpConversionDirection):
        b_.PrependUint8Slot(0, DIRECTION, 0)
        return this
    def add_REFERENCE_EPOCH_MS(REFERENCE_EPOCH_MS:int):
        b_.PrependInt64Slot(1, REFERENCE_EPOCH_MS, 0)
        return this
    def add_ELAPSED_S(ELAPSED_S:float):
        b_.PrependFloat64Slot(2, ELAPSED_S, 0.0)
        return this
    def add_SYNODIC(SYNODIC:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, SYNODIC)
        return this
    def add_INERTIAL(INERTIAL:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, INERTIAL)
        return this
    def end():
        return b_.EndObject()

def tbpFrameConversionStartINERTIALVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(8, n_, 8)
def tbpFrameConversionCreateINERTIALVector(b_:flatbuffers.builder, v_:[float]):
    b_.StartVector(8, v_.length, 8)
    reverse(v_) e_: b_.PrependFloat64(e_)
    return b_.EndVector(v_.length)

/// Three-Body Problem - a CR3BP system and one answer about it.
class TBP : flatbuffers.handle
    /// Identifier of the record; empty = not assigned.
    def ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Unix milliseconds the record was produced.
    def CREATED_AT_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 6, 0)
    /// Identifier of the producing service or tool.
    def PRODUCER() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def PROBLEM() -> tbpProblem:
        return tbpProblem(flatbuffers.field_uint8(buf_, pos_, 10, 0))
    def SYSTEM() -> tbpSystem?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: tbpSystem { buf_, o } else: nil
    def STATUS() -> tbpStatus:
        return tbpStatus(flatbuffers.field_uint8(buf_, pos_, 14, 0))
    /// Stable machine-readable reason when STATUS is not Solved.
    def ERROR_CODE() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)
    def ERROR_MESSAGE() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    /// Propagation: the request, and the propagated trajectory.
    def PROPAGATION() -> tbpPropagationRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 20)
        return if o: tbpPropagationRequest { buf_, o } else: nil
    def TRAJECTORY() -> tbpTrajectory?:
        let o = flatbuffers.field_table(buf_, pos_, 22)
        return if o: tbpTrajectory { buf_, o } else: nil
    /// LibrationPoints: L1 to L5.
    def LIBRATION_POINTS(i:int) -> tbpLibrationPoint:
        return tbpLibrationPoint { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 24) + i * 4) }
    def LIBRATION_POINTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    /// JacobiConstant: the state, and its Jacobi constant.
    def STATE() -> tbpState?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: tbpState { buf_, o } else: nil
    def JACOBI() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    /// PeriodicOrbit, HaloFirstGuess, NearRectilinearHalo: the request fields
    /// (FAMILY, LIBRATION_POINT, AMPLITUDE or perilune/apolune, TOLERANCE,
    /// MAX_ITERATIONS) and the result. Family: the members, ordered along the
    /// family's continuation parameter (AMPLITUDE).
    def ORBITS(i:int) -> tbpPeriodicOrbit:
        return tbpPeriodicOrbit { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 30) + i * 4) }
    def ORBITS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    def TRANSFER() -> tbpTransfer?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: tbpTransfer { buf_, o } else: nil
    def STATION_KEEPING() -> tbpStationKeeping?:
        let o = flatbuffers.field_table(buf_, pos_, 34)
        return if o: tbpStationKeeping { buf_, o } else: nil
    def FRAME_CONVERSION() -> tbpFrameConversion?:
        let o = flatbuffers.field_table(buf_, pos_, 36)
        return if o: tbpFrameConversion { buf_, o } else: nil

def GetRootAsTBP(buf:string): return TBP { buf, flatbuffers.indirect(buf, 0) }

