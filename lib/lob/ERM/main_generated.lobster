/// Result of a realism test of one stratum.
class ERMCoverage : flatbuffers.handle
    def N() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 4, 0)
    def OBJECTS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    def VERDICT() -> ermCoverageVerdict:
        return ermCoverageVerdict(flatbuffers.field_uint8(buf_, pos_, 8, 0))
    /// Mean d2 (3 for a realistic covariance); NaN when N is 0.
    def MEAN_D2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, nan)
    /// Fractions inside the 1, 2, 3 sigma regions (3 values).
    def INSIDE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def INSIDE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// PIT histogram fractions (20 values).
    def PIT(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 8)
    def PIT_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    /// Largest gap of the PIT cumulative distribution from uniform.
    def PIT_MAX_CDF_GAP() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, nan)
    /// Samples without a model covariance.
    def MISSING_MODEL() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 18, 0)

