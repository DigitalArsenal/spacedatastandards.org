        return this
    def add_INSIDE(INSIDE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, INSIDE)
        return this
    def add_PIT(PIT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, PIT)
        return this
