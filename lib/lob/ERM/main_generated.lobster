/// The fit of one object. The fitted element set is the companion $OMM.
class ERMElementFit : flatbuffers.handle
    def NORAD_CAT_ID() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 4, 0)
    def OBJECT_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Why the fit failed; empty on success.
    def ERROR() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def STATES_IN_SPAN() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 10, 0)
    def STATES_FITTED() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 0)
    def STATES_WITHOUT_WEIGHTS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)
    def STATES_REJECTED() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 16, 0)
    def STAGES(i:int) -> ERMFitStage:
        return ERMFitStage { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def STAGES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    def ITERATIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 20, 0)
    def CONVERGED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 22, 0))
    def STOP() -> string:
        return flatbuffers.field_string(buf_, pos_, 24)
    def CRITERION() -> string:
        return flatbuffers.field_string(buf_, pos_, 26)
    def RMS() -> ERMResidualStatistics?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: ERMResidualStatistics { buf_, o } else: nil
    def RESIDUALS(i:int) -> ERMResidualSample:
        return ERMResidualSample { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 30) + i * 4) }
    def RESIDUALS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    def CLOSURE() -> ERMClosureTest?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: ERMClosureTest { buf_, o } else: nil
    def WEIGHTED_RMS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, nan)
    def CONDITION_NUMBER() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, nan)
    def COVARIANCE() -> ERMFitCovariance?:
        let o = flatbuffers.field_table(buf_, pos_, 38)
        return if o: ERMFitCovariance { buf_, o } else: nil
    /// Fit epoch, ISO 8601 (microseconds).
    def EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 40)
    /// n (rad/min), af, ag, chi, psi, lambda, B* (7 values).
    def EQUINOCTIAL(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 42) + i * 8)
    def EQUINOCTIAL_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 42)
    def BSTAR_FITTED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 44, 0))
    def BSTAR_INITIAL() -> float:
        return flatbuffers.field_float64(buf_, pos_, 46, 0.0)

