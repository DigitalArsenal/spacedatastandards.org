/// A covariance to map through a state transition.
class ERMMapRequest : flatbuffers.handle
    def NORAD_CAT_ID() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 4, 0)
    /// Anchor set epoch.
    def SET_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Covariance, Lower21 RTN (km, km/s).
    def COVARIANCE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 8) + i * 8)
    def COVARIANCE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Target epochs.
    def TO_EPOCHS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 4)
    def TO_EPOCHS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Covariance epoch; empty = the set epoch.
    def FROM_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    def METHOD() -> ermMapMethod:
        return ermMapMethod(flatbuffers.field_uint8(buf_, pos_, 14, 0))
    /// Report the STM.
    def INCLUDE_STM() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 0))
    /// Set whose state at FROM_EPOCH defines the input axes; empty = the anchor.
    def AXES_SET() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)

def GetRootAsERMMapRequest(buf:string): return ERMMapRequest { buf, flatbuffers.indirect(buf, 0) }

