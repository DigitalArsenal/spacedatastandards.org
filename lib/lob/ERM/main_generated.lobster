/// Covariance of a fit.
class ERMFitCovariance : flatbuffers.handle
    /// Parameters, of "n", "af", "ag", "chi", "psi", "lambda", "bstar".
    def PARAMETERS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 4) + i * 4)
    def PARAMETERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 4)
    /// Equinoctial covariance, lower triangle.
    def EQUINOCTIAL(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 6) + i * 8)
    def EQUINOCTIAL_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    def SCALE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Classical-element covariance, lower 6x6 or 7x7; empty = none.
    def CLASSICAL(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 8)
    def CLASSICAL_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    def CLASSICAL_UNITS() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// Cartesian RSW covariance, Lower21 (km, km/s); empty = none.
    def CARTESIAN_RSW(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 8)
    def CARTESIAN_RSW_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    def CARTESIAN_UNITS() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)

