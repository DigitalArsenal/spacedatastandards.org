        return this
    def add_HISTOGRAMS(HISTOGRAMS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, HISTOGRAMS)
        return this
    def add_CLIPPED(CLIPPED:flatbuffers.offset):
