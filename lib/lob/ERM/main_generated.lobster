/// One stratum of a model.
class ERMModelStratum : flatbuffers.handle
    /// Regime ID.
    def REGIME() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    def REGIME_INDEX() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    def AGE_INDEX() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    /// Age bin, days.
    def AGE_MIN_DAYS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    def AGE_MAX_DAYS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// Samples.
    def N() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 14, 0)
    /// Mean error, 6 values.
    def MEAN(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 8)
    def MEAN_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Sample covariance, Lower21; empty when N < 2.
    def COVARIANCE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 18) + i * 8)
    def COVARIANCE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Quantiles, per component at the model's QUANTILE_PROBABILITIES,
    /// component-major (6 x 7 values).
    def QUANTILES(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 20) + i * 8)
    def QUANTILES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    def MEDIAN(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 22) + i * 8)
    def MEDIAN_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    /// (q84 - q16) / 2 per component.
    def ROBUST_SIGMA(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 24) + i * 8)
    def ROBUST_SIGMA_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    def CLIPPED() -> ERMClippedStatistics?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: ERMClippedStatistics { buf_, o } else: nil
    def COVERAGE() -> ERMCoverage?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: ERMCoverage { buf_, o } else: nil
    /// Absent when unscaled.
    def SCALE() -> ERMStratumScale?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: ERMStratumScale { buf_, o } else: nil
    /// Whether the stratum's covariance passed its realism test.
    def CALIBRATION() -> covarianceCalibration:
        return covarianceCalibration(flatbuffers.field_int8(buf_, pos_, 32, 0))
    /// Identifier of the realism evidence; empty unless calibrated.
    def CALIBRATION_REFERENCE() -> string:
        return flatbuffers.field_string(buf_, pos_, 34)

