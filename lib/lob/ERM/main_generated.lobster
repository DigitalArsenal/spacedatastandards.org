/// Fit settings: shared by every object, and per object.
class ERMFitOptions : flatbuffers.handle
    /// Settings for every object without its own entry in FITS.
    def SHARED() -> ERMFitSettings?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: ERMFitSettings { buf_, o } else: nil
    /// Per-object overrides (NORAD_CAT_ID set); empty = fit every object of
    /// the ephemeris with SHARED.
    def FITS(i:int) -> ERMFitSettings:
        return ERMFitSettings { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 6) + i * 4) }
    def FITS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)

def GetRootAsERMFitOptions(buf:string): return ERMFitOptions { buf, flatbuffers.indirect(buf, 0) }

