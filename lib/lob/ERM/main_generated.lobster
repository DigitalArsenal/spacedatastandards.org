/// An object to give a calibrated covariance.
class ERMCalibrationObject : flatbuffers.handle
    def ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Regime ID, when known.
    def REGIME() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Element set placing it in a regime: NORAD number and epoch.
    def SET_NORAD_CAT_ID() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    def SET_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// Inertial state, m and m/s (3 values each); empty = none.
    def POSITION_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def POSITION_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    def VELOCITY_M_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 8)
    def VELOCITY_M_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    def OBJECT_FACTOR() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 1.0)
    /// Element-set age, days (set models); NaN = none.
    def AGE_DAYS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, nan)
    /// Prediction horizon, days (factor models); NaN = none.
    def HORIZON_DAYS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, nan)
    /// Covariance to scale: 6, 9, 21 or 36 values, SI.
    def COVARIANCE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 22) + i * 8)
    def COVARIANCE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    def COVARIANCE_AXES() -> ermCovarianceAxes:
        return ermCovarianceAxes(flatbuffers.field_uint8(buf_, pos_, 24, 0))

