/// One stage of a fit.
class ERMFitStage : flatbuffers.handle
    /// How the stage started, e.g. "osculating-to-mean", "apriori".
    def START() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Half-width of the stage's span, s; NaN = whole span.
    def HALF_WIDTH_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, nan)
    def STATES() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    def ITERATIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 10, 0)
    def STOP() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    def REJECTED() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)

def GetRootAsERMFitStage(buf:string): return ERMFitStage { buf, flatbuffers.indirect(buf, 0) }

