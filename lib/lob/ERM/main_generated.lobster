/// Running realism test of one stratum.
class ERMCoverageTally : flatbuffers.handle
    def N() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 4, 0)
    /// Samples without a model covariance.
    def MISSING() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 6, 0)
    /// Sum of d2.
    def SUM_D2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Samples inside the 1, 2, 3 sigma regions (3 values).
    def INSIDE(i:int) -> int:
        return read_uint64_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 8)
    def INSIDE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Probability-integral-transform histogram (20 values).
    def PIT(i:int) -> int:
        return read_uint64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def PIT_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// NORAD numbers of the objects sampled.
    def OBJECTS(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 4)
    def OBJECTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)

