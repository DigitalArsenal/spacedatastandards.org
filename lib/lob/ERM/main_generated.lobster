/// Settings of a fit of element sets to an ephemeris (shared, or for one
/// object when NORAD_CAT_ID is set).
class ERMFitSettings : flatbuffers.handle
    /// Object; 0 = the shared settings.
    def NORAD_CAT_ID() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 4, 0)
    def FROM_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def TO_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def EPOCH_CHOICE() -> ermFitEpochChoice:
        return ermFitEpochChoice(flatbuffers.field_uint8(buf_, pos_, 10, 0))
    def EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// Thin the ephemeris to this step, s; 0 = every state.
    def STEP_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    def FIT_BSTAR() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 1))
    /// Fixed B*, 1/earth radii; NaN = the a priori set's, else 0.
    def BSTAR() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, nan)
    /// Take B* from the a priori set.
    def BSTAR_FROM_APRIORI() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 20, 0))
    def WEIGHTING() -> ermFitWeighting:
        return ermFitWeighting(flatbuffers.field_uint8(buf_, pos_, 22, 0))
    def SIGMA_RTN_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 24) + i * 8)
    def SIGMA_RTN_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    /// Fit velocities too.
    def VELOCITY() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))
    def SIGMA_VELOCITY_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.001)
    /// Exponential weighting half-life, hours; 0 = none.
    def HALF_LIFE_HOURS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)
    def TOWARDS() -> ermFitFavour:
        return ermFitFavour(flatbuffers.field_uint8(buf_, pos_, 32, 0))
    def MAX_ITERATIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 34, 100)
    def TOLERANCE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, 1.0e-10)
    def FLOOR_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 38, 1.0e-6)
    def INITIAL() -> ermFitStart:
        return ermFitStart(flatbuffers.field_uint8(buf_, pos_, 40, 0))
    /// Reject residuals beyond this many sigma; 0 = none.
    def REJECT_SIGMA() -> float:
        return flatbuffers.field_float64(buf_, pos_, 42, 0.0)
    /// Scale the fit covariance by the residual variance (default true unless
    /// WEIGHTING is EphemerisCovariance).
    def SCALE_COVARIANCE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 44, 0))
    /// True when SCALE_COVARIANCE carries a value; false means the default.
    def HAS_SCALE_COVARIANCE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 46, 0))
    def RESIDUALS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 48, 0))
    def CLOSURE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 50, 1))
    /// Ephemeris stream to use; -1 = all.
    def EPHEMERIS_STREAM() -> int:
        return flatbuffers.field_int32(buf_, pos_, 52, -1)
    /// Metadata of the fitted OMM.
    def ORIGINATOR() -> string:
        return flatbuffers.field_string(buf_, pos_, 54)
    def CREATION_DATE() -> string:
        return flatbuffers.field_string(buf_, pos_, 56)
    def CLASSIFICATION() -> string:
        return flatbuffers.field_string(buf_, pos_, 58)
    def COMMENT() -> string:
        return flatbuffers.field_string(buf_, pos_, 60)
    def OBJECT_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 62)
    def OBJECT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 64)
    def ELEMENT_SET_NO() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 66, 0)

