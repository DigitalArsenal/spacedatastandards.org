/// An orbit error model.
class ERMModel : flatbuffers.handle
    /// Model identifier (e.g. a calibration version); empty = none.
    def ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Version of the calibration the model freezes; empty = none.
    def CALIBRATION_VERSION() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Name of the candidate or variant, e.g. "S3-KC".
    def CANDIDATE() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def FORM() -> ermModelForm:
        return ermModelForm(flatbuffers.field_uint8(buf_, pos_, 10, 0))
    def BASIS() -> ermErrorBasis:
        return ermErrorBasis(flatbuffers.field_uint8(buf_, pos_, 12, 0))
    /// How the statistics were formed, human-readable.
    def BASIS_TEXT() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Propagator the predictions came from, e.g. "SGP4 (Vallado 2020,
    /// WGS-72, opsmode i)".
    def PROPAGATOR() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)
    def STRATA_SETTINGS() -> ERMStrataSettings?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: ERMStrataSettings { buf_, o } else: nil
    /// Horizons of the realism cells, days.
    def HORIZONS_DAYS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 20) + i * 8)
    def HORIZONS_DAYS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    def COUNTS() -> ERMCounts?:
        let o = flatbuffers.field_table(buf_, pos_, 22)
        return if o: ERMCounts { buf_, o } else: nil
    /// Probabilities of the stratum quantiles (7 values).
    def QUANTILE_PROBABILITIES(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 24) + i * 8)
    def QUANTILE_PROBABILITIES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    /// Model the realism was tested against; empty = none.
    def COVERAGE_MODEL() -> string:
        return flatbuffers.field_string(buf_, pos_, 26)
    def GATE() -> ERMGate?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: ERMGate { buf_, o } else: nil
    def STRATA(i:int) -> ERMModelStratum:
        return ERMModelStratum { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 30) + i * 4) }
    def STRATA_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    def SCALE() -> ERMModelScale?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: ERMModelScale { buf_, o } else: nil
    def CELLS(i:int) -> ERMRealismCell:
        return ERMRealismCell { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 34) + i * 4) }
    def CELLS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    /// ElementSetModel: factors and statuses by stratum.
    def STRATUM_FACTORS(i:int) -> ERMStratumFactor:
        return ERMStratumFactor { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 36) + i * 4) }
    def STRATUM_FACTORS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 36)
    /// ElementSetModel: strata with fewer samples are not used.
    def MINIMUM_BIN_SAMPLES() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 38, 0)
    /// HorizonFactors: the factors.
    def HORIZON_FACTORS(i:int) -> ERMHorizonFactor:
        return ERMHorizonFactor { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 40) + i * 4) }
    def HORIZON_FACTORS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 40)
    /// PropagatorCovariance: per regime.
    def PROPAGATOR_REGIMES(i:int) -> ERMPropagatorRegime:
        return ERMPropagatorRegime { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 42) + i * 4) }
    def PROPAGATOR_REGIMES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 42)
    /// PropagatorCovariance: window of the epoch fit, ISO 8601.
    def EPOCH_WINDOW_START() -> string:
        return flatbuffers.field_string(buf_, pos_, 44)
    def EPOCH_WINDOW_STOP() -> string:
        return flatbuffers.field_string(buf_, pos_, 46)
    def MEASURED_ON() -> ERMMeasuredOn?:
        let o = flatbuffers.field_table(buf_, pos_, 48)
        return if o: ERMMeasuredOn { buf_, o } else: nil
    /// Sources (lineages) the model applies to; empty = any.
    def SOURCES(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 50) + i * 4)
    def SOURCES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 50)
    /// True for a model pooled over all sources.
    def POOLED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 52, 0))
    /// Repository, commit and files the model was derived from.
    def PROVENANCE_REPOSITORY() -> string:
        return flatbuffers.field_string(buf_, pos_, 54)
    def PROVENANCE_COMMIT() -> string:
        return flatbuffers.field_string(buf_, pos_, 56)
    def PROVENANCE_FILES(i:int) -> ERMProvenanceFile:
        return ERMProvenanceFile { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 58) + i * 4) }
    def PROVENANCE_FILES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 58)
    /// Free label, e.g. the model and calibration paths.
    def LABEL() -> string:
        return flatbuffers.field_string(buf_, pos_, 60)

