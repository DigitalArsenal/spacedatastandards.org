    def VELOCITY_ERROR_RTN_M_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 8)
    def VELOCITY_ERROR_RTN_M_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Interpolation of the predicted side: degree, first sample index,
    /// samples; 0 = not interpolated.
    def INTERPOLATION_DEGREE() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 12, 0)
    def INTERPOLATION_FROM() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)
    def INTERPOLATION_SAMPLES() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 16, 0)
    /// Position covariances, Lower6, RTN, m**2; TRUTH_RTN empty = none.
    def PREDICTED_RTN(i:int) -> float:
