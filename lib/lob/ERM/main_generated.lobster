    def BASIS() -> ermErrorBasis:
        return ermErrorBasis(flatbuffers.field_uint8(buf_, pos_, 6, 0))
    /// Clip multiple used, 0 = none.
    def CLIP_K() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    def COUNTS() -> ERMCounts?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: ERMCounts { buf_, o } else: nil
    /// The model tested against, e.g. "reference", "reference+scaled"; empty =
    /// none.
    def COVERAGE_MODEL() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    def STRATA(i:int) -> ERMAccumulatorStratum:
        return ERMAccumulatorStratum { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 14) + i * 4) }
    def STRATA_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)

