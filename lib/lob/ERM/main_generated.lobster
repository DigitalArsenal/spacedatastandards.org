/// One histogram bin: |x| in 20 bins per decade from 1e-9 to 1e5, signed bin
/// number (0 = |x| < 1e-9, +-k for k = 1..280).
class ERMHistogramBin : flatbuffers.handle
    def BIN() -> int:
        return buf_.read_int16_le(pos_ + 0)
    def COUNT() -> int:
        return buf_.read_uint64_le(pos_ + 8)

def CreateERMHistogramBin(b_:flatbuffers.builder, BIN:int, COUNT:int):
    b_.Prep(8, 16)
    b_.PrependUint64(COUNT)
    b_.Pad(6)
    b_.PrependInt16(BIN)
    return b_.Offset()

/// Histogram of one error component.
class ERMHistogram : flatbuffers.handle
    def BINS(i:int) -> ERMHistogramBin:
        return ERMHistogramBin { buf_, flatbuffers.field_vector(buf_, pos_, 4) + i * 16 }
    def BINS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 4)

def GetRootAsERMHistogram(buf:string): return ERMHistogram { buf, flatbuffers.indirect(buf, 0) }

