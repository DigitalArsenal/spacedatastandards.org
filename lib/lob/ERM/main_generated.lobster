/// One side of a predicted-versus-truth pair.
class ERMPairSide : flatbuffers.handle
    /// Epoch (sampled form).
    def EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Position, m, and velocity, m/s, inertial (3 values each).
    def POSITION_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 6) + i * 8)
    def POSITION_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    def VELOCITY_M_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 8) + i * 8)
    def VELOCITY_M_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Covariance: Lower6, 3x3 (9), Lower21 or 6x6 (36), SI; empty = none.
    def COVARIANCE(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 8)
    def COVARIANCE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Summed covariance terms, instead of COVARIANCE.
    def COVARIANCE_TERMS(i:int) -> ERMWeightedCovariance:
        return ERMWeightedCovariance { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 12) + i * 4) }
    def COVARIANCE_TERMS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    def COVARIANCE_AXES() -> ermCovarianceAxes:
        return ermCovarianceAxes(flatbuffers.field_uint8(buf_, pos_, 14, 0))
    /// Samples to interpolate at EPOCH (sampled form).
    def SAMPLES(i:int) -> ERMStateSample:
        return ERMStateSample { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def SAMPLES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    def INTERPOLATION_DEGREE() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 18, 5)

