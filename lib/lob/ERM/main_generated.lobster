/// Element-set fits or residuals against an ephemeris.
class ERMElementFits : flatbuffers.handle
    /// Model, e.g. "SGP4 (Vallado 2020), WGS-72, opsmode i; TEME".
    def MODEL() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// e.g. "model minus ephemeris".
    def RESIDUAL_SIGN() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def UNITS() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def COUNTS() -> ERMCounts?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: ERMCounts { buf_, o } else: nil
    def OPTIONS() -> ERMFitOptions?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: ERMFitOptions { buf_, o } else: nil
    def FITS(i:int) -> ERMElementFit:
        return ERMElementFit { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 14) + i * 4) }
    def FITS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    /// Residual requests; include per-window samples.
    def INCLUDE_SAMPLES() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 0))
    def RESIDUAL_REQUESTS(i:int) -> ERMResidualRequest:
        return ERMResidualRequest { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def RESIDUAL_REQUESTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    def RESIDUAL_RESULTS(i:int) -> ERMResidualResult:
        return ERMResidualResult { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 20) + i * 4) }
