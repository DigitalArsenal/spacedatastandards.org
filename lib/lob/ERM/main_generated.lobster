        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    def MOMENTS() -> ERMMoments?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: ERMMoments { buf_, o } else: nil
    /// One per component (6).
    def HISTOGRAMS(i:int) -> ERMHistogram:
        return ERMHistogram { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 10) + i * 4) }
    def HISTOGRAMS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Moments after clipping (when clipping).
    def CLIPPED() -> ERMMoments?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: ERMMoments { buf_, o } else: nil
    /// Realism tally (when a model is tested).
    def COVERAGE() -> ERMCoverageTally?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: ERMCoverageTally { buf_, o } else: nil

