/// One planned maneuver checked against the versions.
class MDEPlannedCheck : flatbuffers.handle
    /// The plan's maneuver ID.
    def ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Planned ignition, Unix ms.
    def TIG_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 6, 0)
    /// Planned delta-v, m/s.
    def PLANNED_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// EXECUTED, CANCELLED or UNKNOWN.
    def STATUS() -> maneuverStatus:
        return maneuverStatus(flatbuffers.field_int8(buf_, pos_, 10, 6))
    /// Group of plans checked together, Unix ms.
    def GROUP_START_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 12, 0)
    def GROUP_STOP_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 14, 0)
    /// Why it could not be decided; empty otherwise.
    def DETAIL() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)
    /// Pre-burn and post-burn version descriptions; empty = none.
    def PRE() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    def POST() -> string:
        return flatbuffers.field_string(buf_, pos_, 20)
    /// Window compared, Unix ms.
    def WINDOW_START_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 22, 0)
    def WINDOW_STOP_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 24, 0)
    /// Semi-major axis change the plan models, km.
    def MODELED_DELTA_SMA_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, nan)
    /// Post-burn minus pre-burn semi-major axis, km.
    def POST_MINUS_PRE_SMA_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, nan)
    /// Executed semi-major axis change, km.
    def EXECUTED_DELTA_SMA_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, nan)
    /// Executed in-track and cross-track delta-v, m/s.
    def EXECUTED_IN_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, nan)
    def EXECUTED_CROSS_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, nan)
    /// Cross-track delta-v the plan models, m/s.
    def MODELED_CROSS_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 36, nan)
    /// Post minus pre cross-track, m/s.
    def POST_MINUS_PRE_CROSS_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 38, nan)

