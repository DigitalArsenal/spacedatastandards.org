/// A known maneuver and the detection matched to it (if any).
class MDETruthMatch : flatbuffers.handle
    def OBJECT_KEY() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// The known maneuver's ID and time, Unix ms.
    def ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def TIME_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 8, 0)
    /// Known delta-v and its in-track part, m/s.
    def DV_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, nan)
    def IN_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, nan)
    /// The matched detection's ID and time; empty and 0 for a miss.
    def EVENT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    def EVENT_TIME_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 16, 0)
    /// Detection minus truth time, s; NaN for a miss.
    def TIME_ERROR_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, nan)
    def EVENT_DV_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, nan)
    def EVENT_IN_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, nan)
    def DV_RATIO() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, nan)
    def IN_TRACK_RATIO() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, nan)

def GetRootAsMDETruthMatch(buf:string): return MDETruthMatch { buf, flatbuffers.indirect(buf, 0) }

