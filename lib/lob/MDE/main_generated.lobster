        let o = flatbuffers.field_table(buf_, pos_, 20)
        return if o: MDEDistribution { buf_, o } else: nil
    /// Detected over known in-track delta-v; absent when none.
    def IN_TRACK_RATIO() -> MDEDistribution?:
        let o = flatbuffers.field_table(buf_, pos_, 22)
        return if o: MDEDistribution { buf_, o } else: nil
    def UNMATCHED_EVENTS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 24, 0)
    /// Unmatched detections inside explained spans.
    def EXPLAINED() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 26, 0)
    def FALSE_ALARMS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 28, 0)
    /// Object-years assessed.
    def OBJECT_YEARS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)
    def FALSE_ALARMS_PER_OBJECT_YEAR() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, nan)

