        return this
    def add_MATCHES(MATCHES:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, MATCHES)
        return this
    def add_MISSED(MISSED:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, MISSED)
        return this
    def add_UNMATCHED(UNMATCHED:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, UNMATCHED)
        return this
    def end():
        return b_.EndObject()

