/// Result of a detection run.
class MDEDetectReport : flatbuffers.handle
    def STATUS() -> mdeRunStatus:
        return mdeRunStatus(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    /// Window requests emitted (NeedsPropagation).
    def QUERIES() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    def DUPLICATE_EPOCHS(i:int) -> MDEDuplicateEpoch:
        return MDEDuplicateEpoch { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 8) + i * 4) }
    def DUPLICATE_EPOCHS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// The options used, defaults filled in.
    def OPTIONS() -> MDEDetectOptions?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: MDEDetectOptions { buf_, o } else: nil
    def OBJECTS(i:int) -> MDEObjectDetection:
        return MDEObjectDetection { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 12) + i * 4) }
    def OBJECTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    def OBJECTS_SCREENED() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)
    def REFUSED_SETS(i:int) -> MDERefusedSet:
        return MDERefusedSet { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def REFUSED_SETS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Events emitted over all objects.
    def DETECTIONS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 18, 0)

