/// One comparison of two versions (or one version with itself).
class MDEVersionChange : flatbuffers.handle
    /// Older and newer version descriptions; WITHIN names the version for a
    /// WithinVersion change.
    def OLDER() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    def NEWER() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def WITHIN() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def MODE() -> mdeComparisonMode:
        return mdeComparisonMode(flatbuffers.field_uint8(buf_, pos_, 10, 0))
    /// Why there was no comparison; empty otherwise.
    def DETAIL() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// Window compared, Unix ms.
    def WINDOW_START_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 14, 0)
    def WINDOW_STOP_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 16, 0)
    /// Semi-major axis change, km.
    def DELTA_SMA_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, nan)
    /// In-track and cross-track equivalent delta-v, m/s.
    def IN_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, nan)
    def CROSS_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, nan)
    /// Gap between adjacent versions, s.
    def GAP_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, nan)

