        return this
    def end():
        return b_.EndObject()

/// Result of scoring detections.
class MDEScoreReport : flatbuffers.handle
    def OPTIONS() -> MDEScoreOptions?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: MDEScoreOptions { buf_, o } else: nil
    def SUMMARY() -> MDEScoreSummary?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: MDEScoreSummary { buf_, o } else: nil
    def MATCHES(i:int) -> MDETruthMatch:
        return MDETruthMatch { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 8) + i * 4) }
    def MATCHES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Known maneuvers not detected (EVENT fields empty).
    def MISSED(i:int) -> MDETruthMatch:
        return MDETruthMatch { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 10) + i * 4) }
    def MISSED_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    def UNMATCHED(i:int) -> MDEUnmatchedEvent:
        return MDEUnmatchedEvent { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 12) + i * 4) }
    def UNMATCHED_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)

def GetRootAsMDEScoreReport(buf:string): return MDEScoreReport { buf, flatbuffers.indirect(buf, 0) }

