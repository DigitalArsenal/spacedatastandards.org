/// One object screened.
class MDEObjectDetection : flatbuffers.handle
    /// Object key: "NORAD:<n>", else OBJECT_ID, else OBJECT_NAME.
    def OBJECT_KEY() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    def NORAD_CAT_ID() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    /// Element sets in its history.
    def ELEMENT_SETS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    /// Frame the history was screened in, e.g. "TEMEOFDATE", "EME2000".
    def FRAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    def STATUS() -> mdeObjectStatus:
        return mdeObjectStatus(flatbuffers.field_uint8(buf_, pos_, 12, 0))
    /// Why the history was insufficient; empty otherwise.
    def DETAIL() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Crossing pairs (when REPORT_PAIRS).
    def PAIRS(i:int) -> MDECrossingPair:
        return MDECrossingPair { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def PAIRS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Level series (when REPORT_LEVELS).
    def LEVELS(i:int) -> MDELevel:
        return MDELevel { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def LEVELS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Every event each enabled detector raised, before combining.
    def DETECTOR_EVENTS(i:int) -> MDEEvent:
        return MDEEvent { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 20) + i * 4) }
    def DETECTOR_EVENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// The events emitted (one $MNV each).
    def EVENTS(i:int) -> MDEEvent:
        return MDEEvent { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 22) + i * 4) }
    def EVENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)

