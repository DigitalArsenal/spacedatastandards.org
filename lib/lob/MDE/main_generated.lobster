/// Settings of a comparison of ephemeris versions.
class MDECompareOptions : flatbuffers.handle
    /// Report time, Unix ms; 0 = from the versions.
    def REPORT_TIME_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 4, 0)
    /// Also look for changes inside one version.
    def WITHIN_VERSION() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 6, 0))
    /// Margin around a planned ignition, s.
    def MARGIN_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 600.0)
    /// The post-burn version must start this long after ignition, s.
    def POST_START_AFTER_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 3600.0)
    /// Fraction of the planned change that marks EXECUTED.
    def EXECUTED_FRACTION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.5)
    /// Fraction below which the plan is CANCELLED (<= EXECUTED_FRACTION).
    def CANCELLED_FRACTION() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.25)
    /// Semi-major axis change that flags an unplanned change, km; NaN = off.
    def UNPLANNED_THRESHOLD_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, nan)

def GetRootAsMDECompareOptions(buf:string): return MDECompareOptions { buf, flatbuffers.indirect(buf, 0) }

