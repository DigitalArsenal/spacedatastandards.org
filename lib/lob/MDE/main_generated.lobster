/// Maneuver Detection Evidence - exactly one arm is set.
class MDE : flatbuffers.handle
    def DETECT_OPTIONS() -> MDEDetectOptions?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: MDEDetectOptions { buf_, o } else: nil
    def DETECT_REPORT() -> MDEDetectReport?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: MDEDetectReport { buf_, o } else: nil
    def COMPARE_OPTIONS() -> MDECompareOptions?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: MDECompareOptions { buf_, o } else: nil
    def COMPARE_REPORT() -> MDECompareReport?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: MDECompareReport { buf_, o } else: nil
    def SCORE_OPTIONS() -> MDEScoreOptions?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: MDEScoreOptions { buf_, o } else: nil
    def SCORE_REPORT() -> MDEScoreReport?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: MDEScoreReport { buf_, o } else: nil

