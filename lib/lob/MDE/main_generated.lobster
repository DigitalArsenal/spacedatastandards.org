/// Settings of scoring detections against known maneuvers.
class MDEScoreOptions : flatbuffers.handle
    /// A detection up to this long before a known maneuver matches, s.
    def BEFORE_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, 21600.0)
    /// A detection up to this long after a known maneuver matches, s.
    def AFTER_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 129600.0)
    /// Delta-v bin edges for recall, increasing, m/s; empty = 0.05, 0.2, 1.0.
    def BINS_M_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 8) + i * 8)
    def BINS_M_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Spans where an unmatched detection is explained (not a false alarm).
    def EXPLAINED(i:int) -> MDEObjectSpan:
        return MDEObjectSpan { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 10) + i * 4) }
    def EXPLAINED_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    /// Spans where truth is complete (false alarms count only here).
    def ASSESSED(i:int) -> MDEObjectSpan:
        return MDEObjectSpan { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 12) + i * 4) }
    def ASSESSED_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// Spans of observation of each object (object-years).
    def SPANS(i:int) -> MDEObjectSpan:
        return MDEObjectSpan { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 14) + i * 4) }
    def SPANS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)

