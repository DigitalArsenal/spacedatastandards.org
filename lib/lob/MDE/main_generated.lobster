        b_.PrependFloat64Slot(7, TIME_ERROR_S, nan)
        return this
    def add_EVENT_DV_M_S(EVENT_DV_M_S:float):
        b_.PrependFloat64Slot(8, EVENT_DV_M_S, nan)
        return this
    def add_EVENT_IN_TRACK_M_S(EVENT_IN_TRACK_M_S:float):
        b_.PrependFloat64Slot(9, EVENT_IN_TRACK_M_S, nan)
        return this
    def add_DV_RATIO(DV_RATIO:float):
        b_.PrependFloat64Slot(10, DV_RATIO, nan)
        return this
    def add_IN_TRACK_RATIO(IN_TRACK_RATIO:float):
        b_.PrependFloat64Slot(11, IN_TRACK_RATIO, nan)
        return this
    def end():
        return b_.EndObject()

/// A detection matched to no known maneuver.
class MDEUnmatchedEvent : flatbuffers.handle
    def OBJECT_KEY() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    def ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def TIME_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 8, 0)
    def DV_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, nan)
    def IN_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, nan)
    def CROSS_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, nan)
    /// Inside an explained span.
    def EXPLAINED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 0))
    /// Inside an assessed span (a false alarm when not explained).
    def ASSESSED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 18, 0))

