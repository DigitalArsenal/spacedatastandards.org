    b_:flatbuffers.builder
    def start():
        b_.StartObject(12)
        return this
    def add_OBJECT_KEY(OBJECT_KEY:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, OBJECT_KEY)
        return this
    def add_ID(ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, ID)
        return this
    def add_TIME_MS(TIME_MS:int):
        b_.PrependInt64Slot(2, TIME_MS, 0)
        return this
    def add_DV_M_S(DV_M_S:float):
        b_.PrependFloat64Slot(3, DV_M_S, nan)
        return this
    def add_IN_TRACK_M_S(IN_TRACK_M_S:float):
        b_.PrependFloat64Slot(4, IN_TRACK_M_S, nan)
        return this
    def add_EVENT_ID(EVENT_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(5, EVENT_ID)
        return this
    def add_EVENT_TIME_MS(EVENT_TIME_MS:int):
        b_.PrependInt64Slot(6, EVENT_TIME_MS, 0)
        return this
