/// One event a detector raised.
class MDEEvent : flatbuffers.handle
    def DETECTOR() -> mdeDetector:
        return mdeDetector(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    /// Event time, Unix ms.
    def TIME_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 6, 0)
    def CHARACTERIZATION() -> maneuverCharacterization:
        return maneuverCharacterization(flatbuffers.field_int8(buf_, pos_, 8, 9))
    /// In-track delta-v, m/s; 0 unless its test fired.
    def IN_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Cross-track delta-v, m/s; 0 unless its test fired.
    def CROSS_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    def IN_TRACK_FIRED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 14, 0))
    def CROSS_TRACK_FIRED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 0))
    /// In-track and cross-track estimates before the firing rule, m/s.
    def RAW_IN_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    def RAW_CROSS_TRACK_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    /// Semi-major axis change, km.
    def DELTA_SMA_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// Separation at the crossing, km.
    def SEPARATION_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    /// True when TIME_MS is a crossing time (else a gap middle).
    def TIME_FROM_CROSSING() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))
    /// Indices of the history blocks (element sets or versions) before and
    /// after the event.
    def BLOCK_BEFORE() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 28, 0)
    def BLOCK_AFTER() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 30, 0)
    def EVIDENCE() -> MDEEvidence?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: MDEEvidence { buf_, o } else: nil
    /// D3: change of along-track acceleration, m/s**2; NaN = not computed.
    def ACCEL_CHANGE_M_S2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, nan)
    /// ID of the $MNV record emitted for the event; empty when not emitted.
    def MNV_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 36)

def GetRootAsMDEEvent(buf:string): return MDEEvent { buf, flatbuffers.indirect(buf, 0) }

