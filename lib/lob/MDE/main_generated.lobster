/// Scoring summary.
class MDEScoreSummary : flatbuffers.handle
    /// Known maneuvers.
    def TRUTH() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 4, 0)
    /// Detections scored.
    def EVENTS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    /// Known maneuvers detected.
    def DETECTED() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    def RECALL() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, nan)
    def WILSON95_LOW() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, nan)
    def WILSON95_HIGH() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, nan)
    def BY_DELTA_V(i:int) -> MDERecallBin:
        return MDERecallBin { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def BY_DELTA_V_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Absolute time error of matches, s; absent when none.
    def TIME_ERROR_ABS_S() -> MDEDistribution?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: MDEDistribution { buf_, o } else: nil
    /// Detected over known delta-v; absent when none.
