        return this
    def add_EXCESS_LOSS_DB(EXCESS_LOSS_DB:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(9, EXCESS_LOSS_DB)
        return this
    def add_LINK_MARGIN_DB(LINK_MARGIN_DB:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(10, LINK_MARGIN_DB)
        return this
    def add_DIFFRACTION_PARAMETER(DIFFRACTION_PARAMETER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(11, DIFFRACTION_PARAMETER)
        return this
    def add_REFLECTION_CONTRIBUTION_DB(REFLECTION_CONTRIBUTION_DB:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(12, REFLECTION_CONTRIBUTION_DB)
        return this
    def add_TRACE_ID(TRACE_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(13, TRACE_ID)
        return this
    def end():
        return b_.EndObject()

def TRSResultStartVISIBLEMASKVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(1, n_, 1)
def TRSResultCreateVISIBLEMASKVector(b_:flatbuffers.builder, v_:[int]):
    b_.StartVector(1, v_.length, 1)
    reverse(v_) e_: b_.PrependUint8(e_)
    return b_.EndVector(v_.length)

