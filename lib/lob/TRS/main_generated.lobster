    /// Exactly -10.0 where no finite v exists (an unobstructed, Fresnel-clear
    /// path) — the layer's stated no-finite-v encoding, carried verbatim so
    /// the FlatBuffer and aligned-binary forms stay byte-comparable.
    def DIFFRACTION_PARAMETER(i:int) -> float:
        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 26) + i * 4)
    def DIFFRACTION_PARAMETER_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)
    /// Specular ground-bounce contribution, dB. All zeros outside the
    /// SPECULAR_SINGLE_BOUNCE tier.
    def REFLECTION_CONTRIBUTION_DB(i:int) -> float:
        return read_float32_le(buf_, buf_.flatbuffers.field_vector(pos_, 28) + i * 4)
    def REFLECTION_CONTRIBUTION_DB_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    /// Caller trace/correlation identifier copied from the request when
    /// present.
    def TRACE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 30)

def GetRootAsTRSResult(buf:string): return TRSResult { buf, flatbuffers.indirect(buf, 0) }

struct TRSResultBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(14)
        return this
    def add_STATUS(STATUS:trsResultStatus):
        b_.PrependInt8Slot(0, STATUS, 0)
        return this
    def add_ERROR_MESSAGE(ERROR_MESSAGE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, ERROR_MESSAGE)
        return this
    def add_GRID_WIDTH(GRID_WIDTH:int):
        b_.PrependUint32Slot(2, GRID_WIDTH, 0)
        return this
    def add_GRID_HEIGHT(GRID_HEIGHT:int):
        b_.PrependUint32Slot(3, GRID_HEIGHT, 0)
        return this
    def add_VISIBLE_MASK(VISIBLE_MASK:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, VISIBLE_MASK)
        return this
    def add_OCCLUDED_MASK(OCCLUDED_MASK:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(5, OCCLUDED_MASK)
        return this
    def add_POSITIVE_LINK_MASK(POSITIVE_LINK_MASK:flatbuffers.offset):
