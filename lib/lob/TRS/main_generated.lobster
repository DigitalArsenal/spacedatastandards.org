/// Terrain raster solve envelope.
class TRS : flatbuffers.handle
    def REQUEST() -> TRSRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: TRSRequest { buf_, o } else: nil
    def RESULT() -> TRSResult?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: TRSResult { buf_, o } else: nil

def GetRootAsTRS(buf:string): return TRS { buf, flatbuffers.indirect(buf, 0) }

struct TRSBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(2)
        return this
    def add_REQUEST(REQUEST:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, REQUEST)
        return this
    def add_RESULT(RESULT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, RESULT)
        return this
    def end():
        return b_.EndObject()
