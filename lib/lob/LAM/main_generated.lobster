    def FLIGHT_PATH_ANGLE_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 86)
    /// Instantaneous impact point latitude samples in degrees.
    def IIP_LATITUDE_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 88) + i * 8)
    def IIP_LATITUDE_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 88)
    /// Instantaneous impact point longitude samples in degrees.
    def IIP_LONGITUDE_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 90) + i * 8)
    def IIP_LONGITUDE_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 90)
    /// Maximum dynamic pressure in pascals.
    def MAX_DYNAMIC_PRESSURE_PA() -> float:
        return flatbuffers.field_float64(buf_, pos_, 92, 0.0)
    /// Epoch of maximum dynamic pressure in ISO 8601 UTC format.
    def MAX_DYNAMIC_PRESSURE_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 94)
    /// Maximum heat flux in watts per square meter.
    def MAX_HEAT_FLUX_W_PER_M2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 96, 0.0)
    /// Epoch of maximum heat flux in ISO 8601 UTC format.
    def MAX_HEAT_FLUX_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 98)
    /// Orbit insertion epoch in ISO 8601 UTC format.
    def ORBIT_INSERTION_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 100)
    /// Achieved apoapsis in meters.
    def APOAPSIS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 102, 0.0)
    /// Achieved periapsis in meters.
    def PERIAPSIS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 104, 0.0)
    /// Achieved inclination in degrees.
    def INCLINATION_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 106, 0.0)
    /// Payload injection velocity error in meters per second.
    def PAYLOAD_INJECTION_ERROR_M_PER_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 108, 0.0)
    /// Key ascent events.
    def ASCENT_EVENTS(i:int) -> lamAscentEvent:
        return lamAscentEvent { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 110) + i * 4) }
    def ASCENT_EVENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 110)
    /// Constraint warnings and violations.
    def CONSTRAINT_VIOLATIONS(i:int) -> lamConstraintViolation:
        return lamConstraintViolation { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 112) + i * 4) }
    def CONSTRAINT_VIOLATIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 112)
    /// Free-form model assumptions or limitations.
    def ASSUMPTIONS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 114) + i * 4)
    def ASSUMPTIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 114)
    /// Additional comments.
    def COMMENT() -> string:
        return flatbuffers.field_string(buf_, pos_, 116)
    /// Orbit the launch is steered to.
    def TARGET_ORBIT() -> lamTargetOrbit?:
        let o = flatbuffers.field_table(buf_, pos_, 118)
        return if o: lamTargetOrbit { buf_, o } else: nil
    /// Origin of the trajectory samples.
    def TRAJECTORY_SOURCE() -> lamTrajectorySource:
        return lamTrajectorySource(flatbuffers.field_int8(buf_, pos_, 120, 0))
    /// Frame of SPEED_M_PER_S samples.
    def SPEED_REFERENCE() -> lamSpeedReference:
        return lamSpeedReference(flatbuffers.field_int8(buf_, pos_, 122, 0))
    /// Orbit at insertion.
    def INSERTION() -> lamInsertionOrbit?:
        let o = flatbuffers.field_table(buf_, pos_, 124)
        return if o: lamInsertionOrbit { buf_, o } else: nil
    /// Periapsis altitude of each sample's osculating orbit above the WGS-84 equatorial radius, in meters.
    def INSTANTANEOUS_PERIAPSIS_ALTITUDE_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 126) + i * 8)
    def INSTANTANEOUS_PERIAPSIS_ALTITUDE_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 126)
    /// Apoapsis altitude of each sample's osculating orbit above the WGS-84 equatorial radius, in meters.
    def INSTANTANEOUS_APOAPSIS_ALTITUDE_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 128) + i * 8)
    def INSTANTANEOUS_APOAPSIS_ALTITUDE_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 128)
    /// Liftoff epochs, ISO 8601 UTC, at which the ascent joins the TARGET_ORBIT reference plane.
    def IN_PLANE_LIFTOFF_EPOCHS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 130) + i * 4)
    def IN_PLANE_LIFTOFF_EPOCHS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 130)

def GetRootAsLAM(buf:string): return LAM { buf, flatbuffers.indirect(buf, 0) }

