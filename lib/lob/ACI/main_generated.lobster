    def LINK_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Index into the link's RFLLink.MODCOD_SET.
    def MODCOD_INDEX() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    /// Stable RFLModCod.MODCOD_ID copied for queryability across records.
    def MODCOD_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    def DURATION_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    def DATA_VOLUME_BITS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    def MEAN_DATA_RATE_BPS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    def SAMPLE_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 18, 0)

