/// Access Interval
class ACI : flatbuffers.handle
    /// Stable identifier of this interval set.
    def ACI_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Display name.
    def NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Analysis or scenario grouping identifier shared with the `$RFL` samples
    /// and `$CVP` geometry of the same study.
    def SCENARIO_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    /// `$RFL.RFL_ID` these intervals were derived from, when they were derived
    /// from a published sample set. Absent for measured or scheduled intervals.
    def RFL_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// The intervals.
    def INTERVALS(i:int) -> ACIInterval:
        return ACIInterval { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 12) + i * 4) }
    def INTERVALS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// Analysis window, seconds since 1970-01-01T00:00:00 in TIME_SYSTEM. An
    /// interval set states its window so "no intervals" can be distinguished
    /// from "not analysed".
    def WINDOW_START() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    def WINDOW_STOP() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// Time scale all epochs in this record are expressed in. Defaults to UTC
    /// explicitly: `timingStandard` ordinal 0 is GMST.
    def TIME_SYSTEM() -> timingStandard:
        return timingStandard(flatbuffers.field_int8(buf_, pos_, 18, 11))
    /// Provenance. Required.
    def PROVENANCE() -> ACIProvenance:
        let o = flatbuffers.field_table(buf_, pos_, 20)
        return ACIProvenance { buf_, assert o }
    /// Unix ms this record was serialized.
    def COMPUTED_AT() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 22, 0)
    /// `$EPM` identifier of the producing node.
    def PRODUCER_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 24)
    /// Ed25519 signature by the producing `$EPM` over the size-prefixed
    /// FlatBuffer projection with both 64-byte signature payloads zeroed while
    /// preserving their vectors and offsets.
    def SIGNATURE(i:int) -> int:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 26) + i * 1)
    def SIGNATURE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)
    /// Ed25519 signature by the producing `$EPM` over canonical JSON with IDL
    /// field order, IDL capitalization, no insignificant whitespace, and both
    /// signature fields omitted.
    def CANONICAL_JSON_SIGNATURE(i:int) -> int:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 28) + i * 1)
    def CANONICAL_JSON_SIGNATURE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    /// Per-interval delivered volume grouped by selected modulation-and-coding
    /// entry. The sum for an interval equals ACIInterval.DATA_VOLUME_BITS.
    def DATA_VOLUME_BY_MODCOD(i:int) -> ACIDataVolumeByModCod:
        return ACIDataVolumeByModCod { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 30) + i * 4) }
    def DATA_VOLUME_BY_MODCOD_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)

def GetRootAsACI(buf:string): return ACI { buf, flatbuffers.indirect(buf, 0) }

