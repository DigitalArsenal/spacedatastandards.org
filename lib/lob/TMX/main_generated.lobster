        return flatbuffers.field_string(buf_, pos_, 6)
    /// Optional NORAD catalog number of the affected asset.
    def NORAD_CAT_ID() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    /// Optional ground site or gateway identifier.
    def SITE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// Co-occurring phenomenologies participating in the overlap.
    def PHENOMENOLOGIES(i:int) -> tmxPhenomenologyKind:
        return tmxPhenomenologyKind(read_int8_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 1))
    def PHENOMENOLOGIES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
