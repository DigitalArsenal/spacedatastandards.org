    /// Final composite score in basis points (0..10000).
    def COMPOSITE_SCORE() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 8, 0)
    /// Pre-bonus weighted average score in basis points (0..10000).
    def BASE_WEIGHTED_SCORE() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 10, 0)
    /// Compound overlap bonus applied in basis points.
    def COMPOUND_BONUS_APPLIED_BPS() -> int:
