    def MEMBER_EVENT_REFS(i:int) -> TMXRecordRef:
        return TMXRecordRef { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 14) + i * 4) }
    def MEMBER_EVENT_REFS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    /// Inclusive overlap window start, RFC 3339 UTC.
    def OVERLAP_START_UTC() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)
    /// Exclusive overlap window end, RFC 3339 UTC.
    def OVERLAP_END_UTC() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    /// Applied compound multiplier in basis points.
    def COMPOUND_MULTIPLIER_BPS() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 20, 0)
    /// Applied compound bonus in basis points.
    def COMPOUND_BONUS_BPS() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 22, 0)
    /// Final deterministic combined score in basis points (0..10000).
    def COMBINED_SCORE() -> int:
        return flatbuffers.field_uint16(buf_, pos_, 24, 0)
    /// Resulting categorical severity tier.
    def SEVERITY_TIER() -> tmxSeverityLevel:
        return tmxSeverityLevel(flatbuffers.field_int8(buf_, pos_, 26, 2))

