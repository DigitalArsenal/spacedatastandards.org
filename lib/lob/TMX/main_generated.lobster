/// Multi-Phenomenology Threat Matrix
class TMX : flatbuffers.handle
    /// Unique run identifier for this threat matrix assessment.
    def RUN_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Creation timestamp of this chunk/run, RFC 3339 UTC.
    def CREATED_UTC() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Inclusive analysis window start, RFC 3339 UTC.
    def WINDOW_START() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    /// Exclusive analysis window end, RFC 3339 UTC.
    def WINDOW_END() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// Ephemeris propagator theory used for this run.
    def PROPAGATOR() -> tmxPropagatorKind:
        return tmxPropagatorKind(flatbuffers.field_int8(buf_, pos_, 12, 1))
    /// Canonical propagator module identifier.
    def PROPAGATOR_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Execution host that computed this matrix.
    def EXECUTION_HOST() -> tmxExecutionHostKind:
        return tmxExecutionHostKind(flatbuffers.field_int8(buf_, pos_, 16, 1))
    /// Deterministic scoring profile identifier.
    def SCORING_PROFILE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    /// Zero-based streaming chunk index for progressive delivery.
    def CHUNK_INDEX() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 20, 0)
    /// True on the final chunk of a streamed matrix run.
    def IS_FINAL_CHUNK() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 22, 1))
    /// Originating TMXRequest configuration for reproducibility.
    def REQUEST() -> TMXRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 24)
        return if o: TMXRequest { buf_, o } else: nil
    /// Configured phenomenology weights and severity thresholds.
    def PHENOMENOLOGY_WEIGHTS(i:int) -> TMXPhenomenologyWeight:
        return TMXPhenomenologyWeight { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 26) + i * 4) }
    def PHENOMENOLOGY_WEIGHTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)
    /// Configured compound overlap multiplier/bonus rules.
    def COMPOUND_MULTIPLIERS(i:int) -> TMXCompoundRule:
        return TMXCompoundRule { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 28) + i * 4) }
    def COMPOUND_MULTIPLIERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    /// Target aggregation buckets included in this run.
    def TARGET_BUCKETS(i:int) -> TMXBucket:
        return TMXBucket { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 30) + i * 4) }
    def TARGET_BUCKETS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 30)
    /// Per-phenomenology module execution records.
    def PHENOMENOLOGIES_RUN(i:int) -> TMXModuleRun:
        return TMXModuleRun { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 32) + i * 4) }
    def PHENOMENOLOGIES_RUN_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 32)
    /// Evaluated matrix cells (bucket x phenomenology).
    def CELLS(i:int) -> TMXCell:
        return TMXCell { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 34) + i * 4) }
    def CELLS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    /// Detected multi-phenomenology compound overlap events.
    def COMPOUND_EVENTS(i:int) -> TMXCompoundEvent:
        return TMXCompoundEvent { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 36) + i * 4) }
    def COMPOUND_EVENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 36)
    /// Deterministic composite rollups per bucket.
    def ROLLUPS(i:int) -> TMXRollup:
        return TMXRollup { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 38) + i * 4) }
    def ROLLUPS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 38)

