        return SRGProvider { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 14) + i * 4) }
    def PROVIDERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    /// Resources, in retrieval order. A single job carries one.
    def RESOURCES(i:int) -> SRGResource:
        return SRGResource { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def RESOURCES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    def RECEIPTS(i:int) -> SRGContentReceipt:
        return SRGContentReceipt { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def RECEIPTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    def STATUS() -> SRGRetrievalStatus?:
        let o = flatbuffers.field_table(buf_, pos_, 20)
        return if o: SRGRetrievalStatus { buf_, o } else: nil
    def SETTINGS() -> SRGRetrievalSettings?:
        let o = flatbuffers.field_table(buf_, pos_, 22)
        return if o: SRGRetrievalSettings { buf_, o } else: nil

def GetRootAsSRG(buf:string): return SRG { buf, flatbuffers.indirect(buf, 0) }

