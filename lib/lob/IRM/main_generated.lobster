    /// Everything needed to decode the chunk at NEXT_OFFSET. REQUIRED in practice
    /// whenever NEXT_OFFSET is past the source's own header; a consumer that finds
    /// it absent there restarts from offset 0 rather than decoding blind.
    def DECODE_CONTEXT() -> IRMDecodeContext?:
        let o = flatbuffers.field_table(buf_, pos_, 24)
        return if o: IRMDecodeContext { buf_, o } else: nil
    /// The chunk this mark was advanced from — the last one durably committed.
    def LAST_CHUNK() -> IRMChunk?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: IRMChunk { buf_, o } else: nil
    /// Chunks durably committed by this job so far.
    def CHUNKS_COMMITTED() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 28, 0)
    /// Source bytes accounted for by committed chunks.
    def BYTES_COMMITTED() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 30, 0)
    /// Records durably committed by this job so far, across every chunk.
    def RECORDS_COMMITTED() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 32, 0)
    /// Four-character standard code of the records this job writes, `$` included,
    /// e.g. `$TBS`. Never a union ordinal.
    def TARGET_STANDARD() -> string:
        return flatbuffers.field_string(buf_, pos_, 34)
    /// Reconciliation mode the storage lane was called with, verbatim, e.g.
    /// `append`. A chunked job never reconciles per batch: reconciling would delete
    /// every earlier chunk as the next one arrived.
    def RECONCILE_MODE() -> string:
        return flatbuffers.field_string(buf_, pos_, 36)
    /// Deduplication or merge policy the job applied, verbatim.
    def MERGE_POLICY() -> string:
        return flatbuffers.field_string(buf_, pos_, 38)
    /// The last unrecovered error, when there is one.
    def FAULT() -> IRMFault?:
        let o = flatbuffers.field_table(buf_, pos_, 40)
        return if o: IRMFault { buf_, o } else: nil
    /// RFC 3339 UTC fixed-millisecond timestamp at which the job was created.
    def CREATED_AT() -> string:
        return flatbuffers.field_string(buf_, pos_, 42)
    /// RFC 3339 UTC fixed-millisecond timestamp at which the first chunk was read.
    def STARTED_AT() -> string:
        return flatbuffers.field_string(buf_, pos_, 44)
    /// RFC 3339 UTC fixed-millisecond timestamp at which this mark was published.
    /// With JOB_ID and SEQUENCE this is the version key; SEQUENCE breaks ties.
    def UPDATED_AT() -> string:
        return flatbuffers.field_string(buf_, pos_, 46)
    /// RFC 3339 UTC fixed-millisecond timestamp at which the job reached COMPLETE.
    def COMPLETED_AT() -> string:
        return flatbuffers.field_string(buf_, pos_, 48)
    /// RFC 3339 UTC fixed-millisecond timestamp after which a consumer treats the
    /// mark as stale and re-validates the source before resuming. Empty means the
    /// publisher states no expiry.
    def EXPIRES_AT() -> string:
        return flatbuffers.field_string(buf_, pos_, 50)
    /// `namespace:value` facets, sorted and deduplicated. See TAG GRAMMAR above.
    def TAGS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 52) + i * 4)
    def TAGS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 52)
    /// Publisher note about this job; never a substitute for a field.
    def NOTES() -> string:
        return flatbuffers.field_string(buf_, pos_, 54)

def GetRootAsIRM(buf:string): return IRM { buf, flatbuffers.indirect(buf, 0) }

struct IRMBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(26)
        return this
    def add_JOB_ID(JOB_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, JOB_ID)
        return this
    def add_SEQUENCE(SEQUENCE:int):
        b_.PrependUint64Slot(1, SEQUENCE, 0)
        return this
    def add_PROVIDER_ID(PROVIDER_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, PROVIDER_ID)
        return this
    def add_INGESTOR_ID(INGESTOR_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, INGESTOR_ID)
        return this
    def add_SOURCE(SOURCE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, SOURCE)
        return this
    def add_STATE(STATE:irmJobState):
        b_.PrependInt8Slot(5, STATE, 0)
        return this
    def add_RANGE_MODE(RANGE_MODE:irmRangeMode):
        b_.PrependInt8Slot(6, RANGE_MODE, 0)
        return this
    def add_NEXT_OFFSET(NEXT_OFFSET:int):
        b_.PrependUint64Slot(7, NEXT_OFFSET, 0)
        return this
    def add_NEXT_CHUNK_INDEX(NEXT_CHUNK_INDEX:int):
        b_.PrependUint32Slot(8, NEXT_CHUNK_INDEX, 0)
        return this
    def add_CHUNK_BYTE_BUDGET(CHUNK_BYTE_BUDGET:int):
        b_.PrependUint64Slot(9, CHUNK_BYTE_BUDGET, 0)
        return this
    def add_DECODE_CONTEXT(DECODE_CONTEXT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(10, DECODE_CONTEXT)
        return this
    def add_LAST_CHUNK(LAST_CHUNK:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(11, LAST_CHUNK)
        return this
    def add_CHUNKS_COMMITTED(CHUNKS_COMMITTED:int):
        b_.PrependUint32Slot(12, CHUNKS_COMMITTED, 0)
        return this
    def add_BYTES_COMMITTED(BYTES_COMMITTED:int):
        b_.PrependUint64Slot(13, BYTES_COMMITTED, 0)
        return this
    def add_RECORDS_COMMITTED(RECORDS_COMMITTED:int):
        b_.PrependUint64Slot(14, RECORDS_COMMITTED, 0)
        return this
    def add_TARGET_STANDARD(TARGET_STANDARD:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(15, TARGET_STANDARD)
        return this
    def add_RECONCILE_MODE(RECONCILE_MODE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(16, RECONCILE_MODE)
        return this
    def add_MERGE_POLICY(MERGE_POLICY:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(17, MERGE_POLICY)
        return this
    def add_FAULT(FAULT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(18, FAULT)
        return this
    def add_CREATED_AT(CREATED_AT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(19, CREATED_AT)
        return this
    def add_STARTED_AT(STARTED_AT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(20, STARTED_AT)
        return this
    def add_UPDATED_AT(UPDATED_AT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(21, UPDATED_AT)
        return this
    def add_COMPLETED_AT(COMPLETED_AT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(22, COMPLETED_AT)
        return this
    def add_EXPIRES_AT(EXPIRES_AT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(23, EXPIRES_AT)
        return this
    def add_TAGS(TAGS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(24, TAGS)
        return this
    def add_NOTES(NOTES:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(25, NOTES)
        return this
    def end():
        return b_.EndObject()

def IRMStartTAGSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def IRMCreateTAGSVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)
