/// Locate events of one class over one interval.
class EVLEventLocationRequest : flatbuffers.handle
    def LOCATOR_CLASS() -> evlLocatorClass:
        return evlLocatorClass(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    /// Object the events are located for.
    def TARGET_OBJECT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Bodies, coordinate systems, epoch reference and Earth-orientation data
    /// set the geometry is evaluated in. The state source itself is a port the
    /// caller supplies and is NOT named here.
    def CONTEXT() -> PCEEvaluationContext?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: PCEEvaluationContext { buf_, o } else: nil
    /// Interval to search, ISO 8601.
    def SCAN_START_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    def SCAN_STOP_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// Time system of the interval, named by the $TIM timingStandard member
    /// name.
    def EPOCH_TIME_SYSTEM() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Coarse step the event function is sampled at before refinement. A
    /// provider MAY choose its own step when this is absent, and the located
    /// epochs MUST NOT depend on it beyond REFINEMENT_TOLERANCE_SECONDS.
    def SCAN_STEP_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// Convergence bar on a located epoch. A provider that cannot meet it
    /// returns ROOT_REFINEMENT_FAILED.
    def REFINEMENT_TOLERANCE_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// Upper bound on reported events. 0 means no bound.
    def MAXIMUM_EVENTS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 20, 0)
    /// Parameters to evaluate at each event's instants.
    def REPORT_PARAMETERS(i:int) -> PCEParameterRef:
        return PCEParameterRef { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 22) + i * 4) }
    def REPORT_PARAMETERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    /// Exactly the configuration matching LOCATOR_CLASS is present; any other
    /// combination is MISSING_CONFIGURATION.
    def ECLIPSE_CONFIGURATION() -> EVLEclipseConfiguration?:
        let o = flatbuffers.field_table(buf_, pos_, 24)
        return if o: EVLEclipseConfiguration { buf_, o } else: nil
    def CONTACT_CONFIGURATION() -> EVLContactConfiguration?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: EVLContactConfiguration { buf_, o } else: nil
    def INTRUSION_CONFIGURATION() -> EVLIntrusionConfiguration?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: EVLIntrusionConfiguration { buf_, o } else: nil
    def APSIDES_CONFIGURATION() -> EVLApsidesConfiguration?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: EVLApsidesConfiguration { buf_, o } else: nil
    def NODE_CROSSING_CONFIGURATION() -> EVLNodeCrossingConfiguration?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: EVLNodeCrossingConfiguration { buf_, o } else: nil
    def PARAMETER_CONDITION_CONFIGURATION() -> EVLParameterConditionConfiguration?:
        let o = flatbuffers.field_table(buf_, pos_, 34)
        return if o: EVLParameterConditionConfiguration { buf_, o } else: nil
    def TRACE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 36)
    def LATITUDE_EXTREMUM_CONFIGURATION() -> EVLLatitudeExtremumConfiguration?:
        let o = flatbuffers.field_table(buf_, pos_, 38)
        return if o: EVLLatitudeExtremumConfiguration { buf_, o } else: nil

