/// The roster a named publisher offers, resolved as a whole. A consumer
/// caches this and resolves every later name against it.
class PCEParameterCatalog : flatbuffers.handle
    /// Identifier of the catalog itself.
    def CATALOG_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Identifier of the publisher that evaluates these parameters.
    def PROVIDER_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// ISO 8601 instant this catalog was published.
    def PUBLISHED_AT() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def ENTRIES(i:int) -> PCEParameterDescriptor:
        return PCEParameterDescriptor { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 10) + i * 4) }
    def ENTRIES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)

def GetRootAsPCEParameterCatalog(buf:string): return PCEParameterCatalog { buf, flatbuffers.indirect(buf, 0) }

