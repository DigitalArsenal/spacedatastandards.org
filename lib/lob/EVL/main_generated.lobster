    def CONDITIONS(i:int) -> PCEParameterCondition:
        return PCEParameterCondition { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 4) + i * 4) }
    def CONDITIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 4)
    /// True reports the interval BETWEEN a satisfying crossing and the next
    /// unsatisfying one; false reports each crossing as an instantaneous event
    /// with equal start and stop epochs.
    def REPORT_AS_INTERVAL() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 6, 1))
    def MINIMUM_DURATION_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)

