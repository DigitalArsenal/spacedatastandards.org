/// The events found, and the interval they were actually searched over.
class EVLEventReport : flatbuffers.handle
    def STATUS() -> evlResultStatus:
        return evlResultStatus(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    def ERROR_MESSAGE() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def LOCATOR_CLASS() -> evlLocatorClass:
        return evlLocatorClass(flatbuffers.field_uint8(buf_, pos_, 8, 0))
    def TARGET_OBJECT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// Interval actually searched, ISO 8601. A BUDGET_EXCEEDED run reports the
    /// interval it reached, not the interval it was asked for.
    def SCAN_START_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    def SCAN_STOP_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Time system of the epochs, named by the $TIM timingStandard member name.
    def EPOCH_TIME_SYSTEM() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)
    /// Events in chronological order of START_EPOCH.
    def EVENTS(i:int) -> EVLEvent:
        return EVLEvent { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def EVENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Event-function evaluations actually performed, for step-independence
    /// evidence.
    def FUNCTION_EVALUATION_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 20, 0)
    /// Content identifier of the Earth-orientation data set actually used.
    def EOP_DATA_SET_CID() -> string:
        return flatbuffers.field_string(buf_, pos_, 22)
    def TRACE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 24)

