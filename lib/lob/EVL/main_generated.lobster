/// Evaluate these parameters on these states. One state is a point query; a
/// run of states is a report or a plot series, and carries the same shape.
class PCEEvaluationRequest : flatbuffers.handle
    def CONTEXT() -> PCEEvaluationContext?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: PCEEvaluationContext { buf_, o } else: nil
    def PARAMETERS(i:int) -> PCEParameterRef:
        return PCEParameterRef { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 6) + i * 4) }
    def PARAMETERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    /// States to evaluate at, in chronological order. Each carries its own
    /// epoch and coordinate system name.
    def STATES(i:int) -> FRMStateVector:
        return FRMStateVector { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 8) + i * 4) }
    def STATES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    def TRACE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)

def GetRootAsPCEEvaluationRequest(buf:string): return PCEEvaluationRequest { buf, flatbuffers.indirect(buf, 0) }

