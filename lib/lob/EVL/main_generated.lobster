/// A predicate on a named parameter: the parameter attains GOAL_VALUE, in
/// DIRECTION, for the OCCURRENCE-th time. This is the ONE spelling of a
/// stopping condition and of a generic event function; $EVL references it
/// rather than minting a second one.
class PCEParameterCondition : flatbuffers.handle
    def PARAMETER() -> PCEParameterRef?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: PCEParameterRef { buf_, o } else: nil
    /// Value the parameter must attain, in the parameter's own SI unit.
    def GOAL_VALUE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, 0.0)
    def DIRECTION() -> pceConditionDirection:
        return pceConditionDirection(flatbuffers.field_uint8(buf_, pos_, 8, 0))
    /// Convergence bar on the parameter value at the reported epoch, in the
    /// parameter's own unit. A provider that cannot meet it returns
    /// ROOT_REFINEMENT_FAILED rather than reporting an unconverged root.
    def GOAL_TOLERANCE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Which attainment satisfies the condition, one-based. 0 and 1 both mean
    /// the first.
    def OCCURRENCE() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 1)

def GetRootAsPCEParameterCondition(buf:string): return PCEParameterCondition { buf, flatbuffers.indirect(buf, 0) }

struct PCEParameterConditionBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(5)
        return this
    def add_PARAMETER(PARAMETER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, PARAMETER)
        return this
    def add_GOAL_VALUE(GOAL_VALUE:float):
        b_.PrependFloat64Slot(1, GOAL_VALUE, 0.0)
        return this
    def add_DIRECTION(DIRECTION:pceConditionDirection):
        b_.PrependUint8Slot(2, DIRECTION, 0)
        return this
    def add_GOAL_TOLERANCE(GOAL_TOLERANCE:float):
        b_.PrependFloat64Slot(3, GOAL_TOLERANCE, 0.0)
        return this
    def add_OCCURRENCE(OCCURRENCE:int):
        b_.PrependUint32Slot(4, OCCURRENCE, 1)
        return this
    def end():
        return b_.EndObject()

/// Propagate until a condition is attained. The propagator itself is NOT named
/// here: it is a port the caller supplies, per the pluggable-propagation law.
/// This record carries only the condition, the interval and the tolerances.
class PCEStopRequest : flatbuffers.handle
    def CONTEXT() -> PCEEvaluationContext?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: PCEEvaluationContext { buf_, o } else: nil
    /// State the propagation starts from.
    def INITIAL_STATE() -> FRMStateVector?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: FRMStateVector { buf_, o } else: nil
    /// Conditions evaluated together; the run stops at whichever is attained
    /// first in time.
    def CONDITIONS(i:int) -> PCEParameterCondition:
        return PCEParameterCondition { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 8) + i * 4) }
    def CONDITIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    def DIRECTION() -> pcePropagationDirection:
        return pcePropagationDirection(flatbuffers.field_uint8(buf_, pos_, 10, 1))
    /// Upper bound on the propagated interval. Reaching it without attaining a
    /// condition is GOAL_NOT_ATTAINED, never a silent stop.
    def MAXIMUM_ELAPSED_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// Convergence bar on the stop epoch. The same scenario run at different
    /// step sizes MUST land inside this bar.
    def EPOCH_TOLERANCE_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// Objects propagated in step with the owner and reported at the same stop
    /// epoch.
    def SYNCHRONIZED_OBJECT_IDS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 4)
    def SYNCHRONIZED_OBJECT_IDS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Parameters to evaluate at the stop epoch, beyond the condition itself.
    def REPORT_PARAMETERS(i:int) -> PCEParameterRef:
        return PCEParameterRef { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def REPORT_PARAMETERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    def TRACE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 20)

def GetRootAsPCEStopRequest(buf:string): return PCEStopRequest { buf, flatbuffers.indirect(buf, 0) }

