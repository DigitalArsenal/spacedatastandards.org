        b_.StartObject(5)
        return this
    def add_CATALOG(CATALOG:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, CATALOG)
        return this
    def add_EVALUATION_REQUEST(EVALUATION_REQUEST:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, EVALUATION_REQUEST)
        return this
    def add_EVALUATION_RESULT(EVALUATION_RESULT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, EVALUATION_RESULT)
        return this
    def add_STOP_REQUEST(STOP_REQUEST:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, STOP_REQUEST)
        return this
    def add_STOP_REPORT(STOP_REPORT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, STOP_REPORT)
        return this
    def end():
        return b_.EndObject()
