/// One parameter's value at one state. STATUS is per value: a request never
/// fails as a whole because one name is unavailable.
class PCEParameterValue : flatbuffers.handle
    def PARAMETER() -> pceParameter:
        return pceParameter(flatbuffers.field_uint16(buf_, pos_, 4, 0))
    /// REQUIRED when PARAMETER is PROVIDER_DEFINED.
    def PROVIDER_DEFINED_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def STATUS() -> pceResultStatus:
        return pceResultStatus(flatbuffers.field_uint8(buf_, pos_, 8, 0))
    /// Scalar, integer or boolean value. Absent for vector and matrix types.
    def VALUE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Vector or matrix values, row-major. Absent for scalar types; a scalar is
    /// NEVER also written here.
    def VALUES(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 8)
    def VALUES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// Matrix shape, REQUIRED when the descriptor's DATA_TYPE is REAL_MATRIX.
    def ROW_COUNT() -> int:
        return flatbuffers.field_int32(buf_, pos_, 14, 0)
    def COLUMN_COUNT() -> int:
        return flatbuffers.field_int32(buf_, pos_, 16, 0)
    /// Text or ISO 8601 epoch value.
    def STRING_VALUE() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    /// Unit the value is expressed in, restating the descriptor so a value is
    /// self-describing when it travels without its catalog.
    def UNIT() -> pceUnit:
        return pceUnit(flatbuffers.field_uint8(buf_, pos_, 20, 0))
    /// Why STATUS is not OK, in capability language.
    def MESSAGE() -> string:
        return flatbuffers.field_string(buf_, pos_, 22)

def GetRootAsPCEParameterValue(buf:string): return PCEParameterValue { buf, flatbuffers.indirect(buf, 0) }

