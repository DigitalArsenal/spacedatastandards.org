/// Where a propagate-to-condition run actually landed.
class PCEStopReport : flatbuffers.handle
    def STATUS() -> pceResultStatus:
        return pceResultStatus(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    def ERROR_MESSAGE() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Index into PCEStopRequest.CONDITIONS of the condition that stopped the
    /// run; negative when none did.
    def ATTAINED_CONDITION_INDEX() -> int:
        return flatbuffers.field_int32(buf_, pos_, 8, -1)
    /// Which attainment this was, one-based.
    def ATTAINED_OCCURRENCE() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 10, 0)
    /// Epoch the run stopped at, ISO 8601.
    def EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// Time system of EPOCH, named by the $TIM timingStandard member name.
    def EPOCH_TIME_SYSTEM() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Seconds of propagated time from the initial state to EPOCH; negative for
    /// a BACKWARD run.
    def ELAPSED_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// State at EPOCH.
    def STATE() -> FRMStateVector?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: FRMStateVector { buf_, o } else: nil
    /// Value the condition parameter actually had at EPOCH.
    def ACHIEVED_VALUE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    /// ACHIEVED_VALUE minus GOAL_VALUE, in the parameter's own unit. This is
    /// the residual a consumer gates on; it is NOT assumed to be zero.
    def GOAL_RESIDUAL() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// States of SYNCHRONIZED_OBJECT_IDS at the same epoch, in that order.
    def SYNCHRONIZED_STATES(i:int) -> FRMStateVector:
        return FRMStateVector { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 24) + i * 4) }
    def SYNCHRONIZED_STATES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    /// Parameters evaluated at the stop epoch.
    def SAMPLE() -> PCEParameterSample?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: PCEParameterSample { buf_, o } else: nil
    /// Root-refinement work actually done, for the step-independence evidence.
    def FUNCTION_EVALUATION_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 28, 0)
    def TRACE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 30)

def GetRootAsPCEStopReport(buf:string): return PCEStopReport { buf, flatbuffers.indirect(buf, 0) }

