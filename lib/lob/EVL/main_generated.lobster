        b_.PrependUOffsetTRelativeSlot(0, CATALOG_ID)
        return this
    def add_PROVIDER_ID(PROVIDER_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, PROVIDER_ID)
        return this
    def add_PUBLISHED_AT(PUBLISHED_AT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, PUBLISHED_AT)
        return this
    def add_ENTRIES(ENTRIES:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, ENTRIES)
        return this
    def end():
        return b_.EndObject()

def PCEParameterCatalogStartENTRIESVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def PCEParameterCatalogCreateENTRIESVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

/// Everything an evaluation needs besides the state itself.
class PCEEvaluationContext : flatbuffers.handle
    def OWNER_CLASS() -> pceOwnerClass:
        return pceOwnerClass(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    /// Identifier of the object the parameters are evaluated on.
    def OBJECT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Hardware item, when the owner class names one.
    def HARDWARE_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    /// Ephemeris body code of the default central body.
    def CENTRAL_BODY_ID() -> int:
        return flatbuffers.field_int32(buf_, pos_, 10, 0)
    /// Gravitational parameter of the central body, m^3/s^2. Absent means the
    /// provider's own value for CENTRAL_BODY_ID.
    def GRAVITATIONAL_PARAMETER() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// Shape of the central body, REQUIRED for planetodetic parameters.
    def EQUATORIAL_RADIUS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    def FLATTENING() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// Fully specified coordinate systems, each named through
    /// RFMCoordinateSystem.NAME.
    def COORDINATE_SYSTEMS(i:int) -> RFMCoordinateSystem:
        return RFMCoordinateSystem { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def COORDINATE_SYSTEMS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Which of COORDINATE_SYSTEMS a parameter reference falls back to.
    def DEFAULT_COORDINATE_SYSTEM_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 20)
    /// Time system a parameter reference falls back to, named by the $TIM
    /// timingStandard member name.
    def DEFAULT_TIME_SYSTEM() -> string:
        return flatbuffers.field_string(buf_, pos_, 22)
    /// Zero of ELAPSED_DAYS and ELAPSED_SECONDS, ISO 8601.
    def REFERENCE_EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 24)
    /// Content identifier of the Earth-orientation data set the caller requires.
    /// A provider that cannot honour it returns MISSING_EOP_DATA rather than
    /// substituting another table.
    def EOP_DATA_SET_CID() -> string:
        return flatbuffers.field_string(buf_, pos_, 26)
    /// Ephemeris body code of the illuminating body for lighting parameters.
    def ILLUMINATING_BODY_ID() -> int:
        return flatbuffers.field_int32(buf_, pos_, 28, 0)

