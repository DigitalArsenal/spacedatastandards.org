    def add_CONTEXT(CONTEXT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, CONTEXT)
        return this
    def add_INITIAL_STATE(INITIAL_STATE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, INITIAL_STATE)
        return this
    def add_CONDITIONS(CONDITIONS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, CONDITIONS)
        return this
    def add_DIRECTION(DIRECTION:pcePropagationDirection):
        b_.PrependUint8Slot(3, DIRECTION, 1)
        return this
    def add_MAXIMUM_ELAPSED_SECONDS(MAXIMUM_ELAPSED_SECONDS:float):
        b_.PrependFloat64Slot(4, MAXIMUM_ELAPSED_SECONDS, 0.0)
        return this
    def add_EPOCH_TOLERANCE_SECONDS(EPOCH_TOLERANCE_SECONDS:float):
        b_.PrependFloat64Slot(5, EPOCH_TOLERANCE_SECONDS, 0.0)
        return this
    def add_SYNCHRONIZED_OBJECT_IDS(SYNCHRONIZED_OBJECT_IDS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(6, SYNCHRONIZED_OBJECT_IDS)
        return this
    def add_REPORT_PARAMETERS(REPORT_PARAMETERS:flatbuffers.offset):
