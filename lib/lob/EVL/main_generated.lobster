/// One roster entry as a named publisher implements it. The catalog is the
/// authority a consumer resolves a name through BEFORE it asks for a value.
class PCEParameterDescriptor : flatbuffers.handle
    def PARAMETER() -> pceParameter:
        return pceParameter(flatbuffers.field_uint16(buf_, pos_, 4, 0))
    /// REQUIRED when PARAMETER is PROVIDER_DEFINED, absent otherwise.
    def PROVIDER_DEFINED_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def OWNER_CLASS() -> pceOwnerClass:
        return pceOwnerClass(flatbuffers.field_uint8(buf_, pos_, 8, 0))
    def DATA_TYPE() -> pceDataType:
        return pceDataType(flatbuffers.field_uint8(buf_, pos_, 10, 0))
    def UNIT() -> pceUnit:
        return pceUnit(flatbuffers.field_uint8(buf_, pos_, 12, 0))
    /// REQUIRED when UNIT is PROVIDER_DEFINED, absent otherwise.
    def PROVIDER_DEFINED_UNIT_SYMBOL() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Number of values for REAL_VECTOR, and rows times columns for
    /// REAL_MATRIX. Absent or 1 for a scalar.
    def ELEMENT_COUNT() -> int:
        return flatbuffers.field_int32(buf_, pos_, 16, 0)
    /// Matrix shape, REQUIRED when DATA_TYPE is REAL_MATRIX.
    def ROW_COUNT() -> int:
        return flatbuffers.field_int32(buf_, pos_, 18, 0)
    def COLUMN_COUNT() -> int:
        return flatbuffers.field_int32(buf_, pos_, 20, 0)
    def FRAME_DEPENDENCY() -> pceFrameDependency:
        return pceFrameDependency(flatbuffers.field_uint8(buf_, pos_, 22, 0))
    /// The one axis set this parameter is defined for, when it is defined for
    /// only one: planetodetic quantities require BODY_FIXED. UNSPECIFIED means
    /// any axis set the request names.
    def REQUIRED_AXIS_TYPE() -> rfmAxisType:
        return rfmAxisType(flatbuffers.field_uint8(buf_, pos_, 24, 0))
    /// The one origin kind this parameter is defined for, when it is defined
    /// for only one. UNSPECIFIED means any origin the request names.
    def REQUIRED_ORIGIN_KIND() -> rfmOriginKind:
        return rfmOriginKind(flatbuffers.field_uint8(buf_, pos_, 26, 0))
    /// The value changes with the time system it is asked for, independently of
    /// the frame.
    def TIME_SYSTEM_DEPENDENT() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 28, 0))
    /// The element set this parameter is a member of, when it is a member of
    /// one; UNSPECIFIED for a derived scalar that belongs to no set.
    def STATE_REPRESENTATION() -> frmStateRepresentation:
        return frmStateRepresentation(flatbuffers.field_uint8(buf_, pos_, 30, 0))
    def AVAILABILITY() -> pceAvailability:
        return pceAvailability(flatbuffers.field_uint8(buf_, pos_, 32, 0))
    /// REQUIRED when AVAILABILITY is DECLARED_UNAVAILABLE: what is missing,
    /// stated as a capability, so a consumer can report the refusal.
    def UNAVAILABLE_REASON() -> string:
        return flatbuffers.field_string(buf_, pos_, 34)
    /// REQUIRED when AVAILABILITY is DEPRECATED: the parameter to migrate to.
    def SUPERSEDED_BY() -> pceParameter:
        return pceParameter(flatbuffers.field_uint16(buf_, pos_, 36, 0))
    /// The publisher can bracket and refine a root of this parameter, so it may
    /// be used as a stopping condition or a generic event function. A parameter
    /// that is not continuous in time MUST declare false.
    def SUPPORTS_STOPPING_CONDITION() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 38, 0))
    /// The parameter can be written as well as read, so it may be a targeting
    /// variable.
    def IS_SETTABLE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 40, 0))
    /// The value wraps: a goal crossing must be tested modulo the cycle.
    def IS_CYCLIC() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 42, 0))
    /// Inclusive lower and exclusive upper bound of the cycle, REQUIRED when
    /// IS_CYCLIC is true.
    def CYCLE_LOWER_BOUND() -> float:
        return flatbuffers.field_float64(buf_, pos_, 44, 0.0)
    def CYCLE_UPPER_BOUND() -> float:
        return flatbuffers.field_float64(buf_, pos_, 46, 0.0)
    /// One sentence, capability language, no product or organization names.
    def DESCRIPTION() -> string:
        return flatbuffers.field_string(buf_, pos_, 48)

def GetRootAsPCEParameterDescriptor(buf:string): return PCEParameterDescriptor { buf, flatbuffers.indirect(buf, 0) }

