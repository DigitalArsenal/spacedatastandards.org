        return SLPGoal { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def GOALS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    def OBJECTIVE() -> SLPObjective?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: SLPObjective { buf_, o } else: nil
    def CONSTRAINTS(i:int) -> SLPNonlinearConstraint:
        return SLPNonlinearConstraint { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 20) + i * 4) }
    def CONSTRAINTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    def SETTINGS() -> SLPSolverSettings?:
        let o = flatbuffers.field_table(buf_, pos_, 22)
        return if o: SLPSolverSettings { buf_, o } else: nil
    def REPORT() -> SLPSolverReport?:
        let o = flatbuffers.field_table(buf_, pos_, 24)
        return if o: SLPSolverReport { buf_, o } else: nil
    def CREATED_AT() -> string:
        return flatbuffers.field_string(buf_, pos_, 26)
    def ATTESTATION() -> SLPAttestation:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return SLPAttestation { buf_, assert o }

def GetRootAsSLP(buf:string): return SLP { buf, flatbuffers.indirect(buf, 0) }

struct SLPBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(13)
        return this
    def add_PROBLEM_ID(PROBLEM_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, PROBLEM_ID)
        return this
    def add_NAME(NAME:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, NAME)
        return this
    def add_KIND(KIND:slpProblemKind):
        b_.PrependUint8Slot(2, KIND, 0)
        return this
    def add_PROPAGATOR_PORT_ID(PROPAGATOR_PORT_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, PROPAGATOR_PORT_ID)
        return this
    def add_OBJECTIVE_EVALUATOR_PORT_ID(OBJECTIVE_EVALUATOR_PORT_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, OBJECTIVE_EVALUATOR_PORT_ID)
        return this
    def add_VARIABLES(VARIABLES:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(5, VARIABLES)
        return this
    def add_GOALS(GOALS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(6, GOALS)
        return this
    def add_OBJECTIVE(OBJECTIVE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(7, OBJECTIVE)
        return this
    def add_CONSTRAINTS(CONSTRAINTS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(8, CONSTRAINTS)
        return this
    def add_SETTINGS(SETTINGS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(9, SETTINGS)
        return this
    def add_REPORT(REPORT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(10, REPORT)
        return this
    def add_CREATED_AT(CREATED_AT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(11, CREATED_AT)
        return this
    def add_ATTESTATION(ATTESTATION:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(12, ATTESTATION)
        return this
    def end():
        return b_.EndObject()

def SLPStartVARIABLESVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def SLPCreateVARIABLESVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

def SLPStartGOALSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def SLPCreateGOALSVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

