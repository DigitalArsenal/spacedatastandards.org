        return TIMInstant { buf_, assert o }
    def MISS_DISTANCE_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    def RELATIVE_SPEED_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    def PROBABILITY() -> CQRProbabilityResult?:
        let o = flatbuffers.field_table(buf_, pos_, 22)
        return if o: CQRProbabilityResult { buf_, o } else: nil
    def DILUTION_THRESHOLD_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    /// True when DILUTION_THRESHOLD_M carries a value; false means absent.
    def HAS_DILUTION_THRESHOLD_M() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))
    /// Primary-object RTN components in m and m/s; omitted when unavailable.
    def RELATIVE_POSITION_RTN() -> FRMVector3?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: FRMVector3 { buf_, o } else: nil
    def RELATIVE_VELOCITY_RTN() -> FRMVector3?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: FRMVector3 { buf_, o } else: nil
    /// One-sigma RTN values in metres, not covariance matrices.
    def PRIMARY_SIGMA_RTN_M() -> FRMVector3?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: FRMVector3 { buf_, o } else: nil
    def SECONDARY_SIGMA_RTN_M() -> FRMVector3?:
        let o = flatbuffers.field_table(buf_, pos_, 34)
        return if o: FRMVector3 { buf_, o } else: nil
    def PRIMARY_DAYS_SINCE_EPOCH() -> float:
