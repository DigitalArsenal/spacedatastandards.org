/// Conjunction Query and Result — pair/catalog screening, encounter-plane
/// probability, typed native documents, resident screening-index control and
/// launch-window screening.
/// Exactly one arm per PIV payload, selected by the declared METHOD_ID.
class CQR : flatbuffers.handle
    def PAIR_REQUEST() -> CQRPairRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: CQRPairRequest { buf_, o } else: nil
    def CATALOG_REQUEST() -> CQRCatalogRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: CQRCatalogRequest { buf_, o } else: nil
    def PROBABILITY_REQUEST() -> CQRProbabilityRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: CQRProbabilityRequest { buf_, o } else: nil
    def PROBABILITY_RESULT() -> CQRProbabilityResult?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: CQRProbabilityResult { buf_, o } else: nil
    def ALFANO_REQUEST() -> CQRAlfanoRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: CQRAlfanoRequest { buf_, o } else: nil
    def ALFANO_RESULT() -> CQRAlfanoResult?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: CQRAlfanoResult { buf_, o } else: nil
    def EVENT_RESULT() -> CQREvent?:
        let o = flatbuffers.field_table(buf_, pos_, 16)
        return if o: CQREvent { buf_, o } else: nil
    def TCA_RESULT() -> TIMInstant?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: TIMInstant { buf_, o } else: nil
    def CATALOG_RESULT() -> CQRCatalogResult?:
        let o = flatbuffers.field_table(buf_, pos_, 20)
        return if o: CQRCatalogResult { buf_, o } else: nil
    def NATIVE_DOCUMENT() -> CQRNativeDocument?:
        let o = flatbuffers.field_table(buf_, pos_, 22)
        return if o: CQRNativeDocument { buf_, o } else: nil
    def INDEX_REQUEST() -> CQRIndexRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 24)
        return if o: CQRIndexRequest { buf_, o } else: nil
    def INDEX_RESULT() -> CQRIndexResult?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: CQRIndexResult { buf_, o } else: nil
    def WINDOW_REQUEST() -> CQRWindowRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: CQRWindowRequest { buf_, o } else: nil
    def DESTROY_REQUEST() -> CQRDestroyRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: CQRDestroyRequest { buf_, o } else: nil
    def VERSION_QUERY() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 32, 0))
    def VERSION_RESULT() -> CQRVersionResult?:
        let o = flatbuffers.field_table(buf_, pos_, 34)
        return if o: CQRVersionResult { buf_, o } else: nil
    /// APPENDED. Launch-window screening request and result.
    def LAUNCH_REQUEST() -> CQRLaunchRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 36)
        return if o: CQRLaunchRequest { buf_, o } else: nil
    def LAUNCH_RESULT() -> CQRLaunchResult?:
        let o = flatbuffers.field_table(buf_, pos_, 38)
        return if o: CQRLaunchResult { buf_, o } else: nil

def GetRootAsCQR(buf:string): return CQR { buf, flatbuffers.indirect(buf, 0) }

