    def TRAJECTORY() -> OEM:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return OEM { buf_, assert o }
    /// Hard-body radius, metres.
    def RADIUS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 5.0)
    /// Radar cross section, square metres.
    def RADAR_CROSS_SECTION_M2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// True when RADAR_CROSS_SECTION_M2 carries a value; false means absent.
    def HAS_RADAR_CROSS_SECTION_M2() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 14, 0))
    /// Liftoff times this trajectory applies to, half-open [VALID_FROM,
    /// VALID_UNTIL). Absent bounds select the whole window. Windows whose
    /// trajectory changes (for example a varying azimuth) supply one segment
    /// per span.
    def VALID_FROM() -> TIMInstant?:
        let o = flatbuffers.field_table(buf_, pos_, 16)
        return if o: TIMInstant { buf_, o } else: nil
    def VALID_UNTIL() -> TIMInstant?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: TIMInstant { buf_, o } else: nil

