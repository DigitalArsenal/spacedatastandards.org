class CQRLaunchRequest : flatbuffers.handle
    def MISSION_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Liftoff time the segment trajectories were produced for.
    def NOMINAL_LIFTOFF() -> TIMInstant:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return TIMInstant { buf_, assert o }
    /// Liftoff window, inclusive of both ends.
    def WINDOW_OPEN() -> TIMInstant:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return TIMInstant { buf_, assert o }
    def WINDOW_CLOSE() -> TIMInstant:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return TIMInstant { buf_, assert o }
    /// Spacing of evaluated liftoff times, seconds.
    def LIFTOFF_STEP_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 1.0)
    def SEGMENTS(i:int) -> CQRLaunchSegment:
        return CQRLaunchSegment { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 14) + i * 4) }
    def SEGMENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    def OBJECTS(i:int) -> CQRLaunchObject:
        return CQRLaunchObject { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def OBJECTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// One criterion per object class present in OBJECTS.
    def CRITERIA(i:int) -> CQRLaunchCriterion:
        return CQRLaunchCriterion { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def CRITERIA_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Segment states below this height above the reference ellipsoid are not
    /// screened, metres.
    def MINIMUM_ALTITUDE_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 150000.0)
    /// Screening ends this long after liftoff, seconds, or earlier where a
    /// trajectory ends.
    def SCREEN_SECONDS_AFTER_LIFTOFF() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 10800.0)
    /// Time added before and after every closure for vehicle performance and
    /// timing uncertainty, seconds.
    def CLOSURE_PAD_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    /// Report approaches whose criterion ratio is below this value; 1 reports
    /// violations only.
    def REPORT_RATIO() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 1.0)
    /// Earth-fixed frame shared by every trajectory and ephemeris.
    def EVALUATION_FRAME() -> RFMCoordinateSystem:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return RFMCoordinateSystem { buf_, assert o }

