/// Closest approach of one segment to one orbiting object for one liftoff
/// time: the worst liftoff time of each contiguous run below REPORT_RATIO.
class CQRLaunchApproach : flatbuffers.handle
    def SEGMENT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    def OBJECT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def OBJECT_CLASS() -> cqrLaunchObjectClass:
        return cqrLaunchObjectClass(flatbuffers.field_uint8(buf_, pos_, 8, 0))
    def LIFTOFF() -> TIMInstant:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return TIMInstant { buf_, assert o }
    def TCA() -> TIMInstant:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return TIMInstant { buf_, assert o }
    def MISS_DISTANCE_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    def RELATIVE_SPEED_M_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// Segment position relative to the orbiting object in the object's
    /// radial/in-track/cross-track frame, metres.
    def RELATIVE_POSITION_RTN() -> FRMVector3?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: FRMVector3 { buf_, o } else: nil
    /// Normalised separation: distance over radius (SPHERICAL) or ellipsoid
    /// radius (ELLIPSOIDAL). Below 1 violates.
    def CRITERION_RATIO() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, 0.0)
    def VIOLATES() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 22, 0))
    def RENDEZVOUS_COORDINATED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 24, 0))
    /// First and last liftoff times of the run this approach represents.
    def RUN_START() -> TIMInstant?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: TIMInstant { buf_, o } else: nil
    def RUN_END() -> TIMInstant?:
        let o = flatbuffers.field_table(buf_, pos_, 28)
        return if o: TIMInstant { buf_, o } else: nil

