def CQRCatalogResultStartEVENTSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def CQRCatalogResultCreateEVENTSVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
