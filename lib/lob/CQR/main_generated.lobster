/// Stable order by TCA then primary/secondary identity; ties retain original
/// input-pair order. EVENT_OFFSET indexes this order across bounded chunks.
/// PIV output cap, YIELDED and BACKLOG_REMAINING carry stream backpressure.
class CQRCatalogResult : flatbuffers.handle
    def OBJECTS_PARSED() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 4, 0)
    def CONJUNCTIONS_FOUND() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 6, 0)
    def EVENTS(i:int) -> CQREvent:
        return CQREvent { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 8) + i * 4) }
    def EVENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    def STATISTICS() -> CQRScreeningStatistics?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: CQRScreeningStatistics { buf_, o } else: nil
    def EVENT_OFFSET() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 12, 0)
    def FINAL_CHUNK() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 14, 1))

def GetRootAsCQRCatalogResult(buf:string): return CQRCatalogResult { buf, flatbuffers.indirect(buf, 0) }

