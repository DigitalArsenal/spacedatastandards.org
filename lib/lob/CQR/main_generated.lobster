    return b_.EndVector(v_.length)

/// Resident index construction reuses canonical sources, samples and PPE.
/// SAMPLED_STATES consumes sampled OEM records in SOURCES[].EPHEMERIS;
/// POLYNOMIAL_SEGMENTS consumes SEGMENTS/PPE. Handles are validated against
/// INSTANCE identity/generation; they are never persisted process addresses.
class CQRIndexRequest : flatbuffers.handle
    def INSTANCE() -> PRWInstance:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return PRWInstance { buf_, assert o }
    def CATALOG_HANDLE() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    def SOURCE_HANDLES(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 8) + i * 4)
    def SOURCE_HANDLES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    def SEGMENT_SET_HANDLE() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 10, 0)
    def PRIMARY_SOURCE_HANDLES(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 4)
    def PRIMARY_SOURCE_HANDLES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    def INDEX_CONTENT() -> cqrIndexRepresentation:
        return cqrIndexRepresentation(flatbuffers.field_uint8(buf_, pos_, 14, 0))
    def REFINEMENT_MODE() -> cqrRefinementStrategy:
        return cqrRefinementStrategy(flatbuffers.field_uint8(buf_, pos_, 16, 0))
    def SOURCES(i:int) -> CQRObjectSource:
        return CQRObjectSource { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def SOURCES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    def SEGMENTS() -> PRWDescribeResult?:
        let o = flatbuffers.field_table(buf_, pos_, 20)
        return if o: PRWDescribeResult { buf_, o } else: nil

