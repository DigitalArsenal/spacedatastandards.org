        return if o: PRWResidentState { buf_, o } else: nil
    def MAHALANOBIS_3D_SQUARED() -> float:
        return flatbuffers.field_float64(buf_, pos_, 50, 0.0)
    /// True when MAHALANOBIS_3D_SQUARED carries a value; false means absent.
    def HAS_MAHALANOBIS_3D_SQUARED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 52, 0))
    def COMBINED_RADIUS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 54, 0.0)
    /// True when COMBINED_RADIUS_M carries a value; false means absent.
    def HAS_COMBINED_RADIUS_M() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 56, 0))
    /// Each object's hard-body radius in metres and where it came from;
