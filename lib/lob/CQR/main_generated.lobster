    /// True when SECONDARY_DAYS_SINCE_EPOCH carries a value; false means absent.
    def HAS_SECONDARY_DAYS_SINCE_EPOCH() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 42, 0))
    /// Full standards-backed result when physically available.
    def CONJUNCTION_MESSAGE() -> CDM?:
        let o = flatbuffers.field_table(buf_, pos_, 44)
        return if o: CDM { buf_, o } else: nil
    def PRIMARY_STATE() -> PRWResidentState?:
        let o = flatbuffers.field_table(buf_, pos_, 46)
        return if o: PRWResidentState { buf_, o } else: nil
    def SECONDARY_STATE() -> PRWResidentState?:
