/// Report the actual algorithm and uncertainty origin. With
/// MAXIMUM_PROBABILITY_ONLY, MAXIMUM_PROBABILITY is present and PROBABILITY is
/// inapplicable: consumers must ignore its default zero. Never report a heuristic
/// maximum as probability computed from supplied covariance. Otherwise
/// PROBABILITY is unitless in [0,1]; supplied/synthesized covariance is explicit.
class CQRProbabilityResult : flatbuffers.handle
    def PROBABILITY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, 0.0)
    def ALGORITHM() -> cqrProbabilityAlgorithm:
        return cqrProbabilityAlgorithm(flatbuffers.field_uint8(buf_, pos_, 6, 0))
    def CONVERGED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 8, 0))
    def ITERATIONS() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 10, 0)
    def MAXIMUM_PROBABILITY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    /// True when MAXIMUM_PROBABILITY carries a value; false means absent.
    def HAS_MAXIMUM_PROBABILITY() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 14, 0))
    /// Explicitly squared distance d^T C^-1 d, dimensionless.
    def MAHALANOBIS_SQUARED() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// True when MAHALANOBIS_SQUARED carries a value; false means absent.
    def HAS_MAHALANOBIS_SQUARED() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 18, 0))
    def UNCERTAINTY_SOURCE() -> cqrUncertaintyOrigin:
        return cqrUncertaintyOrigin(flatbuffers.field_uint8(buf_, pos_, 20, 0))
    /// For a covariance-based probability: whether the covariance's coverage was
    /// measured against independent reference states. Only CALIBRATED
    /// covariance supports a probability beyond "conditional on the stated
    /// assumptions".
    def CALIBRATION() -> covarianceCalibration:
        return covarianceCalibration(flatbuffers.field_int8(buf_, pos_, 22, 0))
    /// Identifier of the calibration evidence (a report or record).
    def CALIBRATION_REFERENCE() -> string:
        return flatbuffers.field_string(buf_, pos_, 24)
    /// The correlation assumed between the two objects' errors.
    def CROSS_CORRELATION() -> cqrCovarianceCorrelation:
        return cqrCovarianceCorrelation(flatbuffers.field_uint8(buf_, pos_, 26, 0))

