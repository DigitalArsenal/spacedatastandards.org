/// Screening criterion for one object class. Exactly one kind per entry;
/// SCREENING selects which fields apply.
class CQRLaunchCriterion : flatbuffers.handle
    def OBJECT_CLASS() -> cqrLaunchObjectClass:
        return cqrLaunchObjectClass(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    def SCREENING() -> cqrLaunchScreening:
        return cqrLaunchScreening(flatbuffers.field_uint8(buf_, pos_, 6, 0))
    /// Sphere radius, metres (SPHERICAL).
    def RADIUS_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, 0.0)
    /// Ellipsoid semi-axes, metres (ELLIPSOIDAL).
    def RADIAL_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    def IN_TRACK_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    def CROSS_TRACK_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    /// Largest acceptable probability of collision (PROBABILITY).
    def MAX_PROBABILITY() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    def ALGORITHM() -> cqrProbabilityAlgorithm:
        return cqrProbabilityAlgorithm(flatbuffers.field_uint8(buf_, pos_, 18, 0))

