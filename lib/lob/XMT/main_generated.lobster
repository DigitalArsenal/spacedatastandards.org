/// Catalog Cross-Match - exactly one arm is set.
class XMT : flatbuffers.handle
    def MATCH_REQUEST() -> XMTMatchRequest?:
        let o = flatbuffers.field_table(buf_, pos_, 4)
        return if o: XMTMatchRequest { buf_, o } else: nil
    def MATCH_REPORT() -> XMTMatchReport?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: XMTMatchReport { buf_, o } else: nil
    def COMPOSE_RECIPE() -> XMTComposeRecipe?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: XMTComposeRecipe { buf_, o } else: nil
    def COMPOSE_REPORT() -> XMTComposeReport?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: XMTComposeReport { buf_, o } else: nil
    def INTEGRATE_RECIPE() -> XMTIntegrateRecipe?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: XMTIntegrateRecipe { buf_, o } else: nil
    def INTEGRATE_REPORT() -> XMTIntegrateReport?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: XMTIntegrateReport { buf_, o } else: nil
    def EPOCH_FIT_POLICY() -> XMTEpochFitPolicy?:
        let o = flatbuffers.field_table(buf_, pos_, 16)
        return if o: XMTEpochFitPolicy { buf_, o } else: nil
    def EPOCH_FIT_REPORT() -> XMTEpochFitReport?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: XMTEpochFitReport { buf_, o } else: nil

def GetRootAsXMT(buf:string): return XMT { buf, flatbuffers.indirect(buf, 0) }

