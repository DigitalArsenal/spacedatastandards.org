    b_:flatbuffers.builder
    def start():
        b_.StartObject(14)
        return this
    def add_PROPAGATOR_ID(PROPAGATOR_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, PROPAGATOR_ID)
        return this
    def add_PROPAGATOR_ARTIFACT_SHA256(PROPAGATOR_ARTIFACT_SHA256:flatbuffers.offset):
