/// Policy of an epoch-state fit to a provider ephemeris, validated on
/// held-out samples.
class XMTEpochFitPolicy : flatbuffers.handle
    /// Propagator module identifier, e.g. "com.orbpro.ffm".
    def PROPAGATOR_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// SHA-256 hex digest of the propagator artifact.
    def PROPAGATOR_ARTIFACT_SHA256() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Force model the trajectories were propagated with.
    def FORCE_MODEL() -> PRWForceConfiguration?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: PRWForceConfiguration { buf_, o } else: nil
    /// Integrator settings, when stated.
    def INTEGRATOR() -> PRWIntegratorSettings?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: PRWIntegratorSettings { buf_, o } else: nil
    /// Known limitations of the force model (human-readable).
    def FORCE_MODEL_LIMITATION() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// Immutable reference to the frame transformation used.
    def FRAME_TRANSFORMATION_REF() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Every HOLDOUT_STRIDE-th sample is held out, 2 to 8.
    def HOLDOUT_STRIDE() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 16, 0)
    /// Maximum training and held-out residual for Validated, km.
    def POSITION_TOLERANCE_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, 0.0)
    /// Held-out RMS above this rejects the fit, km; NaN = no limit.
    def MAXIMUM_HOLDOUT_RMS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 20, nan)
    /// Finite-difference perturbation of the position, km (fit step).
    def POSITION_PERTURBATION_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// Finite-difference perturbation of the velocity, km/s (fit step).
    def VELOCITY_PERTURBATION_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    /// Position residual weight (one sigma), km (fit step).
    def POSITION_WEIGHT_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    /// Position regularization (prior sigma), km (fit step).
    def POSITION_REGULARIZATION_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    /// Velocity regularization (prior sigma), km/s (fit step).
    def VELOCITY_REGULARIZATION_KM_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, 0.0)

def GetRootAsXMTEpochFitPolicy(buf:string): return XMTEpochFitPolicy { buf, flatbuffers.indirect(buf, 0) }

