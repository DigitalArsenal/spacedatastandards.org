/// Result of a catalog integration.
class XMTIntegrateReport : flatbuffers.handle
    def AS_OF_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 4, 0)
    /// The policies applied (SELECTION may omit its MEASURED table and give
    /// MEASURED_ROWS).
    def SELECTION() -> XMTSelectionPolicy?:
        let o = flatbuffers.field_table(buf_, pos_, 6)
        return if o: XMTSelectionPolicy { buf_, o } else: nil
    def MANEUVERS() -> XMTManeuverPolicy?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: XMTManeuverPolicy { buf_, o } else: nil
    def CATALOG_RECORDS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 10, 0)
    def OMM_RECORDS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 12, 0)
    def OCM_RECORDS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)
    def MNV_RECORDS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 16, 0)
    /// Product kinds with a selection.
    def SELECTED_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 18, 0)
    /// Objects with products but no eligible one.
    def STALE_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 20, 0)
    /// Objects with no product.
    def NO_PRODUCT_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 22, 0)
    /// Selections decided by source order (nothing measured).
    def UNMEASURED_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 24, 0)
    /// Selections without a paired $OCM.
    def WITHOUT_OCM_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 26, 0)
    def MANEUVERABLE_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 28, 0)
    def MANEUVER_EVENT_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 30, 0)
    /// Events merged from more than one source.
    def MERGED_EVENT_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 32, 0)
    /// Unlinked records by reason.
    def UNLINKED_COUNTS(i:int) -> XMTReasonCount:
        return XMTReasonCount { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 34) + i * 4) }
    def UNLINKED_COUNTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    /// Records refused.
    def REFUSED_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 36, 0)
    /// The identity links tested, with BOUND set where they bound.
    def IDENTITY() -> XMTMatchReport?:
        let o = flatbuffers.field_table(buf_, pos_, 38)
        return if o: XMTMatchReport { buf_, o } else: nil
    def OBJECTS(i:int) -> XMTIntegratedObject:
        return XMTIntegratedObject { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 40) + i * 4) }
    def OBJECTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 40)
    /// Products that named no catalog object (first 1000).
    def UNLINKED(i:int) -> XMTUnplacedRecord:
        return XMTUnplacedRecord { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 42) + i * 4) }
    def UNLINKED_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 42)
    /// Products refused as unreadable (first 1000).
    def REFUSED(i:int) -> XMTUnplacedRecord:
        return XMTUnplacedRecord { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 44) + i * 4) }
    def REFUSED_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 44)

