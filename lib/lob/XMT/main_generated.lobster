        return this
    def add_MAXIMUM_HOLDOUT_RMS_KM(MAXIMUM_HOLDOUT_RMS_KM:float):
        b_.PrependFloat64Slot(8, MAXIMUM_HOLDOUT_RMS_KM, nan)
        return this
    def add_POSITION_PERTURBATION_KM(POSITION_PERTURBATION_KM:float):
        b_.PrependFloat64Slot(9, POSITION_PERTURBATION_KM, 0.0)
        return this
    def add_VELOCITY_PERTURBATION_KM_S(VELOCITY_PERTURBATION_KM_S:float):
