        b_.PrependFloat64Slot(13, VELOCITY_REGULARIZATION_KM_S, 0.0)
        return this
    def end():
        return b_.EndObject()

/// Training and held-out residuals of an epoch state against a provider's
/// ephemeris.
class XMTEpochFitReport : flatbuffers.handle
    def VERDICT() -> xmtFitVerdict:
        return xmtFitVerdict(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    def TRAINING_SAMPLES() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 6, 0)
    def HOLDOUT_SAMPLES() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 8, 0)
    /// Position RMS on the training samples, km.
    def TRAINING_RMS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, 0.0)
    /// Position RMS on the held-out samples, km.
    def HOLDOUT_RMS_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, 0.0)
    def MAXIMUM_TRAINING_RESIDUAL_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, 0.0)
    def MAXIMUM_HOLDOUT_RESIDUAL_KM() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// SHA-256 of the provider ephemeris compared against.
    def REFERENCE_SHA256() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    /// SHA-256 of the seed state record.
    def SEED_SHA256() -> string:
        return flatbuffers.field_string(buf_, pos_, 20)
    /// Provider-native object identifier.
    def NATIVE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 22)
    /// Epoch of the seed state, ISO 8601 UTC as the seed states it.
    def EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 24)
    /// Samples on the arc.
    def SAMPLE_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 26, 0)
    /// Arc span, s.
    def SPAN_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, 0.0)
    def POLICY() -> XMTEpochFitPolicy?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: XMTEpochFitPolicy { buf_, o } else: nil
    /// True when a covariance accompanies the state (false: position
    /// consistency only).
    def COVARIANCE_AVAILABLE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 32, 0))
    /// Proposed position correction, km (3 values, the seed's frame); empty
    /// when no fit step ran.
    def POSITION_CORRECTION_KM(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 34) + i * 8)
    def POSITION_CORRECTION_KM_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    /// Proposed velocity correction, km/s (3 values); empty when no fit step
    /// ran.
    def VELOCITY_CORRECTION_KM_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 36) + i * 8)
    def VELOCITY_CORRECTION_KM_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 36)
    /// Human-readable caveat.
    def NOTE() -> string:
        return flatbuffers.field_string(buf_, pos_, 38)

def GetRootAsXMTEpochFitReport(buf:string): return XMTEpochFitReport { buf, flatbuffers.indirect(buf, 0) }

