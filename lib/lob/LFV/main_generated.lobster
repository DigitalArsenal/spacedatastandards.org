/// Labelled Feature Vectors - labelled rows and, optionally, the report of a
/// test that distinguishes their classes.
class LFV : flatbuffers.handle
    /// Name of the feature set or view, e.g. "gp" (from element sets), "hpop"
    /// (from propagated ephemeris).
    def VIEW() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Feature names, in the order of every row's VALUES.
    def FEATURE_NAMES(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 6) + i * 4)
    def FEATURE_NAMES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    /// Unit of each feature, same order, e.g. "km", "deg", "km/day", "1";
    /// empty = not stated.
    def FEATURE_UNITS(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 8) + i * 4)
    def FEATURE_UNITS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// Window of data the features were computed over, Unix milliseconds
    /// [start, end); 0 = not stated.
    def WINDOW_START_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 10, 0)
    def WINDOW_END_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 12, 0)
    /// Fewest data points a source needed to get a row.
    def MIN_POINTS() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 14, 0)
    def ROWS(i:int) -> LFVRow:
        return LFVRow { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def ROWS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Sources offered, reference objects compared against (the catalog),
    /// and sources skipped for having too few points.
    def SOURCE_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 18, 0)
    def REFERENCE_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 20, 0)
    def SKIPPED_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 22, 0)
    /// Unix milliseconds this record was generated; 0 = not stated.
    def GENERATED_AT_MS() -> int:
        return flatbuffers.field_int64(buf_, pos_, 24, 0)
    def REPORT() -> LFVTestReport?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: LFVTestReport { buf_, o } else: nil

def GetRootAsLFV(buf:string): return LFV { buf, flatbuffers.indirect(buf, 0) }

struct LFVBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(12)
        return this
    def add_VIEW(VIEW:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, VIEW)
        return this
    def add_FEATURE_NAMES(FEATURE_NAMES:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, FEATURE_NAMES)
        return this
    def add_FEATURE_UNITS(FEATURE_UNITS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, FEATURE_UNITS)
        return this
    def add_WINDOW_START_MS(WINDOW_START_MS:int):
