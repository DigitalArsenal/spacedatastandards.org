        return this
    def add_GENERATED_AT_MS(GENERATED_AT_MS:int):
        b_.PrependInt64Slot(10, GENERATED_AT_MS, 0)
        return this
    def add_REPORT(REPORT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(11, REPORT)
        return this
    def end():
        return b_.EndObject()

