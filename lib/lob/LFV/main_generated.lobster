        return this
    def add_WINDOW_END_MS(WINDOW_END_MS:int):
        b_.PrependInt64Slot(4, WINDOW_END_MS, 0)
        return this
    def add_MIN_POINTS(MIN_POINTS:int):
        b_.PrependUint32Slot(5, MIN_POINTS, 0)
        return this
    def add_ROWS(ROWS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(6, ROWS)
