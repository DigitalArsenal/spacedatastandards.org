/// Binding to the exact 3D asset bytes this record accompanies.
///
/// Every field is copied verbatim from the $VAM that governs the asset, so an
/// $OPP is valid for exactly one reviewed variant. Different bytes are a
/// different asset: mint a new $OPP and set SUPERSEDES_OPP_CID rather than
/// repointing an existing one.
class OPPAssetRef : flatbuffers.handle
    /// $VAM.ID verbatim.
    def VAM_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// $VAM.VERSION verbatim.
    def VAM_VERSION() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// CIDv1 containing a multihash of the exact $VAM bytes.
    def VAM_CID() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    /// $VAMVariant.ID verbatim: the specific glTF or GLB this record describes.
    def VARIANT_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 10)
    /// $VAMVariant.BYTE_SHA256 verbatim: 64 lowercase hexadecimal characters
    /// encoding SHA-256 of the exact asset file bytes.
    def ASSET_SHA256() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// $VAMVariant.CID verbatim.
    def ASSET_CID() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// $VAMVariant.FILE_NAME verbatim.
    def ASSET_FILE_NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 16)
    /// $VAMVariant.MEDIA_TYPE verbatim.
    def ASSET_MEDIA_TYPE() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    /// $VAMVariant.GLTF_VERSION verbatim.
    def GLTF_VERSION() -> string:
        return flatbuffers.field_string(buf_, pos_, 20)
    /// $VAM.ENTITY_ID verbatim. MUST equal OPP.ENTITY_ID.
    def ENTITY_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 22)
    /// True only when the asset geometry was authored or rescaled to the physical
    /// dimensions in this record. False, the default, means the asset is
    /// representative and its geometry is not a source of physical dimensions.
    def GEOMETRY_MATCHES_PHYSICAL() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 24, 0))
    /// Metres per asset unit for the named variant. Restates
    /// $VAMTransform.METERS_PER_SOURCE_UNIT for consumers that read only $OPP.
    def METERS_PER_ASSET_UNIT() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 1.0)

def GetRootAsOPPAssetRef(buf:string): return OPPAssetRef { buf, flatbuffers.indirect(buf, 0) }

struct OPPAssetRefBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(12)
        return this
    def add_VAM_ID(VAM_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, VAM_ID)
        return this
    def add_VAM_VERSION(VAM_VERSION:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, VAM_VERSION)
        return this
    def add_VAM_CID(VAM_CID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, VAM_CID)
        return this
    def add_VARIANT_ID(VARIANT_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, VARIANT_ID)
        return this
    def add_ASSET_SHA256(ASSET_SHA256:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, ASSET_SHA256)
        return this
    def add_ASSET_CID(ASSET_CID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(5, ASSET_CID)
        return this
    def add_ASSET_FILE_NAME(ASSET_FILE_NAME:flatbuffers.offset):
