/// Coverage Geometry
class CVP : flatbuffers.handle
    /// Stable identifier of this geometry product.
    def COVERAGE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Display name.
    def NAME() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    /// Analysis or scenario grouping identifier shared with the `$RFL` samples
    /// and `$ACI` intervals of the same study.
    def SCENARIO_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def GEOMETRY_KIND() -> cvpGeometryKind:
        return cvpGeometryKind(flatbuffers.field_int8(buf_, pos_, 10, 0))
    /// The metric the rings contour.
    def METRIC() -> rflBudgetTerm:
        return rflBudgetTerm(flatbuffers.field_int8(buf_, pos_, 12, 0))
    /// Units of the metric and of POLYGON_LEVEL_VALUES.
    def METRIC_UNITS() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// The threshold the boundary was drawn at, for a THRESHOLD_CONTOUR.
    def THRESHOLD_VALUE() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    def THRESHOLD_UNITS() -> string:
        return flatbuffers.field_string(buf_, pos_, 18)
    def THRESHOLD_COMPARISON() -> rflComparison:
        return rflComparison(flatbuffers.field_int8(buf_, pos_, 20, 0))
    /// Instantaneous epoch, seconds since 1970-01-01T00:00:00 in TIME_SYSTEM.
    /// Set for FOOTPRINT and other instantaneous products; NaN for aggregates.
    def EPOCH() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, 0.0)
    /// Interval this geometry holds over, same encoding. Set for aggregated
    /// products (union over a window, availability contour); NaN for
    /// instantaneous ones. A product that states neither EPOCH nor an interval
    /// is untethered in time and MUST be refused.
    def INTERVAL_START() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, 0.0)
    def INTERVAL_STOP() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, 0.0)
    /// Time scale all epochs in this record are expressed in. Defaults to UTC
    /// explicitly: `timingStandard` ordinal 0 is GMST.
    def TIME_SYSTEM() -> timingStandard:
        return timingStandard(flatbuffers.field_int8(buf_, pos_, 28, 11))
    /// Monotonic generation of this coverage product within its COVERAGE_ID
    /// lineage. A streaming producer increments it per emission; a consumer
    /// holding a higher generation MUST NOT be overwritten by a lower one.
    def GENERATION() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 30, 0)
    /// COVERAGE_ID this record replaces, when the lineage was re-identified.
    def SUPERSEDES_COVERAGE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 32)
    /// Vertex longitudes, geodetic degrees in [-180, 180].
    def VERTEX_LONGITUDE_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 34) + i * 8)
    def VERTEX_LONGITUDE_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 34)
    /// Vertex latitudes, geodetic degrees in [-90, 90]. Same length as
    /// VERTEX_LONGITUDE_DEG.
    def VERTEX_LATITUDE_DEG(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 36) + i * 8)
    def VERTEX_LATITUDE_DEG_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 36)
    /// Vertex altitudes, metres above ALTITUDE_REFERENCE. Absent when the
    /// geometry lies on the reference surface.
    def VERTEX_ALTITUDE_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 38) + i * 8)
    def VERTEX_ALTITUDE_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 38)
    def ALTITUDE_REFERENCE() -> cvpAltitudeReference:
        return cvpAltitudeReference(flatbuffers.field_int8(buf_, pos_, 40, 0))
    /// The constant altitude, metres, when ALTITUDE_REFERENCE is FIXED_ALTITUDE.
    def FIXED_ALTITUDE_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 42, 0.0)
    /// Ring start indexes; RING_COUNT + 1 entries, last equals the vertex count.
    def RING_OFFSETS(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 44) + i * 4)
    def RING_OFFSETS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 44)
    /// Polygon each ring belongs to. Same length as RING_COUNT.
    def RING_POLYGON_INDEXES(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 46) + i * 4)
    def RING_POLYGON_INDEXES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 46)
    /// Role of each ring. Same length as RING_COUNT.
    def RING_ROLES(i:int) -> cvpRingRole:
        return read_int8_le(buf_, buf_.flatbuffers.field_vector(pos_, 48) + i * 1)
    def RING_ROLES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 48)
    /// Number of polygons; equals max(RING_POLYGON_INDEXES) + 1 and is published
    /// so an empty coverage field (zero polygons, zero rings) is representable
    /// and distinguishable from an unpopulated record.
    def POLYGON_COUNT() -> int:
        return flatbuffers.field_uint32(buf_, pos_, 50, 0)
    /// Metric value each polygon is drawn at, in METRIC_UNITS. Same length as
    /// POLYGON_COUNT. Carried for ISO_METRIC_CONTOUR; for a THRESHOLD_CONTOUR
    /// every entry equals THRESHOLD_VALUE.
    def POLYGON_LEVEL_VALUES(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 52) + i * 8)
    def POLYGON_LEVEL_VALUES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 52)
    /// 1-sigma uncertainty of each polygon's level, same units and length.
    def POLYGON_LEVEL_UNCERTAINTIES(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 54) + i * 8)
    def POLYGON_LEVEL_UNCERTAINTIES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 54)
    /// Surface area enclosed by each polygon, square kilometres.
    def POLYGON_AREA_KM2(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 56) + i * 8)
    def POLYGON_AREA_KM2_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 56)
    /// Per-vertex 1-sigma horizontal uncertainty, metres. Same length as the
    /// vertex arrays. Absent means CVPUncertainty.HORIZONTAL_POSITION_M governs
    /// the whole boundary.
    def VERTEX_POSITION_UNCERTAINTY_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 58) + i * 8)
    def VERTEX_POSITION_UNCERTAINTY_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 58)
    /// Grid the field was sampled on before contouring, e.g. "H3" or
    /// "GEODETIC_LATLON". A contour is never finer than the grid behind it.
    def GRID_SCHEME() -> string:
        return flatbuffers.field_string(buf_, pos_, 60)
    /// Grid resolution in the scheme's own convention (H3 resolution 0-15).
    def GRID_RESOLUTION() -> int:
        return flatbuffers.field_uint8(buf_, pos_, 62, 0)
    /// Grid spacing in degrees, for a geodetic lat/lon grid.
    def GRID_SPACING_DEG() -> float:
        return flatbuffers.field_float64(buf_, pos_, 64, 0.0)
    /// Number of grid cells evaluated.
    def GRID_CELL_COUNT() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 66, 0)
    /// `$CVG.COVERAGE_ID` of the figure-of-merit grid this geometry was
    /// contoured from, when one was published.
    def CVG_COVERAGE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 68)
    /// `$RFL.RFL_ID` of the sample set the field was evaluated from, when one
    /// was published.
    def RFL_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 70)
    /// `$ACI.ACI_ID` of the interval set an availability or gap product was
    /// aggregated from, when one was published.
    def ACI_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 72)
    /// Emitters that contributed. Required: coverage with no stated emitter is
    /// an unattributable claim about the sky.
    def CONTRIBUTING_EMITTERS(i:int) -> CVPEmitterRef:
        return CVPEmitterRef { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 74) + i * 4) }
    def CONTRIBUTING_EMITTERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 74)
    /// Identifier of the receiver set this coverage is stated for.
    def RECEIVER_SET_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 76)
    /// The receivers themselves, when the set is enumerable.
    def RECEIVERS(i:int) -> CVPReceiverRef:
        return CVPReceiverRef { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 78) + i * 4) }
    def RECEIVERS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 78)
    /// 3D obstacles that clipped or shaped the boundary, each naming the `$RFS`
    /// material that produced its effect.
    def CONTRIBUTING_OBSTACLES(i:int) -> CVPObstacleRef:
        return CVPObstacleRef { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 80) + i * 4) }
    def CONTRIBUTING_OBSTACLES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 80)
    /// Identifier of the obstacle set used, when it is published as a set rather
    /// than enumerated here.
    def OBSTACLE_SET_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 82)
    /// The condition that bounds the boundary — why the contour is where it is.
    def LIMITING_CONSTRAINT() -> rflConstraint:
        return rflConstraint(flatbuffers.field_int8(buf_, pos_, 84, 0))
    /// Verbatim description, required when LIMITING_CONSTRAINT is OTHER.
    def LIMITING_CONSTRAINT_NOTE() -> string:
        return flatbuffers.field_string(buf_, pos_, 86)
    /// Uncertainty of level and boundary.
    def UNCERTAINTY() -> CVPUncertainty?:
        let o = flatbuffers.field_table(buf_, pos_, 88)
        return if o: CVPUncertainty { buf_, o } else: nil
    /// Provenance. Required.
    def PROVENANCE() -> CVPProvenance:
        let o = flatbuffers.field_table(buf_, pos_, 90)
        return CVPProvenance { buf_, assert o }
    /// Unix ms this record was serialized.
    def COMPUTED_AT() -> int:
        return flatbuffers.field_uint64(buf_, pos_, 92, 0)
    /// `$EPM` identifier of the producing node.
    def PRODUCER_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 94)
    /// Ed25519 signature by the producing `$EPM`.
    def SIGNATURE(i:int) -> int:
        return read_uint8_le(buf_, buf_.flatbuffers.field_vector(pos_, 96) + i * 1)
    def SIGNATURE_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 96)

def GetRootAsCVP(buf:string): return CVP { buf, flatbuffers.indirect(buf, 0) }

