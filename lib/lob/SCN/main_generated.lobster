/// Scenario - canonical scene composition and simulation state for external
/// scenario controls integrations. Domain records remain in their native SDS
/// schemas and are referenced or embedded here only as scenario content.
class SCN : flatbuffers.handle
    /// Stable id for the scenario.
    def SCENARIO_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// Objects, annotations, and variables included in the scenario.
    def REFERENCES(i:int) -> SCNReference:
        return SCNReference { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 6) + i * 4) }
    def REFERENCES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    /// Imported event payload associated with the scenario.
    def EVENT() -> SCNEvent?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: SCNEvent { buf_, o } else: nil
    /// Zero-based focused reference index, or -1 when no index is focused.
    def FOCUSED_REFERENCE_INDEX() -> int:
        return flatbuffers.field_int32(buf_, pos_, 10, -1)
    /// Reference id of the currently focused scenario object.
    def FOCUSED_REFERENCE_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 12)
    /// Current scenario epoch as an ISO-8601 UTC timestamp.
    def EPOCH() -> string:
        return flatbuffers.field_string(buf_, pos_, 14)
    /// Simulation time-rate multiplier.
    def SIM_SPEED() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, 0.0)
    /// True when the viewer should use a body-fixed display frame.
    def USE_BODY_FIXED_FRAME() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 18, 0))
    /// Authoritative reference frame used for scenario propagation and display.
    def REFERENCE_FRAME() -> RFM?:
        let o = flatbuffers.field_table(buf_, pos_, 20)
        return if o: RFM { buf_, o } else: nil
    /// Command action requested for the scenario.
    def ACTION() -> scenarioActionCode:
        return scenarioActionCode(flatbuffers.field_int8(buf_, pos_, 22, 0))
    /// Viewer camera and display state for the scenario.
    def VIEW_STATE() -> VST?:
        let o = flatbuffers.field_table(buf_, pos_, 24)
        return if o: VST { buf_, o } else: nil
    /// Asset-change notification payload for the scenario.
    def ASSETS_CHANGED() -> SCNAssetsChanged?:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return if o: SCNAssetsChanged { buf_, o } else: nil

def GetRootAsSCN(buf:string): return SCN { buf, flatbuffers.indirect(buf, 0) }

