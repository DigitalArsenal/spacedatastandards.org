        return this
    def add_HAS_RANGE_ERROR_BOUND_M(HAS_RANGE_ERROR_BOUND_M:bool):
        b_.PrependBoolSlot(13, HAS_RANGE_ERROR_BOUND_M, 0)
        return this
    def add_HAS_MODEL_ERROR_BOUND_S(HAS_MODEL_ERROR_BOUND_S:bool):
        b_.PrependBoolSlot(14, HAS_MODEL_ERROR_BOUND_S, 0)
        return this
    def add_HAS_ANALYSIS_SCOPE(HAS_ANALYSIS_SCOPE:bool):
        b_.PrependBoolSlot(15, HAS_ANALYSIS_SCOPE, 0)
        return this
    def add_HAS_TIMING(HAS_TIMING:bool):
        b_.PrependBoolSlot(16, HAS_TIMING, 0)
        return this
    def end():
        return b_.EndObject()

def CLGProvenanceStartSTATEBLOCKSHA256Vector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def CLGProvenanceCreateSTATEBLOCKSHA256Vector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

class CLGResult : flatbuffers.handle
    def STATUS() -> clgComputationState:
        return clgComputationState(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    def ERROR_CODE() -> string:
        return flatbuffers.field_string(buf_, pos_, 6)
    def ERROR_MESSAGE() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def CHUNK_INDEX() -> int:
        return flatbuffers.field_int32(buf_, pos_, 10, -1)
    def CHUNK_COUNT() -> int:
        return flatbuffers.field_int32(buf_, pos_, 12, -1)
    def DEFINITION_REF() -> CLGRecordRef?:
        let o = flatbuffers.field_table(buf_, pos_, 14)
        return if o: CLGRecordRef { buf_, o } else: nil
    /// Global dictionaries in chunk zero only, bounded to 64 MiB together.
    def PAIRS(i:int) -> CLGPair:
        return CLGPair { buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 20 }
    def PAIRS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    def LINKS(i:int) -> CLGLink:
        return CLGLink { buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 24 }
    def LINKS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Each interval and its boundary records live together in exactly one chunk.
    def BOUNDARIES(i:int) -> CLGBoundary:
        return CLGBoundary { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 20) + i * 4) }
    def BOUNDARIES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    def INTERVALS(i:int) -> CLGInterval:
        return CLGInterval { buf_, flatbuffers.field_vector(buf_, pos_, 22) + i * 72 }
    def INTERVALS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    def TRANSITIONS(i:int) -> CLGTransition:
        return CLGTransition { buf_, flatbuffers.field_vector(buf_, pos_, 24) + i * 24 }
    def TRANSITIONS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    def ADJACENCY(i:int) -> CLGAdjacency:
        return CLGAdjacency { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 26) + i * 4) }
    def ADJACENCY_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 26)
    /// Sorted unique TT emission epochs where the directed (src,dst,link) set
    /// changes after atomic transitions; always includes START_OFFSET_S.
    /// Each has a mandatory adjacency, independent of EMIT_EVENT_SNAPSHOTS.
    /// Chunk-local entries correspond to this chunk's snapshots; concatenate.
    def TOPOLOGY_CHANGE_EPOCHS_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 28) + i * 8)
    def TOPOLOGY_CHANGE_EPOCHS_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 28)
    def PROVENANCE() -> CLGProvenance?:
        let o = flatbuffers.field_table(buf_, pos_, 30)
        return if o: CLGProvenance { buf_, o } else: nil
    /// Host stamps PRODUCER_SHA256 from loaded artifact before durable COMPLETE.
    def PRODUCER() -> PVN?:
        let o = flatbuffers.field_table(buf_, pos_, 32)
        return if o: PVN { buf_, o } else: nil
    /// Value presence: false means omitted; true precedes value validation.
    def HAS_STATUS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 34, 0))
    def HAS_CHUNK_INDEX() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 36, 0))
    def HAS_CHUNK_COUNT() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 38, 0))

def GetRootAsCLGResult(buf:string): return CLGResult { buf, flatbuffers.indirect(buf, 0) }

struct CLGResultBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(18)
        return this
    def add_STATUS(STATUS:clgComputationState):
        b_.PrependUint8Slot(0, STATUS, 0)
        return this
    def add_ERROR_CODE(ERROR_CODE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(1, ERROR_CODE)
        return this
    def add_ERROR_MESSAGE(ERROR_MESSAGE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, ERROR_MESSAGE)
        return this
    def add_CHUNK_INDEX(CHUNK_INDEX:int):
        b_.PrependInt32Slot(3, CHUNK_INDEX, -1)
        return this
    def add_CHUNK_COUNT(CHUNK_COUNT:int):
        b_.PrependInt32Slot(4, CHUNK_COUNT, -1)
        return this
    def add_DEFINITION_REF(DEFINITION_REF:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(5, DEFINITION_REF)
        return this
    def add_PAIRS(PAIRS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(6, PAIRS)
        return this
    def add_LINKS(LINKS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(7, LINKS)
        return this
    def add_BOUNDARIES(BOUNDARIES:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(8, BOUNDARIES)
        return this
    def add_INTERVALS(INTERVALS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(9, INTERVALS)
        return this
    def add_TRANSITIONS(TRANSITIONS:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(10, TRANSITIONS)
        return this
    def add_ADJACENCY(ADJACENCY:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(11, ADJACENCY)
        return this
    def add_TOPOLOGY_CHANGE_EPOCHS_S(TOPOLOGY_CHANGE_EPOCHS_S:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(12, TOPOLOGY_CHANGE_EPOCHS_S)
        return this
    def add_PROVENANCE(PROVENANCE:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(13, PROVENANCE)
        return this
    def add_PRODUCER(PRODUCER:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(14, PRODUCER)
        return this
    def add_HAS_STATUS(HAS_STATUS:bool):
        b_.PrependBoolSlot(15, HAS_STATUS, 0)
        return this
    def add_HAS_CHUNK_INDEX(HAS_CHUNK_INDEX:bool):
        b_.PrependBoolSlot(16, HAS_CHUNK_INDEX, 0)
        return this
    def add_HAS_CHUNK_COUNT(HAS_CHUNK_COUNT:bool):
        b_.PrependBoolSlot(17, HAS_CHUNK_COUNT, 0)
        return this
    def end():
        return b_.EndObject()

def CLGResultStartPAIRSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(20, n_, 4)

def CLGResultStartLINKSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(24, n_, 4)

def CLGResultStartBOUNDARIESVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(4, n_, 4)
def CLGResultCreateBOUNDARIESVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

def CLGResultStartINTERVALSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(72, n_, 8)

def CLGResultStartTRANSITIONSVector(b_:flatbuffers.builder, n_:int):
