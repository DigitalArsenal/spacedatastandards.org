    def MAX_RANGE_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 22, nan)
    /// MECHANICAL only: finite positive rates/acceleration with true HAS flags.
    def MAX_SLEW_RATE_RAD_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 24, nan)
    def MAX_ANGULAR_ACCELERATION_RAD_S2() -> float:
        return flatbuffers.field_float64(buf_, pos_, 26, nan)
    def ACQUISITION_MAX_RATE_RAD_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 28, nan)
    /// MECHANICAL only: finite >=0; explicit zero has a true HAS flag.
    def ACQUISITION_TIME_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 30, nan)
    def SETTLE_TIME_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 32, nan)
    /// ELECTRONIC only: HAS_BEAM_SWITCH_TIME_S=false requests no modeled delay;
    /// a true flag with zero specifies
    /// zero delay. Applicability and omission are preserved in provenance.
    def BEAM_SWITCH_TIME_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 34, nan)
    def MAX_SIMULTANEOUS_LINKS() -> int:
        return flatbuffers.field_int32(buf_, pos_, 36, -1)
    def INDEPENDENT_BEAMS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 38, 0))
    def POINTING() -> clgPointingArchitecture:
        return clgPointingArchitecture(flatbuffers.field_uint8(buf_, pos_, 40, 0))
    /// Bidirectional retarded COMMON_AXIS requires finite positive separation
    /// tolerance stated by user, backed by DEFINITION_REFS. No implied zero.
    /// Retarded COMMON_AXIS profiles require positive value even in a one-way run.
    def MAX_POINT_AHEAD_RAD() -> float:
        return flatbuffers.field_float64(buf_, pos_, 42, nan)
    /// Value presence: false means omitted; true precedes value validation.
    def HAS_MEDIUM() -> bool:
