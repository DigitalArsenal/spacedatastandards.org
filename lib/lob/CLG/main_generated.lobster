        b_.PrependBoolSlot(7, HAS_BRACKET_LO_S, 0)
        return this
    def add_HAS_BRACKET_HI_S(HAS_BRACKET_HI_S:bool):
        b_.PrependBoolSlot(8, HAS_BRACKET_HI_S, 0)
        return this
    def end():
        return b_.EndObject()

def CLGBoundaryStartCAUSESVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(16, n_, 4)

def CLGBoundaryStartRAYTIMESVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(48, n_, 8)

/// START/STOP/READY_FROM are emission TT offsets (docs/clg-contract.md section 3a).
/// Packed scalars are present iff HAS_VALUES=true, otherwise invalid.
/// READY_FROM_S is present iff HAS_READY_FROM=true (no silent zero readiness).
class CLGInterval : flatbuffers.handle
    def START_S() -> float:
        return buf_.read_float64_le(pos_ + 0)
    def STOP_S() -> float:
        return buf_.read_float64_le(pos_ + 8)
    def MIN_RANGE_M() -> float:
        return buf_.read_float64_le(pos_ + 16)
    def MAX_RANGE_M() -> float:
        return buf_.read_float64_le(pos_ + 24)
    def READY_FROM_S() -> float:
        return buf_.read_float64_le(pos_ + 32)
    def PAIR_INDEX() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 40 }
    def START_BOUNDARY_INDEX() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 48 }
    def STOP_BOUNDARY_INDEX() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 56 }
    def HAS_VALUES() -> bool:
        return buf_.read_int8_le(pos_ + 64)
    def HAS_READY_FROM() -> bool:
        return buf_.read_int8_le(pos_ + 65)

def CreateCLGInterval(b_:flatbuffers.builder, START_S:float, STOP_S:float, MIN_RANGE_M:float, MAX_RANGE_M:float, READY_FROM_S:float, PAIR_INDEX_VALUE:int, PAIR_INDEX_HAS_VALUE:bool, START_BOUNDARY_INDEX_VALUE:int, START_BOUNDARY_INDEX_HAS_VALUE:bool, STOP_BOUNDARY_INDEX_VALUE:int, STOP_BOUNDARY_INDEX_HAS_VALUE:bool, HAS_VALUES:bool, HAS_READY_FROM:bool):
    b_.Prep(8, 72)
    b_.Pad(6)
    b_.PrependBool(HAS_READY_FROM)
    b_.PrependBool(HAS_VALUES)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(STOP_BOUNDARY_INDEX_HAS_VALUE)
    b_.PrependUint32(STOP_BOUNDARY_INDEX_VALUE)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(START_BOUNDARY_INDEX_HAS_VALUE)
    b_.PrependUint32(START_BOUNDARY_INDEX_VALUE)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(PAIR_INDEX_HAS_VALUE)
    b_.PrependUint32(PAIR_INDEX_VALUE)
    b_.PrependFloat64(READY_FROM_S)
    b_.PrependFloat64(MAX_RANGE_M)
    b_.PrependFloat64(MIN_RANGE_M)
    b_.PrependFloat64(STOP_S)
    b_.PrependFloat64(START_S)
    return b_.Offset()

/// Deduplicated tuple (PAIR_INDEX,SLOT_A,SLOT_B), reused across acquisitions.
class CLGLink : flatbuffers.handle
    def PAIR_INDEX() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 0 }
    def SLOT_A() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 8 }
    def SLOT_B() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 16 }

def CreateCLGLink(b_:flatbuffers.builder, PAIR_INDEX_VALUE:int, PAIR_INDEX_HAS_VALUE:bool, SLOT_A_VALUE:int, SLOT_A_HAS_VALUE:bool, SLOT_B_VALUE:int, SLOT_B_HAS_VALUE:bool):
    b_.Prep(4, 24)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(SLOT_B_HAS_VALUE)
    b_.PrependUint32(SLOT_B_VALUE)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(SLOT_A_HAS_VALUE)
    b_.PrependUint32(SLOT_A_VALUE)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(PAIR_INDEX_HAS_VALUE)
    b_.PrependUint32(PAIR_INDEX_VALUE)
    return b_.Offset()

class CLGTransition : flatbuffers.handle
    /// Physical scheduling event in TT. ACTIVE/DRAIN bound emission service;
    /// retarded RELEASE follows the latest demanded reception, including tails.
    def TIME_S() -> float:
        return buf_.read_float64_le(pos_ + 0)
    def LINK_INDEX() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 8 }
    def STAGE() -> clgTransitionStage:
        return clgTransitionStage(buf_.read_uint8_le(pos_ + 16))
    def CAUSE() -> clgBoundaryCause:
        return clgBoundaryCause(buf_.read_uint8_le(pos_ + 17))
    def HAS_TIME() -> bool:
        return buf_.read_int8_le(pos_ + 18)
    def HAS_STAGE() -> bool:
        return buf_.read_int8_le(pos_ + 19)
    def HAS_CAUSE() -> bool:
        return buf_.read_int8_le(pos_ + 20)

def CreateCLGTransition(b_:flatbuffers.builder, TIME_S:float, LINK_INDEX_VALUE:int, LINK_INDEX_HAS_VALUE:bool, STAGE:clgTransitionStage, CAUSE:clgBoundaryCause, HAS_TIME:bool, HAS_STAGE:bool, HAS_CAUSE:bool):
    b_.Prep(8, 24)
    b_.Pad(3)
    b_.PrependBool(HAS_CAUSE)
    b_.PrependBool(HAS_STAGE)
    b_.PrependBool(HAS_TIME)
    b_.PrependUint8(CAUSE)
    b_.PrependUint8(STAGE)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(LINK_INDEX_HAS_VALUE)
    b_.PrependUint32(LINK_INDEX_VALUE)
    b_.PrependFloat64(TIME_S)
    return b_.Offset()

class CLGAdjacency : flatbuffers.handle
    /// Common emission query in TT; equal-time transitions already applied.
    def EPOCH_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 4, nan)
    def ORIGIN() -> clgSnapshotOrigin:
        return clgSnapshotOrigin(flatbuffers.field_uint8(buf_, pos_, 6, 0))
    /// Exactly N+1 entries, starting zero and ending at arc count.
    def ROW_OFFSETS(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 8) + i * 4)
    def ROW_OFFSETS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 8)
    /// One outgoing arc per directed ACTIVE link, two per bidirectional link.
    def NEIGHBOR_NODE_INDEXES(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 10) + i * 4)
    def NEIGHBOR_NODE_INDEXES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 10)
    def LINK_INDEXES(i:int) -> int:
        return read_uint32_le(buf_, buf_.flatbuffers.field_vector(pos_, 12) + i * 4)
    def LINK_INDEXES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// Parallel to arcs; computed natively for that directed ray at EPOCH_S.
    /// SIMULTANEOUS: same-epoch range and range/c; reception epoch equals EPOCH_S.
    /// RETARDED: null-path range, coordinate vacuum flight time, reception TT.
    def RANGES_M(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 8)
    def RANGES_M_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    def LIGHT_TIMES_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 8)
    def LIGHT_TIMES_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    def RECEPTION_EPOCHS_S(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 18) + i * 8)
    def RECEPTION_EPOCHS_S_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    /// Value presence: false means omitted; true precedes value validation.
    def HAS_EPOCH_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 20, 0))
    def HAS_ORIGIN() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 22, 0))

def GetRootAsCLGAdjacency(buf:string): return CLGAdjacency { buf, flatbuffers.indirect(buf, 0) }

