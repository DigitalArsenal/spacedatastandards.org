class CLGBlackout : flatbuffers.handle
    def TERMINAL_INDEX() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 0 }
    def START_S() -> float:
        return buf_.read_float64_le(pos_ + 8)
    def STOP_S() -> float:
        return buf_.read_float64_le(pos_ + 16)
    def HAS_TIMES() -> bool:
        return buf_.read_int8_le(pos_ + 24)

def CreateCLGBlackout(b_:flatbuffers.builder, TERMINAL_INDEX_VALUE:int, TERMINAL_INDEX_HAS_VALUE:bool, START_S:float, STOP_S:float, HAS_TIMES:bool):
    b_.Prep(8, 32)
    b_.Pad(7)
    b_.PrependBool(HAS_TIMES)
    b_.PrependFloat64(STOP_S)
    b_.PrependFloat64(START_S)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(TERMINAL_INDEX_HAS_VALUE)
    b_.PrependUint32(TERMINAL_INDEX_VALUE)
    return b_.Offset()

