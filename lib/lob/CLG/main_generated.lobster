def CLGResultCreateADJACENCYVector(b_:flatbuffers.builder, v_:[flatbuffers.offset]):
    b_.StartVector(4, v_.length, 4)
    reverse(v_) e_: b_.PrependUOffsetTRelative(e_)
    return b_.EndVector(v_.length)

def CLGResultStartTOPOLOGYCHANGEEPOCHSSVector(b_:flatbuffers.builder, n_:int):
    b_.StartVector(8, n_, 8)
def CLGResultCreateTOPOLOGYCHANGEEPOCHSSVector(b_:flatbuffers.builder, v_:[float]):
    b_.StartVector(8, v_.length, 8)
    reverse(v_) e_: b_.PrependFloat64(e_)
    return b_.EndVector(v_.length)

/// Exactly one payload; every frame uses the same GRAPH_ID. COMPLETE requires
/// all chunks, definition, implemented scope/enums and host-stamped producer.
class CLG : flatbuffers.handle
    /// Globally unique across exchanging producers/stores; names one dictionary
    /// forever. A known ID with a different definition SHA256 is rejected,
    /// never merged or rebound. docs/clg-contract.md section 2 defines allocation and hashing.
    def GRAPH_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    def PAYLOAD() -> clgPayloadClass:
        return clgPayloadClass(flatbuffers.field_uint8(buf_, pos_, 6, 0))
    def DEFINITION() -> CLGDefinition?:
        let o = flatbuffers.field_table(buf_, pos_, 8)
        return if o: CLGDefinition { buf_, o } else: nil
    def STATE_BLOCK() -> CLGStateBlock?:
        let o = flatbuffers.field_table(buf_, pos_, 10)
        return if o: CLGStateBlock { buf_, o } else: nil
    def RESULT() -> CLGResult?:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return if o: CLGResult { buf_, o } else: nil
    /// Value presence: false means omitted; true precedes value validation.
    def HAS_PAYLOAD() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 14, 0))

def GetRootAsCLG(buf:string): return CLG { buf, flatbuffers.indirect(buf, 0) }

struct CLGBuilder:
    b_:flatbuffers.builder
    def start():
        b_.StartObject(6)
        return this
    def add_GRAPH_ID(GRAPH_ID:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(0, GRAPH_ID)
        return this
    def add_PAYLOAD(PAYLOAD:clgPayloadClass):
        b_.PrependUint8Slot(1, PAYLOAD, 0)
        return this
    def add_DEFINITION(DEFINITION:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(2, DEFINITION)
        return this
    def add_STATE_BLOCK(STATE_BLOCK:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(3, STATE_BLOCK)
        return this
    def add_RESULT(RESULT:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, RESULT)
        return this
    def add_HAS_PAYLOAD(HAS_PAYLOAD:bool):
        b_.PrependBoolSlot(5, HAS_PAYLOAD, 0)
        return this
    def end():
        return b_.EndObject()
