/// u=(t-START_S)/(STOP_S-START_S), ascending power coefficients axis-major.
/// Position length=3*(DEGREE+1), SI. Quaternion length=4*(DEGREE+1), xyzw,
/// required for bodies and SUPPLIED_SERIES nodes; absent for evaluated laws.
/// Q/||Q|| defines rotation. Sign-continuous representative, normalized C2
/// rotation and angular derivatives checked using explicit join tolerances.
class CLGPoseSegment : flatbuffers.handle
    def OWNER() -> clgOwnerCategory:
        return clgOwnerCategory(flatbuffers.field_uint8(buf_, pos_, 4, 0))
    def OWNER_INDEX() -> int:
        return flatbuffers.field_int32(buf_, pos_, 6, -1)
    def START_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, nan)
    def STOP_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, nan)
    def DEGREE() -> int:
        return flatbuffers.field_int32(buf_, pos_, 12, -1)
    def POSITION_COEFFICIENTS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 14) + i * 8)
    def POSITION_COEFFICIENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    def QUATERNION_COEFFICIENTS(i:int) -> float:
        return read_float64_le(buf_, buf_.flatbuffers.field_vector(pos_, 16) + i * 8)
    def QUATERNION_COEFFICIENTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Value presence: false means omitted; true precedes value validation.
    def HAS_OWNER() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 18, 0))
    def HAS_OWNER_INDEX() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 20, 0))
    def HAS_START_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 22, 0))
    def HAS_STOP_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 24, 0))
    def HAS_DEGREE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))

