        return this
    def add_BRACKET_HI_S(BRACKET_HI_S:float):
        b_.PrependFloat64Slot(3, BRACKET_HI_S, nan)
        return this
    def add_CAUSES(CAUSES:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(4, CAUSES)
        return this
    def add_RAY_TIMES(RAY_TIMES:flatbuffers.offset):
        b_.PrependUOffsetTRelativeSlot(5, RAY_TIMES)
        return this
    def add_HAS_OFFSET_S(HAS_OFFSET_S:bool):
        b_.PrependBoolSlot(6, HAS_OFFSET_S, 0)
        return this
