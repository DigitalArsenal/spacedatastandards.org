class CLGDefinition : flatbuffers.handle
    /// Two-part JD TT, integer noon-based day plus seconds [0,86400).
    def EPOCH_JD_TT_DAY() -> int:
        return flatbuffers.field_int64(buf_, pos_, 4, -1)
    def EPOCH_JD_TT_SECONDS() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, nan)
    /// ALL offsets incl. source halos satisfy abs(offset)<2^22 seconds.
    /// Longer analyses split/re-epoch definitions; never use year-long doubles.
    def START_OFFSET_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, nan)
    def STOP_OFFSET_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, nan)
    /// SIMULTANEOUS may use fixed axes. RETARDED requires SSB/ICRF inertial
    /// coordinates or a declared constant-velocity inertial transform thereof.
    /// GCRS-like local approximation needs certified model error; rotating
    /// body-fixed axes and a moving body center are not inertial ray coordinates.
    def WORKING_FRAME() -> RFMCoordinateSystem:
        let o = flatbuffers.field_table(buf_, pos_, 12)
        return RFMCoordinateSystem { buf_, assert o }
    def BODIES(i:int) -> CLGBody:
        return CLGBody { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 14) + i * 4) }
    def BODIES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    def SOURCES(i:int) -> CLGSource:
        return CLGSource { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 16) + i * 4) }
    def SOURCES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 16)
    /// Dense index = vector position; ascending exact UTF-8 NODE_ID bytes.
    /// Immutable for the graph, including all state blocks and result chunks.
    def NODES(i:int) -> CLGNode:
        return CLGNode { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 18) + i * 4) }
    def NODES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 18)
    def PROFILES(i:int) -> CLGTerminalProfile:
        return CLGTerminalProfile { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 20) + i * 4) }
    def PROFILES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 20)
    /// Ascending (NODE_INDEX, exact UTF-8 TERMINAL_ID bytes); unique IDs.
    def TERMINALS(i:int) -> CLGTerminal:
        return CLGTerminal { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 22) + i * 4) }
    def TERMINALS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 22)
    def BLACKOUTS(i:int) -> CLGBlackout:
        return CLGBlackout { buf_, flatbuffers.field_vector(buf_, pos_, 24) + i * 32 }
    def BLACKOUTS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 24)
    def CONTROLS() -> CLGControls:
        let o = flatbuffers.field_table(buf_, pos_, 26)
        return CLGControls { buf_, assert o }
    /// Value presence: false means omitted; true precedes value validation.
    def HAS_EPOCH_JD_TT_DAY() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 28, 0))
    def HAS_EPOCH_JD_TT_SECONDS() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 30, 0))
    def HAS_START_OFFSET_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 32, 0))
    def HAS_STOP_OFFSET_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 34, 0))

