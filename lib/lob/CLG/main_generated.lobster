        return flatbuffers.field_string(buf_, pos_, 10)
    def DEFINITION_REFS(i:int) -> CLGRecordRef:
        return CLGRecordRef { buf_, flatbuffers.indirect(buf_, flatbuffers.field_vector(buf_, pos_, 12) + i * 4) }
    def DEFINITION_REFS_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    def STEERING() -> clgSteeringClass:
        return clgSteeringClass(flatbuffers.field_uint8(buf_, pos_, 14, 0))
    def REGARD() -> clgRegardGeometry:
        return clgRegardGeometry(flatbuffers.field_uint8(buf_, pos_, 16, 0))
    /// Mount +Z boresight, +X right, +Y up. SCV angles are degrees.
    /// Shape radial fields zero; bounds below are authoritative SI values.
    def SHAPE() -> SCVSensorShapeContract?:
        let o = flatbuffers.field_table(buf_, pos_, 18)
        return if o: SCVSensorShapeContract { buf_, o } else: nil
