/// A is the endpoint with the lexicographically smaller (NODE_ID,TERMINAL_ID)
/// exact UTF-8 byte tuple, B the larger; distinct nodes, canonical A<B indexes.
/// Reversed fields or noncanonical dictionaries fail, never reverse direction.
/// Sorted by (A,B,DIRECTION); requested direction only.
class CLGPair : flatbuffers.handle
    def TERMINAL_A() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 0 }
    def TERMINAL_B() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 8 }
    def DIRECTION() -> clgLinkDirection:
        return clgLinkDirection(buf_.read_uint8_le(pos_ + 16))
    def HAS_DIRECTION() -> bool:
        return buf_.read_int8_le(pos_ + 17)

def CreateCLGPair(b_:flatbuffers.builder, TERMINAL_A_VALUE:int, TERMINAL_A_HAS_VALUE:bool, TERMINAL_B_VALUE:int, TERMINAL_B_HAS_VALUE:bool, DIRECTION:clgLinkDirection, HAS_DIRECTION:bool):
    b_.Prep(4, 20)
    b_.Pad(2)
    b_.PrependBool(HAS_DIRECTION)
    b_.PrependUint8(DIRECTION)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(TERMINAL_B_HAS_VALUE)
    b_.PrependUint32(TERMINAL_B_VALUE)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(TERMINAL_A_HAS_VALUE)
    b_.PrependUint32(TERMINAL_A_VALUE)
    return b_.Offset()

/// All co-causes retained, sorted by enum ordinal, ray direction, body index.
/// BODY_INDEX supplied for OCCULTATION, HORIZON_A/B and TERRAIN_A/B only.
/// No ambiguous zero body.
class CLGCause : flatbuffers.handle
    def KIND() -> clgBoundaryCause:
        return clgBoundaryCause(buf_.read_uint8_le(pos_ + 0))
    def DIRECTION() -> clgRayDirection:
        return clgRayDirection(buf_.read_uint8_le(pos_ + 1))
    def BODY_INDEX() -> CLGIndex:
        return CLGIndex{ buf_, pos_ + 4 }
    def HAS_KIND() -> bool:
        return buf_.read_int8_le(pos_ + 12)
    def HAS_DIRECTION() -> bool:
        return buf_.read_int8_le(pos_ + 13)

def CreateCLGCause(b_:flatbuffers.builder, KIND:clgBoundaryCause, DIRECTION:clgRayDirection, BODY_INDEX_VALUE:int, BODY_INDEX_HAS_VALUE:bool, HAS_KIND:bool, HAS_DIRECTION:bool):
    b_.Prep(4, 16)
    b_.Pad(2)
    b_.PrependBool(HAS_DIRECTION)
    b_.PrependBool(HAS_KIND)
    b_.Prep(4, 8)
    b_.Pad(3)
    b_.PrependBool(BODY_INDEX_HAS_VALUE)
    b_.PrependUint32(BODY_INDEX_VALUE)
    b_.Pad(2)
    b_.PrependUint8(DIRECTION)
    b_.PrependUint8(KIND)
    return b_.Offset()

/// One demanded ray at an interval boundary, TT offsets from graph epoch.
/// Emission equals boundary OFFSET_S. Reception bracket encloses the mapped
/// emission bracket and light-time solve error; SIMULTANEOUS uses equal times.
class CLGRayTimes : flatbuffers.handle
    def DIRECTION() -> clgRayDirection:
        return clgRayDirection(buf_.read_uint8_le(pos_ + 0))
    def EMISSION_S() -> float:
        return buf_.read_float64_le(pos_ + 8)
    def RECEPTION_S() -> float:
        return buf_.read_float64_le(pos_ + 16)
    def RECEPTION_BRACKET_LO_S() -> float:
        return buf_.read_float64_le(pos_ + 24)
    def RECEPTION_BRACKET_HI_S() -> float:
        return buf_.read_float64_le(pos_ + 32)
    def HAS_VALUES() -> bool:
        return buf_.read_int8_le(pos_ + 40)

def CreateCLGRayTimes(b_:flatbuffers.builder, DIRECTION:clgRayDirection, EMISSION_S:float, RECEPTION_S:float, RECEPTION_BRACKET_LO_S:float, RECEPTION_BRACKET_HI_S:float, HAS_VALUES:bool):
    b_.Prep(8, 48)
    b_.Pad(7)
    b_.PrependBool(HAS_VALUES)
    b_.PrependFloat64(RECEPTION_BRACKET_HI_S)
    b_.PrependFloat64(RECEPTION_BRACKET_LO_S)
    b_.PrependFloat64(RECEPTION_S)
    b_.PrependFloat64(EMISSION_S)
    b_.Pad(7)
    b_.PrependUint8(DIRECTION)
    return b_.Offset()

/// Local to a result chunk. Distinct event clusters never merged by tolerance.
/// Certified root brackets overlap only for a proved common event, otherwise
/// refine to disjoint brackets or fail. A common event retains every cause.
class CLGBoundary : flatbuffers.handle
    def PAIR_INDEX() -> CLGIndex?:
        let o = flatbuffers.field_struct(buf_, pos_, 4)
        return if o: CLGIndex { buf_, o } else: nil
    /// Emission clock for every demanded ray, including both duplex rays.
    def OFFSET_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 6, nan)
    def BRACKET_LO_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 8, nan)
    def BRACKET_HI_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, nan)
    def CAUSES(i:int) -> CLGCause:
        return CLGCause { buf_, flatbuffers.field_vector(buf_, pos_, 12) + i * 16 }
    def CAUSES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 12)
    /// Exactly the demanded direction(s), A_TO_B before B_TO_A; no duplicates.
    def RAY_TIMES(i:int) -> CLGRayTimes:
        return CLGRayTimes { buf_, flatbuffers.field_vector(buf_, pos_, 14) + i * 48 }
    def RAY_TIMES_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 14)
    /// Value presence: false means omitted; true precedes value validation.
    def HAS_OFFSET_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 16, 0))
    def HAS_BRACKET_LO_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 18, 0))
    def HAS_BRACKET_HI_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 20, 0))

def GetRootAsCLGBoundary(buf:string): return CLGBoundary { buf, flatbuffers.indirect(buf, 0) }

struct CLGBoundaryBuilder:
    b_:flatbuffers.builder
