/// Module-known values only; host identity is separate PVN on CLGResult.
class CLGProvenance : flatbuffers.handle
    def DEFINITION_SHA256() -> string:
        return flatbuffers.field_string(buf_, pos_, 4)
    /// One 64-character lowercase hex digest per block in sequence order.
    def STATE_BLOCK_SHA256(i:int) -> string:
        return flatbuffers.string(buf_, buf_.flatbuffers.field_vector(pos_, 6) + i * 4)
    def STATE_BLOCK_SHA256_length() -> int:
        return flatbuffers.field_vector_len(buf_, pos_, 6)
    def ALGORITHM_ID() -> string:
        return flatbuffers.field_string(buf_, pos_, 8)
    def ROOT_ERROR_BOUND_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 10, nan)
    def SOURCE_ERROR_BOUND_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 12, nan)
    def FRAME_TIME_ERROR_BOUND_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 14, nan)
    def RANGE_ERROR_BOUND_M() -> float:
        return flatbuffers.field_float64(buf_, pos_, 16, nan)
    /// Mandatory, >= max compatible range/c for SIMULTANEOUS, and increased
    /// when needed to bound actual model discrepancy; interbody simultaneous fails.
    def MODEL_ERROR_BOUND_S() -> float:
        return flatbuffers.field_float64(buf_, pos_, 18, nan)
    def ANALYSIS_SCOPE() -> clgAnalysisScope:
        return clgAnalysisScope(flatbuffers.field_uint8(buf_, pos_, 20, 0))
    def TIMING() -> clgPropagationTiming:
        return clgPropagationTiming(flatbuffers.field_uint8(buf_, pos_, 22, 0))
    /// Value presence: false means omitted; true precedes value validation.
    def HAS_ROOT_ERROR_BOUND_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 24, 0))
    def HAS_SOURCE_ERROR_BOUND_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 26, 0))
    def HAS_FRAME_TIME_ERROR_BOUND_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 28, 0))
    def HAS_RANGE_ERROR_BOUND_M() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 30, 0))
    def HAS_MODEL_ERROR_BOUND_S() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 32, 0))
    def HAS_ANALYSIS_SCOPE() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 34, 0))
    def HAS_TIMING() -> bool:
        return bool(flatbuffers.field_int8(buf_, pos_, 36, 0))

