{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "PolarizationType" : {
      "type" : "string",
      "enum": ["linear", "circular", "elliptical", "unpolarized"]
    },
    "SimplePolarization" : {
      "type" : "string",
      "enum": ["vertical", "horizontal", "leftHandCircular", "rightHandCircular"]
    },
    "DataMode" : {
      "type" : "string",
      "enum": ["EXERCISE", "REAL", "SIMULATED", "TEST"]
    },
    "DeviceType" : {
      "type" : "string",
      "enum": ["UNKNOWN", "OPTICAL", "INFRARED_SENSOR", "ULTRAVIOLET_SENSOR", "X_RAY_SENSOR", "GAMMA_RAY_SENSOR", "RADAR", "PHASED_ARRAY_RADAR", "SYNTHETIC_APERTURE_RADAR", "BISTATIC_RADIO_TELESCOPE", "RADIO_TELESCOPE", "ATMOSPHERIC_SENSOR", "SPACE_WEATHER_SENSOR", "ENVIRONMENTAL_SENSOR", "SEISMIC_SENSOR", "GRAVIMETRIC_SENSOR", "MAGNETIC_SENSOR", "ELECTROMAGNETIC_SENSOR", "THERMAL_SENSOR", "CHEMICAL_SENSOR", "BIOLOGICAL_SENSOR", "RADIATION_SENSOR", "PARTICLE_DETECTOR", "LIDAR", "SONAR", "TELESCOPE", "SPECTROSCOPIC_SENSOR", "PHOTOMETRIC_SENSOR", "POLARIMETRIC_SENSOR", "INTERFEROMETRIC_SENSOR", "MULTISPECTRAL_SENSOR", "HYPERSPECTRAL_SENSOR", "GPS_RECEIVER", "RADIO_COMMUNICATIONS", "LASER_COMMUNICATIONS", "SATELLITE_COMMUNICATIONS", "LASER_INSTRUMENT", "RF_ANALYZER", "IONOSPHERIC_SENSOR", "LASER_IMAGING", "OPTICAL_TELESCOPE", "HIGH_RESOLUTION_OPTICAL", "RADIO", "MICROWAVE_TRANSMITTER", "RF_MONITOR", "HF_RADIO_COMMUNICATIONS"]
    },
    "pvnSourceKind" : {
      "type" : "string",
      "enum": ["Unspecified", "ElementSet", "Ephemeris", "Observation", "Reference"]
    },
    "pvnLicenseClass" : {
      "type" : "string",
      "enum": ["Unspecified", "Reproducible", "CiteOnly", "ShareAlike", "NonCommercial"]
    },
    "SiteType" : {
      "type" : "string",
      "enum": ["LAUNCH_SITE", "OBSERVATION_STATION", "HOBBYIST_OBSERVER", "RESEARCH_FACILITY", "SATELLITE_GROUND_STATION", "SPACEPORT", "MILITARY_BASE", "WEATHER_STATION", "ASTRONOMICAL_OBSERVATORY", "EDUCATIONAL_INSTITUTE", "COMMUNICATION_HUB", "POWER_PLANT", "INDUSTRIAL_COMPLEX", "TRANSPORTATION_HUB", "URBAN_AREA", "NATIONAL_PARK", "HISTORICAL_SITE", "OTHER"]
    },
    "siteLifecycleStatus" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "PLANNED", "UNDER_CONSTRUCTION", "CONSTRUCTION_SUSPENDED", "OPERATING", "LONG_TERM_SHUTDOWN", "PERMANENT_SHUTDOWN", "DECOMMISSIONING", "DECOMMISSIONED", "CANCELLED", "UNVERIFIED"]
    },
    "sitReferenceRole" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "RECORD", "OFFICIAL_WEBSITE", "ENCYCLOPEDIA_ARTICLE", "REGISTRY_RECORD", "REGULATORY_DOCKET"]
    },
    "sitPartyRole" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "OPERATOR", "OWNER", "REGULATOR"]
    },
    "sitQuantityKind" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "ELECTRICAL_CAPACITY", "THERMAL_POWER", "REACTOR_UNITS", "ELEVATION"]
    },
    "FrequencyRange" : {
      "type" : "object",
      "description" : "Frequency range with lower and upper limits",
      "properties" : {
        "LOWER" : {
                "type" : "number",
                "description" : "Lower frequency in MHz"
              },
        "UPPER" : {
                "type" : "number",
                "description" : "Upper frequency in MHz"
              }
      },
      "additionalProperties" : false
    },
    "StokesParameters" : {
      "type" : "object",
      "description" : "Stokes parameters, representing different aspects of polarization",
      "properties" : {
        "I" : {
                "type" : "number",
                "description" : "Intensity"
              },
        "Q" : {
                "type" : "number",
                "description" : "Linear polarization"
              },
        "U" : {
                "type" : "number",
                "description" : "Another linear polarization, orthogonal to Q"
              },
        "V" : {
                "type" : "number",
                "description" : "Circular polarization"
              }
      },
      "additionalProperties" : false
    },
    "Band" : {
      "type" : "object",
      "description" : "Table representing a frequency band with a name and frequency range",
      "properties" : {
        "NAME" : {
                "type" : "string",
                "description" : "Name of the band"
              },
        "FREQUENCY_RANGE" : {
                "$ref" : "#/definitions/FrequencyRange",
                "description" : "Frequency range of the band"
              }
      },
      "additionalProperties" : false
    },
    "IDM" : {
      "type" : "object",
      "description" : "Integrated Device Message",
      "properties" : {
        "ID" : {
                "type" : "string",
                "description" : "Unique identifier for the EMT"
              },
        "NAME" : {
                "type" : "string",
                "description" : "Name of the EMT"
              },
        "DATA_MODE" : {
                "$ref" : "#/definitions/DataMode",
                "description" : "Mode of the data (real, simulated, synthetic)"
              },
        "UPLINK" : {
                "$ref" : "#/definitions/FrequencyRange",
                "description" : "Uplink frequency range"
              },
        "DOWNLINK" : {
                "$ref" : "#/definitions/FrequencyRange",
                "description" : "Downlink frequency range"
              },
        "BEACON" : {
                "$ref" : "#/definitions/FrequencyRange",
                "description" : "Beacon frequency range"
              },
        "BAND" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/Band"},
                "description" : "Bands associated with the EMT"
              },
        "POLARIZATION_TYPE" : {
                "$ref" : "#/definitions/PolarizationType",
                "description" : "Type of polarization used"
              },
        "SIMPLE_POLARIZATION" : {
                "$ref" : "#/definitions/SimplePolarization",
                "description" : "Simple polarization configuration"
              },
        "STOKES_PARAMETERS" : {
                "$ref" : "#/definitions/StokesParameters",
                "description" : "Stokes parameters for polarization characterization"
              },
        "POWER_REQUIRED" : {
                "type" : "number",
                "description" : "Power required in Watts"
              },
        "POWER_TYPE" : {
                "type" : "string",
                "description" : "Type of power (eg. AC or DC)"
              },
        "TRANSMIT" : {
                "type" : "boolean",
                "description" : "Indicates if the EMT can transmit"
              },
        "RECEIVE" : {
                "type" : "boolean",
                "description" : "Indicates if the EMT can receive"
              },
        "SENSOR_TYPE" : {
                "$ref" : "#/definitions/DeviceType",
                "description" : "Type of the sensor"
              },
        "SOURCE" : {
                "type" : "string",
                "description" : "Source of the data"
              },
        "LAST_OB_TIME" : {
                "type" : "string",
                "description" : "Timestamp of the last observation"
              },
        "LOWER_LEFT_ELEVATION_LIMIT" : {
                "type" : "number",
                "description" : "Lower left elevation limit"
              },
        "UPPER_LEFT_AZIMUTH_LIMIT" : {
                "type" : "number",
                "description" : "Upper left azimuth limit"
              },
        "LOWER_RIGHT_ELEVATION_LIMIT" : {
                "type" : "number",
                "description" : "Lower right elevation limit"
              },
        "LOWER_LEFT_AZIMUTH_LIMIT" : {
                "type" : "number",
                "description" : "Lower left azimuth limit"
              },
        "UPPER_RIGHT_ELEVATION_LIMIT" : {
                "type" : "number",
                "description" : "Upper right elevation limit"
              },
        "UPPER_RIGHT_AZIMUTH_LIMIT" : {
                "type" : "number",
                "description" : "Upper right azimuth limit"
              },
        "LOWER_RIGHT_AZIMUTH_LIMIT" : {
                "type" : "number",
                "description" : "Lower right azimuth limit"
              },
        "UPPER_LEFT_ELEVATION_LIMIT" : {
                "type" : "number",
                "description" : "Upper left elevation limit"
              },
        "RIGHT_GEO_BELT_LIMIT" : {
                "type" : "number",
                "description" : "Right geostationary belt limit"
              },
        "LEFT_GEO_BELT_LIMIT" : {
                "type" : "number",
                "description" : "Left geostationary belt limit"
              },
        "MAGNITUDE_LIMIT" : {
                "type" : "number",
                "description" : "Magnitude limit of the sensor"
              },
        "TASKABLE" : {
                "type" : "boolean",
                "description" : "Indicates if the site is taskable"
              }
      },
      "additionalProperties" : false
    },
    "PVN" : {
      "type" : "object",
      "description" : "Product Provenance",
      "properties" : {
        "SOURCE_ID" : {
                "type" : "string",
                "description" : "Publisher-stable, lowercase identifier of the source in the provider's\nregistry of sources."
              },
        "SOURCE_KIND" : {
                "$ref" : "#/definitions/pvnSourceKind",
                "description" : "What kind of data the source supplies."
              },
        "ORIGINATOR" : {
                "type" : "string",
                "description" : "Agency, operator or catalog that created the source data, as it names\nitself. Not a message's CCSDS ORIGINATOR, which names who created the\nmessage."
              },
        "PROVIDER_ID" : {
                "type" : "string",
                "description" : "Identifier of the provider that published the product, as the provider\nnames itself: the module, node or service that retrieved the source data."
              },
        "PRODUCER" : {
                "type" : "string",
                "description" : "Identifier of the software that made the product from the source data,\nwith its version when it has one."
              },
        "LICENSE_CLASS" : {
                "$ref" : "#/definitions/pvnLicenseClass",
                "description" : "What the source's terms permit for the product."
              },
        "LICENSE_ID" : {
                "type" : "string",
                "description" : "Identifier of the terms LICENSE_CLASS was read from: an SPDX license\nidentifier where one applies, else the identifier of the terms in the\nprovider's licence register."
              },
        "LINEAGE" : {
                "type" : "string",
                "description" : "Identifier of the lineage the source's data descends from. Sources that\nrepublish one upstream share its lineage, so their products are not\nindependent of each other."
              }
      },
      "additionalProperties" : false
    },
    "SITCitation" : {
      "type" : "object",
      "description" : "Where one statement about a site was read: the source, the record, the\nversion of the record and the field the statement came from.",
      "properties" : {
        "PROVENANCE" : {
                "$ref" : "#/definitions/PVN",
                "description" : "The source, its originator and the terms the statement travels under"
              },
        "SOURCE_RECORD_ID" : {
                "type" : "string",
                "description" : "The source's own identifier of the record (Wikidata QID, \"de:Article\ntitle\", tracker unit ids, ROR id, docket number, register row)"
              },
        "SOURCE_URL" : {
                "type" : "string",
                "description" : "Where the record can be read"
              },
        "SOURCE_VERSION" : {
                "type" : "string",
                "description" : "The source's version of the record (revision id, release name)"
              },
        "SOURCE_FIELD" : {
                "type" : "string",
                "description" : "The field of the record the statement was read from, from a closed\nvocabulary: a Wikidata property (\"P5817\", \"P576\"), \"infobox:<parameter>\",\n\"description\", \"class:<QID>\", \"status\" (a registry's status column),\n\"units\" (a tracker's unit statuses), \"register:<id>\" (a row of the\nprovider's reviewed register). Never free text."
              },
        "RETRIEVED_AT" : {
                "type" : "string",
                "description" : "When the record was read, RFC 3339 UTC"
              }
      },
      "additionalProperties" : false
    },
    "SITStatusEvidence" : {
      "type" : "object",
      "description" : "One source's assertion of one lifecycle step of a site.",
      "properties" : {
        "STATUS" : {
                "$ref" : "#/definitions/siteLifecycleStatus",
                "description" : "The status the source states"
              },
        "STATUS_DATE" : {
                "type" : "string",
                "description" : "When that status took effect, ISO 8601 at the source's precision (YYYY, YYYY-MM or YYYY-MM-DD)"
              },
        "CITATION" : {
                "$ref" : "#/definitions/SITCitation",
                "description" : "Where the statement was read"
              }
      },
      "additionalProperties" : false
    },
    "SITReference" : {
      "type" : "object",
      "description" : "A reference to another record about the site or a party.",
      "properties" : {
        "ROLE" : {
                "$ref" : "#/definitions/sitReferenceRole",
                "description" : "What the referenced record is"
              },
        "REGISTRY" : {
                "type" : "string",
                "description" : "Publisher-stable, lowercase identifier of the registry in the provider's\nregister of sources (wikidata, geonames, enwiki, gem-gnpt, ror, us-nrc)"
              },
        "RECORD_ID" : {
                "type" : "string",
                "description" : "The registry's identifier of the record"
              },
        "URL" : {
                "type" : "string",
                "description" : "Where the record can be read"
              },
        "TITLE" : {
                "type" : "string",
                "description" : "The record's title as the registry states it (for an encyclopedia, the\narticle title only, never its text)"
              },
        "LANGUAGE" : {
                "type" : "string",
                "description" : "Language of the record, BCP 47"
              }
      },
      "additionalProperties" : false
    },
    "SITParty" : {
      "type" : "object",
      "description" : "An organisation with a part at the site.",
      "properties" : {
        "ROLE" : {
                "$ref" : "#/definitions/sitPartyRole",
                "description" : "The part it plays"
              },
        "NAME" : {
                "type" : "string",
                "description" : "Its name, as the source states it"
              },
        "EXTERNAL_REFERENCES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/SITReference"},
                "description" : "Records about the party (its registry record, its official website)"
              },
        "CITATION" : {
                "$ref" : "#/definitions/SITCitation",
                "description" : "Where the statement that it plays this part was read"
              }
      },
      "additionalProperties" : false
    },
    "SITQuantity" : {
      "type" : "object",
      "description" : "One stated quantity of a site.",
      "properties" : {
        "KIND" : {
                "$ref" : "#/definitions/sitQuantityKind",
                "description" : "What it measures"
              },
        "VALUE" : {
                "type" : "number",
                "description" : "Its value"
              },
        "UNITS" : {
                "type" : "string",
                "description" : "Units, CCSDS NDM spelling (MW, m); empty for a count"
              },
        "DATE" : {
                "type" : "string",
                "description" : "When the value applies, ISO 8601 at the source's precision; empty when the source states none"
              },
        "CITATION" : {
                "$ref" : "#/definitions/SITCitation",
                "description" : "Where it was read"
              }
      },
      "additionalProperties" : false
    },
    "Geometry" : {
      "type" : "object",
      "description" : "Geometry table with information about geometric properties",
      "properties" : {
        "GEOMETRY_TYPE" : {
                "type" : "string",
                "description" : "Type of geometry"
              },
        "COORDINATES" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Coordinates of the geometry"
              }
      },
      "additionalProperties" : false
    },
    "SIT" : {
      "type" : "object",
      "description" : "Site Information Message",
      "properties" : {
        "ID" : {
                "type" : "string",
                "description" : "Unique identifier for the site, BE_NUMBER"
              },
        "NAME" : {
                "type" : "string",
                "description" : "Name of the site"
              },
        "ABBREVIATION" : {
                "type" : "string",
                "description" : "Abbreviation"
              },
        "SITE_TYPE" : {
                "$ref" : "#/definitions/SiteType",
                "description" : "Site type as defined in SiteType enum"
              },
        "CATCODE" : {
                "type" : "string",
                "description" : "Site type CATCODE"
              },
        "NETWORK" : {
                "type" : "string",
                "description" : "Network identifier"
              },
        "LATITUDE" : {
                "type" : "number",
                "description" : "Latitude of the site"
              },
        "LONGITUDE" : {
                "type" : "number",
                "description" : "Longitude of the site"
              },
        "ALTITUDE" : {
                "type" : "number",
                "description" : "Altitude of the site"
              },
        "GEOMETRY" : {
                "$ref" : "#/definitions/Geometry",
                "description" : "Geometry of the site"
              },
        "CENTER_POINT_GEOMETRY" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Center point geometry coordinates"
              },
        "CLASSIFICATION" : {
                "type" : "string",
                "description" : "Classification marking of the site"
              },
        "CTR_ID" : {
                "type" : "string",
                "description" : "CTR ISO 3166 Numeric code as string"
              },
        "CREATED_BY" : {
                "type" : "string",
                "description" : "Identifier of the user who created the site data"
              },
        "DESCRIPTION" : {
                "type" : "string",
                "description" : "Description of the site"
              },
        "MODEL_URL" : {
                "type" : "string",
                "description" : "URL for the 3D model of the site"
              },
        "SOURCE" : {
                "type" : "string",
                "description" : "Source of the site data"
              },
        "TASKABLE" : {
                "type" : "boolean",
                "description" : "Indicates if the site is taskable"
              },
        "OPERATIONAL_STATUS" : {
                "type" : "string",
                "description" : "Operational status of the site (e.g., active, inactive, under construction)"
              },
        "ESTABLISHMENT_DATE" : {
                "type" : "string",
                "description" : "Date of establishment"
              },
        "CONTACT_INFO" : {
                "type" : "string",
                "description" : "Contact information for the site"
              },
        "ENVIRONMENTAL_IMPACT" : {
                "type" : "string",
                "description" : "Environmental impact or considerations"
              },
        "ACCESSIBILITY_INFRA" : {
                "type" : "string",
                "description" : "Accessibility and infrastructure details"
              },
        "INTEGRATED_DEVICES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/IDM"},
                "description" : "Vector of Integrated Devices (IDM)"
              },
        "LIFECYCLE_STATUS" : {
                "$ref" : "#/definitions/siteLifecycleStatus",
                "description" : "Where the site stands in its life. OPERATIONAL_STATUS keeps availability\nwords (Online, Offline, Testing); this field is the lifecycle."
              },
        "LIFECYCLE_STATUS_DATE" : {
                "type" : "string",
                "description" : "When LIFECYCLE_STATUS took effect, ISO 8601 at the source's precision"
              },
        "STATUS_VERIFIED_AT" : {
                "type" : "string",
                "description" : "When the status was last checked against its sources, RFC 3339 UTC"
              },
        "STATUS_EVIDENCE" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/SITStatusEvidence"},
                "description" : "Each source's assertion behind LIFECYCLE_STATUS, one per source and step"
              },
        "SITE_KIND" : {
                "type" : "string",
                "description" : "What kind of site this is, as its source names the class (\"research\nreactor\", \"radioactive waste repository\"); SITE_TYPE is the nearest\nSiteType"
              },
        "DESCRIPTION_LANGUAGE" : {
                "type" : "string",
                "description" : "Language of DESCRIPTION, BCP 47"
              },
        "DESCRIPTION_CITATION" : {
                "$ref" : "#/definitions/SITCitation",
                "description" : "Where DESCRIPTION was read; a DESCRIPTION without one is the publisher's own"
              },
        "POSITION_CITATION" : {
                "$ref" : "#/definitions/SITCitation",
                "description" : "Where LATITUDE, LONGITUDE (and ALTITUDE) were read"
              },
        "EXTERNAL_REFERENCES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/SITReference"},
                "description" : "Records about the site in other registers; the RECORD role names the\nsite's own record"
              },
        "PARTIES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/SITParty"},
                "description" : "Operators, owners and regulators"
              },
        "QUANTITIES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/SITQuantity"},
                "description" : "Stated quantities (capacity, power, units, elevation)"
              },
        "PROVENANCE" : {
                "$ref" : "#/definitions/PVN",
                "description" : "The record's provider and producer, and the terms of the content the\nrecord reproduces (each citation carries its own source's terms)"
              }
      },
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/SIT"
}
