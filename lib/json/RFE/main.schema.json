{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "rfeEmissionMaskClass" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "IN_BAND", "OUT_OF_BAND", "SPURIOUS", "HARMONIC", "BROADBAND_NOISE", "CONDUCTED", "RADIATED", "SUSCEPTIBILITY"]
    },
    "rfeEmissionPath" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "ANTENNA_PORT", "POWER_LEAD", "SIGNAL_LEAD", "ENCLOSURE", "FREE_SPACE", "STRUCTURE"]
    },
    "emitterType" : {
      "type" : "string",
      "enum": ["RADAR", "COMMUNICATIONS", "NAVIGATION", "JAMMER", "BEACON", "TRANSPONDER", "DATA_LINK", "TELEMETRY", "EW", "UNKNOWN"]
    },
    "signalModulation" : {
      "type" : "string",
      "enum": ["CW", "PULSE", "FMCW", "CHIRP", "BPSK", "QPSK", "FSK", "AM", "FM", "SPREAD_SPECTRUM", "PHASED_ARRAY", "AGILE", "UNKNOWN"]
    },
    "RFEEmissionMaskPoint" : {
      "type" : "object",
      "description" : "One point of an emission-limit curve. FREQUENCY_OFFSET_HZ is signed and is\nrelative to RFEEmissionMask.REFERENCE_FREQUENCY_HZ. VALUE is expressed in\nthe mask's required UNITS.",
      "properties" : {
        "FREQUENCY_OFFSET_HZ" : {
                "type" : "number"
              },
        "VALUE" : {
                "type" : "number"
              }
      },
      "additionalProperties" : false
    },
    "RFEProvenance" : {
      "type" : "object",
      "description" : "Provenance of an emitter descriptor or emission mask. Capability schemas\ncarry model names and citations as data so the IDL remains provider-neutral.",
      "properties" : {
        "SOURCE" : {
                "type" : "string"
              },
        "SOURCE_QUERY" : {
                "type" : "string"
              },
        "MODEL_NAME" : {
                "type" : "string"
              },
        "MODEL_VERSION" : {
                "type" : "string"
              },
        "CITATION" : {
                "type" : "string"
              },
        "MODULE_ID" : {
                "type" : "string"
              },
        "MODULE_VERSION" : {
                "type" : "string"
              },
        "MODULE_CONTENT_HASH" : {
                "type" : "string"
              },
        "COMPUTED_AT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              }
      },
      "required" : ["SOURCE"],
      "additionalProperties" : false
    },
    "RFEEmissionMask" : {
      "type" : "object",
      "description" : "A replayable spurious, harmonic, out-of-band, noise, conducted, radiated,\nor susceptibility limit curve.",
      "properties" : {
        "MASK_ID" : {
                "type" : "string"
              },
        "NAME" : {
                "type" : "string"
              },
        "CLASS" : {
                "$ref" : "#/definitions/rfeEmissionMaskClass"
              },
        "PATH" : {
                "$ref" : "#/definitions/rfeEmissionPath"
              },
        "UNITS" : {
                "type" : "string",
                "description" : "Unit token applying to every point VALUE, for example dBW, dBW/Hz, dBuV,\nor dBuA. A point with no unit is not publishable."
              },
        "REFERENCE_FREQUENCY_HZ" : {
                "type" : "number"
              },
        "REFERENCE_BANDWIDTH_HZ" : {
                "type" : "number"
              },
        "POINTS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/RFEEmissionMaskPoint"}
              },
        "PROVENANCE" : {
                "$ref" : "#/definitions/RFEProvenance"
              }
      },
      "required" : ["MASK_ID", "UNITS", "POINTS", "PROVENANCE"],
      "additionalProperties" : false
    },
    "rfEmitterDetail" : {
      "type" : "object",
      "description" : "RF Emitter Detail Record",
      "properties" : {
        "MODE_NAME" : {
                "type" : "string",
                "description" : "Mode name or identifier"
              },
        "FREQUENCY" : {
                "type" : "number",
                "description" : "Center frequency in MHz"
              },
        "FREQ_MIN" : {
                "type" : "number",
                "description" : "Frequency minimum in MHz"
              },
        "FREQ_MAX" : {
                "type" : "number",
                "description" : "Frequency maximum in MHz"
              },
        "PRI" : {
                "type" : "number",
                "description" : "Pulse repetition interval in microseconds"
              },
        "PRI_MIN" : {
                "type" : "number",
                "description" : "PRI minimum in microseconds"
              },
        "PRI_MAX" : {
                "type" : "number",
                "description" : "PRI maximum in microseconds"
              },
        "PULSE_WIDTH" : {
                "type" : "number",
                "description" : "Pulse width in microseconds"
              },
        "PW_MIN" : {
                "type" : "number",
                "description" : "Pulse width minimum in microseconds"
              },
        "PW_MAX" : {
                "type" : "number",
                "description" : "Pulse width maximum in microseconds"
              },
        "SCAN_PERIOD" : {
                "type" : "number",
                "description" : "Scan period in seconds"
              },
        "ERP" : {
                "type" : "number",
                "description" : "Effective radiated power in dBW"
              },
        "MODULATION" : {
                "$ref" : "#/definitions/signalModulation",
                "description" : "Signal modulation"
              },
        "ANTENNA_PATTERN" : {
                "type" : "string",
                "description" : "Antenna pattern type"
              },
        "BEAMWIDTH" : {
                "type" : "number",
                "description" : "3dB beamwidth in degrees"
              },
        "EMISSION_MASKS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/RFEEmissionMask"},
                "description" : "Emission and susceptibility limit curves applicable to this operating\nmode. Curves are evaluated in point order after sorting by frequency."
              }
      },
      "additionalProperties" : false
    },
    "RFE" : {
      "type" : "object",
      "description" : "RF Emitter",
      "properties" : {
        "ID" : {
                "type" : "string",
                "description" : "Unique emitter identifier"
              },
        "ID_ENTITY" : {
                "type" : "string",
                "description" : "Reference to parent entity"
              },
        "NAME" : {
                "type" : "string",
                "description" : "Emitter name or designation"
              },
        "TYPE" : {
                "$ref" : "#/definitions/emitterType",
                "description" : "Emitter type"
              },
        "ENTITY" : {
                "type" : "string",
                "description" : "Parent entity designator"
              },
        "ELNOT" : {
                "type" : "string",
                "description" : "ELNOT (Electronic Notation)"
              },
        "NATO_NAME" : {
                "type" : "string",
                "description" : "NATO reporting name"
              },
        "PLATFORM_TYPE" : {
                "type" : "string",
                "description" : "Platform type (e.g., SHIP, AIRCRAFT, GROUND, SATELLITE)"
              },
        "COUNTRY" : {
                "type" : "string",
                "description" : "Country of origin"
              },
        "FUNCTION" : {
                "type" : "string",
                "description" : "Primary function description"
              },
        "BAND" : {
                "type" : "string",
                "description" : "Operating band (e.g., HF, VHF, UHF, L, S, C, X, Ku, Ka)"
              },
        "FREQ_MIN" : {
                "type" : "number",
                "description" : "Minimum operating frequency in MHz"
              },
        "FREQ_MAX" : {
                "type" : "number",
                "description" : "Maximum operating frequency in MHz"
              },
        "PEAK_POWER" : {
                "type" : "number",
                "description" : "Peak power in kW"
              },
        "AVG_POWER" : {
                "type" : "number",
                "description" : "Average power in kW"
              },
        "ANTENNA_GAIN" : {
                "type" : "number",
                "description" : "Antenna gain in dBi"
              },
        "NUM_MODES" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Number of operating modes"
              },
        "RF_EMITTER_DETAILS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/rfEmitterDetail"},
                "description" : "Emitter operating mode details"
              },
        "THREAT_LEVEL" : {
                "type" : "string",
                "description" : "Threat level assessment"
              },
        "NOTES" : {
                "type" : "string",
                "description" : "Additional notes"
              },
        "PROVENANCE" : {
                "$ref" : "#/definitions/RFEProvenance",
                "description" : "Provenance of the root emitter descriptor."
              },
        "COMPUTED_AT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615,
                "description" : "Unix ms this record was serialized."
              },
        "PRODUCER_ID" : {
                "type" : "string",
                "description" : "`$EPM` identifier of the producing node."
              },
        "SIGNATURE" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" :255},
                "description" : "Ed25519 signature over the size-prefixed FlatBuffer with both 64-byte\nsignature payloads zeroed while preserving their vectors and offsets."
              },
        "CANONICAL_JSON_SIGNATURE" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" :255},
                "description" : "Ed25519 signature over canonical JSON with IDL field order and\ncapitalization, no insignificant whitespace, and both signature fields\nomitted."
              }
      },
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/RFE"
}
