{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "tmxPhenomenologyKind" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "ORBITAL_KINETIC", "CO_ORBITAL_RPO", "DIRECT_ASCENT_ASAT", "RF_EW_GNSS", "OPTICAL_DIRECTED_ENERGY", "SPACE_ENV_RADIATION", "GROUND_CUSTODY_CYBER"]
    },
    "tmxSeverityLevel" : {
      "type" : "string",
      "enum": ["UNAVAILABLE", "NOMINAL", "WATCH", "HIGH", "CRITICAL"]
    },
    "tmxExecutionHostKind" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "BROWSER_LOCAL", "SDN_COMPUTE_NODE"]
    },
    "tmxModuleRunStatus" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "OK", "PARTIAL", "UNAVAILABLE", "NOT_PUBLIC"]
    },
    "tmxBucketKind" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "CONSTELLATION", "SHELL", "PLANE", "ASSET", "GATEWAY"]
    },
    "tmxPropagatorKind" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "SDN_AP", "SGP4_XP", "SGP4"]
    },
    "tmxCertaintyLevel" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "MEASURED", "PUBLISHED", "KINEMATIC_BOUND", "STATED_WHATIF", "NOT_PUBLIC"]
    },
    "TMXRequest" : {
      "type" : "object",
      "description" : "Invocation request payload carried inside $PIV (PIVRequest.INPUTS) or local execution.",
      "properties" : {
        "REQUEST_ID" : {
                "type" : "string",
                "description" : "Unique identifier of this matrix evaluation request."
              },
        "TARGET_SCOPE" : {
                "type" : "string",
                "description" : "Target scope selector (e.g. constellation name, group, or \"CUSTOM\")."
              },
        "TARGET_NORAD_CAT_IDS" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" : 4294967295},
                "description" : "Explicit NORAD catalog numbers requested for screening."
              },
        "GROUP_IDS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Entity group ($EGP) identifiers requested for screening."
              },
        "CATALOG_REVISION" : {
                "type" : "string",
                "description" : "Catalog revision or snapshot identifier pinned for parity."
              },
        "WINDOW_START" : {
                "type" : "string",
                "description" : "Inclusive analysis window start, RFC 3339 UTC."
              },
        "WINDOW_END" : {
                "type" : "string",
                "description" : "Exclusive analysis window end, RFC 3339 UTC."
              },
        "PROPAGATOR" : {
                "$ref" : "#/definitions/tmxPropagatorKind",
                "description" : "Selected propagator theory."
              },
        "PROPAGATOR_ID" : {
                "type" : "string",
                "description" : "Canonical propagator module identifier (e.g. \"propagator/sdn-ap\")."
              },
        "EXECUTION_HOST" : {
                "$ref" : "#/definitions/tmxExecutionHostKind",
                "description" : "Target execution host kind."
              },
        "PHENOMENOLOGIES_REQUESTED" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/tmxPhenomenologyKind"},
                "description" : "Subset of phenomenologies to evaluate; empty requests all 7."
              },
        "THP_IDS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Threat profile identifiers ($THP.THP_ID) to include."
              },
        "THP_CIDS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Content identifiers pinning exact $THP payloads."
              },
        "SCORING_PROFILE_ID" : {
                "type" : "string",
                "description" : "Named deterministic scoring profile identifier."
              },
        "INCLUDE_COAS" : {
                "type" : "boolean",
                "description" : "True to synthesize and attach defensive COAs alongside matrix output."
              },
        "WHAT_IF_OVERRIDES_JSON" : {
                "type" : "string",
                "description" : "Optional serialized parameter overrides for analyst what-if runs."
              }
      },
      "required" : ["REQUEST_ID", "TARGET_SCOPE", "WINDOW_START", "WINDOW_END"],
      "additionalProperties" : false
    },
    "TMXBucket" : {
      "type" : "object",
      "description" : "Target aggregation bucket (constellation, shell, plane, asset, or gateway).",
      "properties" : {
        "BUCKET_ID" : {
                "type" : "string",
                "description" : "Stable identifier of this bucket within the matrix run."
              },
        "PARENT_BUCKET_ID" : {
                "type" : "string",
                "description" : "Optional parent bucket identifier in the hierarchy."
              },
        "BUCKET_KIND" : {
                "$ref" : "#/definitions/tmxBucketKind",
                "description" : "Granularity kind of this bucket."
              },
        "LABEL" : {
                "type" : "string",
                "description" : "Human-readable bucket label."
              },
        "ASSET_COUNT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Number of assets represented by this bucket."
              },
        "NORAD_CAT_IDS" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" : 4294967295},
                "description" : "Member NORAD catalog numbers when enumerated."
              },
        "ALTITUDE_MIN_KM" : {
                "type" : "number",
                "description" : "Minimum shell altitude in km."
              },
        "ALTITUDE_MAX_KM" : {
                "type" : "number",
                "description" : "Maximum shell altitude in km."
              },
        "INCLINATION_DEG" : {
                "type" : "number",
                "description" : "Representative orbital inclination in degrees."
              }
      },
      "required" : ["BUCKET_ID", "LABEL"],
      "additionalProperties" : false
    },
    "TMXPhenomenologyWeight" : {
      "type" : "object",
      "description" : "Deterministic weight and severity thresholds for one phenomenology (in basis points 0..10000).",
      "properties" : {
        "PHENOMENOLOGY" : {
                "$ref" : "#/definitions/tmxPhenomenologyKind",
                "description" : "Phenomenology configured by this entry."
              },
        "WEIGHT_BPS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Composite rollup weight in basis points (nominal sum across evaluated phenomenologies = 10000)."
              },
        "CRITICAL_THRESHOLD_BPS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Score threshold in basis points for CRITICAL tier."
              },
        "HIGH_THRESHOLD_BPS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Score threshold in basis points for HIGH tier."
              },
        "WATCH_THRESHOLD_BPS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Score threshold in basis points for WATCH tier."
              }
      },
      "additionalProperties" : false
    },
    "TMXCompoundRule" : {
      "type" : "object",
      "description" : "Deterministic compound-overlap scoring rule across co-occurring phenomenologies.",
      "properties" : {
        "RULE_ID" : {
                "type" : "string",
                "description" : "Stable rule identifier."
              },
        "PHENOMENOLOGIES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/tmxPhenomenologyKind"},
                "description" : "Set of phenomenologies whose temporal/spatial overlap triggers this rule."
              },
        "BONUS_BPS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Additive bonus in basis points (0..2500)."
              },
        "MULTIPLIER_BPS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Multiplicative factor in basis points (e.g. 10000 = 1.00x, 12500 = 1.25x)."
              }
      },
      "required" : ["RULE_ID"],
      "additionalProperties" : false
    },
    "TMXModuleRun" : {
      "type" : "object",
      "description" : "Execution telemetry and attribution for one phenomenology analyzer in this run.",
      "properties" : {
        "PHENOMENOLOGY" : {
                "$ref" : "#/definitions/tmxPhenomenologyKind",
                "description" : "Phenomenology axis produced by this module."
              },
        "MODULE_ID" : {
                "type" : "string",
                "description" : "Canonical module identifier (e.g. \"analysis/asat-reach\")."
              },
        "MODULE_VERSION" : {
                "type" : "string",
                "description" : "Module semantic version string."
              },
        "WASM_SHA256" : {
                "type" : "string",
                "description" : "Lowercase hex SHA-256 of the executed portable WASM artifact."
              },
        "STATUS" : {
                "$ref" : "#/definitions/tmxModuleRunStatus",
                "description" : "Outcome status of this module invocation."
              },
        "WALL_TIME_MS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Measured execution wall time in milliseconds."
              },
        "REFUSAL_REASON" : {
                "type" : "string",
                "description" : "Explicit refusal or degradation reason when STATUS is not OK."
              }
      },
      "required" : ["MODULE_ID"],
      "additionalProperties" : false
    },
    "TMXRecordRef" : {
      "type" : "object",
      "description" : "Reference to a supporting underlying SDS record without duplicating its payload.",
      "properties" : {
        "SCHEMA_FILE_ID" : {
                "type" : "string",
                "description" : "Four-character SDS file identifier including \"$\", e.g. \"$CDM\", \"$ACW\", \"$RFL\", \"$RDE\", \"$THP\"."
              },
        "RECORD_ID" : {
                "type" : "string",
                "description" : "Record identifier within the referenced SDS standard."
              },
        "NORAD_CAT_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Optional NORAD catalog number associated with the event."
              },
        "EPOCH" : {
                "type" : "string",
                "description" : "Event epoch or peak timestamp, RFC 3339 UTC."
              },
        "METRIC_LABEL" : {
                "type" : "string",
                "description" : "Primary metric label (e.g. \"MISS_DISTANCE_KM\", \"DOSE_MSV_H\", \"J_S_DB\")."
              },
        "METRIC_VALUE" : {
                "type" : "number",
                "description" : "Primary metric numeric value."
              },
        "METRIC_UNITS" : {
                "type" : "string",
                "description" : "Physical units string for METRIC_VALUE."
              }
      },
      "required" : ["SCHEMA_FILE_ID", "RECORD_ID"],
      "additionalProperties" : false
    },
    "TMXCell" : {
      "type" : "object",
      "description" : "Single (bucket x phenomenology) cell in the threat matrix.",
      "properties" : {
        "BUCKET_ID" : {
                "type" : "string",
                "description" : "Target bucket identifier referencing TMXBucket.BUCKET_ID."
              },
        "PHENOMENOLOGY" : {
                "$ref" : "#/definitions/tmxPhenomenologyKind",
                "description" : "Phenomenology axis for this cell."
              },
        "SEVERITY_TIER" : {
                "$ref" : "#/definitions/tmxSeverityLevel",
                "description" : "Categorical severity tier for this cell."
              },
        "PHENOMENOLOGY_SCORE" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Deterministic fixed-point severity score in basis points (0..10000)."
              },
        "EXPOSED_ASSET_COUNT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Count of unique assets exposed in this cell."
              },
        "PEAK_SIMULTANEOUS_COUNT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Peak simultaneous exposed asset count over the window."
              },
        "EARLIEST_ONSET_UTC" : {
                "type" : "string",
                "description" : "Earliest threat onset timestamp in the window, RFC 3339 UTC."
              },
        "TOTAL_EXPOSURE_MIN" : {
                "type" : "number",
                "description" : "Total accumulated exposure duration in minutes."
              },
        "WORST_METRIC_SUMMARY" : {
                "type" : "string",
                "description" : "Compact human-readable worst-case metric summary."
              },
        "CERTAINTY_FLOOR" : {
                "$ref" : "#/definitions/tmxCertaintyLevel",
                "description" : "Minimum epistemic certainty across contributing threat inputs."
              },
        "EVENT_REFS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXRecordRef"},
                "description" : "Underlying SDS event references supporting this cell."
              }
      },
      "required" : ["BUCKET_ID"],
      "additionalProperties" : false
    },
    "TMXCompoundEvent" : {
      "type" : "object",
      "description" : "Overlapping multi-phenomenology compound threat event on an asset, site, or bucket.",
      "properties" : {
        "COMPOUND_ID" : {
                "type" : "string",
                "description" : "Stable identifier of this compound overlap event."
              },
        "BUCKET_ID" : {
                "type" : "string",
                "description" : "Bucket identifier where the overlap occurs."
              },
        "NORAD_CAT_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Optional NORAD catalog number of the affected asset."
              },
        "SITE_ID" : {
                "type" : "string",
                "description" : "Optional ground site or gateway identifier."
              },
        "PHENOMENOLOGIES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/tmxPhenomenologyKind"},
                "description" : "Co-occurring phenomenologies participating in the overlap."
              },
        "MEMBER_EVENT_REFS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXRecordRef"},
                "description" : "Member SDS event references forming this compound event."
              },
        "OVERLAP_START_UTC" : {
                "type" : "string",
                "description" : "Inclusive overlap window start, RFC 3339 UTC."
              },
        "OVERLAP_END_UTC" : {
                "type" : "string",
                "description" : "Exclusive overlap window end, RFC 3339 UTC."
              },
        "COMPOUND_MULTIPLIER_BPS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Applied compound multiplier in basis points."
              },
        "COMPOUND_BONUS_BPS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Applied compound bonus in basis points."
              },
        "COMBINED_SCORE" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Final deterministic combined score in basis points (0..10000)."
              },
        "SEVERITY_TIER" : {
                "$ref" : "#/definitions/tmxSeverityLevel",
                "description" : "Resulting categorical severity tier."
              }
      },
      "required" : ["COMPOUND_ID", "BUCKET_ID", "OVERLAP_START_UTC", "OVERLAP_END_UTC"],
      "additionalProperties" : false
    },
    "TMXRollup" : {
      "type" : "object",
      "description" : "Deterministic composite rollup across all evaluated phenomenologies for a bucket.",
      "properties" : {
        "BUCKET_ID" : {
                "type" : "string",
                "description" : "Target bucket identifier referencing TMXBucket.BUCKET_ID."
              },
        "WORST_TIER" : {
                "$ref" : "#/definitions/tmxSeverityLevel",
                "description" : "Worst severity tier observed across evaluated phenomenologies."
              },
        "COMPOSITE_SCORE" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Final composite score in basis points (0..10000)."
              },
        "BASE_WEIGHTED_SCORE" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Pre-bonus weighted average score in basis points (0..10000)."
              },
        "COMPOUND_BONUS_APPLIED_BPS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Compound overlap bonus applied in basis points."
              },
        "EVALUATED_COUNT" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Number of phenomenologies successfully evaluated for this bucket."
              },
        "TOTAL_PHENOMENOLOGIES" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Total phenomenology axes configured in the matrix."
              },
        "COVERAGE_RATIO" : {
                "type" : "string",
                "description" : "Coverage string such as \"7/7\"."
              },
        "TOP_THREAT_REFS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXRecordRef"},
                "description" : "Highest-severity underlying SDS event references for quick drill-down."
              }
      },
      "required" : ["BUCKET_ID"],
      "additionalProperties" : false
    },
    "TMX" : {
      "type" : "object",
      "description" : "Multi-Phenomenology Threat Matrix",
      "properties" : {
        "RUN_ID" : {
                "type" : "string",
                "description" : "Unique run identifier for this threat matrix assessment."
              },
        "CREATED_UTC" : {
                "type" : "string",
                "description" : "Creation timestamp of this chunk/run, RFC 3339 UTC."
              },
        "WINDOW_START" : {
                "type" : "string",
                "description" : "Inclusive analysis window start, RFC 3339 UTC."
              },
        "WINDOW_END" : {
                "type" : "string",
                "description" : "Exclusive analysis window end, RFC 3339 UTC."
              },
        "PROPAGATOR" : {
                "$ref" : "#/definitions/tmxPropagatorKind",
                "description" : "Ephemeris propagator theory used for this run."
              },
        "PROPAGATOR_ID" : {
                "type" : "string",
                "description" : "Canonical propagator module identifier."
              },
        "EXECUTION_HOST" : {
                "$ref" : "#/definitions/tmxExecutionHostKind",
                "description" : "Execution host that computed this matrix."
              },
        "SCORING_PROFILE_ID" : {
                "type" : "string",
                "description" : "Deterministic scoring profile identifier."
              },
        "CHUNK_INDEX" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Zero-based streaming chunk index for progressive delivery."
              },
        "IS_FINAL_CHUNK" : {
                "type" : "boolean",
                "description" : "True on the final chunk of a streamed matrix run."
              },
        "REQUEST" : {
                "$ref" : "#/definitions/TMXRequest",
                "description" : "Originating TMXRequest configuration for reproducibility."
              },
        "PHENOMENOLOGY_WEIGHTS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXPhenomenologyWeight"},
                "description" : "Configured phenomenology weights and severity thresholds."
              },
        "COMPOUND_MULTIPLIERS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXCompoundRule"},
                "description" : "Configured compound overlap multiplier/bonus rules."
              },
        "TARGET_BUCKETS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXBucket"},
                "description" : "Target aggregation buckets included in this run."
              },
        "PHENOMENOLOGIES_RUN" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXModuleRun"},
                "description" : "Per-phenomenology module execution records."
              },
        "CELLS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXCell"},
                "description" : "Evaluated matrix cells (bucket x phenomenology)."
              },
        "COMPOUND_EVENTS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXCompoundEvent"},
                "description" : "Detected multi-phenomenology compound overlap events."
              },
        "ROLLUPS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/TMXRollup"},
                "description" : "Deterministic composite rollups per bucket."
              }
      },
      "required" : ["RUN_ID", "CREATED_UTC", "WINDOW_START", "WINDOW_END"],
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/TMX"
}
