{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "dssSyncState" : {
      "type" : "string",
      "enum": ["IDLE", "SYNCING", "SYNCED", "CAPPED", "ERROR"]
    },
    "dssPinPolicy" : {
      "type" : "string",
      "enum": ["None", "Cache", "Pin", "Archive"]
    },
    "dssAction" : {
      "type" : "string",
      "enum": ["None", "Sync", "Subscribe", "Unsubscribe", "Pin", "Unpin", "Hydrate"]
    },
    "dssRetention" : {
      "type" : "string",
      "enum": ["ReplaceCurrent", "ArchiveAll"]
    },
    "DSS" : {
      "type" : "object",
      "properties" : {
        "STATUS" : {
                "$ref" : "#/definitions/dssSyncState"
              },
        "SYNCED_ROWS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "TOTAL_ROWS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "LOCAL_ROWS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "PINNED_ROWS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "MISSING_ROWS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "CACHED_BYTES" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "PINNED_BYTES" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "DOWNLOADED_BYTES" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "DOWNLOAD_SPEED_BYTES_PER_SECOND" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "MEASURED_WIRE_SPEED_BYTES_PER_SECOND" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "HAS_WIRE_SPEED_UTILIZATION" : {
                "type" : "boolean"
              },
        "WIRE_SPEED_UTILIZATION" : {
                "type" : "number"
              },
        "WIRE_SPEED_TARGET" : {
                "type" : "number"
              },
        "HAS_WIRE_SPEED_TARGET_MET" : {
                "type" : "boolean"
              },
        "WIRE_SPEED_TARGET_MET" : {
                "type" : "boolean"
              },
        "MANIFEST_DISCOVERY_MS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "NETWORK_TRANSFER_MS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "VERIFICATION_MS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "FLATSQL_MATERIALIZATION_MS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "PROVIDER_PEER_ID" : {
                "type" : "string"
              },
        "PROVIDER_PUBLIC_KEY" : {
                "type" : "string"
              },
        "SNAPSHOT_ID" : {
                "type" : "string"
              },
        "HEAD" : {
                "type" : "string"
              },
        "CURSOR" : {
                "type" : "string"
              },
        "NEXT_CURSOR" : {
                "type" : "string"
              },
        "HIGH_WATER_MARK" : {
                "type" : "string"
              },
        "QUERY_PROFILE" : {
                "type" : "string"
              },
        "CHUNK_HASH" : {
                "type" : "string"
              },
        "SYNC_PROTOCOL" : {
                "type" : "string"
              },
        "SYNC_FILTER" : {
                "type" : "string"
              },
        "VERIFIED_CHUNKS" : {
                "type" : "array", "items" : {"type" : "string"}
              },
        "LAST_SYNCED_AT" : {
                "type" : "string"
              },
        "ERROR" : {
                "type" : "string"
              },
        "SCHEMA_NAME" : {
                "type" : "string",
                "description" : "Standard code of the lane, e.g. \"OMM\"."
              },
        "PROVIDER_ID" : {
                "type" : "string"
              },
        "SOURCE_NAME" : {
                "type" : "string"
              },
        "DATASET_ID" : {
                "type" : "string",
                "description" : "Stable dataset identifier within the origin."
              },
        "CONNECTOR_ID" : {
                "type" : "string",
                "description" : "Ingest connector that produces the lane, when known."
              },
        "CHANNEL_ID" : {
                "type" : "string",
                "description" : "Channel identifier the lane is announced on."
              },
        "TOPIC" : {
                "type" : "string",
                "description" : "Publish/subscribe topic of the lane."
              },
        "SUBSCRIBED" : {
                "type" : "boolean",
                "description" : "True when this node subscribes to the lane."
              },
        "PIN_POLICY" : {
                "$ref" : "#/definitions/dssPinPolicy"
              },
        "VISIBILITY" : {
                "type" : "string",
                "description" : "Visibility of the lane, e.g. \"public\", \"private\"."
              },
        "ENCRYPTION_STATE" : {
                "type" : "string",
                "description" : "Encryption state of the lane's publications, e.g. \"plain\", \"encrypted\"."
              },
        "GRANT_STATE" : {
                "type" : "string",
                "description" : "Grant state for an encrypted lane, e.g. \"granted\", \"pending\", \"none\"."
              },
        "FEED_HEAD" : {
                "type" : "string",
                "description" : "Feed head this node has materialised up to."
              },
        "LAST_PUBLICATION_CID" : {
                "type" : "string",
                "description" : "Content identifier of the newest publication manifest known."
              },
        "LAST_PNM_CID" : {
                "type" : "string",
                "description" : "Content identifier of the newest publish notification known."
              },
        "DELTA_ROWS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615,
                "description" : "Rows materialised since the previous SYNCED state."
              },
        "LAST_SYNC_STARTED_AT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615,
                "description" : "Unix milliseconds the current or last sync pass started; 0 = never."
              },
        "REQUESTED_ACTION" : {
                "$ref" : "#/definitions/dssAction",
                "description" : "Action a client requests when sending this record to a node."
              },
        "ORIGIN_ID" : {
                "type" : "string",
                "description" : "Upstream publisher of the lane's records."
              },
        "RETENTION" : {
                "$ref" : "#/definitions/dssRetention",
                "description" : "How this node keeps a lane's publications. ReplaceCurrent supersedes the\nprevious batch of the lane with each new publication so the lane holds\none current set; ArchiveAll keeps and pins every publication so history\nstays retrievable by content identifier."
              }
      },
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/DSS"
}
