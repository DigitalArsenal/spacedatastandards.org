{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "pvnSourceKind" : {
      "type" : "string",
      "enum": ["Unspecified", "ElementSet", "Ephemeris", "Observation"]
    },
    "pvnLicenseClass" : {
      "type" : "string",
      "enum": ["Unspecified", "Reproducible", "CiteOnly", "ShareAlike", "NonCommercial"]
    },
    "maneuverStatus" : {
      "type" : "string",
      "enum": ["DETECTED", "CONFIRMED", "PREDICTED", "PLANNED", "EXECUTED", "CANCELLED", "UNKNOWN"]
    },
    "maneuverCharacterization" : {
      "type" : "string",
      "enum": ["IN_PLANE", "OUT_OF_PLANE", "COMBINED", "STATION_KEEPING", "ORBIT_RAISING", "ORBIT_LOWERING", "PHASING", "DEORBIT", "COLLISION_AVOIDANCE", "UNKNOWN"]
    },
    "PVN" : {
      "type" : "object",
      "description" : "Product Provenance",
      "properties" : {
        "SOURCE_ID" : {
                "type" : "string",
                "description" : "Publisher-stable, lowercase identifier of the source in the provider's\nregistry of sources."
              },
        "SOURCE_KIND" : {
                "$ref" : "#/definitions/pvnSourceKind",
                "description" : "What kind of data the source supplies."
              },
        "ORIGINATOR" : {
                "type" : "string",
                "description" : "Agency, operator or catalog that created the source data, as it names\nitself. Not a message's CCSDS ORIGINATOR, which names who created the\nmessage."
              },
        "PROVIDER_ID" : {
                "type" : "string",
                "description" : "Identifier of the provider that published the product, as the provider\nnames itself: the module, node or service that retrieved the source data."
              },
        "PRODUCER" : {
                "type" : "string",
                "description" : "Identifier of the software that made the product from the source data,\nwith its version when it has one."
              },
        "LICENSE_CLASS" : {
                "$ref" : "#/definitions/pvnLicenseClass",
                "description" : "What the source's terms permit for the product."
              },
        "LICENSE_ID" : {
                "type" : "string",
                "description" : "Identifier of the terms LICENSE_CLASS was read from: an SPDX license\nidentifier where one applies, else the identifier of the terms in the\nprovider's licence register."
              },
        "LINEAGE" : {
                "type" : "string",
                "description" : "Identifier of the lineage the source's data descends from. Sources that\nrepublish one upstream share its lineage, so their products are not\nindependent of each other."
              }
      },
      "additionalProperties" : false
    },
    "mnvOrbitalState" : {
      "type" : "object",
      "description" : "Pre/post-maneuver orbital state",
      "properties" : {
        "ID_ELSET" : {
                "type" : "string",
                "description" : "Element set identifier"
              },
        "ELSET" : {
                "type" : "string",
                "description" : "Element set data reference"
              },
        "ID_STATE_VECTOR" : {
                "type" : "string",
                "description" : "State vector identifier"
              },
        "STATE_VECTOR" : {
                "type" : "string",
                "description" : "State vector data reference"
              },
        "POS_X" : {
                "type" : "number",
                "description" : "Position X (km)"
              },
        "POS_Y" : {
                "type" : "number",
                "description" : "Position Y (km)"
              },
        "POS_Z" : {
                "type" : "number",
                "description" : "Position Z (km)"
              },
        "VEL_X" : {
                "type" : "number",
                "description" : "Velocity X (km/s)"
              },
        "VEL_Y" : {
                "type" : "number",
                "description" : "Velocity Y (km/s)"
              },
        "VEL_Z" : {
                "type" : "number",
                "description" : "Velocity Z (km/s)"
              },
        "RADIATION_PRESS_COEFF" : {
                "type" : "number",
                "description" : "Radiation pressure coefficient (Cr)"
              },
        "BALLISTIC_COEFF" : {
                "type" : "number",
                "description" : "Ballistic coefficient (m^2/kg)"
              },
        "APOGEE" : {
                "type" : "number",
                "description" : "Apogee altitude (km)"
              },
        "PERIGEE" : {
                "type" : "number",
                "description" : "Perigee altitude (km)"
              },
        "INCLINATION" : {
                "type" : "number",
                "description" : "Inclination (degrees)"
              },
        "ECCENTRICITY" : {
                "type" : "number",
                "description" : "Eccentricity"
              },
        "PERIOD" : {
                "type" : "number",
                "description" : "Orbital period (minutes)"
              },
        "RAAN" : {
                "type" : "number",
                "description" : "Right ascension of ascending node (degrees)"
              },
        "SMA" : {
                "type" : "number",
                "description" : "Semi-major axis (km)"
              },
        "GEO_LONGITUDE" : {
                "type" : "number",
                "description" : "GEO longitude (degrees east)"
              },
        "DRIFT_RATE" : {
                "type" : "number",
                "description" : "Longitude drift rate (degrees/day)"
              },
        "SIGMA_U" : {
                "type" : "number",
                "description" : "Position uncertainty along U, radial, in the UVW frame of this state (km, 1-sigma)"
              },
        "SIGMA_V" : {
                "type" : "number",
                "description" : "Position uncertainty along V, in-track, in the UVW frame of this state (km, 1-sigma)"
              },
        "SIGMA_W" : {
                "type" : "number",
                "description" : "Position uncertainty along W, cross-track, in the UVW frame of this state (km, 1-sigma)"
              }
      },
      "additionalProperties" : false
    },
    "MNV" : {
      "type" : "object",
      "description" : "Spacecraft Maneuver\n\nU, V and W are the UVW axes of an orbit state: U radial, along the position\nvector away from the central body; W cross-track, along the orbit normal\n(the direction of r x v); V in-track, W x U, completing the right-handed\nframe. DELTA_VEL_U/V/W and DELTA_POS_U/V/W are in the UVW frame of the\npre-maneuver state at EVENT_START_TIME.",
      "properties" : {
        "ID" : {
                "type" : "string",
                "description" : "Unique identifier"
              },
        "SAT_NO" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Satellite catalog number"
              },
        "ORIG_OBJECT_ID" : {
                "type" : "string",
                "description" : "International designator"
              },
        "ON_ORBIT" : {
                "type" : "string",
                "description" : "On-orbit reference"
              },
        "STATUS" : {
                "$ref" : "#/definitions/maneuverStatus",
                "description" : "Maneuver status"
              },
        "CHARACTERIZATION" : {
                "$ref" : "#/definitions/maneuverCharacterization",
                "description" : "Maneuver characterization"
              },
        "CHARACTERIZATION_UNC" : {
                "type" : "number",
                "description" : "Characterization uncertainty (0-1)"
              },
        "REPORT_TIME" : {
                "type" : "string",
                "description" : "Detection report time (ISO 8601)"
              },
        "EVENT_START_TIME" : {
                "type" : "string",
                "description" : "Maneuver start time (ISO 8601)"
              },
        "EVENT_END_TIME" : {
                "type" : "string",
                "description" : "Maneuver end time (ISO 8601)"
              },
        "TOTAL_BURN_TIME" : {
                "type" : "number",
                "description" : "Total burn time (seconds)"
              },
        "OD_FIT_END_TIME" : {
                "type" : "string",
                "description" : "OD fit end time (ISO 8601)"
              },
        "ID_SENSOR" : {
                "type" : "string",
                "description" : "Detecting sensor identifier"
              },
        "ORIG_SENSOR_ID" : {
                "type" : "string",
                "description" : "Original sensor identifier"
              },
        "EVENT_ID" : {
                "type" : "string",
                "description" : "Maneuver event identifier. Records of one event share it: a merged event\nand the source records it combines."
              },
        "UCT" : {
                "type" : "boolean",
                "description" : "True if object is uncorrelated"
              },
        "MANEUVER_UNC" : {
                "type" : "number",
                "description" : "Maneuver detection uncertainty (km)"
              },
        "DELTA_VEL" : {
                "type" : "number",
                "description" : "Total delta-V magnitude (km/s)"
              },
        "DELTA_VEL_U" : {
                "type" : "number",
                "description" : "Delta-V along U, radial (km/s)"
              },
        "DELTA_VEL_V" : {
                "type" : "number",
                "description" : "Delta-V along V, in-track (km/s)"
              },
        "DELTA_VEL_W" : {
                "type" : "number",
                "description" : "Delta-V along W, cross-track (km/s)"
              },
        "DELTA_POS" : {
                "type" : "number",
                "description" : "Total delta position (km)"
              },
        "DELTA_POS_U" : {
                "type" : "number",
                "description" : "Delta position along U, radial (km)"
              },
        "DELTA_POS_V" : {
                "type" : "number",
                "description" : "Delta position along V, in-track (km)"
              },
        "DELTA_POS_W" : {
                "type" : "number",
                "description" : "Delta position along W, cross-track (km)"
              },
        "DELTA_MASS" : {
                "type" : "number",
                "description" : "Propellant mass consumed (kg)"
              },
        "PRE_EVENT" : {
                "$ref" : "#/definitions/mnvOrbitalState",
                "description" : "Pre-maneuver orbital state"
              },
        "POST_EVENT" : {
                "$ref" : "#/definitions/mnvOrbitalState",
                "description" : "Post-maneuver orbital state"
              },
        "POST_MASS" : {
                "type" : "number",
                "description" : "Post-maneuver mass (kg)"
              },
        "POST_AREA" : {
                "type" : "number",
                "description" : "Post-maneuver cross-sectional area (m^2)"
              },
        "COV" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "6x6 covariance matrix (upper triangle, row-major)"
              },
        "NUM_OBS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Number of observations used"
              },
        "STATE_MODEL" : {
                "type" : "string",
                "description" : "State model used"
              },
        "STATE_MODEL_VERSION" : {
                "type" : "number",
                "description" : "State model version"
              },
        "NUM_ACCEL_POINTS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Number of acceleration profile points"
              },
        "MNVR_ACCEL_TIMES" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Acceleration profile times (ISO 8601)"
              },
        "MNVR_ACCELS" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Acceleration values (km/s^2): U, V and W per point, in the UVW frame of\nthe state at that point's MNVR_ACCEL_TIMES entry"
              },
        "MNVR_ACCEL_UNCS" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Acceleration uncertainties (km/s^2)"
              },
        "DESCRIPTION" : {
                "type" : "string",
                "description" : "Description"
              },
        "DESCRIPTOR" : {
                "type" : "string",
                "description" : "Event descriptor"
              },
        "ALGORITHM" : {
                "type" : "string",
                "description" : "Algorithm used for detection"
              },
        "TAGS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Associated tags"
              },
        "SOURCED_DATA" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Sourced data references: identifiers of the records this one was\ndetermined from (CIDv1 for records of this network), such as the source\nrecords a merged event combines"
              },
        "SOURCED_DATA_TYPES" : {
                "type" : "string",
                "description" : "Sourced data types"
              },
        "TRANSACTION_ID" : {
                "type" : "string",
                "description" : "Transaction identifier"
              },
        "PROVENANCE" : {
                "$ref" : "#/definitions/PVN",
                "description" : "Where the maneuver's data comes from and the terms it travels under."
              }
      },
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/MNV"
}
