{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "TrkTrackStatus" : {
      "type" : "string",
      "enum": ["ACTIVE", "DROPPED", "TENTATIVE", "CONFIRMED", "COASTED", "DEAD"]
    },
    "trackEnvironment" : {
      "type" : "string",
      "enum": ["SPACE", "AIR", "SURFACE", "SUBSURFACE", "LAND", "UNKNOWN"]
    },
    "vepEnergyType" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "LIQUID_FUEL", "ELECTRIC", "HYBRID", "NUCLEAR", "SOLAR", "WIND"]
    },
    "vepRegime" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "TAKEOFF", "CLIMB", "CRUISE", "LOITER", "DESCENT", "TAXI", "TRANSIT", "MANEUVER"]
    },
    "vepInterpolation" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "NEAREST", "LINEAR", "BILINEAR", "TABLE_LOOKUP"]
    },
    "TRK" : {
      "type" : "object",
      "description" : "Track",
      "properties" : {
        "ID" : {
                "type" : "string",
                "description" : "Unique identifier"
              },
        "CNTCT" : {
                "type" : "string",
                "description" : "Contact reference"
              },
        "MSG_TS" : {
                "type" : "string",
                "description" : "Message timestamp (ISO 8601)"
              },
        "MSN_ID" : {
                "type" : "string",
                "description" : "Mission identifier"
              },
        "ASSET_NAT" : {
                "type" : "string",
                "description" : "Asset nationality"
              },
        "ASSET" : {
                "type" : "string",
                "description" : "Asset identifier"
              },
        "SENSOR_ID" : {
                "type" : "string",
                "description" : "Sensor identifier"
              },
        "SEN_QUAL" : {
                "type" : "string",
                "description" : "Sensor quality assessment"
              },
        "TRK_ID" : {
                "type" : "string",
                "description" : "Track identifier"
              },
        "TRK_NUM" : {
                "type" : "string",
                "description" : "Track number"
              },
        "TRK_STAT" : {
                "$ref" : "#/definitions/TrkTrackStatus",
                "description" : "Track status"
              },
        "OBJ_NAT" : {
                "type" : "string",
                "description" : "Object nationality"
              },
        "OBJ_ID" : {
                "type" : "string",
                "description" : "Object identifier"
              },
        "OBJ_TYPE" : {
                "type" : "string",
                "description" : "Object type classification"
              },
        "OBJ_SPEC" : {
                "type" : "string",
                "description" : "Object specific type"
              },
        "OBJ_PLAT" : {
                "type" : "string",
                "description" : "Object platform type"
              },
        "OBJ_ACT" : {
                "type" : "string",
                "description" : "Object activity"
              },
        "MOD_TYPE" : {
                "type" : "string",
                "description" : "Mode type"
              },
        "TRK_ITM_ID" : {
                "type" : "string",
                "description" : "Track item identifier"
              },
        "TS" : {
                "type" : "string",
                "description" : "Track point timestamp (ISO 8601)"
              },
        "TRK_QUAL" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Track quality (0-15)"
              },
        "TRK_PT_TYPE" : {
                "type" : "string",
                "description" : "Track point type"
              },
        "OBJ_IDENT" : {
                "type" : "string",
                "description" : "Object identity assessment"
              },
        "IDENT_CRED" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Identity credibility (1-6)"
              },
        "IDENT_REL" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Identity reliability (A-F)"
              },
        "IDENT_AMP" : {
                "type" : "string",
                "description" : "Identity amplification"
              },
        "ENVIRONMENT" : {
                "$ref" : "#/definitions/trackEnvironment",
                "description" : "Track environment"
              },
        "ENVIRONMENT_CONF" : {
                "type" : "number",
                "description" : "Environment confidence (0-1)"
              },
        "TRK_CONF" : {
                "type" : "number",
                "description" : "Track confidence (0-1)"
              },
        "LAT" : {
                "type" : "number",
                "description" : "Latitude (degrees)"
              },
        "LON" : {
                "type" : "number",
                "description" : "Longitude (degrees)"
              },
        "ALT" : {
                "type" : "number",
                "description" : "Altitude (km)"
              },
        "SPD" : {
                "type" : "number",
                "description" : "Speed (km/s)"
              },
        "HDNG" : {
                "type" : "number",
                "description" : "Heading (degrees from north)"
              },
        "COURSE" : {
                "type" : "number",
                "description" : "Course (degrees from north)"
              },
        "SRC_TYPS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Source types"
              },
        "SRC_IDS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Source identifiers"
              },
        "CALL_SIGN" : {
                "type" : "string",
                "description" : "Call sign"
              },
        "MULTI_SOURCE" : {
                "type" : "boolean",
                "description" : "True if fused from multiple sources"
              },
        "J_SERIES" : {
                "type" : "string",
                "description" : "J-series message type"
              },
        "STRENGTH" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Force strength indicator"
              },
        "M1" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Mode 1 code"
              },
        "M1V" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Mode 1 validity"
              },
        "M2" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Mode 2 code"
              },
        "M2V" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Mode 2 validity"
              },
        "M3A" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Mode 3A code"
              },
        "M3AV" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Mode 3A validity"
              },
        "TAGS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Associated tags"
              },
        "TRACK_START_TIME" : {
                "type" : "string",
                "description" : "Start time for track data (ISO 8601)"
              },
        "TRACK_STEP_SIZE" : {
                "type" : "number",
                "description" : "Time interval between track points (seconds)"
              },
        "TRACK_COMPONENTS" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Number of components per point (default 3 for X, Y, Z)"
              },
        "ECEF_POS" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "ECEF position as flat array [X0, Y0, Z0, X1, Y1, Z1, ...]"
              },
        "ECEF_VEL" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "ECEF velocity as flat array [VX0, VY0, VZ0, VX1, VY1, VZ1, ...]"
              },
        "ECEF_ACC" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "ECEF acceleration as flat array [AX0, AY0, AZ0, AX1, AY1, AZ1, ...]"
              },
        "LC_POS" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Local coordinate position as flat array"
              },
        "LC_VEL" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Local coordinate velocity as flat array"
              },
        "LC_ACC" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Local coordinate acceleration as flat array"
              },
        "COV" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Covariance data (21 elements per point for 6x6 lower triangular)"
              },
        "ERR_ELLP" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Error ellipse data (6 elements per point)"
              }
      },
      "additionalProperties" : false
    },
    "VEPPerformancePoint" : {
      "type" : "object",
      "description" : "One point of the burn-rate table: consumption at a stated regime,\naltitude, and speed.",
      "properties" : {
        "ALTITUDE_M" : {
                "type" : "number",
                "description" : "Altitude the point is stated at, metres above mean sea level. NaN for\nsurface and subsurface regimes where altitude does not apply."
              },
        "SPEED_MPS" : {
                "type" : "number",
                "description" : "Speed the point is stated at, metres per second."
              },
        "REGIME" : {
                "$ref" : "#/definitions/vepRegime",
                "description" : "Operating regime."
              },
        "BURN_RATE_VALUE" : {
                "type" : "number",
                "description" : "Consumption rate at this point, in BURN_RATE_UNITS per second unless\nthe unit token itself states another time base."
              },
        "BURN_RATE_UNITS" : {
                "type" : "string",
                "description" : "Units of BURN_RATE_VALUE, verbatim. Required: a rate with no unit is\nnot publishable."
              },
        "SPECIFIC_RANGE_M_PER_UNIT" : {
                "type" : "number",
                "description" : "Distance travelled per unit of energy at this point, metres per\nCAPACITY_UNITS unit."
              },
        "GROSS_MASS_KG" : {
                "type" : "number",
                "description" : "Gross mass the point is stated at, kilograms."
              }
      },
      "required" : ["BURN_RATE_UNITS"],
      "additionalProperties" : false
    },
    "VEPReplenishment" : {
      "type" : "object",
      "description" : "One replenishment option: how the energy store is reset.",
      "properties" : {
        "FACILITY_ID" : {
                "type" : "string",
                "description" : "`$TFN.ID` of a facility where this replenishment is available. Absent\nfor a replenishment that is not facility-bound."
              },
        "DURATION_S" : {
                "type" : "number",
                "description" : "Typical duration of the replenishment, seconds."
              },
        "TRANSFER_RATE_VALUE" : {
                "type" : "number",
                "description" : "Transfer rate, in TRANSFER_RATE_UNITS."
              },
        "TRANSFER_RATE_UNITS" : {
                "type" : "string",
                "description" : "Units of TRANSFER_RATE_VALUE, verbatim."
              },
        "IN_MOTION" : {
                "type" : "boolean",
                "description" : "Replenishment happens while the vehicle is underway (aerial\nrefuelling, underway replenishment)."
              }
      },
      "additionalProperties" : false
    },
    "VEPProvenance" : {
      "type" : "object",
      "description" : "Dataset lineage and redistribution terms for one endurance profile.\n\nRequired on every record: a profile whose data source, epoch, and\nlicence are unstated is not publishable. The standard names no dataset,\nprovider, or site.",
      "properties" : {
        "DATASET_ID" : {
                "type" : "string",
                "description" : "Publisher-stable, lowercase identifier for the dataset or study this\nprofile was derived from."
              },
        "DATASET_NAME" : {
                "type" : "string",
                "description" : "The dataset's own name, verbatim as its publisher states it."
              },
        "DATASET_URL" : {
                "type" : "string",
                "description" : "Replayable URL of the dataset as published."
              },
        "DATASET_EPOCH" : {
                "type" : "string",
                "description" : "RFC 3339 UTC fixed-millisecond epoch of the dataset edition this\nprofile was derived from."
              },
        "DATASET_CID" : {
                "type" : "string",
                "description" : "Content identifier of the exact dataset artifact, when one exists."
              },
        "SOURCE_URL" : {
                "type" : "string",
                "description" : "Replayable URL identifying the source material within the dataset."
              },
        "SOURCE_QUERY" : {
                "type" : "string",
                "description" : "The exact query, filter, or file selection used."
              },
        "RETRIEVED_AT" : {
                "type" : "string",
                "description" : "RFC 3339 UTC fixed-millisecond retrieval timestamp."
              },
        "LICENSE" : {
                "type" : "string",
                "description" : "Redistribution terms verbatim. Unknown terms are never public domain\nand never an implied grant."
              },
        "LICENSE_URL" : {
                "type" : "string",
                "description" : "URL of the full licence text as the dataset publishes it."
              },
        "ATTRIBUTION" : {
                "type" : "string",
                "description" : "Attribution text the licence requires a redistributor to display."
              },
        "NON_COMMERCIAL_ONLY" : {
                "type" : "boolean",
                "description" : "The licence forbids commercial use."
              },
        "SHARE_ALIKE" : {
                "type" : "boolean",
                "description" : "The licence obliges derived works to carry the same terms."
              },
        "NATIVE_ID" : {
                "type" : "string",
                "description" : "The source's own identifier for the vehicle class or type this\nprofile describes, verbatim."
              },
        "NATIVE_MODIFIED" : {
                "type" : "string",
                "description" : "RFC 3339 UTC instant the source last modified this data, as it\nstates."
              }
      },
      "required" : ["DATASET_ID", "DATASET_EPOCH", "RETRIEVED_AT", "LICENSE", "NATIVE_ID"],
      "additionalProperties" : false
    },
    "VEP" : {
      "type" : "object",
      "description" : "Vehicle Endurance Profile",
      "properties" : {
        "ID" : {
                "type" : "string",
                "description" : "Publisher-stable identifier for this profile record."
              },
        "VEHICLE_CLASS_ID" : {
                "type" : "string",
                "description" : "Publisher-stable identifier of the vehicle CLASS this profile models.\nRequired: every profile is at least class-level."
              },
        "VEHICLE_TYPE_DESIGNATOR" : {
                "type" : "string",
                "description" : "Verbatim vehicle type token refining the class, when this profile is\na per-type refinement."
              },
        "ENVIRONMENT" : {
                "$ref" : "#/definitions/trackEnvironment",
                "description" : "Domain the vehicle operates in. The `$TRK` enum reused verbatim;\nordinal 0 is SPACE, so it is defaulted to UNKNOWN explicitly."
              },
        "ENERGY_TYPE" : {
                "$ref" : "#/definitions/vepEnergyType",
                "description" : "Kind of energy store."
              },
        "CAPACITY_VALUE" : {
                "type" : "number",
                "description" : "Usable energy store capacity, in CAPACITY_UNITS."
              },
        "CAPACITY_UNITS" : {
                "type" : "string",
                "description" : "Units of CAPACITY_VALUE, verbatim. The same unit keys\nSPECIFIC_RANGE_M_PER_UNIT and the replenishment transfer rates."
              },
        "RESERVE_FRACTION" : {
                "type" : "number",
                "description" : "Fraction of capacity [0-1] held as reserve; endurance computations\nspend down to the reserve, never through it."
              },
        "PERFORMANCE_POINTS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/VEPPerformancePoint"},
                "description" : "The burn-rate table, keyed regime x altitude x speed. Required, and\nnever a single collapsed scalar."
              },
        "INTERPOLATION" : {
                "$ref" : "#/definitions/vepInterpolation",
                "description" : "How a consumer interpolates between the points."
              },
        "MAXIMUM_ENDURANCE_S" : {
                "type" : "number",
                "description" : "Maximum endurance, seconds, as the source publishes it."
              },
        "MAXIMUM_RANGE_M" : {
                "type" : "number",
                "description" : "Maximum range, metres, as the source publishes it."
              },
        "LOITER_SPEED_MPS" : {
                "type" : "number",
                "description" : "Best-loiter speed, metres per second."
              },
        "SERVICE_CEILING_M" : {
                "type" : "number",
                "description" : "Service ceiling, metres above mean sea level."
              },
        "REPLENISHMENT" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/VEPReplenishment"},
                "description" : "Replenishment options available to this class or type."
              },
        "REFINES_ID" : {
                "type" : "string",
                "description" : "`$VEP.ID` of the parent profile this one refines — the class-to-type\nspecialization chain. Absent for a class-level root profile."
              },
        "SOURCE" : {
                "$ref" : "#/definitions/VEPProvenance",
                "description" : "Dataset lineage and licence. Required."
              }
      },
      "required" : ["ID", "VEHICLE_CLASS_ID", "PERFORMANCE_POINTS", "SOURCE"],
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/VEP"
}
