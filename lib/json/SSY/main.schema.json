        "ELLIPTICITY" : {
                "$ref" : "#/definitions/EXOParameter"
              },
        "POSITION_ANGLE" : {
                "$ref" : "#/definitions/EXOParameter"
              },
        "STRUCTURE_MODEL" : {
                "type" : "string",
