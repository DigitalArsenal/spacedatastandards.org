{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "CelestialFrame" : {
      "type" : "string",
      "enum": ["GCRF", "ICRF", "J2000", "J2000A", "EME2000", "TEMEOFDATE", "GTOD", "CIRS", "MOD_EARTH", "MOD_CB", "MOD_MOON", "TOD_EARTH", "TOD_CB", "TOD_MOON", "TOE_EARTH", "TOE_CB", "TOE_MOON", "ITRF2000", "ITRF93", "ITRF97", "EFG", "FIXED_CB", "FIXED_EARTH", "WGS84", "DTRFYYYY", "ALIGN_EARTH", "ALIGN_CB", "B1950"]
    },
    "SpacecraftFrame" : {
      "type" : "string",
      "enum": ["ACC_i", "ACTUATOR_i", "AST_i", "CSS_i", "DSS_i", "ESA_i", "GYRO_FRAME_i", "IMU_FRAME_i", "INSTRUMENT_i", "MTA_i", "RW_i", "SA_i", "SC_BODY_i", "SENSOR_i", "STARTRACKER_i", "TAM_i"]
    },
    "OrbitFrame" : {
      "type" : "string",
      "enum": ["EQW_INERTIAL", "LVLH_INERTIAL", "LVLH_ROTATING", "NSW_INERTIAL", "NSW_ROTATING", "NTW_INERTIAL", "NTW_ROTATING", "PQW_INERTIAL", "RSW_INERTIAL", "RSW_ROTATING", "SEZ_INERTIAL", "SEZ_ROTATING", "TNW_INERTIAL", "TNW_ROTATING", "VNC_INERTIAL", "VNC_ROTATING"]
    },
    "CustomFrame" : {
      "type" : "string",
      "enum": ["ECEF", "TEME", "TEMEOFEPOCH", "ENU", "NED", "NEU", "RIC", "RTN", "TVN", "VVLH", "QSW", "LTP", "LVLH", "PNE", "BRF", "RSW", "TNW", "UVW"]
    },
    "RFMUnion" : {
      "type" : "string",
      "enum": ["NONE", "CelestialFrameWrapper", "SpacecraftFrameWrapper", "OrbitFrameWrapper", "CustomFrameWrapper"]
    },
    "timingStandard" : {
      "type" : "string",
      "enum": ["GMST", "GPS", "MET", "MRT", "SCLK", "TAI", "TCB", "TDB", "TCG", "TT", "UT1", "UTC", "GLONASS", "GST", "QZSS", "BDT", "NAVIC", "SBAS"]
    },
    "timEpochRepresentation" : {
      "type" : "string",
      "enum": ["JULIAN_DATE", "MODIFIED_JULIAN_DATE", "UNIX_SECONDS", "ISO8601", "GPS_SECONDS", "GNSS_WEEK_SECONDS", "CCSDS_TIME_CODE", "MISSION_ELAPSED_SECONDS"]
    },
    "timCcsdsTimeCodeKind" : {
      "type" : "string",
      "enum": ["NONE", "UNSEGMENTED", "DAY_SEGMENTED", "CALENDAR_SEGMENTED"]
    },
    "timConversionStatus" : {
      "type" : "string",
      "enum": ["OK", "INVALID_INPUT", "UNSUPPORTED_TIME_SYSTEM", "LEAP_SECOND_DATA_REQUIRED", "EOP_DATA_REQUIRED", "OUT_OF_RANGE"]
    },
    "meanElementSource" : {
      "type" : "string",
      "enum": ["SGP4", "SGP4XP", "DSST", "USM"]
    },
    "ephemerisFormat" : {
      "type" : "string",
      "enum": ["SGP", "SGP4", "SDP4", "SGP8", "SDP8"]
    },
    "CelestialFrameWrapper" : {
      "type" : "object",
      "properties" : {
        "frame" : {
                "$ref" : "#/definitions/CelestialFrame"
              }
      },
      "additionalProperties" : false
    },
    "SpacecraftFrameWrapper" : {
      "type" : "object",
      "properties" : {
        "frame" : {
                "$ref" : "#/definitions/SpacecraftFrame"
              }
      },
      "additionalProperties" : false
    },
    "OrbitFrameWrapper" : {
      "type" : "object",
      "properties" : {
        "frame" : {
                "$ref" : "#/definitions/OrbitFrame"
              }
      },
      "additionalProperties" : false
    },
    "CustomFrameWrapper" : {
      "type" : "object",
      "properties" : {
        "frame" : {
                "$ref" : "#/definitions/CustomFrame"
              }
      },
      "additionalProperties" : false
    },
    "RFM" : {
      "type" : "object",
      "description" : "Reference Frame Message",
      "properties" : {
        "REFERENCE_FRAME_type" : {
                "$ref" : "#/definitions/RFMUnion"
              },
        "REFERENCE_FRAME" : {
                "anyOf": [{ "$ref" : "#/definitions/CelestialFrameWrapper" },{ "$ref" : "#/definitions/SpacecraftFrameWrapper" },{ "$ref" : "#/definitions/OrbitFrameWrapper" },{ "$ref" : "#/definitions/CustomFrameWrapper" }]
              },
        "INDEX" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "NAME" : {
                "type" : "string"
              }
      },
      "additionalProperties" : false
    },
    "TIMCcsdsTimeCode" : {
      "type" : "object",
      "description" : "CCSDS time-code payload and preamble metadata.",
      "properties" : {
        "CODE_KIND" : {
                "$ref" : "#/definitions/timCcsdsTimeCodeKind",
                "description" : "CCSDS time-code family."
              },
        "PREAMBLE_FIELD1" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "First CCSDS preamble field octet."
              },
        "PREAMBLE_FIELD2" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Second CCSDS preamble field octet; ignored when not signaled by preamble 1."
              },
        "TIME_FIELD" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" :255},
                "description" : "Raw CCSDS time field octets."
              },
        "AGENCY_DEFINED_EPOCH_ISO8601" : {
                "type" : "string",
                "description" : "Optional agency-defined epoch timestamp for agency epoch time codes."
              },
        "CCSDS_EPOCH_ISO8601" : {
                "type" : "string",
                "description" : "Optional CCSDS epoch override timestamp; defaults to 1958-01-01T00:00:00 TAI."
              }
      },
      "additionalProperties" : false
    },
    "TIMInstant" : {
      "type" : "object",
      "description" : "Numeric or textual instant tagged with its time system and representation.",
      "properties" : {
        "TIME_SYSTEM" : {
                "$ref" : "#/definitions/timingStandard",
                "description" : "Time system for this instant."
              },
        "EPOCH_FORMAT" : {
                "$ref" : "#/definitions/timEpochRepresentation",
                "description" : "Interpretation of JULIAN_DATE, SECONDS, and ISO8601."
              },
        "JULIAN_DATE" : {
                "type" : "number",
                "description" : "Julian Date or Modified Julian Date day value, selected by EPOCH_FORMAT."
              },
        "SECONDS" : {
                "type" : "number",
                "description" : "Seconds for UNIX_SECONDS, GPS_SECONDS, GNSS_WEEK_SECONDS, or MISSION_ELAPSED_SECONDS."
              },
        "ISO8601" : {
                "type" : "string",
                "description" : "ISO 8601 timestamp text for ISO8601 inputs or display outputs."
              },
        "SUBSECOND_NANOS" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Additional nanoseconds beyond the fractional scalar/text value."
              },
        "EPOCH_LABEL" : {
                "type" : "string",
                "description" : "Optional application-defined epoch label for MET, MRT, or SCLK values."
              },
        "GNSS_WEEK" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "GNSS week number when EPOCH_FORMAT is GNSS_WEEK_SECONDS."
              },
        "HAS_GNSS_ROLLOVER_REFERENCE" : {
                "type" : "boolean",
                "description" : "Whether GNSS_ROLLOVER_REFERENCE_ISO8601 should be applied."
              },
        "GNSS_ROLLOVER_REFERENCE_ISO8601" : {
                "type" : "string",
                "description" : "Optional Orekit-style GNSS week rollover reference timestamp."
              },
        "CCSDS_TIME_CODE" : {
                "$ref" : "#/definitions/TIMCcsdsTimeCode",
                "description" : "CCSDS time-code payload when EPOCH_FORMAT is CCSDS_TIME_CODE."
              }
      },
      "additionalProperties" : false
    },
    "TIMConversionRequest" : {
      "type" : "object",
      "description" : "Request to convert one instant into another time system/representation.",
      "properties" : {
        "SOURCE" : {
                "$ref" : "#/definitions/TIMInstant",
                "description" : "Source instant to convert."
              },
        "TARGET_TIME_SYSTEM" : {
                "$ref" : "#/definitions/timingStandard",
                "description" : "Target time system."
              },
        "TARGET_EPOCH_FORMAT" : {
                "$ref" : "#/definitions/timEpochRepresentation",
                "description" : "Preferred target representation."
              },
        "TAI_MINUS_UTC_SECONDS" : {
                "type" : "number",
                "description" : "Optional TAI-UTC override in seconds for the source instant."
              },
        "HAS_TAI_MINUS_UTC" : {
                "type" : "boolean",
                "description" : "Whether TAI_MINUS_UTC_SECONDS should override runtime leap-second data."
              },
        "DUT1_SECONDS" : {
                "type" : "number",
                "description" : "Optional UT1-UTC override in seconds for UT1 conversions."
              },
        "HAS_DUT1" : {
                "type" : "boolean",
                "description" : "Whether DUT1_SECONDS should override runtime Earth-orientation data."
              },
        "TRACE_ID" : {
                "type" : "string",
                "description" : "Optional caller trace/correlation identifier."
              }
      },
      "additionalProperties" : false
    },
    "TIMConversionResult" : {
      "type" : "object",
      "description" : "Result of a time conversion request.",
      "properties" : {
        "SOURCE" : {
                "$ref" : "#/definitions/TIMInstant",
                "description" : "Original source instant."
              },
        "TARGET" : {
                "$ref" : "#/definitions/TIMInstant",
                "description" : "Converted target instant."
              },
        "DELTA_SECONDS" : {
                "type" : "number",
                "description" : "Target minus source offset in SI seconds for the requested conversion."
              },
        "STATUS" : {
                "$ref" : "#/definitions/timConversionStatus",
                "description" : "Conversion status."
              },
        "ERROR_MESSAGE" : {
                "type" : "string",
                "description" : "Optional error detail when STATUS is not OK."
              },
        "TRACE_ID" : {
                "type" : "string",
                "description" : "Caller trace/correlation identifier copied from the request when present."
              }
      },
      "additionalProperties" : false
    },
    "TIM" : {
      "type" : "object",
      "description" : "Time System and time-conversion envelope.",
      "properties" : {
        "TIME_SYSTEM" : {
                "$ref" : "#/definitions/timingStandard",
                "description" : "Legacy time-system selector retained for existing TIM consumers."
              },
        "INSTANT" : {
                "$ref" : "#/definitions/TIMInstant",
                "description" : "A single tagged instant."
              },
        "CONVERSION_REQUEST" : {
                "$ref" : "#/definitions/TIMConversionRequest",
                "description" : "Time conversion request."
              },
        "CONVERSION_RESULT" : {
                "$ref" : "#/definitions/TIMConversionResult",
                "description" : "Time conversion result."
              }
      },
      "additionalProperties" : false
    },
    "MET" : {
      "type" : "object",
      "description" : "Mean Element Theory",
      "properties" : {
        "MEAN_ELEMENT_THEORY" : {
                "$ref" : "#/definitions/meanElementSource"
              }
      },
      "additionalProperties" : false
    },
    "OMM" : {
      "type" : "object",
      "description" : "Orbit Mean Elements Message",
      "properties" : {
        "CCSDS_OMM_VERS" : {
                "type" : "number",
                "description" : "CCSDS OMM Version"
              },
        "CREATION_DATE" : {
                "type" : "string",
                "description" : "Creation Date (ISO 8601 UTC format)"
              },
        "ORIGINATOR" : {
                "type" : "string",
                "description" : "Originator"
              },
        "OBJECT_NAME" : {
                "type" : "string",
                "description" : "Satellite Name(s)"
              },
        "OBJECT_ID" : {
                "type" : "string",
                "description" : "International Designator (YYYY-NNNAAA)"
              },
        "CENTER_NAME" : {
                "type" : "string",
                "description" : "Center Name (e.g. EARTH, MARS)"
              },
        "REFERENCE_FRAME" : {
                "$ref" : "#/definitions/RFM",
                "description" : "Reference Frame\nTypically TEMEOFDATE"
              },
        "REFERENCE_FRAME_EPOCH" : {
                "type" : "string",
                "description" : "Reference Frame Epoch (ISO 8601 UTC format)"
              },
        "TIME_SYSTEM" : {
                "$ref" : "#/definitions/timingStandard",
                "description" : "Time System [M, UTC]"
              },
        "MEAN_ELEMENT_THEORY" : {
                "$ref" : "#/definitions/meanElementSource",
                "description" : "Mean Element Theory"
              },
        "COMMENT" : {
                "type" : "string",
                "description" : "COMMENT (O)"
              },
        "EPOCH" : {
                "type" : "string",
                "description" : "EPOCH of Mean Keplerian elements (ISO 8601 UTC format)"
              },
        "SEMI_MAJOR_AXIS" : {
                "type" : "number",
                "description" : "Semi-major axis in km or Mean Motion in rev/day"
              },
        "MEAN_MOTION" : {
                "type" : "number",
                "description" : "Mean motion in rev/day if MEAN_ELEMENT_THEORY=SGP/SGP4 else unused"
              },
        "ECCENTRICITY" : {
                "type" : "number",
                "description" : "Eccentricity (unitless)"
              },
        "INCLINATION" : {
                "type" : "number",
                "description" : "Inclination in degrees"
              },
        "RA_OF_ASC_NODE" : {
                "type" : "number",
                "description" : "RA_OF_ASC_NODE in degrees"
              },
        "ARG_OF_PERICENTER" : {
                "type" : "number",
                "description" : "ARG_OF_PERICENTER in degrees"
              },
        "MEAN_ANOMALY" : {
                "type" : "number",
                "description" : "MEAN_ANOMALY in degrees"
              },
        "GM" : {
                "type" : "number",
                "description" : "GM in km**3/s**2"
              },
        "MASS" : {
                "type" : "number",
                "description" : "MASS in kg"
              },
        "SOLAR_RAD_AREA" : {
                "type" : "number",
                "description" : "SOLAR_RAD_AREA in m**2"
              },
        "SOLAR_RAD_COEFF" : {
                "type" : "number",
                "description" : "SOLAR_RAD_COEFF (unitless)"
              },
        "DRAG_AREA" : {
                "type" : "number",
                "description" : "DRAG_AREA in m**2"
              },
        "DRAG_COEFF" : {
                "type" : "number",
                "description" : "DRAG_COEFF (unitless)"
              },
        "EPHEMERIS_TYPE" : {
                "$ref" : "#/definitions/ephemerisFormat",
                "description" : "TLE Related Parameters (Only if MEAN_ELEMENT_THEORY=SGP/SGP4)\nEPHEMERIS_TYPE Default=0"
              },
        "CLASSIFICATION_TYPE" : {
                "type" : "string",
                "description" : "CLASSIFICATION_TYPE Default=U"
              },
        "NORAD_CAT_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "NORAD_CAT_ID (integer) [O if SGP/SGP4]"
              },
        "ELEMENT_SET_NO" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "ELEMENT_SET_NO [O if SGP/SGP4]"
              },
        "REV_AT_EPOCH" : {
                "type" : "number",
                "description" : "REV_AT_EPOCH [O if SGP/SGP4]"
              },
        "BSTAR" : {
                "type" : "number",
                "description" : "BSTAR in 1/Earth radii or BTERM in m**2/kg depending on MEAN_ELEMENT_THEORY [C]"
              },
        "MEAN_MOTION_DOT" : {
                "type" : "number",
                "description" : "MEAN_MOTION_DOT in rev/day**2 [C if SGP or PPT3]"
              },
        "MEAN_MOTION_DDOT" : {
                "type" : "number",
                "description" : "MEAN_MOTION_DDOT in rev/day**3 if SGP/PPT3 or AGOM in m**2/kg if SGP4-XP [C]"
              },
        "COV_REFERENCE_FRAME" : {
                "$ref" : "#/definitions/RFM",
                "description" : "Position/Velocity Covariance Matrix (6x6 Lower Triangular) [C if any covariance provided]\nCOV_REF_FRAME reference frame for covariance [C if covariance given]\nTypically RSW"
              },
        "COVARIANCE" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Covariance matrix as flat array (6x6 lower triangular = 21 elements).\nOrder: [CX_X, CY_X, CY_Y, CZ_X, CZ_Y, CZ_Z,\nCX_DOT_X, CX_DOT_Y, CX_DOT_Z, CX_DOT_X_DOT,\nCY_DOT_X, CY_DOT_Y, CY_DOT_Z, CY_DOT_X_DOT, CY_DOT_Y_DOT,\nCZ_DOT_X, CZ_DOT_Y, CZ_DOT_Z, CZ_DOT_X_DOT, CZ_DOT_Y_DOT, CZ_DOT_Z_DOT]\nUnits: position in km**2, velocity in km**2/s**2, cross in km**2/s"
              },
        "USER_DEFINED_BIP_0044_TYPE" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "USER_DEFINED_BIP_0044_TYPE [O, units per ICD]"
              },
        "USER_DEFINED_OBJECT_DESIGNATOR" : {
                "type" : "string",
                "description" : "USER_DEFINED_OBJECT_DESIGNATOR [O, units per ICD]"
              },
        "USER_DEFINED_EARTH_MODEL" : {
                "type" : "string",
                "description" : "USER_DEFINED_EARTH_MODEL [O, units per ICD]"
              },
        "USER_DEFINED_EPOCH_TIMESTAMP" : {
                "type" : "number",
                "description" : "USER_DEFINED_EPOCH_TIMESTAMP [O, units per ICD]"
              },
        "USER_DEFINED_MICROSECONDS" : {
                "type" : "number",
                "description" : "USER_DEFINED_MICROSECONDS [O, units per ICD]"
              }
      },
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/OMM"
}
