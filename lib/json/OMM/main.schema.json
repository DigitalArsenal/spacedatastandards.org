{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "CelestialFrame" : {
      "type" : "string",
      "enum": ["GCRF", "ICRF", "J2000", "J2000A", "EME2000", "TEMEOFDATE", "GTOD", "CIRS", "MOD_EARTH", "MOD_CB", "MOD_MOON", "TOD_EARTH", "TOD_CB", "TOD_MOON", "TOE_EARTH", "TOE_CB", "TOE_MOON", "ITRF2000", "ITRF93", "ITRF97", "EFG", "FIXED_CB", "FIXED_EARTH", "WGS84", "DTRFYYYY", "ALIGN_EARTH", "ALIGN_CB", "B1950"]
    },
    "SpacecraftFrame" : {
      "type" : "string",
      "enum": ["ACC_i", "ACTUATOR_i", "AST_i", "CSS_i", "DSS_i", "ESA_i", "GYRO_FRAME_i", "IMU_FRAME_i", "INSTRUMENT_i", "MTA_i", "RW_i", "SA_i", "SC_BODY_i", "SENSOR_i", "STARTRACKER_i", "TAM_i"]
    },
    "OrbitFrame" : {
      "type" : "string",
      "enum": ["EQW_INERTIAL", "LVLH_INERTIAL", "LVLH_ROTATING", "NSW_INERTIAL", "NSW_ROTATING", "NTW_INERTIAL", "NTW_ROTATING", "PQW_INERTIAL", "RSW_INERTIAL", "RSW_ROTATING", "SEZ_INERTIAL", "SEZ_ROTATING", "TNW_INERTIAL", "TNW_ROTATING", "VNC_INERTIAL", "VNC_ROTATING"]
    },
    "CustomFrame" : {
      "type" : "string",
      "enum": ["ECEF", "TEME", "TEMEOFEPOCH", "ENU", "NED", "NEU", "RIC", "RTN", "TVN", "VVLH", "QSW", "LTP", "LVLH", "PNE", "BRF", "RSW", "TNW", "UVW"]
    },
    "rfmAxisType" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "MEAN_EQUATOR_EQUINOX_J2000", "MEAN_ECLIPTIC_EQUINOX_J2000", "ICRF", "TRUE_EQUATOR_MEAN_EQUINOX_OF_DATE", "MEAN_OF_DATE_EQUATOR", "MEAN_OF_DATE_ECLIPTIC", "TRUE_OF_DATE_EQUATOR", "TRUE_OF_DATE_ECLIPTIC", "MEAN_OF_EPOCH_EQUATOR", "MEAN_OF_EPOCH_ECLIPTIC", "TRUE_OF_EPOCH_EQUATOR", "TRUE_OF_EPOCH_ECLIPTIC", "BODY_FIXED", "BODY_INERTIAL", "OBJECT_REFERENCED", "LOCAL_ALIGNED_CONSTRAINED", "BODY_EQUATOR", "SOLAR_ECLIPTIC_MAGNETOSPHERIC", "SOLAR_MAGNETOSPHERIC", "TOPOCENTRIC", "BODY_SPIN_SUN", "EPHEMERIS_KERNEL_DEFINED", "MEAN_OF_DATE_EQUATOR_FK5", "TRUE_OF_DATE_EQUATOR_FK5"]
    },
    "rfmOriginKind" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "CELESTIAL_BODY", "BARYCENTRE", "LIBRATION_POINT", "SPACE_OBJECT", "GROUND_SITE"]
    },
    "rfmLibrationPoint" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "L1", "L2", "L3", "L4", "L5"]
    },
    "rfmVectorSpecification" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "RADIAL", "ANTI_RADIAL", "VELOCITY", "ANTI_VELOCITY", "ORBIT_NORMAL", "ANTI_ORBIT_NORMAL"]
    },
    "RFMUnion" : {
      "type" : "string",
      "enum": ["NONE", "CelestialFrameWrapper", "SpacecraftFrameWrapper", "OrbitFrameWrapper", "CustomFrameWrapper", "RFMCoordinateSystemWrapper"]
    },
    "timingStandard" : {
      "type" : "string",
      "enum": ["GMST", "GPS", "MET", "MRT", "SCLK", "TAI", "TCB", "TDB", "TCG", "TT", "UT1", "UTC", "GLONASS", "GST", "QZSS", "BDT", "NAVIC", "SBAS", "A1"]
    },
    "timEpochRepresentation" : {
      "type" : "string",
      "enum": ["JULIAN_DATE", "MODIFIED_JULIAN_DATE", "UNIX_SECONDS", "ISO8601", "GPS_SECONDS", "GNSS_WEEK_SECONDS", "CCSDS_TIME_CODE", "MISSION_ELAPSED_SECONDS"]
    },
    "timCcsdsTimeCodeKind" : {
      "type" : "string",
      "enum": ["NONE", "UNSEGMENTED", "DAY_SEGMENTED", "CALENDAR_SEGMENTED"]
    },
    "timConversionStatus" : {
      "type" : "string",
      "enum": ["OK", "INVALID_INPUT", "UNSUPPORTED_TIME_SYSTEM", "LEAP_SECOND_DATA_REQUIRED", "EOP_DATA_REQUIRED", "OUT_OF_RANGE"]
    },
    "meanElementSource" : {
      "type" : "string",
      "enum": ["SGP4", "SGP4XP", "DSST", "USM"]
    },
    "ephemerisFormat" : {
      "type" : "string",
      "enum": ["SGP", "SGP4", "SDP4", "SGP8", "SDP8"]
    },
    "RFMOrigin" : {
      "type" : "object",
      "description" : "The point a coordinate system is centred on. Body and barycentre\nidentifiers are integer ephemeris body codes; text NAME is descriptive\nonly and is never the machine key.",
      "properties" : {
        "KIND" : {
                "$ref" : "#/definitions/rfmOriginKind"
              },
        "CELESTIAL_BODY_ID" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Ephemeris body code when KIND is CELESTIAL_BODY."
              },
        "BARYCENTRE_ID" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Ephemeris body code of the barycentre when KIND is BARYCENTRE."
              },
        "LIBRATION_POINT" : {
                "$ref" : "#/definitions/rfmLibrationPoint",
                "description" : "Which libration point, when KIND is LIBRATION_POINT."
              },
        "LIBRATION_PRIMARY_ID" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Ephemeris body code of the libration system primary."
              },
        "LIBRATION_SECONDARY_ID" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Ephemeris body code of the libration system secondary."
              },
        "OBJECT_ID" : {
                "type" : "string",
                "description" : "Identifier of the space object when KIND is SPACE_OBJECT."
              },
        "SITE_ID" : {
                "type" : "string",
                "description" : "Identifier of the surface site when KIND is GROUND_SITE."
              },
        "SITE_BODY_ID" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Ephemeris body code of the body the site sits on."
              },
        "SITE_LATITUDE" : {
                "type" : "number",
                "description" : "Geodetic latitude of the site, degrees, positive north."
              },
        "SITE_LONGITUDE" : {
                "type" : "number",
                "description" : "Geodetic longitude of the site, degrees, positive east."
              },
        "SITE_ALTITUDE" : {
                "type" : "number",
                "description" : "Height of the site above the reference ellipsoid, metres."
              },
        "NAME" : {
                "type" : "string",
                "description" : "Human-readable label. Descriptive only."
              }
      },
      "additionalProperties" : false
    },
    "RFMObjectReferencedAxes" : {
      "type" : "object",
      "description" : "Axes built from the relative geometry of two objects. Exactly two of the\nthree axis assignments are independent; the third completes the triad.",
      "properties" : {
        "PRIMARY_OBJECT_ID" : {
                "type" : "string"
              },
        "SECONDARY_OBJECT_ID" : {
                "type" : "string"
              },
        "X_AXIS" : {
                "$ref" : "#/definitions/rfmVectorSpecification"
              },
        "Y_AXIS" : {
                "$ref" : "#/definitions/rfmVectorSpecification"
              },
        "Z_AXIS" : {
                "$ref" : "#/definitions/rfmVectorSpecification"
              }
      },
      "additionalProperties" : false
    },
    "RFMLocalAlignedConstrainedAxes" : {
      "type" : "object",
      "description" : "Axes built by aligning one vector with a reference direction and using a\nsecond vector as a constraint. Vectors are 3-element, expressed in the\ncoordinate system named by REFERENCE_COORDINATE_SYSTEM_NAME.",
      "properties" : {
        "REFERENCE_OBJECT_ID" : {
                "type" : "string"
              },
        "REFERENCE_COORDINATE_SYSTEM_NAME" : {
                "type" : "string"
              },
        "ALIGNMENT_VECTOR" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "ALIGNMENT_REFERENCE_VECTOR" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "CONSTRAINT_VECTOR" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "CONSTRAINT_REFERENCE_VECTOR" : {
                "type" : "array", "items" : {"type" : "number"}
              }
      },
      "additionalProperties" : false
    },
    "RFMCoordinateSystem" : {
      "type" : "object",
      "description" : "A fully specified coordinate system: an axis set, an origin, and the epoch\nand time system the axis set is evaluated at. This is the unit a frames\nconsumer needs; the pre-existing RFMUnion members name an axis convention\nalone and cannot express an origin.",
      "properties" : {
        "NAME" : {
                "type" : "string",
                "description" : "Stable name for this coordinate system within the producing data set."
              },
        "AXIS_TYPE" : {
                "$ref" : "#/definitions/rfmAxisType",
                "description" : "Orientation rule."
              },
        "ORIGIN" : {
                "$ref" : "#/definitions/RFMOrigin",
                "description" : "Centre of the system."
              },
        "AXIS_REFERENCE_BODY_ID" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Ephemeris body code whose equator/rotation defines the axes, for the\nbody-referenced axis types. Independent of ORIGIN."
              },
        "EPOCH" : {
                "type" : "string",
                "description" : "Reference epoch the axis set is evaluated at, ISO 8601. Required for the\nof-date and of-epoch axis types; ignored by the inertial ones."
              },
        "EPOCH_TIME_SYSTEM" : {
                "type" : "string",
                "description" : "Time system the EPOCH is expressed in, named by the $TIM timingStandard\nmember name (for example \"UTC\", \"TAI\", \"TT\", \"TDB\", \"A1\")."
              },
        "OBJECT_REFERENCED_AXES" : {
                "$ref" : "#/definitions/RFMObjectReferencedAxes",
                "description" : "Extra parameters for OBJECT_REFERENCED axes."
              },
        "LOCAL_ALIGNED_CONSTRAINED_AXES" : {
                "$ref" : "#/definitions/RFMLocalAlignedConstrainedAxes",
                "description" : "Extra parameters for LOCAL_ALIGNED_CONSTRAINED axes."
              },
        "KERNEL_FRAME_NAME" : {
                "type" : "string",
                "description" : "Kernel-declared frame name for EPHEMERIS_KERNEL_DEFINED axes."
              },
        "KERNEL_FRAME_ID" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Kernel-declared numeric frame id for EPHEMERIS_KERNEL_DEFINED axes."
              },
        "EOP_DATA_SET_CID" : {
                "type" : "string",
                "description" : "Content identifier of the Earth-orientation data set used to realise\nthis system, when the axis chain requires one. Recorded so that two\nconsumers can prove they used the same table rather than assume it."
              }
      },
      "additionalProperties" : false
    },
    "CelestialFrameWrapper" : {
      "type" : "object",
      "properties" : {
        "frame" : {
                "$ref" : "#/definitions/CelestialFrame"
              }
      },
      "additionalProperties" : false
    },
    "SpacecraftFrameWrapper" : {
      "type" : "object",
      "properties" : {
        "frame" : {
                "$ref" : "#/definitions/SpacecraftFrame"
              }
      },
      "additionalProperties" : false
    },
    "OrbitFrameWrapper" : {
      "type" : "object",
      "properties" : {
        "frame" : {
                "$ref" : "#/definitions/OrbitFrame"
              }
      },
      "additionalProperties" : false
    },
    "CustomFrameWrapper" : {
      "type" : "object",
      "properties" : {
        "frame" : {
                "$ref" : "#/definitions/CustomFrame"
              }
      },
      "additionalProperties" : false
    },
    "RFMCoordinateSystemWrapper" : {
      "type" : "object",
      "properties" : {
        "COORDINATE_SYSTEM" : {
                "$ref" : "#/definitions/RFMCoordinateSystem"
              }
      },
      "additionalProperties" : false
    },
    "RFM" : {
      "type" : "object",
      "description" : "Reference Frame Message",
      "properties" : {
        "REFERENCE_FRAME_type" : {
                "$ref" : "#/definitions/RFMUnion"
              },
        "REFERENCE_FRAME" : {
                "anyOf": [{ "$ref" : "#/definitions/CelestialFrameWrapper" },{ "$ref" : "#/definitions/SpacecraftFrameWrapper" },{ "$ref" : "#/definitions/OrbitFrameWrapper" },{ "$ref" : "#/definitions/CustomFrameWrapper" },{ "$ref" : "#/definitions/RFMCoordinateSystemWrapper" }]
              },
        "INDEX" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "NAME" : {
                "type" : "string"
              }
      },
      "additionalProperties" : false
    },
    "TIMCcsdsTimeCode" : {
      "type" : "object",
      "description" : "CCSDS time-code payload and preamble metadata.",
      "properties" : {
        "CODE_KIND" : {
                "$ref" : "#/definitions/timCcsdsTimeCodeKind",
                "description" : "CCSDS time-code family."
              },
        "PREAMBLE_FIELD1" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "First CCSDS preamble field octet."
              },
        "PREAMBLE_FIELD2" : {
                "type" : "integer", "minimum" : 0, "maximum" :255,
                "description" : "Second CCSDS preamble field octet; ignored when not signaled by preamble 1."
              },
        "TIME_FIELD" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" :255},
                "description" : "Raw CCSDS time field octets."
              },
        "AGENCY_DEFINED_EPOCH_ISO8601" : {
                "type" : "string",
                "description" : "Optional agency-defined epoch timestamp for agency epoch time codes."
              },
        "CCSDS_EPOCH_ISO8601" : {
                "type" : "string",
                "description" : "Optional CCSDS epoch override timestamp; defaults to 1958-01-01T00:00:00 TAI."
              }
      },
      "additionalProperties" : false
    },
    "TIMInstant" : {
      "type" : "object",
      "description" : "Numeric or textual instant tagged with its time system and representation.",
      "properties" : {
        "TIME_SYSTEM" : {
                "$ref" : "#/definitions/timingStandard",
                "description" : "Time system for this instant."
              },
        "EPOCH_FORMAT" : {
                "$ref" : "#/definitions/timEpochRepresentation",
                "description" : "Interpretation of JULIAN_DATE, SECONDS, and ISO8601."
              },
        "JULIAN_DATE" : {
                "type" : "number",
                "description" : "Julian Date or Modified Julian Date day value, selected by EPOCH_FORMAT."
              },
        "SECONDS" : {
                "type" : "number",
                "description" : "Seconds for UNIX_SECONDS, GPS_SECONDS, GNSS_WEEK_SECONDS, or MISSION_ELAPSED_SECONDS."
              },
        "ISO8601" : {
                "type" : "string",
                "description" : "ISO 8601 timestamp text for ISO8601 inputs or display outputs."
              },
        "SUBSECOND_NANOS" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Additional nanoseconds beyond the fractional scalar/text value."
              },
        "EPOCH_LABEL" : {
                "type" : "string",
                "description" : "Optional application-defined epoch label for MET, MRT, or SCLK values."
              },
        "GNSS_WEEK" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "GNSS week number when EPOCH_FORMAT is GNSS_WEEK_SECONDS."
              },
        "HAS_GNSS_ROLLOVER_REFERENCE" : {
                "type" : "boolean",
                "description" : "Whether GNSS_ROLLOVER_REFERENCE_ISO8601 should be applied."
              },
        "GNSS_ROLLOVER_REFERENCE_ISO8601" : {
                "type" : "string",
                "description" : "Optional Orekit-style GNSS week rollover reference timestamp."
              },
        "CCSDS_TIME_CODE" : {
                "$ref" : "#/definitions/TIMCcsdsTimeCode",
                "description" : "CCSDS time-code payload when EPOCH_FORMAT is CCSDS_TIME_CODE."
              }
      },
      "additionalProperties" : false
    },
    "TIMConversionRequest" : {
      "type" : "object",
      "description" : "Request to convert one instant into another time system/representation.",
      "properties" : {
        "SOURCE" : {
                "$ref" : "#/definitions/TIMInstant",
                "description" : "Source instant to convert."
              },
        "TARGET_TIME_SYSTEM" : {
                "$ref" : "#/definitions/timingStandard",
                "description" : "Target time system."
              },
        "TARGET_EPOCH_FORMAT" : {
                "$ref" : "#/definitions/timEpochRepresentation",
                "description" : "Preferred target representation."
              },
        "TAI_MINUS_UTC_SECONDS" : {
                "type" : "number",
                "description" : "Optional TAI-UTC override in seconds for the source instant."
              },
        "HAS_TAI_MINUS_UTC" : {
                "type" : "boolean",
                "description" : "Whether TAI_MINUS_UTC_SECONDS should override runtime leap-second data."
              },
        "DUT1_SECONDS" : {
                "type" : "number",
                "description" : "Optional UT1-UTC override in seconds for UT1 conversions."
              },
        "HAS_DUT1" : {
                "type" : "boolean",
                "description" : "Whether DUT1_SECONDS should override runtime Earth-orientation data."
              },
        "TRACE_ID" : {
                "type" : "string",
                "description" : "Optional caller trace/correlation identifier."
              }
      },
      "additionalProperties" : false
    },
    "TIMConversionResult" : {
      "type" : "object",
      "description" : "Result of a time conversion request.",
      "properties" : {
        "SOURCE" : {
                "$ref" : "#/definitions/TIMInstant",
                "description" : "Original source instant."
              },
        "TARGET" : {
                "$ref" : "#/definitions/TIMInstant",
                "description" : "Converted target instant."
              },
        "DELTA_SECONDS" : {
                "type" : "number",
                "description" : "Target minus source offset in SI seconds for the requested conversion."
              },
        "STATUS" : {
                "$ref" : "#/definitions/timConversionStatus",
                "description" : "Conversion status."
              },
        "ERROR_MESSAGE" : {
                "type" : "string",
                "description" : "Optional error detail when STATUS is not OK."
              },
        "TRACE_ID" : {
                "type" : "string",
                "description" : "Caller trace/correlation identifier copied from the request when present."
              }
      },
      "additionalProperties" : false
    },
    "TIM" : {
      "type" : "object",
      "description" : "Time System and time-conversion envelope.",
      "properties" : {
        "TIME_SYSTEM" : {
                "$ref" : "#/definitions/timingStandard",
                "description" : "Legacy time-system selector retained for existing TIM consumers."
              },
        "INSTANT" : {
                "$ref" : "#/definitions/TIMInstant",
                "description" : "A single tagged instant."
              },
        "CONVERSION_REQUEST" : {
                "$ref" : "#/definitions/TIMConversionRequest",
                "description" : "Time conversion request."
              },
        "CONVERSION_RESULT" : {
                "$ref" : "#/definitions/TIMConversionResult",
                "description" : "Time conversion result."
              }
      },
      "additionalProperties" : false
    },
    "MET" : {
      "type" : "object",
      "description" : "Mean Element Theory",
      "properties" : {
        "MEAN_ELEMENT_THEORY" : {
                "$ref" : "#/definitions/meanElementSource"
              }
      },
      "additionalProperties" : false
    },
    "OMM" : {
      "type" : "object",
      "description" : "Orbit Mean Elements Message",
      "properties" : {
        "CCSDS_OMM_VERS" : {
                "type" : "number",
                "description" : "CCSDS OMM Version"
              },
        "CREATION_DATE" : {
                "type" : "string",
                "description" : "Creation Date (ISO 8601 UTC format)"
              },
        "ORIGINATOR" : {
                "type" : "string",
                "description" : "Originator"
              },
        "OBJECT_NAME" : {
                "type" : "string",
                "description" : "Satellite Name(s)"
              },
        "OBJECT_ID" : {
                "type" : "string",
                "description" : "International Designator (YYYY-NNNAAA)"
              },
        "CENTER_NAME" : {
                "type" : "string",
                "description" : "Center Name (e.g. EARTH, MARS)"
              },
        "REFERENCE_FRAME" : {
                "$ref" : "#/definitions/RFM",
                "description" : "Reference Frame\nTypically TEMEOFDATE"
              },
        "REFERENCE_FRAME_EPOCH" : {
                "type" : "string",
                "description" : "Reference Frame Epoch (ISO 8601 UTC format)"
              },
        "TIME_SYSTEM" : {
                "$ref" : "#/definitions/timingStandard",
                "description" : "Time System [M, UTC]"
              },
        "MEAN_ELEMENT_THEORY" : {
                "$ref" : "#/definitions/meanElementSource",
                "description" : "Mean Element Theory"
              },
        "COMMENT" : {
                "type" : "string",
                "description" : "COMMENT (O)"
              },
        "EPOCH" : {
                "type" : "string",
                "description" : "EPOCH of Mean Keplerian elements (ISO 8601 UTC format)"
              },
        "SEMI_MAJOR_AXIS" : {
                "type" : "number",
                "description" : "Semi-major axis in km or Mean Motion in rev/day"
              },
        "MEAN_MOTION" : {
                "type" : "number",
                "description" : "Mean motion in rev/day if MEAN_ELEMENT_THEORY=SGP/SGP4 else unused"
              },
        "ECCENTRICITY" : {
                "type" : "number",
                "description" : "Eccentricity (unitless)"
              },
        "INCLINATION" : {
                "type" : "number",
                "description" : "Inclination in degrees"
              },
        "RA_OF_ASC_NODE" : {
                "type" : "number",
                "description" : "RA_OF_ASC_NODE in degrees"
              },
        "ARG_OF_PERICENTER" : {
                "type" : "number",
                "description" : "ARG_OF_PERICENTER in degrees"
              },
        "MEAN_ANOMALY" : {
                "type" : "number",
                "description" : "MEAN_ANOMALY in degrees"
              },
        "GM" : {
                "type" : "number",
                "description" : "GM in km**3/s**2"
              },
        "MASS" : {
                "type" : "number",
                "description" : "MASS in kg"
              },
        "SOLAR_RAD_AREA" : {
                "type" : "number",
                "description" : "SOLAR_RAD_AREA in m**2"
              },
        "SOLAR_RAD_COEFF" : {
                "type" : "number",
                "description" : "SOLAR_RAD_COEFF (unitless)"
              },
        "DRAG_AREA" : {
                "type" : "number",
                "description" : "DRAG_AREA in m**2"
              },
        "DRAG_COEFF" : {
                "type" : "number",
                "description" : "DRAG_COEFF (unitless)"
              },
        "EPHEMERIS_TYPE" : {
                "$ref" : "#/definitions/ephemerisFormat",
                "description" : "TLE Related Parameters (Only if MEAN_ELEMENT_THEORY=SGP/SGP4)\nEPHEMERIS_TYPE Default=0"
              },
        "CLASSIFICATION_TYPE" : {
                "type" : "string",
                "description" : "CLASSIFICATION_TYPE Default=U"
              },
        "NORAD_CAT_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "NORAD_CAT_ID (integer) [O if SGP/SGP4]"
