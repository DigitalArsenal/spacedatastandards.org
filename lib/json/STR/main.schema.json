{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "phbSpectralRegime" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "GAMMA_RAY", "HARD_X_RAY", "SOFT_X_RAY", "EXTREME_ULTRAVIOLET", "FAR_ULTRAVIOLET", "NEAR_ULTRAVIOLET", "VISIBLE", "NEAR_INFRARED", "MID_INFRARED", "FAR_INFRARED", "SUBMILLIMETRE", "MICROWAVE", "RADIO"]
    },
    "phbMagnitudeSystem" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "VEGA", "AB", "ST", "INSTRUMENTAL", "NOT_A_MAGNITUDE"]
    },
    "phbQuantity" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "MAGNITUDE", "FLUX_DENSITY_JY", "ENERGY_FLUX_W_PER_M2", "PHOTON_FLUX_PER_M2_S", "COUNT_RATE_PER_S", "BRIGHTNESS_TEMPERATURE_K"]
    },
    "phbDerivation" : {
      "type" : "string",
      "enum": ["UNSPECIFIED", "MEASURED", "TRANSFORMED", "MODELLED"]
    },
    "phbBoundKind" : {
      "type" : "string",
      "enum": ["DETECTION", "UPPER_LIMIT", "LOWER_LIMIT"]
    },
    "PHBMeasurement" : {
      "type" : "object",
      "description" : "One source's brightness in one band.",
      "properties" : {
        "BAND_ID" : {
                "type" : "string",
                "description" : "Band identifier; resolves to a `$PHB` BAND_ID."
              },
        "SPECTRAL_REGIME" : {
                "$ref" : "#/definitions/phbSpectralRegime",
                "description" : "Coarse region of the band, copied from its descriptor so a consumer\ncan select a mode without resolving the band."
              },
        "WAVELENGTH_EFF_NM" : {
                "type" : "number",
                "description" : "Effective wavelength of the band, nanometres (vacuum). Copied from the\ndescriptor; required for synthesis when the descriptor is not at hand."
              },
        "QUANTITY" : {
                "$ref" : "#/definitions/phbQuantity",
                "description" : "Quantity VALUE states."
              },
        "MAGNITUDE_SYSTEM" : {
                "$ref" : "#/definitions/phbMagnitudeSystem",
                "description" : "Calibration system when QUANTITY is MAGNITUDE."
              },
        "VALUE" : {
                "type" : "number",
                "description" : "The measurement, in QUANTITY's units."
              },
        "UNCERTAINTY" : {
                "type" : "number",
                "description" : "One-sigma uncertainty of VALUE, same units."
              },
        "BOUND" : {
                "$ref" : "#/definitions/phbBoundKind",
                "description" : "Detection or bound."
              },
        "DERIVATION" : {
                "$ref" : "#/definitions/phbDerivation",
                "description" : "How the value was obtained."
              },
        "EPOCH_MJD" : {
                "type" : "number",
                "description" : "Mid-time of the observation, Modified Julian Date (TT), for sources\nwhose brightness varies. Absent for a catalogue mean."
              },
        "OBSERVATION_COUNT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Number of observations averaged into VALUE; 0 when unstated."
              }
      },
      "additionalProperties" : false
    },
    "PHB" : {
      "type" : "object",
      "description" : "Photometric Band: one passband's place on the spectrum and its calibration.",
      "properties" : {
        "BAND_ID" : {
                "type" : "string",
                "description" : "Stable band identifier, unique within the publishing catalogue, e.g.\n\"V\", \"Ks\", \"0.5-2keV\", \"1.4GHz\". Measurements refer to it."
              },
        "NAME" : {
                "type" : "string",
                "description" : "Human-readable name."
              },
        "SYSTEM_NAME" : {
                "type" : "string",
                "description" : "Name of the photometric system the band belongs to, as the defining\npublication states it."
              },
        "SPECTRAL_REGIME" : {
                "$ref" : "#/definitions/phbSpectralRegime",
                "description" : "Coarse spectral region, by WAVELENGTH_EFF_NM."
              },
        "WAVELENGTH_EFF_NM" : {
                "type" : "number",
                "description" : "Effective (pivot) wavelength, nanometres, vacuum."
              },
        "WAVELENGTH_MIN_NM" : {
                "type" : "number",
                "description" : "Short edge of the band at half maximum response, nanometres."
              },
        "WAVELENGTH_MAX_NM" : {
                "type" : "number",
                "description" : "Long edge of the band at half maximum response, nanometres."
              },
        "MAGNITUDE_SYSTEM" : {
                "$ref" : "#/definitions/phbMagnitudeSystem",
                "description" : "Calibration system of magnitudes stated in the band."
              },
        "ZERO_POINT_JY" : {
                "type" : "number",
                "description" : "Flux density at the effective wavelength of a zero-magnitude source,\njanskys."
              },
        "RESPONSE_WAVELENGTH_NM" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Wavelengths the response curve is sampled at, nanometres, ascending."
              },
        "RESPONSE" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Relative system response at each RESPONSE_WAVELENGTH_NM sample,\npeak-normalised to 1. Photon-counting unless RESPONSE_IS_ENERGY."
              },
        "RESPONSE_IS_ENERGY" : {
                "type" : "boolean",
                "description" : "True when RESPONSE is an energy-counting response."
              },
        "CITATION" : {
                "type" : "string",
                "description" : "Reference to the publication that defines the band."
              },
        "DEFINITION_URL" : {
                "type" : "string",
                "description" : "URL of the band's defining document or response table."
              }
      },
      "required" : ["BAND_ID"],
      "additionalProperties" : false
    },
    "STR" : {
      "type" : "object",
      "description" : "Star Catalog Entry",
      "properties" : {
        "ID" : {
                "type" : "string",
                "description" : "Unique internal identifier"
              },
        "CS_ID" : {
                "type" : "integer", "minimum" : -9223372036854775808, "maximum" : 9223372036854775807,
                "description" : "Community satellite-tracking star catalog identifier"
              },
        "GNC_CAT_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "GNC star catalog identifier"
              },
        "GAIADR3_CAT_ID" : {
                "type" : "integer", "minimum" : -9223372036854775808, "maximum" : 9223372036854775807,
                "description" : "Source identifier in the third data release of the all-sky space astrometry survey"
              },
        "HIP_CAT_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Identifier in the first space astrometry mission's main catalog"
              },
        "CAT_VERSION" : {
                "type" : "string",
                "description" : "Catalog version string"
              },
        "ASTROMETRY_ORIGIN" : {
                "type" : "string",
                "description" : "Astrometry source description"
              },
        "STAR_EPOCH" : {
                "type" : "number",
                "description" : "Epoch of stellar position (Julian years)"
              },
        "RA" : {
                "type" : "number",
                "description" : "Right ascension (degrees, ICRS)"
              },
        "RA_UNC" : {
                "type" : "number",
                "description" : "Right ascension uncertainty (arcseconds)"
              },
        "DEC" : {
                "type" : "number",
                "description" : "Declination (degrees, ICRS)"
              },
        "DEC_UNC" : {
                "type" : "number",
                "description" : "Declination uncertainty (arcseconds)"
              },
        "POS_UNC_FLAG" : {
                "type" : "boolean",
                "description" : "True if position uncertainty is flagged"
              },
        "PARALLAX" : {
                "type" : "number",
                "description" : "Parallax (milliarcseconds)"
              },
        "PARALLAX_UNC" : {
                "type" : "number",
                "description" : "Parallax uncertainty (milliarcseconds)"
              },
        "PMRA" : {
                "type" : "number",
                "description" : "Proper motion in RA (milliarcseconds/year)"
              },
        "PMRA_UNC" : {
                "type" : "number",
                "description" : "Proper motion in RA uncertainty (milliarcseconds/year)"
              },
        "PMDEC" : {
                "type" : "number",
                "description" : "Proper motion in DEC (milliarcseconds/year)"
              },
        "PMDEC_UNC" : {
                "type" : "number",
                "description" : "Proper motion in DEC uncertainty (milliarcseconds/year)"
              },
        "PM_UNC_FLAG" : {
                "type" : "boolean",
                "description" : "True if proper motion uncertainty is flagged"
              },
        "GMAG" : {
                "type" : "number",
                "description" : "Broad-band G magnitude of the space astrometry photometric system"
              },
        "GMAG_UNC" : {
                "type" : "number",
                "description" : "G-band magnitude uncertainty"
              },
        "BPMAG" : {
                "type" : "number",
                "description" : "BP-band magnitude (blue prism photometer of the space astrometry system)"
              },
        "BPMAG_UNC" : {
                "type" : "number",
                "description" : "BP-band magnitude uncertainty"
              },
        "RPMAG" : {
                "type" : "number",
                "description" : "RP-band magnitude (red prism photometer of the space astrometry system)"
              },
        "RPMAG_UNC" : {
                "type" : "number",
                "description" : "RP-band magnitude uncertainty"
              },
        "JMAG" : {
                "type" : "number",
                "description" : "Near-infrared J-band magnitude (1.25 um)"
              },
        "JMAG_UNC" : {
                "type" : "number",
                "description" : "J-band magnitude uncertainty"
              },
        "KMAG" : {
                "type" : "number",
                "description" : "Near-infrared Ks-band magnitude (2.17 um)"
              },
        "KMAG_UNC" : {
                "type" : "number",
                "description" : "K-band magnitude uncertainty"
              },
        "HMAG" : {
                "type" : "number",
                "description" : "Near-infrared H-band magnitude (1.65 um)"
              },
        "HMAG_UNC" : {
                "type" : "number",
                "description" : "H-band magnitude uncertainty"
              },
        "VAR_FLAG" : {
                "type" : "boolean",
                "description" : "True if star is variable"
              },
        "MULT_FLAG" : {
                "type" : "boolean",
                "description" : "True if star is in a multiple system"
              },
        "NEIGHBOR_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Nearest neighbor catalog identifier"
              },
        "NEIGHBOR_FLAG" : {
                "type" : "boolean",
                "description" : "True if nearest neighbor is within confusion radius"
              },
        "NEIGHBOR_DISTANCE" : {
                "type" : "number",
                "description" : "Distance to nearest neighbor (arcseconds)"
              },
        "SHIFT_FLAG" : {
                "type" : "boolean",
                "description" : "True if position shift detected between catalogs"
              },
        "SHIFT" : {
                "type" : "number",
                "description" : "Position shift magnitude (arcseconds)"
              },
        "TEFF" : {
                "type" : "number",
                "description" : "Effective temperature (kelvin)"
              },
        "TEFF_UNC" : {
                "type" : "number",
                "description" : "Effective temperature uncertainty (kelvin)"
              },
        "LOGG" : {
                "type" : "number",
                "description" : "Surface gravity, log10 of g in cm s^-2"
              },
        "LOGG_UNC" : {
                "type" : "number",
                "description" : "Surface gravity uncertainty (dex)"
              },
        "METALLICITY" : {
                "type" : "number",
                "description" : "Metallicity [M/H] (dex)"
              },
        "EXTINCTION_A0" : {
                "type" : "number",
                "description" : "Interstellar extinction at 541.4 nm, A0 (magnitudes)"
              },
        "RADIAL_VELOCITY" : {
                "type" : "number",
                "description" : "Radial velocity, positive receding (km/s)"
              },
        "RADIAL_VELOCITY_UNC" : {
                "type" : "number",
                "description" : "Radial velocity uncertainty (km/s)"
              },
        "SPECTRAL_TYPE" : {
                "type" : "string",
                "description" : "Spectral type in the MK system, e.g. \"A1 V\""
              },
        "PROPER_NAME" : {
                "type" : "string",
                "description" : "Proper name as recognised by the astronomical naming authority"
              },
        "BAYER_FLAMSTEED" : {
                "type" : "string",
                "description" : "Bayer or Flamsteed designation with its constellation, e.g. \"alf CMa\" or \"9 CMa\""
              },
        "CONSTELLATION" : {
                "type" : "string",
                "description" : "Constellation containing the star, three-letter abbreviation"
              },
        "HR_CAT_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Bright-star catalog number (HR); 0 when not in that catalog"
              },
        "HD_CAT_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Spectral-type catalog number (HD); 0 when not in that catalog"
              },
        "DESIGNATIONS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Other designations, each in the form its catalog uses"
              },
        "VARIABILITY_CLASS" : {
                "type" : "string",
                "description" : "Variability type in the standard variable-star classification, e.g. \"DSCT\" or \"EA\""
              },
        "VARIABILITY_PERIOD" : {
                "type" : "number",
                "description" : "Period of variability (days)"
              },
        "VARIABILITY_AMPLITUDE" : {
                "type" : "number",
                "description" : "Peak-to-peak variability amplitude (magnitudes)"
              },
        "VARIABILITY_EPOCH" : {
                "type" : "number",
                "description" : "Epoch of maximum light (or minimum, for eclipsing systems), Modified Julian Date (TT)"
              },
        "PHOTOMETRY" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/PHBMeasurement"},
                "description" : "Brightness in every band the star was measured or modelled in"
              }
      },
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/STR"
}
