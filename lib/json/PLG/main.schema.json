{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "payloadWireFormat" : {
      "type" : "string",
      "enum": ["FLATBUFFER", "ALIGNED_BINARY"]
    },
    "bufferMutability" : {
      "type" : "string",
      "enum": ["IMMUTABLE", "SINGLE_WRITER_MUTABLE", "APPEND_ONLY"]
    },
    "bufferOwnership" : {
      "type" : "string",
      "enum": ["HOST_OWNED", "PLUGIN_OWNED", "TRANSFERRED"]
    },
    "pluginCategory" : {
      "type" : "string",
      "enum": ["Sensor", "Propagator", "Renderer", "Analysis", "DataSource", "EW", "Comms", "Physics", "Shader", "Parser", "Validator", "Interpolator", "Exporter", "Foundation", "Infrastructure", "Licensing", "Storefront", "Publisher", "Basilisk", "Maneuver", "Flow", "Unspecified"]
    },
    "purchaseTier" : {
      "type" : "string",
      "enum": ["Free", "OneTime", "Subscription"]
    },
    "publicationState" : {
      "type" : "string",
      "enum": ["Public", "Unlisted", "Retired"]
    },
    "invokeSurfaceKind" : {
      "type" : "string",
      "enum": ["DIRECT", "COMMAND"]
    },
    "drainBehavior" : {
      "type" : "string",
      "enum": ["SINGLE_SHOT", "DRAIN_UNTIL_YIELD", "DRAIN_TO_EMPTY"]
    },
    "hostCapabilityKind" : {
      "type" : "string",
      "enum": ["CLOCK", "RANDOM", "LOGGING", "TIMERS", "PUBSUB", "PROTOCOL_DIAL", "PROTOCOL_HANDLE", "STORAGE_QUERY", "SCENE_ACCESS", "ENTITY_ACCESS", "RENDER_HOOKS", "HTTP", "FILESYSTEM", "PIPE", "NETWORK", "DATABASE", "STORAGE_ADAPTER", "STORAGE_WRITE", "WALLET_SIGN", "IPFS", "TLS", "MQTT", "WEBSOCKET", "TCP", "UDP", "PROCESS_EXEC", "CONTEXT_READ", "CONTEXT_WRITE", "CRYPTO_HASH", "CRYPTO_SIGN", "CRYPTO_VERIFY", "CRYPTO_ENCRYPT", "CRYPTO_DECRYPT", "CRYPTO_KEY_AGREEMENT", "CRYPTO_KDF", "SCHEDULE_CRON", "STORAGE_INGEST"]
    },
    "flowEdgeRoutePolicy" : {
      "type" : "string",
      "enum": ["CANONICAL_ONLY", "ALIGNED_SHARED_ARENA_OR_CANONICAL"]
    },
    "FlatBufferTypeRef" : {
      "type" : "object",
      "description" : "Payload-schema identity for a stream frame or an accepted port type.",
      "properties" : {
        "SCHEMA_NAME" : {
                "type" : "string",
                "description" : "Logical schema name (for example `OMM.fbs` or `OCM.fbs`)."
              },
        "FILE_IDENTIFIER" : {
                "type" : "string",
                "description" : "Optional 4-byte FlatBuffer file identifier."
              },
        "SCHEMA_VERSION" : {
                "type" : "string",
                "description" : "Optional semver or schema revision string."
              },
        "ROOT_TYPE" : {
                "type" : "string",
                "description" : "Optional root type name within the schema."
              },
        "SCHEMA_HASH" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" :255},
                "description" : "Optional schema hash bytes for stronger compatibility checks."
              },
        "ACCEPTS_ANY_FLATBUFFER" : {
                "type" : "boolean",
                "description" : "True when this port/type set accepts any FlatBuffer frame."
              },
        "WIRE_FORMAT" : {
                "$ref" : "#/definitions/payloadWireFormat",
                "description" : "Logical wire format for this accepted type."
              },
        "FIXED_STRING_LENGTH" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Fixed string length for aligned-binary string fields, when applicable."
              },
        "BYTE_LENGTH" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Byte length for fixed-size aligned-binary records, when applicable."
              },
        "REQUIRED_ALIGNMENT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Required start alignment for aligned-binary records, when applicable."
              }
      },
      "additionalProperties" : false
    },
    "TAB" : {
      "type" : "object",
      "description" : "Typed Arena Buffer — one descriptor for a payload slot in a shared arena.",
      "properties" : {
        "OFFSET" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Byte offset of the payload body within the arena."
              },
        "SIZE" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Byte length of the payload body."
              },
        "ALIGNMENT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Required start alignment of the payload body (in bytes)."
              },
        "WIRE_FORMAT" : {
                "$ref" : "#/definitions/payloadWireFormat",
                "description" : "Wire format for the body."
              },
        "TYPE_REF" : {
                "$ref" : "#/definitions/FlatBufferTypeRef",
                "description" : "Optional payload schema identity."
              },
        "MUTABILITY" : {
                "$ref" : "#/definitions/bufferMutability",
                "description" : "Mutability contract for the slot."
              },
        "OWNERSHIP" : {
                "$ref" : "#/definitions/bufferOwnership",
                "description" : "Ownership contract for the slot."
              },
        "FRAME_ID" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615,
                "description" : "Optional opaque frame identifier for stream bookkeeping."
              },
        "PORT_ID" : {
                "type" : "string",
                "description" : "Optional port identifier for frames that route to/from a named\ninput or output port on a method (maps to\n`PLG.PLGPortManifest.PORT_ID`). Empty for arena frames that carry\nno port routing hint."
              }
      },
      "additionalProperties" : false
    },
    "PluginCapability" : {
      "type" : "object",
      "description" : "Plugin capability declaration",
      "properties" : {
        "NAME" : {
                "type" : "string",
                "description" : "Capability name, e.g., \"gpu_compute\", \"wasm_simd\""
              },
        "VERSION" : {
                "type" : "string",
                "description" : "Capability version"
              },
        "REQUIRED" : {
                "type" : "boolean",
                "description" : "Whether this capability is required"
              }
      },
      "additionalProperties" : false
    },
    "PLGAcceptedTypeSet" : {
      "type" : "object",
      "description" : "Accepted schema family for a port. When a port accepts multiple wire\nformats (canonical FlatBuffer + aligned-binary), each ALLOWED_TYPE\nentry carries its own TAB.FlatBufferTypeRef with the schema identity,\nand the enclosing PLGPortManifest advertises both wire formats via\nALLOWED_WIRE_FORMATS. Per SDK contract: a port that advertises\naligned-binary MUST also advertise the canonical flatbuffer fallback\nfor the same schema and file identifier in the same set.",
      "properties" : {
        "SET_ID" : {
                "type" : "string",
                "description" : "Stable type-set identifier within the port."
              },
        "ALLOWED_TYPES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/FlatBufferTypeRef"},
                "description" : "Specific FlatBuffer types accepted by the set."
              },
        "ALLOWED_WIRE_FORMATS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/payloadWireFormat"},
                "description" : "Wire formats this set accepts. If ALIGNED_BINARY is present,\nFLATBUFFER MUST also be present for the same schemas."
              },
        "DESCRIPTION" : {
                "type" : "string",
                "description" : "Human-readable explanation of the accepted schema family."
              }
      },
      "required" : ["SET_ID"],
      "additionalProperties" : false
    },
    "PLGPortManifest" : {
      "type" : "object",
      "description" : "One input or output port on a method.",
      "properties" : {
        "PORT_ID" : {
                "type" : "string",
                "description" : "Stable port identifier within the method."
              },
        "DISPLAY_NAME" : {
                "type" : "string",
                "description" : "Human-readable name for UIs."
              },
        "ACCEPTED_TYPE_SETS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/PLGAcceptedTypeSet"},
                "description" : "Type sets accepted on this port."
              },
        "MIN_STREAMS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Minimum number of streams that must be connected."
              },
        "MAX_STREAMS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535,
                "description" : "Maximum number of streams that may be connected."
              },
        "REQUIRED" : {
                "type" : "boolean",
                "description" : "Whether the port must be connected for invocation."
              },
        "DESCRIPTION" : {
                "type" : "string",
                "description" : "Optional human-readable description."
              }
      },
      "required" : ["PORT_ID"],
      "additionalProperties" : false
    },
    "PLGHostCapability" : {
      "type" : "object",
      "description" : "One host capability dependency (richer form of PluginCapability).",
      "properties" : {
        "CAPABILITY" : {
                "$ref" : "#/definitions/hostCapabilityKind"
              },
        "SCOPE" : {
                "type" : "string"
              },
        "REQUIRED" : {
                "type" : "boolean"
              },
        "DESCRIPTION" : {
                "type" : "string"
              }
      },
      "additionalProperties" : false
    },
    "PLGTimerSpec" : {
      "type" : "object",
      "description" : "Timer entry declared by a plugin.",
      "properties" : {
        "TIMER_ID" : {
                "type" : "string"
              },
        "METHOD_ID" : {
                "type" : "string"
              },
        "INPUT_PORT_ID" : {
                "type" : "string"
              },
        "DEFAULT_INTERVAL_MS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615
              },
        "DESCRIPTION" : {
                "type" : "string"
              }
      },
      "required" : ["TIMER_ID", "METHOD_ID"],
      "additionalProperties" : false
    },
    "PLGProtocolSpec" : {
      "type" : "object",
      "description" : "Protocol handler declared by a plugin.",
      "properties" : {
        "PROTOCOL_ID" : {
                "type" : "string"
              },
        "METHOD_ID" : {
                "type" : "string"
              },
        "INPUT_PORT_ID" : {
                "type" : "string"
              },
        "OUTPUT_PORT_ID" : {
                "type" : "string"
              },
        "DESCRIPTION" : {
                "type" : "string"
              },
        "WIRE_ID" : {
                "type" : "string"
              },
        "TRANSPORT_KIND" : {
                "type" : "string"
              },
        "ROLE" : {
                "type" : "string"
              },
        "SPEC_URI" : {
                "type" : "string"
              },
        "AUTO_INSTALL" : {
                "type" : "boolean"
              },
        "ADVERTISE" : {
                "type" : "boolean"
              },
        "DISCOVERY_KEY" : {
                "type" : "string"
              },
        "DEFAULT_PORT" : {
                "type" : "integer", "minimum" : 0, "maximum" : 65535
              },
        "REQUIRE_SECURE_TRANSPORT" : {
                "type" : "boolean"
              }
      },
      "required" : ["PROTOCOL_ID", "METHOD_ID"],
      "additionalProperties" : false
    },
    "PLGBuildArtifact" : {
      "type" : "object",
      "description" : "Build artifact emitted by the plugin toolchain.",
      "properties" : {
        "ARTIFACT_ID" : {
                "type" : "string"
              },
        "KIND" : {
                "type" : "string"
              },
        "PATH" : {
                "type" : "string"
              },
        "TARGET" : {
                "type" : "string"
              },
        "ENTRY_SYMBOL" : {
                "type" : "string"
              }
      },
      "required" : ["ARTIFACT_ID", "PATH"],
      "additionalProperties" : false
    },
    "PLGMethodManifest" : {
      "type" : "object",
      "description" : "Canonical method declaration.",
      "properties" : {
        "METHOD_ID" : {
                "type" : "string"
              },
        "DISPLAY_NAME" : {
                "type" : "string"
              },
        "INPUT_PORTS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/PLGPortManifest"}
              },
        "OUTPUT_PORTS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/PLGPortManifest"}
              },
        "MAX_BATCH" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295
              },
        "DRAIN_POLICY" : {
                "$ref" : "#/definitions/drainBehavior"
              },
        "DESCRIPTION" : {
                "type" : "string"
              }
      },
      "required" : ["METHOD_ID"],
      "additionalProperties" : false
    },
    "PluginDependency" : {
      "type" : "object",
      "description" : "Plugin dependency on another plugin",
      "properties" : {
        "PLUGIN_ID" : {
                "type" : "string",
                "description" : "Plugin ID of the dependency"
              },
        "MIN_VERSION" : {
                "type" : "string",
                "description" : "Minimum version required (semver)"
              },
        "MAX_VERSION" : {
                "type" : "string",
                "description" : "Maximum version allowed (optional)"
              }
      },
      "additionalProperties" : false
    },
    "EntryFunction" : {
      "type" : "object",
      "description" : "Plugin entry point function definition",
      "properties" : {
        "NAME" : {
                "type" : "string",
                "description" : "Function name as exported from WASM"
              },
        "DESCRIPTION" : {
                "type" : "string",
                "description" : "Human-readable description"
              },
        "INPUT_SCHEMAS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Input parameter types (FlatBuffer schema names)"
              },
        "OUTPUT_SCHEMA" : {
                "type" : "string",
                "description" : "Output type (FlatBuffer schema name)"
              }
      },
      "required" : ["NAME"],
      "additionalProperties" : false
    },
    "PLGFlowNode" : {
      "type" : "object",
      "description" : "One node in a composed flow graph. A degenerate flow IS a module: a leaf\nmodule leaves the flow-graph fields on PLG empty; a composed flow populates\nthem. This is how flows reuse the module schema rather than a separate one.",
      "properties" : {
        "NODE_ID" : {
                "type" : "string",
                "description" : "Stable node identifier within this flow"
              },
        "PLUGIN_ID" : {
                "type" : "string",
                "description" : "Plugin id of the module this node invokes"
              },
        "METHOD_ID" : {
                "type" : "string",
                "description" : "Method id invoked on the module"
              },
        "KIND" : {
                "type" : "string",
                "description" : "Node kind, e.g. \"transform\", \"trigger\", \"capability\""
              },
        "DISPATCH_MODEL" : {
                "type" : "string",
                "description" : "Dispatch model: empty = linked-direct (in-wasm), \"isomorphic\" = an\nindependently instantiated signed WASM node, and \"host-capability\" = a\ngeneric host adapter."
              },
        "CONFIG" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" :255},
                "description" : "Opaque per-node configuration (FlatBuffer or raw bytes; never JSON)"
              },
        "UI_X" : {
                "type" : "number",
                "description" : "Editor layout X position"
              },
        "UI_Y" : {
                "type" : "number",
                "description" : "Editor layout Y position"
              }
      },
      "required" : ["NODE_ID", "PLUGIN_ID"],
      "additionalProperties" : false
    },
    "PLGFlowEdgeContract" : {
      "type" : "object",
      "description" : "Exact validated SDS and representation contract bound into a signed flow\nedge. CANONICAL_TYPE and ALIGNED_TYPE describe the same logical schema;\nALIGNED_TYPE carries its fixed layout in TAB.FlatBufferTypeRef.",
      "properties" : {
        "CANONICAL_TYPE" : {
                "$ref" : "#/definitions/FlatBufferTypeRef",
                "description" : "Canonical SDS identity carried by the edge. NOT `required`: an edge may\nbe opaque by design (see OPAQUE), and a signer must never be forced to\ninvent an identity to satisfy the schema. A contract MUST carry exactly\none of CANONICAL_TYPE or OPAQUE = true; a contract with neither, or with\nboth, is invalid and MUST be rejected by the compiler that signs the flow."
              },
        "ALIGNED_TYPE" : {
                "$ref" : "#/definitions/FlatBufferTypeRef"
              },
        "CANONICAL_FALLBACK_AVAILABLE" : {
                "type" : "boolean"
              },
        "ALIGNED_ELIGIBLE" : {
                "type" : "boolean"
              },
        "ROUTE_POLICY" : {
                "$ref" : "#/definitions/flowEdgeRoutePolicy"
              },
        "OPAQUE" : {
                "type" : "boolean",
                "description" : "The edge carries bytes with no SDS identity BY DESIGN — an\napplication-blind host-capability adapter (an HTTP body, a raw file\nchunk) or a timer TICK frame with no payload at all. This is a deliberate\nsigned assertion of opacity, which is why it is an explicit flag rather\nthan an absent CANONICAL_TYPE: a missing type must stay distinguishable\nfrom a declared-opaque one. An opaque edge is ineligible for the aligned\nroute, so ALIGNED_ELIGIBLE MUST be false when OPAQUE is true."
              }
      },
      "additionalProperties" : false
    },
    "PLGFlowEdge" : {
      "type" : "object",
      "description" : "One directed edge wiring a producer output port to a consumer input port.",
      "properties" : {
        "EDGE_ID" : {
                "type" : "string",
                "description" : "Stable edge identifier"
              },
        "FROM_NODE_ID" : {
                "type" : "string",
                "description" : "Source node id"
              },
        "FROM_PORT_ID" : {
                "type" : "string",
                "description" : "Source output port id"
              },
        "TO_NODE_ID" : {
                "type" : "string",
                "description" : "Destination node id"
              },
        "TO_PORT_ID" : {
                "type" : "string",
                "description" : "Destination input port id"
              },
        "CONTRACT" : {
                "$ref" : "#/definitions/PLGFlowEdgeContract",
                "description" : "Exact identity/layout and compile-time representation policy. NOT\n`required`: marking a NEW field of an EXISTING table required makes the\nFlatBuffers verifier reject every $PLG buffer written before 1.0.13,\nwhich is a breaking change to a ratified standard. Presence is enforced\nwhere it belongs — the flow compiler MUST refuse to SIGN a flow whose\nedges lack a CONTRACT, and a verifier MUST reject a signed flow edge\nwithout one. Buffers predating 1.0.13 stay readable and stay unsigned."
              }
      },
      "required" : ["FROM_NODE_ID", "FROM_PORT_ID", "TO_NODE_ID", "TO_PORT_ID"],
      "additionalProperties" : false
    },
    "PLGFlowTrigger" : {
      "type" : "object",
      "description" : "One flow trigger (e.g. a host timer or HTTP route) that starts a drain.",
      "properties" : {
        "TRIGGER_ID" : {
                "type" : "string",
                "description" : "Stable trigger identifier"
              },
        "KIND" : {
                "type" : "string",
                "description" : "Trigger kind, e.g. \"timer\", \"http\""
              },
        "SOURCE" : {
                "type" : "string",
                "description" : "Trigger source, e.g. \"host-cron\""
              },
        "DEFAULT_INTERVAL_MS" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615,
                "description" : "Default firing interval in milliseconds (timer triggers)"
              },
        "HTTP_PATH" : {
                "type" : "string",
                "description" : "Mounted HTTP path (http triggers)"
              }
      },
      "required" : ["TRIGGER_ID"],
      "additionalProperties" : false
    },
    "PLGFlowTriggerBinding" : {
      "type" : "object",
      "description" : "Binds a trigger to the node + input port it delivers its frame to.",
      "properties" : {
        "TRIGGER_ID" : {
                "type" : "string",
                "description" : "Trigger identifier"
              },
        "TARGET_NODE_ID" : {
                "type" : "string",
                "description" : "Target node id"
              },
        "TARGET_PORT_ID" : {
                "type" : "string",
                "description" : "Target input port id"
              }
      },
      "required" : ["TRIGGER_ID", "TARGET_NODE_ID", "TARGET_PORT_ID"],
      "additionalProperties" : false
    },
    "PLG" : {
      "type" : "object",
      "description" : "Plugin Manifest - canonical signed storefront and WASM distribution record",
      "properties" : {
        "PLUGIN_ID" : {
                "type" : "string",
                "description" : "Unique identifier for the plugin"
              },
        "NAME" : {
                "type" : "string",
                "description" : "Human-readable plugin name"
              },
        "VERSION" : {
                "type" : "string",
                "description" : "Plugin version (semver format)"
              },
        "DESCRIPTION" : {
                "type" : "string",
                "description" : "Detailed description of plugin functionality"
              },
        "TAGLINE" : {
                "type" : "string",
                "description" : "Short marketing summary shown in storefront listings"
              },
        "PLUGIN_TYPE" : {
                "$ref" : "#/definitions/pluginCategory",
                "description" : "Type/category of the plugin"
              },
        "PUBLISHER_NAME" : {
                "type" : "string",
                "description" : "Human-readable publisher or organization name"
              },
        "PUBLISHER_HANDLE" : {
                "type" : "string",
                "description" : "Publisher handle or username"
              },
        "PUBLISHER_URL" : {
                "type" : "string",
                "description" : "Canonical publisher website"
              },
        "SUPPORT_URL" : {
                "type" : "string",
                "description" : "Support or helpdesk URL for this plugin"
              },
        "TAGS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Search and categorization tags for discovery"
              },
        "FEATURES" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Short feature bullets highlighted in storefront listings"
              },
        "SCREENSHOT_URLS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Screenshot URLs showing the plugin in use"
              },
        "BANNER_URL" : {
                "type" : "string",
                "description" : "Optional hero/banner image URL for the listing"
              },
        "ABI_VERSION" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "ABI version for compatibility checking"
              },
        "WASM_HASH" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" :255},
                "description" : "SHA256 hash of the decrypted WASM binary"
              },
        "WASM_SIZE" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615,
                "description" : "Size of decrypted WASM binary in bytes"
              },
        "WASM_CID" : {
                "type" : "string",
                "description" : "IPFS CID of the encrypted WASM binary"
              },
        "ENCRYPTED_WASM_HASH" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : 0, "maximum" :255},
                "description" : "SHA256 hash of the encrypted delivery artifact bytes"
              },
        "ENCRYPTED_WASM_SIZE" : {
                "type" : "integer", "minimum" : 0, "maximum" : 18446744073709551615,
                "description" : "Size of the encrypted delivery artifact in bytes"
              },
        "ENTRY_FUNCTIONS" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/EntryFunction"},
                "description" : "Entry point functions exported by the plugin"
              },
        "REQUIRED_SCHEMAS" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "FlatBuffer schemas required by this plugin"
              },
        "DEPENDENCIES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/PluginDependency"},
                "description" : "Other plugins this depends on"
              },
        "CAPABILITIES" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/PluginCapability"},
                "description" : "Capabilities provided by this plugin"
              },
        "PROVIDER_PEER_ID" : {
                "type" : "string",
                "description" : "Peer ID of the plugin provider"
              },
        "PROVIDER_EPM_CID" : {
                "type" : "string",
                "description" : "IPFS CID of provider's EPM (Entity Profile Message)"
              },
        "ENCRYPTED" : {
                "type" : "boolean",
                "description" : "Whether the WASM binary is encrypted"
              },
        "REQUIRED_SCOPE" : {
                "type" : "string",
