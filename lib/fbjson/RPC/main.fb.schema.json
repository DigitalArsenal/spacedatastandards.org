{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "KeyExchange": {
      "type": "string",
      "enum": [
        "X25519",
        "Secp256k1",
        "P256"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "X25519": {
          "value": 0
        }
      }
    },
    "SymmetricAlgo": {
      "type": "string",
      "enum": [
        "AES_256_CTR"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "AES_256_CTR": {
          "value": 0
        }
      }
    },
    "KDF": {
      "type": "string",
      "enum": [
        "HKDF_SHA256"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "HKDF_SHA256": {
          "value": 0
        }
      }
    },
    "rpcDirection": {
      "type": "string",
      "enum": [
        "Request",
        "Response"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "Request": {
          "value": 0
        },
        "Response": {
          "value": 1
        }
      }
    },
    "ENC": {
      "type": "object",
      "description": "Encryption Header containing all parameters needed for decryption",
      "properties": {
        "VERSION": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Schema version for forward compatibility",
          "x-flatbuffer-type": "ubyte",
          "x-flatbuffer-default": "1"
        },
        "KEY_EXCHANGE": {
          "$ref": "#/definitions/KeyExchange",
          "description": "Key exchange algorithm used",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "X25519": {
              "value": 0
            }
          },
          "x-flatbuffer-default": "X25519"
        },
        "SYMMETRIC": {
          "$ref": "#/definitions/SymmetricAlgo",
          "description": "Symmetric encryption algorithm used",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "AES_256_CTR": {
              "value": 0
            }
          },
          "x-flatbuffer-default": "AES_256_CTR"
        },
        "KEY_DERIVATION": {
          "$ref": "#/definitions/KDF",
          "description": "Key derivation function used",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "HKDF_SHA256": {
              "value": 0
            }
          },
          "x-flatbuffer-default": "HKDF_SHA256"
        },
        "EPHEMERAL_PUBLIC_KEY": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Ephemeral public key for ECDH key agreement (32-65 bytes depending on algorithm)",
          "x-flatbuffer-type": "[ubyte]",
          "x-flatbuffer-required": true
        },
        "NONCE_START": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Random 12-byte nonce starting value. Incremented for each record in the stream to ensure unique nonces.",
          "x-flatbuffer-type": "[ubyte]",
          "x-flatbuffer-required": true
        },
        "RECIPIENT_KEY_ID": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Optional identifier for the recipient's public key (up to 32 bytes)",
          "x-flatbuffer-type": "[ubyte]"
        },
        "CONTEXT": {
          "type": "string",
          "description": "Optional domain separation context string",
          "x-flatbuffer-type": "string"
        },
        "SCHEMA_HASH": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Optional SHA-256 hash of the FlatBuffers schema (32 bytes)",
          "x-flatbuffer-type": "[ubyte]"
        },
        "ROOT_TYPE": {
          "type": "string",
          "description": "Optional root type name from the schema",
          "x-flatbuffer-type": "string"
        },
        "TIMESTAMP": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Optional Unix timestamp (milliseconds) when encryption was performed",
          "x-flatbuffer-type": "uint64"
        }
      },
      "required": [
        "EPHEMERAL_PUBLIC_KEY",
        "NONCE_START"
      ],
      "additionalProperties": false
    },
    "RPCBody": {
      "type": "object",
      "description": "Plaintext carried, size-prefixed, inside RPC.CIPHERTEXT.",
      "properties": {
        "METHOD": {
          "type": "string",
          "description": "Request method verb (for example GET, POST). Empty on a response.",
          "x-flatbuffer-type": "string"
        },
        "ROUTE": {
          "type": "string",
          "description": "Request route, path plus optional query. Empty on a response.",
          "x-flatbuffer-type": "string"
        },
        "BODY": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Request or response payload bytes.",
          "x-flatbuffer-type": "[ubyte]"
        },
        "BODY_FILE_ID": {
          "type": "string",
          "description": "Four-character file identifier of BODY when BODY is a FlatBuffer,\n`$` included (for example \"$EPM\"). Empty when BODY is not a FlatBuffer.",
          "x-flatbuffer-type": "string"
        },
        "STATUS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Response status code. Zero on a request.",
          "x-flatbuffer-type": "uint16"
        },
        "SIGNER_KEY_ID": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Identifier of the signer's key; MUST identify RPC.SIGNER_PUBLIC_KEY.",
          "x-flatbuffer-type": "[ubyte]"
        },
        "REPLY_KEY": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Request only: public key the response is sealed to.",
          "x-flatbuffer-type": "[ubyte]"
        },
        "REQUEST_NONCE": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Response only: RPC.NONCE of the request being answered.",
          "x-flatbuffer-type": "[ubyte]"
        },
        "REQUEST_DIGEST": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Response only: SHA-256 (32 bytes) of the complete size-prefixed request\nRPC FlatBuffer as received, signatures included.",
          "x-flatbuffer-type": "[ubyte]"
        }
      },
      "additionalProperties": false
    },
    "RPC": {
      "type": "object",
      "description": "Sealed Remote Procedure Call envelope (outer, plaintext, signed).",
      "properties": {
        "VERSION": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Envelope version. This document defines version 1.",
          "x-flatbuffer-type": "ubyte",
          "x-flatbuffer-default": "1"
        },
        "DIRECTION": {
          "$ref": "#/definitions/rpcDirection",
          "description": "Request or response.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "Request": {
              "value": 0
            },
            "Response": {
              "value": 1
            }
          },
          "x-flatbuffer-default": "Request"
        },
        "ENCRYPTION": {
          "$ref": "#/definitions/ENC",
          "description": "Encryption header for CIPHERTEXT. CONTEXT is \"RPC/1|request\" or\n\"RPC/1|response\" matching DIRECTION.",
          "x-flatbuffer-type": "ENC",
          "x-flatbuffer-required": true
        },
        "SESSION_ID": {
          "type": "string",
          "description": "Optional session identifier established by a prior sign-in.",
          "x-flatbuffer-type": "string"
        },
        "SENDER_KEY_ID": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Optional identifier of the sender's key (routing hint only; the binding\nidentity is SIGNER_PUBLIC_KEY checked against RPCBody.SIGNER_KEY_ID).",
          "x-flatbuffer-type": "[ubyte]"
        },
        "TIMESTAMP": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Sender clock at signing, milliseconds since the Unix epoch (UTC).",
          "x-flatbuffer-type": "uint64"
        },
        "NONCE": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Random 16-byte nonce, unique per envelope.",
          "x-flatbuffer-type": "[ubyte]"
        },
        "CIPHERTEXT": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Encrypted size-prefixed RPCBody.",
          "x-flatbuffer-type": "[ubyte]",
          "x-flatbuffer-required": true
        },
        "SIGNER_PUBLIC_KEY": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Ed25519 public key (32 bytes) that verifies both signatures.",
          "x-flatbuffer-type": "[ubyte]",
          "x-flatbuffer-required": true
        },
        "SIGNATURE_TYPE": {
          "type": "string",
          "description": "Signature algorithm name. Version 1 defines \"Ed25519\".",
          "x-flatbuffer-type": "string"
        },
        "SIGNATURE": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Ed25519 signature over the size-prefixed FlatBuffer with both 64-byte\nsignature payloads zeroed while preserving their vectors and offsets.",
          "x-flatbuffer-type": "[ubyte]",
          "x-flatbuffer-required": true
        },
        "CANONICAL_JSON_SIGNATURE": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Ed25519 signature over canonical JSON with IDL field order and\ncapitalization, no insignificant whitespace, and both signature fields\nomitted.",
          "x-flatbuffer-type": "[ubyte]",
          "x-flatbuffer-required": true
        }
      },
      "required": [
        "ENCRYPTION",
        "CIPHERTEXT",
        "SIGNER_PUBLIC_KEY",
        "SIGNATURE",
        "CANONICAL_JSON_SIGNATURE"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/RPC",
  "x-flatbuffer-root-type": "RPC",
  "x-flatbuffer-file-identifier": "$RPC"
}