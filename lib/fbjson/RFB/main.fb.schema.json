          "x-flatbuffer-type": "double"
        },
        "EIRP": {
          "type": "number",
          "description": "Effective isotropic radiated power (dBW)",
          "x-flatbuffer-type": "double"
        },
        "NORAD_CAT_ID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "NORAD catalog number of the spacecraft carrying this emitter. Joins to\nCAT.NORAD_CAT_ID. 0 when unbound.",
          "x-flatbuffer-type": "uint"
        },
        "ID_TRANSMITTER": {
          "type": "string",
          "description": "Identifier of the physical transmitter, transceiver or transponder this\nrecord describes (e.g. a SatNOGS transmitter UUID). Uplink and downlink\nrecords of the same device share this value.",
