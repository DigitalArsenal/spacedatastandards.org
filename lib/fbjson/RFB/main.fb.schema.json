          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UPLINK": {
              "value": 0
            },
            "DOWNLINK": {
              "value": 1
            },
            "CROSSLINK": {
              "value": 2
            },
            "INTER_SATELLITE": {
              "value": 3
            },
            "GROUND_TO_GROUND": {
              "value": 4
            },
            "RELAY": {
              "value": 5
            }
          }
        },
        "BAUD": {
