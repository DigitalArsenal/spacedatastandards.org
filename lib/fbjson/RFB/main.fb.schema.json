          "x-flatbuffer-type": "double"
        },
        "SERVICE": {
          "type": "string",
          "description": "Regulatory/ITU service designation (e.g. Amateur, Earth Exploration).",
          "x-flatbuffer-type": "string"
        },
        "XMT_STATUS": {
