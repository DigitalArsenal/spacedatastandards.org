    "RFB": {
      "type": "object",
      "description": "RF Band Specification\n\nUNITS ARE NORMATIVE. Every frequency field in this table is MHz. Sources\nthat publish Hz (SatNOGS DB) MUST divide by 1e6 before encoding; sources\nthat publish kHz MUST divide by 1e3. BAUD is baud (symbols per second),\nnever kilobaud. Encoding a Hz value into a MHz field is a defect, not a\nconvention.\n\nOne RFB record carries exactly one LINK_DIRECTION. A transceiver or\ntransponder is therefore represented as TWO RFB records \u2014 one UPLINK and\none DOWNLINK \u2014 sharing ID_TRANSMITTER, each carrying its own MODE,\nFREQ_MIN, FREQ_MAX and CENTER_FREQ.",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Unique identifier",
          "x-flatbuffer-type": "string"
        },
        "ID_ENTITY": {
          "type": "string",
          "description": "Parent entity identifier",
          "x-flatbuffer-type": "string"
        },
        "NAME": {
          "type": "string",
          "description": "Band name or designation",
          "x-flatbuffer-type": "string"
        },
        "BAND": {
          "$ref": "#/definitions/rfBandDesignation",
          "description": "RF band designation",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UHF": {
              "value": 0
            },
            "L": {
              "value": 1
            },
            "S": {
              "value": 2
            },
            "C": {
              "value": 3
            },
            "X": {
              "value": 4
            },
            "KU": {
              "value": 5
            },
            "K": {
              "value": 6
            },
            "KA": {
              "value": 7
            },
            "V": {
              "value": 8
            },
            "W": {
              "value": 9
            },
            "Q": {
              "value": 10
            },
            "EHF": {
              "value": 11
            },
            "OTHER": {
              "value": 12
            }
          }
        },
        "MODE": {
          "type": "string",
          "description": "Operating mode",
          "x-flatbuffer-type": "string"
        },
        "PURPOSE": {
          "type": "string",
          "description": "Band purpose (e.g., TT&C, PAYLOAD, BEACON)",
          "x-flatbuffer-type": "string"
        },
        "FREQ_MIN": {
          "type": "number",
          "description": "Minimum frequency (MHz)",
          "x-flatbuffer-type": "double"
        },
        "FREQ_MAX": {
          "type": "number",
          "description": "Maximum frequency (MHz)",
          "x-flatbuffer-type": "double"
        },
        "CENTER_FREQ": {
          "type": "number",
          "description": "Center frequency (MHz)",
          "x-flatbuffer-type": "double"
        },
        "BANDWIDTH": {
          "type": "number",
          "description": "Bandwidth (MHz)",
          "x-flatbuffer-type": "double"
        },
        "PEAK_GAIN": {
          "type": "number",
          "description": "Peak antenna gain (dBi)",
          "x-flatbuffer-type": "double"
        },
        "EDGE_GAIN": {
          "type": "number",
          "description": "Edge-of-coverage gain (dBi)",
          "x-flatbuffer-type": "double"
        },
        "BEAMWIDTH": {
          "type": "number",
          "description": "Antenna beamwidth (degrees)",
          "x-flatbuffer-type": "double"
        },
        "POLARIZATION": {
          "$ref": "#/definitions/rfPolarization",
          "description": "Polarization",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "LHCP": {
              "value": 0
            },
            "RHCP": {
              "value": 1
            },
            "LINEAR_H": {
              "value": 2
