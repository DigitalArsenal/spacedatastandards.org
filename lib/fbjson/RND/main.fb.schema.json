{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "rndSource": {
      "type": "string",
      "enum": [
        "Unspecified",
        "SystemCsprng",
        "Hardware",
        "Deterministic",
        "Beacon"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "Unspecified": {
          "value": 0,
          "description": "Not stated."
        },
        "SystemCsprng": {
          "value": 1,
          "description": "The host operating system's cryptographically secure generator."
        },
        "Hardware": {
          "value": 2,
          "description": "A hardware random number generator."
        },
        "Deterministic": {
          "value": 3,
          "description": "A deterministic generator from a stated seed (reproducible; not for secrets)."
        },
        "Beacon": {
          "value": 4,
          "description": "A public randomness beacon (verifiable, not secret)."
        }
      }
    },
    "RND": {
      "type": "object",
      "description": "Random Data - a request for random bytes, or the bytes.",
      "properties": {
        "LENGTH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of bytes requested or delivered.",
          "x-flatbuffer-type": "uint32"
        },
        "BYTES": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "The random bytes; empty in a request.",
          "x-flatbuffer-type": "[ubyte]"
        },
        "SOURCE": {
          "$ref": "#/definitions/rndSource",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "Unspecified": {
              "value": 0,
              "description": "Not stated."
            },
            "SystemCsprng": {
              "value": 1,
              "description": "The host operating system's cryptographically secure generator."
            },
            "Hardware": {
              "value": 2,
              "description": "A hardware random number generator."
            },
            "Deterministic": {
              "value": 3,
              "description": "A deterministic generator from a stated seed (reproducible; not for secrets)."
            },
            "Beacon": {
              "value": 4,
              "description": "A public randomness beacon (verifiable, not secret)."
            }
          },
          "x-flatbuffer-default": "Unspecified"
        },
        "GENERATED_AT_MS": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds when the bytes were generated; 0 in a request.",
          "x-flatbuffer-type": "int64"
        },
        "GENERATOR_ID": {
          "type": "string",
          "description": "Identifier of the generator or beacon (a device serial, a beacon URL).",
          "x-flatbuffer-type": "string"
        },
        "SEQUENCE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Position of this block in the generator's output, for beacons and\ndeterministic generators; 0 = not sequenced.",
          "x-flatbuffer-type": "uint64"
        },
        "SEED": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Seed of a Deterministic generator, so the block can be reproduced.",
          "x-flatbuffer-type": "[ubyte]"
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/RND",
  "x-flatbuffer-root-type": "RND",
  "x-flatbuffer-file-identifier": "$RND"
}