{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "beamType": {
      "type": "string",
      "enum": [
        "SPOT",
        "REGIONAL",
        "GLOBAL",
        "SHAPED",
        "STEERABLE",
        "HOPPING"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "SPOT": {
          "value": 0
        },
        "REGIONAL": {
          "value": 1
        },
        "GLOBAL": {
          "value": 2
        },
        "SHAPED": {
          "value": 3
        },
        "STEERABLE": {
          "value": 4
        },
        "HOPPING": {
          "value": 5
        }
      }
    },
    "beamPolarization": {
      "type": "string",
      "enum": [
        "RHCP",
        "LHCP",
        "LINEAR_H",
        "LINEAR_V",
        "DUAL_CIRCULAR",
        "DUAL_LINEAR",
        "CROSS_POL"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "RHCP": {
          "value": 0
        },
        "LHCP": {
          "value": 1
        },
        "LINEAR_H": {
          "value": 2
        },
        "LINEAR_V": {
          "value": 3
        },
        "DUAL_CIRCULAR": {
          "value": 4
        },
        "DUAL_LINEAR": {
          "value": 5
        },
        "CROSS_POL": {
          "value": 6
        }
      }
    },
    "bemHopSlotState": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "ACTIVE",
        "GUARD",
        "IDLE"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0
        },
        "ACTIVE": {
          "value": 1
        },
        "GUARD": {
          "value": 2
        },
        "IDLE": {
          "value": 3
        }
      }
    },
    "BEMProvenance": {
      "type": "object",
      "description": "Provenance of a deployed-beam descriptor or hop schedule.",
      "properties": {
        "SOURCE": {
          "type": "string",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "SOURCE_QUERY": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "MODEL_NAME": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "MODEL_VERSION": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "CITATION": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "MODULE_ID": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "MODULE_VERSION": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "MODULE_CONTENT_HASH": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "COMPUTED_AT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "x-flatbuffer-type": "uint64"
        }
      },
      "required": [
        "SOURCE"
      ],
      "additionalProperties": false
    },
    "BEMHopSlot": {
      "type": "object",
      "description": "One time slice of a periodic beam-hopping plan.",
      "properties": {
        "SLOT_ID": {
          "type": "string",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "START_OFFSET_S": {
          "type": "number",
          "description": "Offset from BEMHopSchedule.EPOCH in seconds.",
          "x-flatbuffer-type": "double"
        },
        "DURATION_S": {
          "type": "number",
          "x-flatbuffer-type": "double"
        },
        "STATE": {
          "$ref": "#/definitions/bemHopSlotState",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "ACTIVE": {
              "value": 1
            },
            "GUARD": {
              "value": 2
            },
            "IDLE": {
              "value": 3
            }
          },
          "x-flatbuffer-default": "UNSPECIFIED"
        },
        "BEAM_ID": {
          "type": "string",
          "description": "Beam activated in this slot. May name this BEM.ID or another beam in a\ncoordinated schedule.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "TARGET_CELL_ID": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "TARGET_CENTER_LATITUDE_DEG": {
          "type": "number",
          "x-flatbuffer-type": "double"
        },
        "TARGET_CENTER_LONGITUDE_DEG": {
          "type": "number",
          "x-flatbuffer-type": "double"
        },
        "CENTER_FREQUENCY_HZ": {
          "type": "number",
          "x-flatbuffer-type": "double"
        },
        "EIRP_DBW": {
          "type": "number",
          "x-flatbuffer-type": "double"
        },
        "PRIORITY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-flatbuffer-type": "uint32"
        }
      },
      "required": [
        "SLOT_ID",
        "BEAM_ID"
      ],
      "additionalProperties": false
    },
    "BEMHopSchedule": {
      "type": "object",
      "description": "Periodic beam-hopping schedule carried by a deployed beam descriptor.",
      "properties": {
        "SCHEDULE_ID": {
          "type": "string",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "EPOCH": {
          "type": "number",
          "description": "Seconds since 1970-01-01T00:00:00 UTC at which slot offsets begin.",
          "x-flatbuffer-type": "double"
        },
        "PERIOD_S": {
          "type": "number",
          "x-flatbuffer-type": "double"
        },
        "REPEATS": {
          "type": "boolean",
          "x-flatbuffer-type": "bool"
        },
        "SLOTS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BEMHopSlot"
          },
          "x-flatbuffer-type": "[BEMHopSlot]",
          "x-flatbuffer-required": true
        },
        "PROVENANCE": {
          "$ref": "#/definitions/BEMProvenance",
          "x-flatbuffer-type": "BEMProvenance",
          "x-flatbuffer-required": true
        }
      },
      "required": [
        "SCHEDULE_ID",
        "SLOTS",
        "PROVENANCE"
      ],
      "additionalProperties": false
    },
    "beamContourPoint": {
      "type": "object",
      "description": "Beam Contour Point (gain pattern boundary)",
      "properties": {
        "LATITUDE": {
          "type": "number",
          "description": "Latitude in degrees",
          "x-flatbuffer-type": "double"
        },
        "LONGITUDE": {
          "type": "number",
          "description": "Longitude in degrees",
          "x-flatbuffer-type": "double"
        },
        "GAIN": {
          "type": "number",
          "description": "Gain level in dBi at this contour",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "beamContour": {
      "type": "object",
      "description": "Beam Contour (iso-gain boundary)",
      "properties": {
        "CONTOUR_ID": {
          "type": "string",
          "description": "Contour level identifier",
          "x-flatbuffer-type": "string"
        },
        "GAIN_LEVEL": {
          "type": "number",
          "description": "Gain level in dBi",
          "x-flatbuffer-type": "double"
        },
        "POINTS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/beamContourPoint"
          },
          "description": "Contour boundary points",
          "x-flatbuffer-type": "[beamContourPoint]"
        }
      },
      "additionalProperties": false
    },
    "BEM": {
      "type": "object",
      "description": "Antenna Beam",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Unique beam identifier",
          "x-flatbuffer-type": "string"
        },
        "BEAM_NAME": {
          "type": "string",
          "description": "Beam name or designation",
          "x-flatbuffer-type": "string"
        },
        "ID_ENTITY": {
          "type": "string",
          "description": "Reference to parent entity (satellite/transponder)",
          "x-flatbuffer-type": "string"
        },
        "ID_ANTENNA": {
          "type": "string",
          "description": "Reference to parent antenna",
          "x-flatbuffer-type": "string"
        },
        "TYPE": {
          "$ref": "#/definitions/beamType",
          "description": "Beam type",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "SPOT": {
              "value": 0
            },
            "REGIONAL": {
              "value": 1
            },
            "GLOBAL": {
              "value": 2
            },
            "SHAPED": {
              "value": 3
            },
            "STEERABLE": {
              "value": 4
            },
            "HOPPING": {
              "value": 5
            }
          }
        },
        "POLARIZATION": {
          "$ref": "#/definitions/beamPolarization",
          "description": "Beam polarization",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "RHCP": {
              "value": 0
            },
            "LHCP": {
              "value": 1
            },
            "LINEAR_H": {
              "value": 2
            },
            "LINEAR_V": {
              "value": 3
            },
            "DUAL_CIRCULAR": {
              "value": 4
            },
            "DUAL_LINEAR": {
              "value": 5
            },
            "CROSS_POL": {
              "value": 6
            }
          }
        },
        "PEAK_GAIN": {
          "type": "number",
          "description": "Peak gain in dBi",
          "x-flatbuffer-type": "double"
        },
        "EOC_GAIN": {
          "type": "number",
          "description": "Edge-of-coverage gain in dBi",
          "x-flatbuffer-type": "double"
        },
        "CENTER_LATITUDE": {
          "type": "number",
          "description": "Beam center latitude in degrees",
          "x-flatbuffer-type": "double"
        },
        "CENTER_LONGITUDE": {
          "type": "number",
          "description": "Beam center longitude in degrees",
          "x-flatbuffer-type": "double"
        },
        "BEAMWIDTH": {
          "type": "number",
          "description": "Beamwidth (3dB) in degrees",
          "x-flatbuffer-type": "double"
        },
        "FREQUENCY": {
          "type": "number",
          "description": "Operating frequency in MHz",
          "x-flatbuffer-type": "double"
        },
        "EIRP": {
          "type": "number",
          "description": "EIRP at beam center in dBW",
          "x-flatbuffer-type": "double"
        },
        "G_OVER_T": {
          "type": "number",
          "description": "G/T at beam center in dB/K",
          "x-flatbuffer-type": "double"
        },
        "FOOTPRINT_AREA": {
          "type": "number",
          "description": "Beam footprint area in km^2",
          "x-flatbuffer-type": "double"
        },
        "BEAM_CONTOURS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/beamContour"
          },
          "description": "Beam contour definitions",
          "x-flatbuffer-type": "[beamContour]"
        },
        "NOTES": {
          "type": "string",
          "description": "Additional notes",
          "x-flatbuffer-type": "string"
        },
        "HOP_SCHEDULE": {
          "$ref": "#/definitions/BEMHopSchedule",
          "description": "Time-sliced activation plan for this deployed beam.",
          "x-flatbuffer-type": "BEMHopSchedule"
        },
        "PROVENANCE": {
          "$ref": "#/definitions/BEMProvenance",
          "x-flatbuffer-type": "BEMProvenance"
        },
        "COMPUTED_AT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Unix ms this record was serialized.",
          "x-flatbuffer-type": "uint64"
        },
        "PRODUCER_ID": {
          "type": "string",
          "description": "`$EPM` identifier of the producing node.",
          "x-flatbuffer-type": "string"
        },
        "SIGNATURE": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Ed25519 signature over the size-prefixed FlatBuffer with both 64-byte\nsignature payloads zeroed while preserving their vectors and offsets.",
          "x-flatbuffer-type": "[ubyte]"
        },
        "CANONICAL_JSON_SIGNATURE": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Ed25519 signature over canonical JSON with IDL field order and\ncapitalization, no insignificant whitespace, and both signature fields\nomitted.",
          "x-flatbuffer-type": "[ubyte]"
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/BEM",
  "x-flatbuffer-root-type": "BEM",
  "x-flatbuffer-file-identifier": "$BEM"
}