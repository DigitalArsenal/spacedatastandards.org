{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "nhsServiceState": {
      "type": "string",
      "enum": [
        "Unknown",
        "Starting",
        "Running",
        "Degraded",
        "Draining",
        "Stopped",
        "Failed"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "Unknown": {
          "value": 0,
          "description": "Not reported."
        },
        "Starting": {
          "value": 1,
          "description": "Starting up; not yet serving."
        },
        "Running": {
          "value": 2,
          "description": "Serving normally."
        },
        "Degraded": {
          "value": 3,
          "description": "Serving with reduced capability (a dependency is down, storage is nearly full, a backlog is building)."
        },
        "Draining": {
          "value": 4,
          "description": "Finishing work and refusing new work before stopping."
        },
        "Stopped": {
          "value": 5,
          "description": "Not serving."
        },
        "Failed": {
          "value": 6,
          "description": "Failed; operator action is required."
        }
      }
    },
    "NHSThroughputSample": {
      "type": "object",
      "description": "One sample of network throughput.",
      "properties": {
        "TIME_MS": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds of the sample.",
          "x-flatbuffer-type": "int64"
        },
        "TOTAL_IN_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Total bytes received since the service started, at this sample.",
          "x-flatbuffer-type": "uint64"
        },
        "TOTAL_OUT_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Total bytes sent since the service started, at this sample.",
          "x-flatbuffer-type": "uint64"
        },
        "RATE_IN_BPS": {
          "type": "number",
          "description": "Receive rate at this sample, bytes per second.",
          "x-flatbuffer-type": "double"
        },
        "RATE_OUT_BPS": {
          "type": "number",
          "description": "Send rate at this sample, bytes per second.",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "NHS": {
      "type": "object",
      "description": "Node Health Status - one snapshot of a node's own health.",
      "properties": {
        "NODE_ID": {
          "type": "string",
          "description": "Identifier of the node reporting (a peer identifier, host name or asset\nidentifier).",
          "x-flatbuffer-type": "string"
        },
        "GENERATED_AT_MS": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds when the snapshot was taken.",
          "x-flatbuffer-type": "int64"
        },
        "STARTED_AT_MS": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds when the service started; 0 = unknown.",
          "x-flatbuffer-type": "int64"
        },
        "UPTIME_S": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Seconds the service has been running.",
          "x-flatbuffer-type": "uint64"
        },
        "SERVICE_STATE": {
          "$ref": "#/definitions/nhsServiceState",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "Unknown": {
              "value": 0,
              "description": "Not reported."
            },
            "Starting": {
              "value": 1,
              "description": "Starting up; not yet serving."
            },
            "Running": {
              "value": 2,
              "description": "Serving normally."
            },
            "Degraded": {
              "value": 3,
              "description": "Serving with reduced capability (a dependency is down, storage is nearly full, a backlog is building)."
            },
            "Draining": {
              "value": 4,
              "description": "Finishing work and refusing new work before stopping."
            },
            "Stopped": {
              "value": 5,
              "description": "Not serving."
            },
            "Failed": {
              "value": 6,
              "description": "Failed; operator action is required."
            }
          },
          "x-flatbuffer-default": "Unknown"
        },
        "SERVICE_MODE": {
          "type": "string",
          "description": "Operating mode the service runs in, as the service names it, e.g.\n\"full\", \"edge\", \"relay\", \"maintenance\".",
          "x-flatbuffer-type": "string"
        },
        "SOFTWARE_VERSION": {
          "type": "string",
          "description": "Software name and version of the service, e.g. \"sdn-server 1.4.2\".",
          "x-flatbuffer-type": "string"
        },
        "STORAGE_PATH": {
          "type": "string",
          "description": "Location of the node's data store (a path or URI).",
          "x-flatbuffer-type": "string"
        },
        "STORE_TOTAL_RECORDS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Records the node's data store holds.",
          "x-flatbuffer-type": "uint64"
        },
        "STORE_TOTAL_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Bytes the node's data store occupies.",
          "x-flatbuffer-type": "uint64"
        },
        "HAS_DISK": {
          "type": "boolean",
          "description": "True when the disk figures below were measured.",
          "x-flatbuffer-type": "bool"
        },
        "DISK_CAPACITY_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Capacity of the volume holding the store, bytes.",
          "x-flatbuffer-type": "uint64"
        },
        "DISK_FREE_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Free bytes on that volume.",
          "x-flatbuffer-type": "uint64"
        },
        "DISK_AVAILABLE_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Bytes on that volume available to the service (free bytes less any\nreserve the service may not use).",
          "x-flatbuffer-type": "uint64"
        },
        "HAS_NETWORK": {
          "type": "boolean",
          "description": "True when the network figures below were measured.",
          "x-flatbuffer-type": "bool"
        },
        "TOTAL_IN_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Total bytes received since the service started.",
          "x-flatbuffer-type": "uint64"
        },
        "TOTAL_OUT_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Total bytes sent since the service started.",
          "x-flatbuffer-type": "uint64"
        },
        "RATE_IN_BPS": {
          "type": "number",
          "description": "Current receive rate, bytes per second.",
          "x-flatbuffer-type": "double"
        },
        "RATE_OUT_BPS": {
          "type": "number",
          "description": "Current send rate, bytes per second.",
          "x-flatbuffer-type": "double"
        },
        "THROUGHPUT_HISTORY": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NHSThroughputSample"
          },
          "description": "Recent throughput, oldest first.",
          "x-flatbuffer-type": "[NHSThroughputSample]"
        },
        "HAS_COMPUTE": {
          "type": "boolean",
          "description": "True when the processor and memory figures below were measured.",
          "x-flatbuffer-type": "bool"
        },
        "CPU_LOAD": {
          "type": "number",
          "description": "Processor load, 0..1 of all cores.",
          "x-flatbuffer-type": "float"
        },
        "CPU_CORES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Processor cores available to the service.",
          "x-flatbuffer-type": "uint16"
        },
        "MEMORY_USED_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Memory the service uses, bytes.",
          "x-flatbuffer-type": "uint64"
        },
        "MEMORY_TOTAL_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Memory available to the service, bytes.",
          "x-flatbuffer-type": "uint64"
        },
        "CONNECTION_COUNT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Peers or clients currently connected; 0 = none or not measured.",
          "x-flatbuffer-type": "uint32"
        },
        "NOTES": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Short human-readable notes on anything degraded, e.g. \"disk 92% full\".",
          "x-flatbuffer-type": "[string]"
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/NHS",
  "x-flatbuffer-root-type": "NHS",
  "x-flatbuffer-file-identifier": "$NHS"
}