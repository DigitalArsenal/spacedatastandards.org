    "VEPPerformancePoint": {
      "type": "object",
      "description": "One point of the burn-rate table: consumption at a stated regime,\naltitude, and speed.",
      "properties": {
        "ALTITUDE_M": {
          "type": "number",
          "description": "Altitude the point is stated at, metres above mean sea level. NaN for\nsurface and subsurface regimes where altitude does not apply.",
          "x-flatbuffer-type": "double"
        },
        "SPEED_MPS": {
          "type": "number",
          "description": "Speed the point is stated at, metres per second.",
          "x-flatbuffer-type": "double"
        },
        "REGIME": {
          "$ref": "#/definitions/vepRegime",
          "description": "Operating regime.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "TAKEOFF": {
              "value": 1
            },
            "CLIMB": {
              "value": 2
            },
            "CRUISE": {
              "value": 3
            },
            "LOITER": {
              "value": 4
            },
            "DESCENT": {
              "value": 5
            },
            "TAXI": {
              "value": 6
            },
            "TRANSIT": {
              "value": 7,
              "description": "Steady transit for surface and subsurface vehicles."
            },
            "MANEUVER": {
              "value": 8,
              "description": "High-consumption maneuvering."
            }
          },
          "x-flatbuffer-default": "UNSPECIFIED"
        },
        "BURN_RATE_VALUE": {
          "type": "number",
          "description": "Consumption rate at this point, in BURN_RATE_UNITS per second unless\nthe unit token itself states another time base.",
          "x-flatbuffer-type": "double"
        },
        "BURN_RATE_UNITS": {
          "type": "string",
          "description": "Units of BURN_RATE_VALUE, verbatim. Required: a rate with no unit is\nnot publishable.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "SPECIFIC_RANGE_M_PER_UNIT": {
          "type": "number",
          "description": "Distance travelled per unit of energy at this point, metres per\nCAPACITY_UNITS unit.",
          "x-flatbuffer-type": "double"
        },
        "GROSS_MASS_KG": {
          "type": "number",
          "description": "Gross mass the point is stated at, kilograms.",
          "x-flatbuffer-type": "double"
        }
      },
      "required": [
        "BURN_RATE_UNITS"
      ],
      "additionalProperties": false
    },
    "VEPReplenishment": {
      "type": "object",
      "description": "One replenishment option: how the energy store is reset.",
      "properties": {
        "FACILITY_ID": {
          "type": "string",
          "description": "`$TFN.ID` of a facility where this replenishment is available. Absent\nfor a replenishment that is not facility-bound.",
