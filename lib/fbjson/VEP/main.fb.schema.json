        },
        "IN_MOTION": {
          "type": "boolean",
          "description": "Replenishment happens while the vehicle is underway (aerial\nrefuelling, underway replenishment).",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "false"
        }
      },
      "additionalProperties": false
    },
    "VEPProvenance": {
      "type": "object",
      "description": "Dataset lineage and redistribution terms for one endurance profile.\n\nRequired on every record: a profile whose data source, epoch, and\nlicence are unstated is not publishable. The standard names no dataset,\nprovider, or site.",
      "properties": {
        "DATASET_ID": {
          "type": "string",
          "description": "Publisher-stable, lowercase identifier for the dataset or study this\nprofile was derived from.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "DATASET_NAME": {
          "type": "string",
          "description": "The dataset's own name, verbatim as its publisher states it.",
          "x-flatbuffer-type": "string"
        },
        "DATASET_URL": {
          "type": "string",
          "description": "Replayable URL of the dataset as published.",
          "x-flatbuffer-type": "string"
        },
        "DATASET_EPOCH": {
          "type": "string",
          "description": "RFC 3339 UTC fixed-millisecond epoch of the dataset edition this\nprofile was derived from.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "DATASET_CID": {
          "type": "string",
          "description": "Content identifier of the exact dataset artifact, when one exists.",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_URL": {
          "type": "string",
          "description": "Replayable URL identifying the source material within the dataset.",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_QUERY": {
          "type": "string",
          "description": "The exact query, filter, or file selection used.",
          "x-flatbuffer-type": "string"
        },
        "RETRIEVED_AT": {
          "type": "string",
          "description": "RFC 3339 UTC fixed-millisecond retrieval timestamp.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "LICENSE": {
          "type": "string",
          "description": "Redistribution terms verbatim. Unknown terms are never public domain\nand never an implied grant.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "LICENSE_URL": {
          "type": "string",
          "description": "URL of the full licence text as the dataset publishes it.",
          "x-flatbuffer-type": "string"
        },
        "ATTRIBUTION": {
          "type": "string",
          "description": "Attribution text the licence requires a redistributor to display.",
          "x-flatbuffer-type": "string"
        },
        "NON_COMMERCIAL_ONLY": {
          "type": "boolean",
          "description": "The licence forbids commercial use.",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "false"
        },
        "SHARE_ALIKE": {
          "type": "boolean",
          "description": "The licence obliges derived works to carry the same terms.",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "false"
        },
        "NATIVE_ID": {
          "type": "string",
          "description": "The source's own identifier for the vehicle class or type this\nprofile describes, verbatim.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "NATIVE_MODIFIED": {
          "type": "string",
          "description": "RFC 3339 UTC instant the source last modified this data, as it\nstates.",
          "x-flatbuffer-type": "string"
        }
      },
      "required": [
        "DATASET_ID",
        "DATASET_EPOCH",
        "RETRIEVED_AT",
        "LICENSE",
        "NATIVE_ID"
      ],
      "additionalProperties": false
    },
    "VEP": {
      "type": "object",
      "description": "Vehicle Endurance Profile",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Publisher-stable identifier for this profile record.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "VEHICLE_CLASS_ID": {
          "type": "string",
          "description": "Publisher-stable identifier of the vehicle CLASS this profile models.\nRequired: every profile is at least class-level.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "VEHICLE_TYPE_DESIGNATOR": {
          "type": "string",
          "description": "Verbatim vehicle type token refining the class, when this profile is\na per-type refinement.",
          "x-flatbuffer-type": "string"
        },
        "ENVIRONMENT": {
          "$ref": "#/definitions/trackEnvironment",
          "description": "Domain the vehicle operates in. The `$TRK` enum reused verbatim;\nordinal 0 is SPACE, so it is defaulted to UNKNOWN explicitly.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "SPACE": {
              "value": 0
            },
            "AIR": {
              "value": 1
            },
            "SURFACE": {
              "value": 2
            },
            "SUBSURFACE": {
              "value": 3
            },
            "LAND": {
              "value": 4
            },
            "UNKNOWN": {
              "value": 5
            }
          },
          "x-flatbuffer-default": "UNKNOWN"
        },
        "ENERGY_TYPE": {
          "$ref": "#/definitions/vepEnergyType",
