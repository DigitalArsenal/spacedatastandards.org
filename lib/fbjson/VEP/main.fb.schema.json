    "vepInterpolation": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "NEAREST",
        "LINEAR",
        "BILINEAR",
        "TABLE_LOOKUP"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0,
          "description": "No method stated; a consumer MUST treat the table as TABLE_LOOKUP rather than invent an interpolant."
        },
        "NEAREST": {
          "value": 1,
          "description": "Nearest point in (regime, altitude, speed)."
        },
        "LINEAR": {
          "value": 2,
          "description": "Linear along the single varying axis."
        },
        "BILINEAR": {
          "value": 3,
          "description": "Bilinear over altitude and speed within a regime."
        },
        "TABLE_LOOKUP": {
          "value": 4,
          "description": "Exact-key lookup only; no interpolation between points."
        }
      }
    },
