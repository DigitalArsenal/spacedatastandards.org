{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "davUnavailableReason": {
      "type": "string",
      "enum": [
        "None",
        "NotPublished",
        "NotHeld",
        "Stale",
        "Unverified",
        "NotEntitled"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "None": {
          "value": 0,
          "description": "The dataset is available."
        },
        "NotPublished": {
          "value": 1,
          "description": "No publication of the lane is known."
        },
        "NotHeld": {
          "value": 2,
          "description": "A publication is known but its content is not held."
        },
        "Stale": {
          "value": 3,
          "description": "The content is held but older than the latest known publication."
        },
        "Unverified": {
          "value": 4,
          "description": "The notice did not verify."
        },
        "NotEntitled": {
          "value": 5,
          "description": "The caller may not read it."
        }
      }
    },
    "DAV": {
      "type": "object",
      "description": "Dataset Availability - the latest dataset of a lane, as one node holds it.",
      "properties": {
        "STANDARD": {
          "type": "string",
          "description": "Standard of the dataset, as its code, e.g. \"OMM\".",
          "x-flatbuffer-type": "string"
        },
        "SCHEMA_NAME": {
          "type": "string",
          "description": "Schema file name of its records, e.g. \"OMM.fbs\".",
          "x-flatbuffer-type": "string"
        },
        "PROVIDER_ID": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_NAME": {
          "type": "string",
          "x-flatbuffer-type": "string"
        },
        "KNOWN": {
          "type": "boolean",
          "description": "True when the node knows of a publication of this lane.",
          "x-flatbuffer-type": "bool"
        },
        "AVAILABLE": {
          "type": "boolean",
          "description": "True when the node can serve the dataset now.",
          "x-flatbuffer-type": "bool"
        },
        "UNAVAILABLE_REASON": {
          "$ref": "#/definitions/davUnavailableReason",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "None": {
              "value": 0,
              "description": "The dataset is available."
            },
            "NotPublished": {
              "value": 1,
              "description": "No publication of the lane is known."
            },
            "NotHeld": {
              "value": 2,
              "description": "A publication is known but its content is not held."
            },
            "Stale": {
              "value": 3,
              "description": "The content is held but older than the latest known publication."
            },
            "Unverified": {
              "value": 4,
              "description": "The notice did not verify."
            },
            "NotEntitled": {
              "value": 5,
              "description": "The caller may not read it."
            }
          },
          "x-flatbuffer-default": "None"
        },
        "SELF_PUBLISHED": {
          "type": "boolean",
          "description": "True when the node published the dataset itself.",
          "x-flatbuffer-type": "bool"
        },
        "PINNED": {
          "type": "boolean",
          "description": "True when the node keeps the content (it is not evicted).",
          "x-flatbuffer-type": "bool"
        },
        "FRESH": {
          "type": "boolean",
          "description": "True when the node's copy is the latest known publication.",
          "x-flatbuffer-type": "bool"
        },
        "BATCH_ID": {
          "type": "string",
          "description": "Batch identifier of the dataset.",
          "x-flatbuffer-type": "string"
        },
        "RECORD_COUNT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Records in the dataset.",
          "x-flatbuffer-type": "uint64"
        },
        "BYTE_COUNT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Bytes of the dataset's record stream.",
          "x-flatbuffer-type": "uint64"
        },
        "PARTS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Parts the dataset is split into for transfer; 0 or 1 = one part.",
          "x-flatbuffer-type": "uint32"
        },
        "PUBLISHED_AT_MS": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds the dataset was published.",
          "x-flatbuffer-type": "int64"
        },
        "PNM_CID": {
          "type": "string",
          "description": "Content identifier of the $PNM that announced it.",
          "x-flatbuffer-type": "string"
        },
        "PNM_FILE_ID": {
          "type": "string",
          "description": "The notice's FILE_ID.",
          "x-flatbuffer-type": "string"
        },
        "PNM_PUBLISHED_AT_MS": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807,
          "description": "Unix milliseconds of the notice.",
          "x-flatbuffer-type": "int64"
        },
        "PNM_SIGNATURE_VERIFIED": {
          "type": "boolean",
          "description": "True when the notice's signature verified.",
          "x-flatbuffer-type": "bool"
        },
        "PUBLISHER_PEER_ID": {
          "type": "string",
          "description": "Peer that published the notice.",
          "x-flatbuffer-type": "string"
        },
        "ETAG": {
          "type": "string",
          "description": "Entity tag of the dataset, for conditional requests.",
          "x-flatbuffer-type": "string"
        },
        "BODY_REF_TOKEN": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "When the dataset's records are not inline but held by the serving node\nfor delivery out of band: the reference token the node resolves (single\nuse), and the byte size of what it refers to. 0 = inline.",
          "x-flatbuffer-type": "uint64"
        },
        "BODY_REF_SIZE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "x-flatbuffer-type": "uint64"
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/DAV",
  "x-flatbuffer-root-type": "DAV",
  "x-flatbuffer-file-identifier": "$DAV"
}