{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "dcoActionKind": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "MANEUVER_AVOID",
        "MANEUVER_PHASE_SHIFT",
        "MANEUVER_ALTITUDE_CHANGE",
        "RF_FREQ_HOP",
        "RF_NULL_STEER",
        "RF_POWER_BOOST",
        "RF_BEAM_NARROW",
        "GATEWAY_REROUTE",
        "SENSOR_SHUTTER_OR_SLEW",
        "SAFE_MODE_PREEMPT",
        "TRACK_TASKING_SURGE",
        "RIDE_OUT"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0,
          "description": "Not stated."
        },
        "MANEUVER_AVOID": {
          "value": 1,
          "description": "Orbital collision or threat avoidance maneuver."
        },
        "MANEUVER_PHASE_SHIFT": {
          "value": 2,
          "description": "In-plane phasing shift maneuver."
        },
        "MANEUVER_ALTITUDE_CHANGE": {
          "value": 3,
          "description": "Altitude-change maneuver."
        },
        "RF_FREQ_HOP": {
          "value": 4,
          "description": "RF frequency hopping countermeasure."
        },
        "RF_NULL_STEER": {
          "value": 5,
          "description": "Phased-array null steering countermeasure."
        },
        "RF_POWER_BOOST": {
          "value": 6,
          "description": "Transmit power boost countermeasure."
        },
        "RF_BEAM_NARROW": {
          "value": 7,
          "description": "Antenna beam narrowing countermeasure."
        },
        "GATEWAY_REROUTE": {
          "value": 8,
          "description": "Traffic or TT&C gateway reroute."
        },
        "SENSOR_SHUTTER_OR_SLEW": {
          "value": 9,
          "description": "Optical or star-tracker shuttering or protective slew."
        },
        "SAFE_MODE_PREEMPT": {
          "value": 10,
          "description": "Preemptive spacecraft safe-mode entry."
        },
        "TRACK_TASKING_SURGE": {
          "value": 11,
          "description": "Tracking / custody sensor tasking surge."
        },
        "RIDE_OUT": {
          "value": 12,
          "description": "Ride out the event with no active maneuver or reconfiguration."
        }
      }
    },
    "dcoSeverityLevel": {
      "type": "string",
      "enum": [
        "UNAVAILABLE",
        "NOMINAL",
        "WATCH",
        "HIGH",
        "CRITICAL"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "UNAVAILABLE": {
          "value": 0,
          "description": "Residual risk could not be evaluated."
        },
        "NOMINAL": {
          "value": 1,
          "description": "Residual risk reduced to nominal."
        },
        "WATCH": {
          "value": 2,
          "description": "Residual risk remains at watch level."
        },
        "HIGH": {
          "value": 3,
          "description": "Residual risk remains high."
        },
        "CRITICAL": {
          "value": 4,
          "description": "Residual risk remains critical."
        }
      }
    },
    "dcoRecheckOutcome": {
      "type": "string",
      "enum": [
        "UNCHECKED",
        "CLEAR",
        "CONFLICTS_FOUND",
        "SECONDARY_THREAT_FOUND",
        "INFEASIBLE"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "UNCHECKED": {
          "value": 0,
          "description": "Conflict re-screening has not been run."
        },
        "CLEAR": {
          "value": 1,
          "description": "Re-screening passed with no COA conflicts or secondary threats."
        },
        "CONFLICTS_FOUND": {
          "value": 2,
          "description": "Proposed action conflicts with another active or candidate COA."
        },
        "SECONDARY_THREAT_FOUND": {
          "value": 3,
          "description": "Proposed action introduces a secondary threat in another phenomenology."
        },
        "INFEASIBLE": {
          "value": 4,
          "description": "Proposed action violates physical, delta-v, or operational feasibility bounds."
        }
      }
    },
    "DCOThreatRef": {
      "type": "object",
      "description": "Reference to a threat record, matrix bucket, or compound event addressed or introduced.",
      "properties": {
        "SCHEMA_FILE_ID": {
          "type": "string",
          "description": "Four-character SDS file identifier including \"$\", e.g. \"$TMX\", \"$CDM\", \"$RFL\", \"$RDE\".",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "RECORD_ID": {
          "type": "string",
          "description": "Record identifier within the referenced standard.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "BUCKET_ID": {
          "type": "string",
          "description": "Optional $TMX bucket identifier.",
          "x-flatbuffer-type": "string"
        },
        "COMPOUND_ID": {
          "type": "string",
          "description": "Optional $TMX compound event identifier.",
          "x-flatbuffer-type": "string"
        },
        "NORAD_CAT_ID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Optional NORAD catalog number of the affected space object.",
          "x-flatbuffer-type": "uint"
        }
      },
      "required": [
        "SCHEMA_FILE_ID",
        "RECORD_ID"
      ],
      "additionalProperties": false
    },
    "DCOModuleAttribution": {
      "type": "object",
      "description": "Attribution linking a computed trade metric to the exact WASM module build that produced it.",
      "properties": {
        "METRIC_NAME": {
          "type": "string",
          "description": "Name of the computed metric (e.g. \"DELTA_V_MPS\", \"MARGIN_GAIN_DB\", \"RESIDUAL_SCORE\").",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "MODULE_ID": {
          "type": "string",
          "description": "Canonical module identifier (e.g. \"analysis/coa-synthesizer\").",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "MODULE_VERSION": {
          "type": "string",
          "description": "Module semantic version string.",
          "x-flatbuffer-type": "string"
        },
        "WASM_SHA256": {
          "type": "string",
          "description": "Lowercase hex SHA-256 of the executed portable WASM artifact.",
          "x-flatbuffer-type": "string"
        }
      },
      "required": [
        "METRIC_NAME",
        "MODULE_ID"
      ],
      "additionalProperties": false
    },
    "DCO": {
      "type": "object",
      "description": "Defensive COA Trade & Conflict-Recheck",
      "properties": {
        "DCO_ID": {
          "type": "string",
          "description": "Unique identifier of this defensive COA evaluation record.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "COA_ID": {
          "type": "string",
          "description": "Identifier of the input $COA record ($COA.ID).",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "TMX_RUN_ID": {
          "type": "string",
          "description": "Identifier of the $TMX assessment run ($TMX.RUN_ID).",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "CREATED_UTC": {
          "type": "string",
          "description": "Evaluation timestamp, RFC 3339 UTC.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "THREAT_REF": {
          "$ref": "#/definitions/DCOThreatRef",
          "description": "Primary threat or compound event answered by this COA.",
          "x-flatbuffer-type": "DCOThreatRef",
          "x-flatbuffer-required": true
        },
        "ACTION_KIND": {
          "$ref": "#/definitions/dcoActionKind",
          "description": "Specific defensive action modeled in this evaluation.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0,
              "description": "Not stated."
            },
            "MANEUVER_AVOID": {
              "value": 1,
              "description": "Orbital collision or threat avoidance maneuver."
            },
            "MANEUVER_PHASE_SHIFT": {
              "value": 2,
              "description": "In-plane phasing shift maneuver."
            },
            "MANEUVER_ALTITUDE_CHANGE": {
              "value": 3,
              "description": "Altitude-change maneuver."
            },
            "RF_FREQ_HOP": {
              "value": 4,
              "description": "RF frequency hopping countermeasure."
            },
            "RF_NULL_STEER": {
              "value": 5,
              "description": "Phased-array null steering countermeasure."
            },
            "RF_POWER_BOOST": {
              "value": 6,
              "description": "Transmit power boost countermeasure."
            },
            "RF_BEAM_NARROW": {
              "value": 7,
              "description": "Antenna beam narrowing countermeasure."
            },
            "GATEWAY_REROUTE": {
              "value": 8,
              "description": "Traffic or TT&C gateway reroute."
            },
            "SENSOR_SHUTTER_OR_SLEW": {
              "value": 9,
              "description": "Optical or star-tracker shuttering or protective slew."
            },
            "SAFE_MODE_PREEMPT": {
              "value": 10,
              "description": "Preemptive spacecraft safe-mode entry."
            },
            "TRACK_TASKING_SURGE": {
              "value": 11,
              "description": "Tracking / custody sensor tasking surge."
            },
            "RIDE_OUT": {
              "value": 12,
              "description": "Ride out the event with no active maneuver or reconfiguration."
            }
          },
          "x-flatbuffer-default": "UNSPECIFIED"
        },
        "NORAD_CAT_ID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "NORAD catalog number of the defended object (0 when GROUP_ID is used).",
          "x-flatbuffer-type": "uint"
        },
        "GROUP_ID": {
          "type": "string",
          "description": "Entity group identifier ($EGP.GROUP_ID) when the COA applies to a group.",
          "x-flatbuffer-type": "string"
        },
        "DELTA_V_MPS": {
          "type": "number",
          "description": "Computed maneuver delta-v cost in m/s.",
          "x-flatbuffer-type": "double"
        },
        "PROPELLANT_KG": {
          "type": "number",
          "description": "Computed propellant mass consumed in kg.",
          "x-flatbuffer-type": "double"
        },
        "MISSION_LIFE_DAYS": {
          "type": "number",
          "description": "Estimated mission life impact in days.",
          "x-flatbuffer-type": "double"
        },
        "OUTAGE_HOURS": {
          "type": "number",
          "description": "Service or payload outage duration in hours.",
          "x-flatbuffer-type": "double"
        },
        "COVERAGE_IMPACT_PCT": {
          "type": "number",
          "description": "Constellation or regional coverage impact in percent.",
          "x-flatbuffer-type": "double"
        },
        "MARGIN_GAIN_DB": {
          "type": "number",
          "description": "RF link margin gain achieved in dB.",
          "x-flatbuffer-type": "double"
        },
        "EXPOSURE_REDUCED_MIN": {
          "type": "number",
          "description": "Threat exposure time reduced in minutes.",
          "x-flatbuffer-type": "double"
        },
        "BASELINE_SCORE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Baseline severity score before the COA in basis points (0..10000).",
          "x-flatbuffer-type": "uint16"
        },
        "RESIDUAL_SCORE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Residual severity score after applying the COA in basis points (0..10000).",
          "x-flatbuffer-type": "uint16"
        },
        "RESIDUAL_TIER": {
          "$ref": "#/definitions/dcoSeverityLevel",
          "description": "Residual severity tier after applying the COA.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UNAVAILABLE": {
              "value": 0,
              "description": "Residual risk could not be evaluated."
            },
            "NOMINAL": {
              "value": 1,
              "description": "Residual risk reduced to nominal."
            },
            "WATCH": {
              "value": 2,
              "description": "Residual risk remains at watch level."
            },
            "HIGH": {
              "value": 3,
              "description": "Residual risk remains high."
            },
            "CRITICAL": {
              "value": 4,
              "description": "Residual risk remains critical."
            }
          },
          "x-flatbuffer-default": "UNAVAILABLE"
        },
        "CONFLICTS_WITH_COA_IDS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Identifiers of other $COA records that conflict with this action.",
          "x-flatbuffer-type": "[string]"
        },
        "SECONDARY_THREATS_INTRODUCED": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DCOThreatRef"
          },
          "description": "Secondary threats introduced by this action (e.g. post-maneuver conjunction or drag).",
          "x-flatbuffer-type": "[DCOThreatRef]"
        },
        "RECHECKED": {
          "type": "boolean",
          "description": "True once full multi-phenomenology conflict re-screening has been executed.",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "false"
        },
        "RECHECK_STATUS": {
          "$ref": "#/definitions/dcoRecheckOutcome",
          "description": "Outcome status of the multi-phenomenology conflict re-screen.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UNCHECKED": {
              "value": 0,
              "description": "Conflict re-screening has not been run."
            },
            "CLEAR": {
              "value": 1,
              "description": "Re-screening passed with no COA conflicts or secondary threats."
            },
            "CONFLICTS_FOUND": {
              "value": 2,
              "description": "Proposed action conflicts with another active or candidate COA."
            },
            "SECONDARY_THREAT_FOUND": {
              "value": 3,
              "description": "Proposed action introduces a secondary threat in another phenomenology."
            },
            "INFEASIBLE": {
              "value": 4,
              "description": "Proposed action violates physical, delta-v, or operational feasibility bounds."
            }
          },
          "x-flatbuffer-default": "UNCHECKED"
        },
        "RECHECK_NOTES": {
          "type": "string",
          "description": "Human-readable diagnostics from conflict re-screening.",
          "x-flatbuffer-type": "string"
        },
        "ATTRIBUTIONS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DCOModuleAttribution"
          },
          "description": "Per-metric module provenance attributions.",
          "x-flatbuffer-type": "[DCOModuleAttribution]"
        }
      },
      "required": [
        "DCO_ID",
        "COA_ID",
        "TMX_RUN_ID",
        "CREATED_UTC",
        "THREAT_REF"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/DCO",
  "x-flatbuffer-root-type": "DCO",
  "x-flatbuffer-file-identifier": "$DCO"
}