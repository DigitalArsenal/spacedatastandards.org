{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "asgObjective": {
      "type": "string",
      "enum": [
        "Minimize",
        "Maximize"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "Minimize": {
          "value": 0,
          "description": "Minimize the sum of the assigned costs (the usual form)."
        },
        "Maximize": {
          "value": 1,
          "description": "Maximize the sum of the assigned costs (a score or likelihood matrix)."
        }
      }
    },
    "asgMeasurementKind": {
      "type": "string",
      "enum": [
        "Unspecified",
        "Range",
        "RangeRate",
        "RightAscension",
        "Declination",
        "Azimuth",
        "Elevation"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "Unspecified": {
          "value": 0,
          "description": "Not stated."
        },
        "Range": {
          "value": 1,
          "description": "Range, km."
        },
        "RangeRate": {
          "value": 2,
          "description": "Range rate, km/s (also from a Doppler shift)."
        },
        "RightAscension": {
          "value": 3,
          "description": "Topocentric right ascension, degrees."
        },
        "Declination": {
          "value": 4,
          "description": "Topocentric declination, degrees."
        },
        "Azimuth": {
          "value": 5,
          "description": "Azimuth, degrees clockwise from north."
        },
        "Elevation": {
          "value": 6,
          "description": "Elevation above the local horizontal, degrees."
        }
      }
    },
    "asgAssociationOutcome": {
      "type": "string",
      "enum": [
        "Unspecified",
        "Associated",
        "Uncorrelated"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "Unspecified": {
          "value": 0,
          "description": "Not decided."
        },
        "Associated": {
          "value": 1,
          "description": "Assigned to a predicted object."
        },
        "Uncorrelated": {
          "value": 2,
          "description": "Uncorrelated: assigned to no predicted object (a UCT)."
        }
      }
    },
    "asgUncorrelatedReason": {
      "type": "string",
      "enum": [
        "Unspecified",
        "NoPrediction",
        "OutsideGate",
        "LostAssignment"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "Unspecified": {
          "value": 0,
          "description": "Not uncorrelated, or no reason stated."
        },
        "NoPrediction": {
          "value": 1,
          "description": "No prediction covered the observation time."
        },
        "OutsideGate": {
          "value": 2,
          "description": "The nearest candidate was outside the gate."
        },
        "LostAssignment": {
          "value": 3,
          "description": "An in-gate candidate existed but the global assignment gave it to another observation."
        }
      }
    },
    "asgScanGrouping": {
      "type": "string",
      "enum": [
        "SensorTime",
        "Track",
        "Observation"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "SensorTime": {
          "value": 0,
          "description": "One scan per sensor and observation time."
        },
        "Track": {
          "value": 1,
          "description": "One scan per track identifier (observations without one fall back to sensor and time)."
        },
        "Observation": {
          "value": 2,
          "description": "Every observation is its own scan (no competition between observations)."
        }
      }
    },
    "ASGCostEntry": {
      "type": "object",
      "description": "One sparse cost: assigning ROW to COLUMN costs COST.",
      "properties": {
        "ROW": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Row index, 0-based.",
          "x-flatbuffer-type": "uint32"
        },
        "COLUMN": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Column index, 0-based.",
          "x-flatbuffer-type": "uint32"
        },
        "COST": {
          "type": "number",
          "description": "Cost of the pair, finite.",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "ASGProblem": {
      "type": "object",
      "description": "A rectangular linear assignment problem.",
      "properties": {
        "ROWS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of rows.",
          "x-flatbuffer-type": "uint32"
        },
        "COLUMNS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of columns.",
          "x-flatbuffer-type": "uint32"
        },
        "DENSE_COST": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Dense cost matrix, row-major, ROWS * COLUMNS values. NaN or +Infinity\nmarks a forbidden pair. Empty when ENTRIES gives the problem.",
          "x-flatbuffer-type": "[double]"
        },
        "ENTRIES": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ASGCostEntry"
          },
          "description": "Sparse costs; a pair not listed is forbidden. When a pair repeats, the\nlowest cost stands. Empty when DENSE_COST gives the problem.",
          "x-flatbuffer-type": "[ASGCostEntry]"
        },
        "UNASSIGNED_COST": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Cost of leaving a row unassigned: empty means every row must be assigned\n(then ROWS <= COLUMNS); one value applies to every row; ROWS values give\none per row. In gated association this is the gate.",
          "x-flatbuffer-type": "[double]"
        },
        "OBJECTIVE": {
          "$ref": "#/definitions/asgObjective",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "Minimize": {
              "value": 0,
              "description": "Minimize the sum of the assigned costs (the usual form)."
            },
            "Maximize": {
              "value": 1,
              "description": "Maximize the sum of the assigned costs (a score or likelihood matrix)."
            }
          },
          "x-flatbuffer-default": "Minimize"
        },
        "ROW_IDS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional labels of the rows (e.g. observation identifiers), ROWS entries\nor empty.",
          "x-flatbuffer-type": "[string]"
        },
        "COLUMN_IDS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional labels of the columns (e.g. object keys), COLUMNS entries or\nempty.",
          "x-flatbuffer-type": "[string]"
        }
      },
      "additionalProperties": false
    },
    "ASGSolution": {
      "type": "object",
      "description": "The optimal assignment of a problem.",
      "properties": {
        "ROWS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of rows of the problem.",
          "x-flatbuffer-type": "uint32"
        },
        "COLUMNS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of columns of the problem.",
          "x-flatbuffer-type": "uint32"
        },
        "ASSIGNMENT": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "description": "Column assigned to each row, ROWS entries; -1 = unassigned.",
          "x-flatbuffer-type": "[int32]"
        },
        "TOTAL_COST": {
          "type": "number",
          "description": "Sum of the assigned costs plus the unassigned costs paid.",
          "x-flatbuffer-type": "double"
        },
        "ASSIGNED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of rows assigned to a real column.",
          "x-flatbuffer-type": "uint32"
        },
        "METHOD": {
          "type": "string",
          "description": "Algorithm, e.g. \"Hungarian (shortest augmenting path with potentials)\",\n\"auction\", \"JVC\".",
          "x-flatbuffer-type": "string"
        }
      },
      "additionalProperties": false
    },
    "ASGObjectRef": {
      "type": "object",
      "description": "Identity of a predicted object.",
      "properties": {
        "KEY": {
          "type": "string",
          "description": "The key the solver used for the object: its OBJECT_ID, else\n\"NORAD:<n>\", else its name.",
          "x-flatbuffer-type": "string"
        },
        "NORAD_CAT_ID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "NORAD catalog number; 0 = none.",
          "x-flatbuffer-type": "uint32"
        },
        "OBJECT_ID": {
          "type": "string",
          "description": "International designator or provider object identifier; empty = none.",
          "x-flatbuffer-type": "string"
        },
        "OBJECT_NAME": {
          "type": "string",
          "description": "Object name; empty = none.",
          "x-flatbuffer-type": "string"
        }
      },
      "additionalProperties": false
    },
    "ASGMeasurement": {
      "type": "object",
      "description": "One measured quantity of an observation.",
      "properties": {
        "KIND": {
          "$ref": "#/definitions/asgMeasurementKind",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "Unspecified": {
              "value": 0,
              "description": "Not stated."
            },
            "Range": {
              "value": 1,
              "description": "Range, km."
            },
            "RangeRate": {
              "value": 2,
              "description": "Range rate, km/s (also from a Doppler shift)."
            },
            "RightAscension": {
              "value": 3,
              "description": "Topocentric right ascension, degrees."
            },
            "Declination": {
              "value": 4,
              "description": "Topocentric declination, degrees."
            },
            "Azimuth": {
              "value": 5,
              "description": "Azimuth, degrees clockwise from north."
            },
            "Elevation": {
              "value": 6,
              "description": "Elevation above the local horizontal, degrees."
            }
          },
          "x-flatbuffer-default": "Unspecified"
        },
        "VALUE": {
          "type": "number",
          "description": "Measured value: km, km/s or degrees by KIND.",
          "x-flatbuffer-type": "double"
        },
        "SIGMA": {
          "type": "number",
          "description": "One-sigma uncertainty, same unit as VALUE; positive.",
          "x-flatbuffer-type": "double"
        },
        "SOURCE_FIELD": {
          "type": "string",
          "description": "The field of the source record the value came from, e.g. \"RANGE\",\n\"RANGE_RATE\", \"DOPPLER\", \"RA\", \"DECLINATION\", \"AZIMUTH\", \"ELEVATION\".",
          "x-flatbuffer-type": "string"
        }
      },
      "additionalProperties": false
    },
    "ASGCandidate": {
      "type": "object",
      "description": "One predicted object tested against an observation.",
      "properties": {
        "OBJECT": {
          "$ref": "#/definitions/ASGObjectRef",
          "x-flatbuffer-type": "ASGObjectRef"
        },
        "D2": {
          "type": "number",
          "description": "Mahalanobis distance squared of the residual on S = H P H' + R\n(dimensionless, chi-square distributed with the observation's degrees\nof freedom).",
          "x-flatbuffer-type": "double"
        },
        "P_VALUE": {
          "type": "number",
          "description": "Chi-square upper-tail probability of D2.",
          "x-flatbuffer-type": "double"
        },
        "POSTERIOR": {
          "type": "number",
          "description": "Posterior association probability among the observation's candidates and\nclutter, 0 to 1.",
          "x-flatbuffer-type": "double"
        },
        "IN_GATE": {
          "type": "boolean",
          "description": "True when D2 is within the observation's gate.",
          "x-flatbuffer-type": "bool"
        },
        "LOG_DET_S": {
          "type": "number",
          "description": "Natural logarithm of det(S), in the measurement units' product.",
          "x-flatbuffer-type": "double"
        },
        "RESIDUAL": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Residuals, measured minus predicted, one per observation MEASUREMENTS\nentry in the same order and unit (angles wrapped to +-180 degrees).",
          "x-flatbuffer-type": "[double]"
        },
        "PREDICTED": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Predicted values, one per observation MEASUREMENTS entry.",
          "x-flatbuffer-type": "[double]"
        },
        "LIGHT_TIME_S": {
          "type": "number",
          "description": "One-way light time applied, s; 0 = none.",
          "x-flatbuffer-type": "double"
        },
        "POSITION_GCRF_KM": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Predicted position at the observation time, GCRF, km (3 values); empty\nwhen geometry was not requested.",
          "x-flatbuffer-type": "[double]"
        },
        "VELOCITY_GCRF_KM_S": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Predicted velocity, GCRF, km/s (3 values); empty when not requested.",
          "x-flatbuffer-type": "[double]"
        },
        "POSITION_COVARIANCE_KM2": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Predicted position covariance, GCRF, km**2, 3x3 row-major (9 values);\nempty when not requested.",
          "x-flatbuffer-type": "[double]"
        }
      },
      "additionalProperties": false
    },
    "ASGObservation": {
      "type": "object",
      "description": "One observation and its association.",
      "properties": {
        "INDEX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Position of the observation in the input, 0-based.",
          "x-flatbuffer-type": "uint32"
        },
        "RECORD_TYPE": {
          "type": "string",
          "description": "Standard of the observation record, as its code, e.g. \"RDO\", \"EOO\",\n\"RFO\".",
          "x-flatbuffer-type": "string"
        },
        "ID": {
          "type": "string",
          "description": "The record's identifier.",
          "x-flatbuffer-type": "string"
        },
        "TIME": {
          "type": "string",
          "description": "Observation time, UTC, ISO 8601 as the record states it.",
          "x-flatbuffer-type": "string"
        },
        "SENSOR": {
          "type": "string",
          "description": "Sensor identifier (the record's sensor or original sensor id).",
          "x-flatbuffer-type": "string"
        },
        "TRACK_ID": {
          "type": "string",
          "description": "Track identifier from the record; empty = none.",
          "x-flatbuffer-type": "string"
        },
        "MEASUREMENTS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ASGMeasurement"
          },
          "description": "The measured quantities, in the order every candidate's RESIDUAL and\nPREDICTED follow.",
          "x-flatbuffer-type": "[ASGMeasurement]"
        },
        "DEGREES_OF_FREEDOM": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Degrees of freedom of the test (the number of MEASUREMENTS).",
          "x-flatbuffer-type": "uint8"
        },
        "GATE": {
          "type": "number",
          "description": "Gate threshold on D2 for this observation.",
          "x-flatbuffer-type": "double"
        },
        "OUTCOME": {
          "$ref": "#/definitions/asgAssociationOutcome",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "Unspecified": {
              "value": 0,
              "description": "Not decided."
            },
            "Associated": {
              "value": 1,
              "description": "Assigned to a predicted object."
            },
            "Uncorrelated": {
              "value": 2,
              "description": "Uncorrelated: assigned to no predicted object (a UCT)."
            }
          },
          "x-flatbuffer-default": "Unspecified"
        },
        "REASON": {
          "$ref": "#/definitions/asgUncorrelatedReason",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "Unspecified": {
              "value": 0,
              "description": "Not uncorrelated, or no reason stated."
            },
            "NoPrediction": {
              "value": 1,
              "description": "No prediction covered the observation time."
            },
            "OutsideGate": {
              "value": 2,
              "description": "The nearest candidate was outside the gate."
            },
            "LostAssignment": {
              "value": 3,
              "description": "An in-gate candidate existed but the global assignment gave it to another observation."
            }
          },
          "x-flatbuffer-default": "Unspecified"
        },
        "AMBIGUOUS": {
          "type": "boolean",
          "description": "True when the judged candidate's posterior is under the minimum\nposterior, or the assignment gave the observation other than its best\ncandidate.",
          "x-flatbuffer-type": "bool"
        },
        "ASSIGNMENT_CONFLICT": {
          "type": "boolean",
          "description": "True when the assignment gave the observation other than its best\nin-gate candidate.",
          "x-flatbuffer-type": "bool"
        },
        "CANDIDATES": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ASGCandidate"
          },
          "description": "Candidates by increasing D2: the best few plus every in-gate one. The\nfirst is the nearest (the one a UCT report names).",
          "x-flatbuffer-type": "[ASGCandidate]"
        },
        "ASSIGNED_CANDIDATE": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "description": "Index into CANDIDATES of the assigned object; -1 = uncorrelated.",
          "x-flatbuffer-type": "int32",
          "x-flatbuffer-default": "-1"
        },
        "SENSOR_POSITION_GCRF_KM": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Sensor position at the observation time, GCRF, km (3 values).",
          "x-flatbuffer-type": "[double]"
        },
        "SENSOR_VELOCITY_GCRF_KM_S": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Sensor velocity, GCRF, km/s (3 values) for an Earth-fixed sensor; empty\nfor an inertial sensor position, which carries no velocity.",
          "x-flatbuffer-type": "[double]"
        },
        "LINE_OF_SIGHT_GCRF": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Unit line of sight from the sensor, GCRF (3 values); empty when the\nobservation has no direction.",
          "x-flatbuffer-type": "[double]"
        }
      },
      "additionalProperties": false
    },
    "ASGAssociationOptions": {
      "type": "object",
      "description": "Settings of a gated association. Every field has its default.",
      "properties": {
        "GATE_PROBABILITY": {
          "type": "number",
          "description": "Probability mass inside the chi-square gate, (0, 1).",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "0.9973"
        },
        "LIGHT_TIME": {
          "type": "boolean",
          "description": "Correct predictions for light time.",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "true"
        },
        "MIN_POSTERIOR": {
          "type": "number",
          "description": "Minimum posterior for an unambiguous association, (0, 1].",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "0.99"
        },
        "CLUTTER_DENSITY": {
          "type": "number",
          "description": "Spatial density of clutter (false or new-object detections) in the\nposterior, per unit measurement volume; 0 = none.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "0"
        },
        "SCAN": {
          "$ref": "#/definitions/asgScanGrouping",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "SensorTime": {
              "value": 0,
              "description": "One scan per sensor and observation time."
            },
            "Track": {
              "value": 1,
              "description": "One scan per track identifier (observations without one fall back to sensor and time)."
            },
            "Observation": {
              "value": 2,
              "description": "Every observation is its own scan (no competition between observations)."
            }
          },
          "x-flatbuffer-default": "SensorTime"
        },
        "MAX_CANDIDATES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Out-of-gate candidates reported per observation, 1 to 50.",
          "x-flatbuffer-type": "uint8",
          "x-flatbuffer-default": "5"
        },
        "GEOMETRY": {
          "type": "boolean",
          "description": "Report each candidate's predicted position, velocity and covariance.",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "true"
        }
      },
      "additionalProperties": false
    },
    "ASGGateThreshold": {
      "type": "object",
      "description": "Chi-square gate threshold for one number of degrees of freedom.",
      "properties": {
        "DEGREES_OF_FREEDOM": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-flatbuffer-type": "uint8"
        },
        "THRESHOLD": {
          "type": "number",
          "description": "D2 threshold at the gate probability.",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "ASGAssociationReport": {
      "type": "object",
      "description": "The evidence of one association run. The association list and the\nuncorrelated list are OBSERVATIONS filtered by OUTCOME.",
      "properties": {
        "METHOD": {
          "type": "string",
          "description": "Method, e.g. \"chi-square gate on S = H P H^T + R, global nearest\nneighbour per scan (Hungarian), gate as the non-assignment cost\".",
          "x-flatbuffer-type": "string"
        },
        "OPTIONS": {
          "$ref": "#/definitions/ASGAssociationOptions",
          "description": "The options the run used, defaults filled in.",
          "x-flatbuffer-type": "ASGAssociationOptions"
        },
        "GATE_THRESHOLDS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ASGGateThreshold"
          },
          "description": "Gate thresholds by degrees of freedom.",
          "x-flatbuffer-type": "[ASGGateThreshold]"
        },
        "EARTH_ORIENTATION_ROWS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Earth orientation rows supplied.",
          "x-flatbuffer-type": "uint32"
        },
        "OBSERVATION_COUNT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Observations read.",
          "x-flatbuffer-type": "uint32"
        },
        "PREDICTION_COUNT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Predicted objects (prediction blocks) read.",
          "x-flatbuffer-type": "uint32"
        },
        "SCAN_COUNT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Scans solved.",
          "x-flatbuffer-type": "uint32"
        },
        "ASSOCIATED_COUNT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Observations associated.",
          "x-flatbuffer-type": "uint32"
        },
        "UNCORRELATED_COUNT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Observations left uncorrelated.",
          "x-flatbuffer-type": "uint32"
        },
        "AMBIGUOUS_COUNT": {
