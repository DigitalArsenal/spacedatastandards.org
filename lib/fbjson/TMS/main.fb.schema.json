{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "TrkTrackStatus": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DROPPED",
        "TENTATIVE",
        "CONFIRMED",
        "COASTED",
        "DEAD"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "ACTIVE": {
          "value": 0
        },
        "DROPPED": {
          "value": 1
        },
        "TENTATIVE": {
          "value": 2
        },
        "CONFIRMED": {
          "value": 3
        },
        "COASTED": {
          "value": 4
        },
        "DEAD": {
          "value": 5
        }
      }
    },
    "trackEnvironment": {
      "type": "string",
      "enum": [
        "SPACE",
        "AIR",
        "SURFACE",
        "SUBSURFACE",
        "LAND",
        "UNKNOWN"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "SPACE": {
          "value": 0
        },
        "AIR": {
          "value": 1
        },
        "SURFACE": {
          "value": 2
        },
        "SUBSURFACE": {
          "value": 3
        },
        "LAND": {
          "value": 4
        },
        "UNKNOWN": {
          "value": 5
        }
      }
    },
    "TRK": {
      "type": "object",
      "description": "Track",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Unique identifier",
          "x-flatbuffer-type": "string"
        },
        "CNTCT": {
          "type": "string",
          "description": "Contact reference",
          "x-flatbuffer-type": "string"
        },
        "MSG_TS": {
          "type": "string",
          "description": "Message timestamp (ISO 8601)",
          "x-flatbuffer-type": "string"
        },
        "MSN_ID": {
          "type": "string",
          "description": "Mission identifier",
          "x-flatbuffer-type": "string"
        },
        "ASSET_NAT": {
          "type": "string",
          "description": "Asset nationality",
          "x-flatbuffer-type": "string"
        },
        "ASSET": {
          "type": "string",
          "description": "Asset identifier",
          "x-flatbuffer-type": "string"
        },
        "SENSOR_ID": {
          "type": "string",
          "description": "Sensor identifier",
          "x-flatbuffer-type": "string"
        },
        "SEN_QUAL": {
          "type": "string",
          "description": "Sensor quality assessment",
          "x-flatbuffer-type": "string"
        },
        "TRK_ID": {
          "type": "string",
          "description": "Track identifier",
          "x-flatbuffer-type": "string"
        },
        "TRK_NUM": {
          "type": "string",
          "description": "Track number",
          "x-flatbuffer-type": "string"
        },
        "TRK_STAT": {
          "$ref": "#/definitions/TrkTrackStatus",
          "description": "Track status",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "ACTIVE": {
              "value": 0
            },
            "DROPPED": {
              "value": 1
            },
            "TENTATIVE": {
              "value": 2
            },
            "CONFIRMED": {
              "value": 3
            },
            "COASTED": {
              "value": 4
            },
            "DEAD": {
              "value": 5
            }
          }
        },
        "OBJ_NAT": {
          "type": "string",
          "description": "Object nationality",
          "x-flatbuffer-type": "string"
        },
        "OBJ_ID": {
          "type": "string",
          "description": "Object identifier",
          "x-flatbuffer-type": "string"
        },
        "OBJ_TYPE": {
          "type": "string",
          "description": "Object type classification",
          "x-flatbuffer-type": "string"
        },
        "OBJ_SPEC": {
          "type": "string",
          "description": "Object specific type",
          "x-flatbuffer-type": "string"
        },
        "OBJ_PLAT": {
          "type": "string",
          "description": "Object platform type",
          "x-flatbuffer-type": "string"
        },
        "OBJ_ACT": {
          "type": "string",
          "description": "Object activity",
          "x-flatbuffer-type": "string"
        },
        "MOD_TYPE": {
          "type": "string",
          "description": "Mode type",
          "x-flatbuffer-type": "string"
        },
        "TRK_ITM_ID": {
          "type": "string",
          "description": "Track item identifier",
          "x-flatbuffer-type": "string"
        },
        "TS": {
          "type": "string",
          "description": "Track point timestamp (ISO 8601)",
          "x-flatbuffer-type": "string"
        },
        "TRK_QUAL": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Track quality (0-15)",
          "x-flatbuffer-type": "uint8"
        },
        "TRK_PT_TYPE": {
          "type": "string",
          "description": "Track point type",
          "x-flatbuffer-type": "string"
        },
        "OBJ_IDENT": {
          "type": "string",
          "description": "Object identity assessment",
          "x-flatbuffer-type": "string"
        },
        "IDENT_CRED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Identity credibility (1-6)",
          "x-flatbuffer-type": "uint8"
        },
        "IDENT_REL": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Identity reliability (A-F)",
          "x-flatbuffer-type": "uint8"
        },
        "IDENT_AMP": {
          "type": "string",
          "description": "Identity amplification",
          "x-flatbuffer-type": "string"
        },
        "ENVIRONMENT": {
          "$ref": "#/definitions/trackEnvironment",
          "description": "Track environment",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "SPACE": {
              "value": 0
            },
            "AIR": {
              "value": 1
            },
            "SURFACE": {
              "value": 2
            },
            "SUBSURFACE": {
              "value": 3
            },
            "LAND": {
              "value": 4
            },
            "UNKNOWN": {
              "value": 5
            }
          }
        },
        "ENVIRONMENT_CONF": {
          "type": "number",
          "description": "Environment confidence (0-1)",
          "x-flatbuffer-type": "double"
        },
        "TRK_CONF": {
          "type": "number",
          "description": "Track confidence (0-1)",
          "x-flatbuffer-type": "double"
        },
        "LAT": {
          "type": "number",
          "description": "Latitude (degrees)",
          "x-flatbuffer-type": "double"
        },
        "LON": {
          "type": "number",
          "description": "Longitude (degrees)",
          "x-flatbuffer-type": "double"
        },
        "ALT": {
          "type": "number",
          "description": "Altitude (km)",
          "x-flatbuffer-type": "double"
        },
        "SPD": {
          "type": "number",
          "description": "Speed (km/s)",
          "x-flatbuffer-type": "double"
        },
        "HDNG": {
          "type": "number",
          "description": "Heading (degrees from north)",
          "x-flatbuffer-type": "double"
        },
        "COURSE": {
          "type": "number",
          "description": "Course (degrees from north)",
          "x-flatbuffer-type": "double"
        },
        "SRC_TYPS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source types",
          "x-flatbuffer-type": "[string]"
        },
        "SRC_IDS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source identifiers",
          "x-flatbuffer-type": "[string]"
        },
        "CALL_SIGN": {
          "type": "string",
          "description": "Call sign",
          "x-flatbuffer-type": "string"
        },
        "MULTI_SOURCE": {
          "type": "boolean",
          "description": "True if fused from multiple sources",
          "x-flatbuffer-type": "bool"
        },
        "J_SERIES": {
          "type": "string",
          "description": "J-series message type",
          "x-flatbuffer-type": "string"
        },
        "STRENGTH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Force strength indicator",
          "x-flatbuffer-type": "uint16"
        },
        "M1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Mode 1 code",
          "x-flatbuffer-type": "uint16"
        },
        "M1V": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Mode 1 validity",
          "x-flatbuffer-type": "uint8"
        },
        "M2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Mode 2 code",
          "x-flatbuffer-type": "uint16"
        },
        "M2V": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Mode 2 validity",
          "x-flatbuffer-type": "uint8"
        },
        "M3A": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Mode 3A code",
          "x-flatbuffer-type": "uint16"
        },
        "M3AV": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Mode 3A validity",
          "x-flatbuffer-type": "uint8"
        },
        "TAGS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Associated tags",
          "x-flatbuffer-type": "[string]"
        },
        "TRACK_START_TIME": {
          "type": "string",
          "description": "Start time for track data (ISO 8601)",
          "x-flatbuffer-type": "string"
        },
        "TRACK_STEP_SIZE": {
          "type": "number",
          "description": "Time interval between track points (seconds)",
          "x-flatbuffer-type": "double"
        },
        "TRACK_COMPONENTS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Number of components per point (default 3 for X, Y, Z)",
          "x-flatbuffer-type": "uint8",
          "x-flatbuffer-default": "3"
        },
        "ECEF_POS": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "ECEF position as flat array [X0, Y0, Z0, X1, Y1, Z1, ...]",
          "x-flatbuffer-type": "[double]"
        },
        "ECEF_VEL": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "ECEF velocity as flat array [VX0, VY0, VZ0, VX1, VY1, VZ1, ...]",
          "x-flatbuffer-type": "[double]"
        },
        "ECEF_ACC": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "ECEF acceleration as flat array [AX0, AY0, AZ0, AX1, AY1, AZ1, ...]",
          "x-flatbuffer-type": "[double]"
        },
        "LC_POS": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Local coordinate position as flat array",
          "x-flatbuffer-type": "[double]"
        },
        "LC_VEL": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Local coordinate velocity as flat array",
          "x-flatbuffer-type": "[double]"
        },
        "LC_ACC": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Local coordinate acceleration as flat array",
          "x-flatbuffer-type": "[double]"
        },
        "COV": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Covariance data (21 elements per point for 6x6 lower triangular)",
          "x-flatbuffer-type": "[double]"
        },
        "ERR_ELLP": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Error ellipse data (6 elements per point)",
          "x-flatbuffer-type": "[double]"
        }
      },
      "additionalProperties": false
    },
    "TMSModelParameter": {
      "type": "object",
      "description": "One parameter of the propagation model, stated by name so a model\nregistry can evolve without schema change.",
      "properties": {
        "NAME": {
          "type": "string",
          "description": "Parameter name within the MODEL_ID model's own registry, verbatim.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "VALUE": {
          "type": "number",
          "description": "Parameter value.",
          "x-flatbuffer-type": "double"
        },
        "UNITS": {
          "type": "string",
          "description": "Units of VALUE, verbatim. Required: a unitless parameter states so\nexplicitly (e.g. \"1\").",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        }
      },
      "required": [
        "NAME",
        "UNITS"
      ],
      "additionalProperties": false
    },
    "TMSIdentifier": {
      "type": "object",
      "description": "One identity the track is known by in a named identity scheme.",
      "properties": {
        "SCHEME": {
          "type": "string",
          "description": "Identity scheme token, verbatim (the identity system's own name).\nNever a field name and never normalized by the publisher.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "VALUE": {
          "type": "string",
          "description": "The identifier within that scheme, verbatim.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        }
      },
      "required": [
        "SCHEME",
        "VALUE"
      ],
      "additionalProperties": false
    },
    "TMSProvenance": {
      "type": "object",
      "description": "Dataset lineage and redistribution terms for one track model state.\n\nRequired on every record: a redistributed track whose feed, epoch, and\nlicence are unstated is not publishable. The standard names no feed,\nprovider, or site.",
      "properties": {
        "DATASET_ID": {
          "type": "string",
          "description": "Publisher-stable, lowercase identifier for the feed or dataset this\nstate was derived from, unique within the publisher's own dataset\nregistry. Never a display name and never a URL.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "DATASET_NAME": {
          "type": "string",
          "description": "The feed or dataset's own name, verbatim as its publisher states it.",
          "x-flatbuffer-type": "string"
        },
        "DATASET_URL": {
          "type": "string",
          "description": "Replayable URL of the feed or dataset as published.",
          "x-flatbuffer-type": "string"
        },
        "DATASET_EPOCH": {
          "type": "string",
          "description": "RFC 3339 UTC fixed-millisecond epoch of the dataset edition or feed\nsession this state was derived from.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "DATASET_CID": {
          "type": "string",
          "description": "Content identifier of the exact dataset artifact, when one exists.",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_URL": {
          "type": "string",
          "description": "Replayable URL identifying the source material within the dataset.",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_QUERY": {
          "type": "string",
          "description": "The exact query, filter, or subscription used.",
          "x-flatbuffer-type": "string"
        },
        "RETRIEVED_AT": {
          "type": "string",
          "description": "RFC 3339 UTC fixed-millisecond retrieval timestamp of the observation\nthis state was updated from.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "LICENSE": {
          "type": "string",
          "description": "Redistribution terms verbatim. Unknown terms are never public domain\nand never an implied grant.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "LICENSE_URL": {
          "type": "string",
          "description": "URL of the full licence text as the source publishes it.",
          "x-flatbuffer-type": "string"
        },
        "ATTRIBUTION": {
          "type": "string",
          "description": "Attribution text the licence requires a redistributor to display.",
          "x-flatbuffer-type": "string"
        },
        "NON_COMMERCIAL_ONLY": {
          "type": "boolean",
          "description": "The licence forbids commercial use.",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "false"
        },
        "SHARE_ALIKE": {
          "type": "boolean",
          "description": "The licence obliges derived works to carry the same terms.",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "false"
        },
        "NATIVE_ID": {
          "type": "string",
          "description": "The source's own identifier for the track or observation stream this\nstate was derived from, verbatim.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "NATIVE_MODIFIED": {
          "type": "string",
          "description": "RFC 3339 UTC instant the source last modified or emitted the\nunderlying observation, as the source states it.",
          "x-flatbuffer-type": "string"
        }
      },
      "required": [
        "DATASET_ID",
        "DATASET_EPOCH",
        "RETRIEVED_AT",
        "LICENSE",
        "NATIVE_ID"
      ],
      "additionalProperties": false
    },
    "TMS": {
      "type": "object",
      "description": "Track Model State",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Publisher-stable identifier for this state record.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "TRACK_ID": {
          "type": "string",
          "description": "Publisher-stable identifier of the track this state belongs to, held\nconstant across every state update of the same track.",
          "x-flatbuffer-type": "string"
        },
        "ENVIRONMENT": {
          "$ref": "#/definitions/trackEnvironment",
          "description": "Domain the track moves in. The `$TRK` enum reused verbatim; ordinal 0\nis SPACE, so a publisher MUST set this field \u2014 it is defaulted to\nUNKNOWN explicitly so an unset field can never be read as SPACE.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "SPACE": {
              "value": 0
            },
            "AIR": {
              "value": 1
            },
            "SURFACE": {
              "value": 2
            },
            "SUBSURFACE": {
              "value": 3
            },
            "LAND": {
              "value": 4
            },
            "UNKNOWN": {
              "value": 5
            }
          },
          "x-flatbuffer-default": "UNKNOWN"
        },
        "EPOCH": {
          "type": "string",
          "description": "RFC 3339 UTC fixed-millisecond epoch this state is valid at. The\npropagation origin: every kinematic field below is stated at EPOCH.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "LATITUDE": {
          "type": "number",
          "description": "Latitude, decimal degrees on WGS 84, positive north.",
          "x-flatbuffer-type": "double"
        },
        "LONGITUDE": {
          "type": "number",
          "description": "Longitude, decimal degrees on WGS 84, positive east, in [-180, 180].",
          "x-flatbuffer-type": "double"
        },
        "ALTITUDE_M": {
          "type": "number",
          "description": "Altitude, metres above the WGS 84 ellipsoid. NaN for a surface track\nwhose source publishes no altitude.",
          "x-flatbuffer-type": "double"
        },
        "GROUND_SPEED_MPS": {
          "type": "number",
          "description": "Speed over ground, metres per second.",
          "x-flatbuffer-type": "double"
        },
        "VELOCITY_NORTH_MPS": {
          "type": "number",
          "description": "Velocity components, metres per second, local NED-derived axes:\nnorth, east, and up. Published when the source or filter resolves\nthem; NaN otherwise.",
          "x-flatbuffer-type": "double"
        },
        "VELOCITY_EAST_MPS": {
          "type": "number",
          "x-flatbuffer-type": "double"
        },
        "VELOCITY_UP_MPS": {
          "type": "number",
          "x-flatbuffer-type": "double"
        },
        "HEADING_DEG": {
          "type": "number",
          "description": "Heading, degrees true, [0, 360): the direction the vehicle points.",
          "x-flatbuffer-type": "double"
        },
        "COURSE_DEG": {
          "type": "number",
          "description": "Course over ground, degrees true, [0, 360): the direction it moves.",
          "x-flatbuffer-type": "double"
        },
        "TURN_RATE_DPS": {
          "type": "number",
          "description": "Turn rate, degrees per second, positive clockwise seen from above.",
          "x-flatbuffer-type": "double"
        },
        "VERTICAL_RATE_MPS": {
          "type": "number",
          "description": "Vertical rate, metres per second, positive up.",
          "x-flatbuffer-type": "double"
        },
        "MODEL_ID": {
          "type": "string",
          "description": "Identifier of the dead-reckoning or motion model that extrapolates\nthis state, a key into the publisher's model registry. Required: a\nstate with no model is a position report, which this record is not.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "MODEL_PARAMETERS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TMSModelParameter"
          },
          "description": "Parameters of that model, named per its own registry.",
          "x-flatbuffer-type": "[TMSModelParameter]"
        },
        "PROPAGATION_VALID_UNTIL": {
          "type": "string",
          "description": "RFC 3339 UTC instant beyond which the publisher no longer stands\nbehind propagation of this state.",
          "x-flatbuffer-type": "string"
        },
        "POSITION_UNCERTAINTY_M": {
          "type": "number",
          "description": "1-sigma horizontal position uncertainty at EPOCH, metres.",
          "x-flatbuffer-type": "double"
        },
        "INNOVATION_GATE_SIGMA": {
          "type": "number",
          "description": "Gate in standard deviations: an observation whose innovation exceeds\nthis many sigma of POSITION_UNCERTAINTY_M breached the model and\nproduced this update.",
          "x-flatbuffer-type": "double"
        },
        "INNOVATION_GATE_DISTANCE_M": {
          "type": "number",
          "description": "Gate as an absolute distance, metres, when the publisher gates on\ndistance rather than sigma.",
          "x-flatbuffer-type": "double"
        },
        "TOLERANCE_M": {
          "type": "number",
          "description": "Publisher's stated tolerance, metres, within which propagation of this\nstate is considered to agree with truth.",
          "x-flatbuffer-type": "double"
        },
        "TRACK_STATUS": {
          "$ref": "#/definitions/TrkTrackStatus",
          "description": "Track status. The `$TRK` enum reused verbatim; ordinal 0 is ACTIVE,\nso a publisher MUST set this field on every record \u2014 an unset field\nreads as ACTIVE and a consumer cannot distinguish the two.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "ACTIVE": {
              "value": 0
            },
            "DROPPED": {
              "value": 1
            },
            "TENTATIVE": {
              "value": 2
            },
            "CONFIRMED": {
              "value": 3
            },
            "COASTED": {
              "value": 4
            },
            "DEAD": {
              "value": 5
            }
          },
          "x-flatbuffer-default": "ACTIVE"
        },
        "STALE_AFTER_S": {
          "type": "number",
          "description": "Seconds after LAST_UPDATE_EPOCH at which a consumer MUST mark the\ntrack stale.",
          "x-flatbuffer-type": "double"
        },
        "DROP_AFTER_S": {
          "type": "number",
          "description": "Seconds after LAST_UPDATE_EPOCH at which a consumer MUST drop the\ntrack.",
          "x-flatbuffer-type": "double"
        },
        "LAST_UPDATE_EPOCH": {
          "type": "string",
