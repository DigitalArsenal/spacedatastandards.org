{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "pvnSourceKind": {
      "type": "string",
      "enum": [
        "Unspecified",
        "ElementSet",
        "Ephemeris",
        "Observation",
        "Reference"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "Unspecified": {
          "value": 0,
          "description": "Not stated"
        },
        "ElementSet": {
          "value": 1,
          "description": "Element sets of a catalog"
        },
        "Ephemeris": {
          "value": 2,
          "description": "Ephemerides: states over time, from an operator or a precise-orbit service"
        },
        "Observation": {
          "value": 3,
          "description": "Observations (ranges, angles, other measurements) that states are estimated from"
        },
        "Reference": {
          "value": 4,
          "description": "Reference registers of sites and facilities (status, dates, identity)"
        }
      }
    },
    "pvnLicenseClass": {
      "type": "string",
      "enum": [
        "Unspecified",
        "Reproducible",
        "CiteOnly",
        "ShareAlike",
        "NonCommercial"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "Unspecified": {
          "value": 0,
          "description": "Not stated. Never a grant: treated as CiteOnly."
        },
        "Reproducible": {
          "value": 1,
          "description": "The records may be republished, with the credit the terms ask."
        },
        "CiteOnly": {
          "value": 2,
          "description": "The records are computed on and cited, never republished."
        },
        "ShareAlike": {
          "value": 3,
          "description": "The records may be republished under the same terms, which every derived record carries."
        },
        "NonCommercial": {
          "value": 4,
          "description": "The records may be republished for non-commercial use only."
        }
      }
    },
    "rdeShieldMaterial": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "ALUMINUM",
        "POLYETHYLENE",
        "TANTALUM",
        "WATER",
        "CARBON_COMPOSITE",
        "MULTI_MATERIAL",
        "CUSTOM"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0,
          "description": "Not stated."
        },
        "ALUMINUM": {
          "value": 1,
          "description": "Standard aerospace aluminum (Al)."
        },
        "POLYETHYLENE": {
          "value": 2,
          "description": "Hydrogen-rich polyethylene shielding."
        },
        "TANTALUM": {
          "value": 3,
          "description": "High-Z tantalum spot shielding."
        },
        "WATER": {
          "value": 4,
          "description": "Water shielding wall / storm shelter."
        },
        "CARBON_COMPOSITE": {
          "value": 5,
          "description": "Carbon-fiber composite structure."
        },
        "MULTI_MATERIAL": {
          "value": 6,
          "description": "Layered multi-material stackup."
        },
        "CUSTOM": {
          "value": 7,
          "description": "Custom material specification in MATERIAL_NAME."
        }
      }
    },
    "rdeShieldGeometry": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "SOLID_SPHERE",
        "HOLLOW_SPHERE",
        "SLAB",
        "SECTOR_TRACE"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0,
          "description": "Not stated."
        },
        "SOLID_SPHERE": {
          "value": 1,
          "description": "Dose at the center of a solid sphere."
        },
        "HOLLOW_SPHERE": {
          "value": 2,
          "description": "Dose inside a hollow spherical shell."
        },
        "SLAB": {
          "value": 3,
          "description": "Planar slab geometry."
        },
        "SECTOR_TRACE": {
          "value": 4,
          "description": "Multi-ray 3D sectoring trace."
        }
      }
    },
    "rdeEffectSeverity": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "NOMINAL",
        "ELEVATED",
        "WARNING",
        "CRITICAL"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0,
          "description": "Not stated."
        },
        "NOMINAL": {
          "value": 1,
          "description": "Nominal radiation environment and margins."
        },
        "ELEVATED": {
          "value": 2,
          "description": "Elevated radiation exposure; monitor margins."
        },
        "WARNING": {
          "value": 3,
          "description": "Warning threshold exceeded; operational mitigation advised."
        },
        "CRITICAL": {
          "value": 4,
          "description": "Critical threshold exceeded; safe-mode or crew shelter action required."
        }
      }
    },
    "PVN": {
      "type": "object",
      "description": "Product Provenance",
      "properties": {
        "SOURCE_ID": {
          "type": "string",
          "description": "Publisher-stable, lowercase identifier of the source in the provider's\nregistry of sources.",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_KIND": {
          "$ref": "#/definitions/pvnSourceKind",
          "description": "What kind of data the source supplies.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "Unspecified": {
              "value": 0,
              "description": "Not stated"
            },
            "ElementSet": {
              "value": 1,
              "description": "Element sets of a catalog"
            },
            "Ephemeris": {
              "value": 2,
              "description": "Ephemerides: states over time, from an operator or a precise-orbit service"
            },
            "Observation": {
              "value": 3,
              "description": "Observations (ranges, angles, other measurements) that states are estimated from"
            },
            "Reference": {
              "value": 4,
              "description": "Reference registers of sites and facilities (status, dates, identity)"
            }
          },
          "x-flatbuffer-default": "Unspecified"
        },
        "ORIGINATOR": {
          "type": "string",
          "description": "Agency, operator or catalog that created the source data, as it names\nitself. Not a message's CCSDS ORIGINATOR, which names who created the\nmessage.",
          "x-flatbuffer-type": "string"
        },
        "PROVIDER_ID": {
          "type": "string",
          "description": "Identifier of the provider that published the product, as the provider\nnames itself: the module, node or service that retrieved the source data.",
          "x-flatbuffer-type": "string"
        },
        "PRODUCER": {
          "type": "string",
          "description": "Identifier of the software that made the product from the source data,\nwith its version when it has one.",
          "x-flatbuffer-type": "string"
        },
        "LICENSE_CLASS": {
          "$ref": "#/definitions/pvnLicenseClass",
          "description": "What the source's terms permit for the product.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "Unspecified": {
              "value": 0,
              "description": "Not stated. Never a grant: treated as CiteOnly."
            },
            "Reproducible": {
              "value": 1,
              "description": "The records may be republished, with the credit the terms ask."
            },
            "CiteOnly": {
              "value": 2,
              "description": "The records are computed on and cited, never republished."
            },
            "ShareAlike": {
              "value": 3,
              "description": "The records may be republished under the same terms, which every derived record carries."
            },
            "NonCommercial": {
              "value": 4,
              "description": "The records may be republished for non-commercial use only."
            }
          },
          "x-flatbuffer-default": "Unspecified"
        },
        "LICENSE_ID": {
          "type": "string",
          "description": "Identifier of the terms LICENSE_CLASS was read from: an SPDX license\nidentifier where one applies, else the identifier of the terms in the\nprovider's licence register.",
          "x-flatbuffer-type": "string"
        },
        "LINEAGE": {
          "type": "string",
          "description": "Identifier of the lineage the source's data descends from. Sources that\nrepublish one upstream share its lineage, so their products are not\nindependent of each other.",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_URL": {
          "type": "string",
          "description": "Replayable URL or provider query identifying the source material as it\nwas retrieved (the SOURCE_URL of $CMR and $AVL).",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_VERSION": {
          "type": "string",
          "description": "Source revision, edition or upstream update marker verbatim: for a file\nits originator stamps, the stamp.",
          "x-flatbuffer-type": "string"
        },
        "RETRIEVED_AT": {
          "type": "string",
          "description": "RFC 3339 UTC fixed-millisecond time the source material was retrieved.",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_SHA256": {
          "type": "string",
          "description": "SHA-256 of the exact source payload bytes as retrieved, 64 lowercase\nhexadecimal characters. Empty when the source cannot expose replayable\nbytes.",
          "x-flatbuffer-type": "string"
        },
        "SOURCE_BYTES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Number of source bytes SOURCE_SHA256 covers: the length of the prefix when\nthe source was fetched by range. 0 when not stated.",
          "x-flatbuffer-type": "uint64"
        },
        "PRODUCER_SHA256": {
          "type": "string",
          "description": "SHA-256 of the build of PRODUCER that made the product (its dist\nmodule.wasm), 64 lowercase hexadecimal characters. Stamped by the host\nthat loaded the producing module: a module cannot hash its own bytes.\nEmpty when not stated.",
          "x-flatbuffer-type": "string"
        }
      },
      "additionalProperties": false
    },
    "RDEShielding": {
      "type": "object",
      "description": "Shielding configuration for dose and TID calculations.",
      "properties": {
        "MATERIAL": {
          "$ref": "#/definitions/rdeShieldMaterial",
          "description": "Primary shielding material class.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0,
              "description": "Not stated."
            },
            "ALUMINUM": {
              "value": 1,
              "description": "Standard aerospace aluminum (Al)."
            },
            "POLYETHYLENE": {
              "value": 2,
              "description": "Hydrogen-rich polyethylene shielding."
            },
            "TANTALUM": {
              "value": 3,
              "description": "High-Z tantalum spot shielding."
            },
            "WATER": {
              "value": 4,
              "description": "Water shielding wall / storm shelter."
            },
            "CARBON_COMPOSITE": {
              "value": 5,
              "description": "Carbon-fiber composite structure."
            },
            "MULTI_MATERIAL": {
              "value": 6,
              "description": "Layered multi-material stackup."
            },
            "CUSTOM": {
              "value": 7,
              "description": "Custom material specification in MATERIAL_NAME."
            }
          },
          "x-flatbuffer-default": "ALUMINUM"
        },
        "MATERIAL_NAME": {
          "type": "string",
          "description": "Descriptive material or layup name when CUSTOM or MULTI_MATERIAL.",
          "x-flatbuffer-type": "string"
        },
        "GEOMETRY": {
          "$ref": "#/definitions/rdeShieldGeometry",
          "description": "Transport geometry approximation.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0,
              "description": "Not stated."
            },
            "SOLID_SPHERE": {
              "value": 1,
              "description": "Dose at the center of a solid sphere."
            },
            "HOLLOW_SPHERE": {
              "value": 2,
              "description": "Dose inside a hollow spherical shell."
            },
            "SLAB": {
              "value": 3,
              "description": "Planar slab geometry."
            },
            "SECTOR_TRACE": {
              "value": 4,
              "description": "Multi-ray 3D sectoring trace."
            }
          },
          "x-flatbuffer-default": "SOLID_SPHERE"
        },
        "THICKNESS_MM": {
          "type": "number",
          "description": "Shield thickness in millimeters.",
          "x-flatbuffer-type": "double"
        },
        "AREAL_DENSITY_G_CM2": {
          "type": "number",
          "description": "Areal mass density in g/cm^2.",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "RDEShieldCurvePoint": {
      "type": "object",
      "description": "One point on a depth-dose shielding curve.",
      "properties": {
        "THICKNESS_MM": {
          "type": "number",
          "description": "Shield thickness in millimeters.",
          "x-flatbuffer-type": "double"
        },
        "AREAL_DENSITY_G_CM2": {
          "type": "number",
          "description": "Areal mass density in g/cm^2.",
          "x-flatbuffer-type": "double"
        },
        "DOSE_RATE_MSV_H": {
          "type": "number",
          "description": "Computed dose rate behind this thickness in mSv/h.",
          "x-flatbuffer-type": "double"
        },
        "TID_KRAD_SI": {
          "type": "number",
          "description": "Computed total ionizing dose over the window in krad(Si).",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "RDEPassDose": {
      "type": "object",
      "description": "Integrated radiation exposure for a single belt or SAA pass.",
      "properties": {
        "PASS_ID": {
          "type": "string",
          "description": "Unique pass identifier within the assessment window.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "START_UTC": {
          "type": "string",
          "description": "Pass entry timestamp, RFC 3339 UTC.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "END_UTC": {
          "type": "string",
          "description": "Pass exit timestamp, RFC 3339 UTC.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "IN_SAA": {
          "type": "boolean",
          "description": "True when the pass traverses the South Atlantic Anomaly.",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "false"
        },
        "IN_BELT_CORE": {
          "type": "boolean",
          "description": "True when the pass traverses a primary trapped radiation belt core.",
          "x-flatbuffer-type": "bool",
          "x-flatbuffer-default": "false"
        },
        "PEAK_DOSE_RATE_MSV_H": {
          "type": "number",
          "description": "Peak instantaneous dose rate during the pass in mSv/h.",
          "x-flatbuffer-type": "double"
        },
        "INTEGRATED_DOSE_MSV": {
          "type": "number",
          "description": "Total integrated dose accumulated during the pass in mSv.",
          "x-flatbuffer-type": "double"
        },
        "PEAK_L_SHELL": {
          "type": "number",
          "description": "Peak McIlwain L-shell reached during the pass.",
          "x-flatbuffer-type": "double"
        }
      },
      "required": [
        "PASS_ID",
        "START_UTC",
        "END_UTC"
      ],
      "additionalProperties": false
    },
    "RDEElectronicsEffect": {
      "type": "object",
      "description": "Spacecraft electronics single-event effects (SEE) and total ionizing dose (TID) assessment.",
      "properties": {
        "DEVICE_PROFILE_ID": {
          "type": "string",
          "description": "Reference device or part hardness profile identifier.",
          "x-flatbuffer-type": "string"
        },
        "SEE_UPSET_RATE_PER_BIT_DAY": {
          "type": "number",
          "description": "Single-event upset rate in upsets/bit/day.",
          "x-flatbuffer-type": "double"
        },
        "SEL_PROBABILITY": {
          "type": "number",
          "description": "Single-event latchup probability over the assessment window (0..1).",
          "x-flatbuffer-type": "double"
        },
        "SEB_SEGR_RISK": {
          "type": "number",
          "description": "Single-event burnout / gate rupture risk metric (0..1).",
          "x-flatbuffer-type": "double"
        },
        "TID_KRAD_SI": {
          "type": "number",
          "description": "Total ionizing dose accumulated over the window in krad(Si).",
          "x-flatbuffer-type": "double"
        },
        "TID_MARGIN_PCT": {
          "type": "number",
          "description": "Remaining TID design margin in percent.",
          "x-flatbuffer-type": "double"
        },
        "LET_THRESHOLD_MEV_CM2_MG": {
          "type": "number",
          "description": "Linear energy transfer threshold in MeV*cm^2/mg.",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "RDECrewDose": {
      "type": "object",
      "description": "Human crew dosimetry and career limit tracking.",
      "properties": {
        "CREW_ID": {
          "type": "string",
          "description": "Crew member or mission role identifier.",
          "x-flatbuffer-type": "string"
        },
        "EFFECTIVE_DOSE_MSV": {
          "type": "number",
          "description": "Whole-body effective dose over the window in mSv.",
          "x-flatbuffer-type": "double"
        },
        "BLOOD_FORMING_ORGANS_MSV": {
          "type": "number",
          "description": "Blood-forming organs (BFO) dose in mSv.",
          "x-flatbuffer-type": "double"
        },
        "EYE_LENS_MSV": {
          "type": "number",
          "description": "Eye lens dose in mSv.",
          "x-flatbuffer-type": "double"
        },
        "SKIN_MSV": {
          "type": "number",
          "description": "Skin dose in mSv.",
          "x-flatbuffer-type": "double"
        },
        "CUMULATIVE_CAREER_MSV": {
          "type": "number",
          "description": "Updated cumulative career effective dose in mSv.",
          "x-flatbuffer-type": "double"
        },
        "CAREER_LIMIT_FRACTION": {
          "type": "number",
          "description": "Fraction of applicable career limit consumed (0..1+).",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "RDESepEffect": {
      "type": "object",
      "description": "Solar flare / solar energetic particle (SEP) asset impact entry.",
      "properties": {
        "SFE_EVENT_ID": {
          "type": "string",
          "description": "Referenced $SFE solar flare event identifier.",
          "x-flatbuffer-type": "string"
        },
        "NOAA_S_SCALE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "NOAA Solar Radiation Storm scale S1..S5 (0 if below S1).",
          "x-flatbuffer-type": "ubyte"
        },
        "FLARE_CLASS": {
          "type": "string",
          "description": "Soft X-ray flare class verbatim (e.g. \"X2.4\").",
          "x-flatbuffer-type": "string"
        },
        "SEP_DOSE_MSV": {
          "type": "number",
          "description": "Additional SEP event dose in mSv.",
          "x-flatbuffer-type": "double"
        },
        "SOLAR_CELL_DEGRADATION_PCT": {
          "type": "number",
          "description": "Estimated solar array power degradation in percent.",
          "x-flatbuffer-type": "double"
        },
        "STAR_TRACKER_BLINDING_MIN": {
          "type": "number",
          "description": "Estimated star-tracker blinding duration in minutes.",
          "x-flatbuffer-type": "double"
        },
        "SUMMARY": {
          "type": "string",
          "description": "Concise human-readable impact summary.",
          "x-flatbuffer-type": "string"
        }
      },
      "additionalProperties": false
    },
    "RDE": {
      "type": "object",
      "description": "Radiation Effects",
      "properties": {
        "RDE_ID": {
          "type": "string",
          "description": "Unique identifier of this radiation effects record.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "BODY_NAME": {
          "type": "string",
          "description": "CCSDS SANA central body name (e.g. \"EARTH\", \"JUPITER\", \"SATURN\").",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "BODY_NAIF_ID": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "description": "NAIF SPICE body identifier (e.g. 399, 599, 699).",
          "x-flatbuffer-type": "int"
        },
        "NORAD_CAT_ID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "NORAD catalog number of the target spacecraft (0 for uncataloged/crew trajectory).",
          "x-flatbuffer-type": "uint"
        },
        "OBJECT_ID": {
          "type": "string",
          "description": "International designator or object identifier.",
          "x-flatbuffer-type": "string"
        },
        "WINDOW_START": {
          "type": "string",
          "description": "Inclusive assessment window start, RFC 3339 UTC.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "WINDOW_END": {
          "type": "string",
          "description": "Exclusive assessment window end, RFC 3339 UTC.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "RBF_RECORD_IDS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Referenced $RBF radiation belt flux record identifiers.",
          "x-flatbuffer-type": "[string]"
        },
        "SPACE_WEATHER_REFS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Referenced $SWS or $SFE space-weather record identifiers.",
          "x-flatbuffer-type": "[string]"
        },
        "SHIELDING": {
          "$ref": "#/definitions/RDEShielding",
          "description": "Spacecraft or habitat shielding configuration.",
          "x-flatbuffer-type": "RDEShielding"
        },
        "INSTANT_DOSE_RATE_MSV_H": {
          "type": "number",
          "description": "Instantaneous dose rate at WINDOW_START in mSv/h.",
          "x-flatbuffer-type": "double"
        },
        "ORBIT_AVG_DOSE_RATE_MSV_H": {
          "type": "number",
          "description": "Orbit-averaged dose rate over the assessment window in mSv/h.",
          "x-flatbuffer-type": "double"
        },
        "MISSION_DOSE_MSV": {
          "type": "number",
          "description": "Total mission/window dose in mSv.",
          "x-flatbuffer-type": "double"
        },
        "TID_KRAD_SI": {
          "type": "number",
          "description": "Total ionizing dose in silicon over the window in krad(Si).",
          "x-flatbuffer-type": "double"
        },
        "EFFECT_SEVERITY": {
          "$ref": "#/definitions/rdeEffectSeverity",
          "description": "Overall effect severity classification.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0,
              "description": "Not stated."
            },
            "NOMINAL": {
              "value": 1,
              "description": "Nominal radiation environment and margins."
            },
            "ELEVATED": {
              "value": 2,
              "description": "Elevated radiation exposure; monitor margins."
            },
            "WARNING": {
              "value": 3,
              "description": "Warning threshold exceeded; operational mitigation advised."
            },
            "CRITICAL": {
              "value": 4,
              "description": "Critical threshold exceeded; safe-mode or crew shelter action required."
            }
          },
          "x-flatbuffer-default": "UNSPECIFIED"
        },
        "PASS_DOSES": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RDEPassDose"
          },
          "description": "Per-pass dose breakdown across belt and SAA transits.",
          "x-flatbuffer-type": "[RDEPassDose]"
        },
        "SHIELDING_CURVE": {
          "type": "array",
          "items": {
