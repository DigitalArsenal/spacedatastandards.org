{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "phbSpectralRegime": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "GAMMA_RAY",
        "HARD_X_RAY",
        "SOFT_X_RAY",
        "EXTREME_ULTRAVIOLET",
        "FAR_ULTRAVIOLET",
        "NEAR_ULTRAVIOLET",
        "VISIBLE",
        "NEAR_INFRARED",
        "MID_INFRARED",
        "FAR_INFRARED",
        "SUBMILLIMETRE",
        "MICROWAVE",
        "RADIO"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0
        },
        "GAMMA_RAY": {
          "value": 1,
          "description": "Photon energy above 100 keV (wavelength below 0.0124 nm)."
        },
        "HARD_X_RAY": {
          "value": 2,
          "description": "10 keV to 100 keV (0.0124 nm to 0.124 nm)."
        },
        "SOFT_X_RAY": {
          "value": 3,
          "description": "0.1 keV to 10 keV (0.124 nm to 12.4 nm)."
        },
        "EXTREME_ULTRAVIOLET": {
          "value": 4,
          "description": "12.4 nm to 91.2 nm."
        },
        "FAR_ULTRAVIOLET": {
          "value": 5,
          "description": "91.2 nm to 200 nm."
        },
        "NEAR_ULTRAVIOLET": {
          "value": 6,
          "description": "200 nm to 380 nm."
        },
        "VISIBLE": {
          "value": 7,
          "description": "380 nm to 750 nm."
        },
        "NEAR_INFRARED": {
          "value": 8,
          "description": "0.75 um to 5 um."
        },
        "MID_INFRARED": {
          "value": 9,
          "description": "5 um to 40 um."
        },
        "FAR_INFRARED": {
          "value": 10,
          "description": "40 um to 350 um."
        },
        "SUBMILLIMETRE": {
          "value": 11,
          "description": "350 um to 1 mm."
        },
        "MICROWAVE": {
          "value": 12,
          "description": "1 mm to 10 cm (3 GHz to 300 GHz)."
        },
        "RADIO": {
          "value": 13,
          "description": "Longer than 10 cm (below 3 GHz)."
        }
      }
    },
    "phbMagnitudeSystem": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "VEGA",
        "AB",
        "ST",
        "INSTRUMENTAL",
        "NOT_A_MAGNITUDE"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0
        },
        "VEGA": {
          "value": 1,
          "description": "Zero magnitude is the flux of the standard A0 V reference star."
        },
        "AB": {
          "value": 2,
          "description": "Zero magnitude is a flux density of 3631 Jy per unit frequency."
        },
        "ST": {
          "value": 3,
          "description": "Zero magnitude is a flux density of 3.631e-9 erg s-1 cm-2 A-1 per unit wavelength."
        },
        "INSTRUMENTAL": {
          "value": 4,
          "description": "Instrument-specific system; ZERO_POINT_JY states the calibration."
        },
        "NOT_A_MAGNITUDE": {
          "value": 5,
          "description": "The value is not a magnitude (a flux, a count rate, a temperature)."
        }
      }
    },
    "phbQuantity": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "MAGNITUDE",
        "FLUX_DENSITY_JY",
        "ENERGY_FLUX_W_PER_M2",
        "PHOTON_FLUX_PER_M2_S",
        "COUNT_RATE_PER_S",
        "BRIGHTNESS_TEMPERATURE_K"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0
        },
        "MAGNITUDE": {
          "value": 1,
          "description": "Magnitude in the band's SYSTEM."
        },
        "FLUX_DENSITY_JY": {
          "value": 2,
          "description": "Spectral flux density per unit frequency, janskys (1e-26 W m-2 Hz-1)."
        },
        "ENERGY_FLUX_W_PER_M2": {
          "value": 3,
          "description": "Band-integrated energy flux, W m-2."
        },
        "PHOTON_FLUX_PER_M2_S": {
          "value": 4,
          "description": "Band-integrated photon flux, photons m-2 s-1."
        },
        "COUNT_RATE_PER_S": {
          "value": 5,
          "description": "Detected count rate of the stated instrument, counts s-1."
        },
        "BRIGHTNESS_TEMPERATURE_K": {
          "value": 6,
          "description": "Brightness temperature, kelvin."
        }
      }
    },
    "phbDerivation": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "MEASURED",
        "TRANSFORMED",
        "MODELLED"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0
        },
        "MEASURED": {
          "value": 1,
          "description": "Observed in this band."
        },
        "TRANSFORMED": {
          "value": 2,
          "description": "Converted from a measurement in another band or system by a stated transformation."
        },
        "MODELLED": {
          "value": 3,
          "description": "Synthesised from a spectral energy distribution or a model atmosphere; never observed in this band."
        }
      }
    },
    "phbBoundKind": {
      "type": "string",
      "enum": [
        "DETECTION",
        "UPPER_LIMIT",
        "LOWER_LIMIT"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "DETECTION": {
          "value": 0,
          "description": "A detection: VALUE is the measured brightness."
        },
        "UPPER_LIMIT": {
          "value": 1,
          "description": "Not detected: the source is fainter than VALUE (a flux upper limit, a magnitude lower bound)."
        },
        "LOWER_LIMIT": {
          "value": 2,
          "description": "Saturated or confused: the source is at least as bright as VALUE."
        }
      }
    },
    "PHBMeasurement": {
      "type": "object",
      "description": "One source's brightness in one band.",
      "properties": {
        "BAND_ID": {
          "type": "string",
          "description": "Band identifier; resolves to a `$PHB` BAND_ID.",
          "x-flatbuffer-type": "string"
        },
        "SPECTRAL_REGIME": {
          "$ref": "#/definitions/phbSpectralRegime",
          "description": "Coarse region of the band, copied from its descriptor so a consumer\ncan select a mode without resolving the band.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "GAMMA_RAY": {
              "value": 1,
              "description": "Photon energy above 100 keV (wavelength below 0.0124 nm)."
            },
            "HARD_X_RAY": {
              "value": 2,
              "description": "10 keV to 100 keV (0.0124 nm to 0.124 nm)."
            },
            "SOFT_X_RAY": {
              "value": 3,
              "description": "0.1 keV to 10 keV (0.124 nm to 12.4 nm)."
            },
            "EXTREME_ULTRAVIOLET": {
              "value": 4,
              "description": "12.4 nm to 91.2 nm."
            },
            "FAR_ULTRAVIOLET": {
              "value": 5,
              "description": "91.2 nm to 200 nm."
            },
            "NEAR_ULTRAVIOLET": {
              "value": 6,
              "description": "200 nm to 380 nm."
            },
            "VISIBLE": {
              "value": 7,
              "description": "380 nm to 750 nm."
            },
            "NEAR_INFRARED": {
              "value": 8,
              "description": "0.75 um to 5 um."
            },
            "MID_INFRARED": {
              "value": 9,
              "description": "5 um to 40 um."
            },
            "FAR_INFRARED": {
              "value": 10,
              "description": "40 um to 350 um."
            },
            "SUBMILLIMETRE": {
              "value": 11,
              "description": "350 um to 1 mm."
            },
            "MICROWAVE": {
              "value": 12,
              "description": "1 mm to 10 cm (3 GHz to 300 GHz)."
            },
            "RADIO": {
              "value": 13,
              "description": "Longer than 10 cm (below 3 GHz)."
            }
          },
          "x-flatbuffer-default": "UNSPECIFIED"
        },
        "WAVELENGTH_EFF_NM": {
          "type": "number",
          "description": "Effective wavelength of the band, nanometres (vacuum). Copied from the\ndescriptor; required for synthesis when the descriptor is not at hand.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "QUANTITY": {
          "$ref": "#/definitions/phbQuantity",
          "description": "Quantity VALUE states.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "MAGNITUDE": {
              "value": 1,
              "description": "Magnitude in the band's SYSTEM."
            },
            "FLUX_DENSITY_JY": {
              "value": 2,
              "description": "Spectral flux density per unit frequency, janskys (1e-26 W m-2 Hz-1)."
            },
            "ENERGY_FLUX_W_PER_M2": {
              "value": 3,
              "description": "Band-integrated energy flux, W m-2."
            },
            "PHOTON_FLUX_PER_M2_S": {
              "value": 4,
              "description": "Band-integrated photon flux, photons m-2 s-1."
            },
            "COUNT_RATE_PER_S": {
              "value": 5,
              "description": "Detected count rate of the stated instrument, counts s-1."
            },
            "BRIGHTNESS_TEMPERATURE_K": {
              "value": 6,
              "description": "Brightness temperature, kelvin."
            }
          },
          "x-flatbuffer-default": "MAGNITUDE"
        },
        "MAGNITUDE_SYSTEM": {
          "$ref": "#/definitions/phbMagnitudeSystem",
          "description": "Calibration system when QUANTITY is MAGNITUDE.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "VEGA": {
              "value": 1,
              "description": "Zero magnitude is the flux of the standard A0 V reference star."
            },
            "AB": {
              "value": 2,
              "description": "Zero magnitude is a flux density of 3631 Jy per unit frequency."
            },
            "ST": {
              "value": 3,
              "description": "Zero magnitude is a flux density of 3.631e-9 erg s-1 cm-2 A-1 per unit wavelength."
            },
            "INSTRUMENTAL": {
              "value": 4,
              "description": "Instrument-specific system; ZERO_POINT_JY states the calibration."
            },
            "NOT_A_MAGNITUDE": {
              "value": 5,
              "description": "The value is not a magnitude (a flux, a count rate, a temperature)."
            }
          },
          "x-flatbuffer-default": "UNSPECIFIED"
        },
        "VALUE": {
          "type": "number",
          "description": "The measurement, in QUANTITY's units.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "UNCERTAINTY": {
          "type": "number",
          "description": "One-sigma uncertainty of VALUE, same units.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "BOUND": {
          "$ref": "#/definitions/phbBoundKind",
          "description": "Detection or bound.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "DETECTION": {
              "value": 0,
              "description": "A detection: VALUE is the measured brightness."
            },
            "UPPER_LIMIT": {
              "value": 1,
              "description": "Not detected: the source is fainter than VALUE (a flux upper limit, a magnitude lower bound)."
            },
            "LOWER_LIMIT": {
              "value": 2,
              "description": "Saturated or confused: the source is at least as bright as VALUE."
            }
          },
          "x-flatbuffer-default": "DETECTION"
        },
        "DERIVATION": {
          "$ref": "#/definitions/phbDerivation",
          "description": "How the value was obtained.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "MEASURED": {
              "value": 1,
              "description": "Observed in this band."
            },
            "TRANSFORMED": {
              "value": 2,
              "description": "Converted from a measurement in another band or system by a stated transformation."
            },
            "MODELLED": {
              "value": 3,
              "description": "Synthesised from a spectral energy distribution or a model atmosphere; never observed in this band."
            }
          },
          "x-flatbuffer-default": "UNSPECIFIED"
        },
        "EPOCH_MJD": {
          "type": "number",
          "description": "Mid-time of the observation, Modified Julian Date (TT), for sources\nwhose brightness varies. Absent for a catalogue mean.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "OBSERVATION_COUNT": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Number of observations averaged into VALUE; 0 when unstated.",
          "x-flatbuffer-type": "uint32"
        }
      },
      "additionalProperties": false
    },
    "PHB": {
      "type": "object",
      "description": "Photometric Band: one passband's place on the spectrum and its calibration.",
      "properties": {
        "BAND_ID": {
          "type": "string",
          "description": "Stable band identifier, unique within the publishing catalogue, e.g.\n\"V\", \"Ks\", \"0.5-2keV\", \"1.4GHz\". Measurements refer to it.",
          "x-flatbuffer-type": "string",
          "x-flatbuffer-required": true
        },
        "NAME": {
          "type": "string",
          "description": "Human-readable name.",
          "x-flatbuffer-type": "string"
        },
        "SYSTEM_NAME": {
          "type": "string",
          "description": "Name of the photometric system the band belongs to, as the defining\npublication states it.",
          "x-flatbuffer-type": "string"
        },
        "SPECTRAL_REGIME": {
          "$ref": "#/definitions/phbSpectralRegime",
          "description": "Coarse spectral region, by WAVELENGTH_EFF_NM.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "GAMMA_RAY": {
              "value": 1,
              "description": "Photon energy above 100 keV (wavelength below 0.0124 nm)."
            },
            "HARD_X_RAY": {
              "value": 2,
              "description": "10 keV to 100 keV (0.0124 nm to 0.124 nm)."
            },
            "SOFT_X_RAY": {
              "value": 3,
              "description": "0.1 keV to 10 keV (0.124 nm to 12.4 nm)."
            },
            "EXTREME_ULTRAVIOLET": {
              "value": 4,
              "description": "12.4 nm to 91.2 nm."
            },
            "FAR_ULTRAVIOLET": {
              "value": 5,
              "description": "91.2 nm to 200 nm."
            },
            "NEAR_ULTRAVIOLET": {
              "value": 6,
              "description": "200 nm to 380 nm."
            },
            "VISIBLE": {
              "value": 7,
              "description": "380 nm to 750 nm."
            },
            "NEAR_INFRARED": {
              "value": 8,
              "description": "0.75 um to 5 um."
            },
            "MID_INFRARED": {
              "value": 9,
              "description": "5 um to 40 um."
            },
            "FAR_INFRARED": {
              "value": 10,
              "description": "40 um to 350 um."
            },
            "SUBMILLIMETRE": {
              "value": 11,
              "description": "350 um to 1 mm."
            },
            "MICROWAVE": {
              "value": 12,
              "description": "1 mm to 10 cm (3 GHz to 300 GHz)."
            },
            "RADIO": {
              "value": 13,
              "description": "Longer than 10 cm (below 3 GHz)."
            }
          },
          "x-flatbuffer-default": "UNSPECIFIED"
        },
        "WAVELENGTH_EFF_NM": {
          "type": "number",
          "description": "Effective (pivot) wavelength, nanometres, vacuum.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "WAVELENGTH_MIN_NM": {
          "type": "number",
          "description": "Short edge of the band at half maximum response, nanometres.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "WAVELENGTH_MAX_NM": {
          "type": "number",
          "description": "Long edge of the band at half maximum response, nanometres.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "MAGNITUDE_SYSTEM": {
          "$ref": "#/definitions/phbMagnitudeSystem",
          "description": "Calibration system of magnitudes stated in the band.",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "VEGA": {
              "value": 1,
              "description": "Zero magnitude is the flux of the standard A0 V reference star."
            },
            "AB": {
              "value": 2,
              "description": "Zero magnitude is a flux density of 3631 Jy per unit frequency."
            },
            "ST": {
              "value": 3,
              "description": "Zero magnitude is a flux density of 3.631e-9 erg s-1 cm-2 A-1 per unit wavelength."
            },
            "INSTRUMENTAL": {
              "value": 4,
              "description": "Instrument-specific system; ZERO_POINT_JY states the calibration."
            },
            "NOT_A_MAGNITUDE": {
              "value": 5,
              "description": "The value is not a magnitude (a flux, a count rate, a temperature)."
            }
          },
          "x-flatbuffer-default": "UNSPECIFIED"
        },
        "ZERO_POINT_JY": {
          "type": "number",
          "description": "Flux density at the effective wavelength of a zero-magnitude source,\njanskys.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "RESPONSE_WAVELENGTH_NM": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Wavelengths the response curve is sampled at, nanometres, ascending.",
          "x-flatbuffer-type": "[double]"
        },
        "RESPONSE": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Relative system response at each RESPONSE_WAVELENGTH_NM sample,\npeak-normalised to 1. Photon-counting unless RESPONSE_IS_ENERGY.",
          "x-flatbuffer-type": "[float]"
        },
        "RESPONSE_IS_ENERGY": {
          "type": "boolean",
          "description": "True when RESPONSE is an energy-counting response.",
          "x-flatbuffer-type": "bool"
        },
        "CITATION": {
          "type": "string",
          "description": "Reference to the publication that defines the band.",
          "x-flatbuffer-type": "string"
        },
        "DEFINITION_URL": {
          "type": "string",
          "description": "URL of the band's defining document or response table.",
          "x-flatbuffer-type": "string"
        }
      },
      "required": [
        "BAND_ID"
      ],
      "additionalProperties": false
    },
    "STR": {
      "type": "object",
      "description": "Star Catalog Entry",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Unique internal identifier",
          "x-flatbuffer-type": "string"
        },
        "CS_ID": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807,
          "description": "Community satellite-tracking star catalog identifier",
          "x-flatbuffer-type": "long"
        },
        "GNC_CAT_ID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "GNC star catalog identifier",
          "x-flatbuffer-type": "uint32"
        },
        "GAIADR3_CAT_ID": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807,
          "description": "Source identifier in the third data release of the all-sky space astrometry survey",
          "x-flatbuffer-type": "long"
        },
        "HIP_CAT_ID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Identifier in the first space astrometry mission's main catalog",
          "x-flatbuffer-type": "uint32"
        },
        "CAT_VERSION": {
          "type": "string",
          "description": "Catalog version string",
          "x-flatbuffer-type": "string"
        },
        "ASTROMETRY_ORIGIN": {
          "type": "string",
          "description": "Astrometry source description",
          "x-flatbuffer-type": "string"
        },
        "STAR_EPOCH": {
          "type": "number",
          "description": "Epoch of stellar position (Julian years)",
          "x-flatbuffer-type": "double"
        },
        "RA": {
          "type": "number",
          "description": "Right ascension (degrees, ICRS)",
          "x-flatbuffer-type": "double"
        },
        "RA_UNC": {
          "type": "number",
          "description": "Right ascension uncertainty (arcseconds)",
          "x-flatbuffer-type": "double"
        },
        "DEC": {
          "type": "number",
          "description": "Declination (degrees, ICRS)",
          "x-flatbuffer-type": "double"
        },
        "DEC_UNC": {
          "type": "number",
          "description": "Declination uncertainty (arcseconds)",
          "x-flatbuffer-type": "double"
        },
        "POS_UNC_FLAG": {
          "type": "boolean",
          "description": "True if position uncertainty is flagged",
          "x-flatbuffer-type": "bool"
        },
        "PARALLAX": {
          "type": "number",
          "description": "Parallax (milliarcseconds)",
          "x-flatbuffer-type": "double"
        },
        "PARALLAX_UNC": {
          "type": "number",
          "description": "Parallax uncertainty (milliarcseconds)",
          "x-flatbuffer-type": "double"
        },
        "PMRA": {
          "type": "number",
          "description": "Proper motion in RA (milliarcseconds/year)",
          "x-flatbuffer-type": "double"
        },
        "PMRA_UNC": {
          "type": "number",
          "description": "Proper motion in RA uncertainty (milliarcseconds/year)",
          "x-flatbuffer-type": "double"
        },
        "PMDEC": {
          "type": "number",
          "description": "Proper motion in DEC (milliarcseconds/year)",
          "x-flatbuffer-type": "double"
        },
        "PMDEC_UNC": {
          "type": "number",
          "description": "Proper motion in DEC uncertainty (milliarcseconds/year)",
          "x-flatbuffer-type": "double"
        },
        "PM_UNC_FLAG": {
          "type": "boolean",
          "description": "True if proper motion uncertainty is flagged",
          "x-flatbuffer-type": "bool"
        },
        "GMAG": {
          "type": "number",
          "description": "Broad-band G magnitude of the space astrometry photometric system",
          "x-flatbuffer-type": "double"
        },
        "GMAG_UNC": {
          "type": "number",
          "description": "G-band magnitude uncertainty",
          "x-flatbuffer-type": "double"
        },
        "BPMAG": {
          "type": "number",
          "description": "BP-band magnitude (blue prism photometer of the space astrometry system)",
          "x-flatbuffer-type": "double"
        },
        "BPMAG_UNC": {
          "type": "number",
          "description": "BP-band magnitude uncertainty",
          "x-flatbuffer-type": "double"
        },
