        "YES": {
          "value": 0
        },
        "NO": {
          "value": 1
        },
        "UNKNOWN": {
          "value": 2
        }
      }
    },
    "attitudeState": {
      "type": "object",
      "description": "Attitude State Data",
      "properties": {
        "ATT_TYPE": {
          "$ref": "#/definitions/attitudeStateType",
          "description": "Attitude state type",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "QUATERNION": {
              "value": 0
            },
            "EULER_ANGLES": {
              "value": 1
            },
            "SPIN": {
              "value": 2
            },
            "DIRECTION_COSINE": {
              "value": 3
            }
          }
        },
        "REF_FRAME_A": {
          "type": "string",
          "description": "Reference frame A",
          "x-flatbuffer-type": "string"
