      "x-flatbuffer-enum-type": "byte",
      "x-flatbuffer-enum-values": {
        "ANGLE": {
          "value": 0
        },
        "ANGLE_GYROBIAS": {
          "value": 1
        },
        "ANGLE_ANGVEL": {
          "value": 2
        },
        "QUATERNION_COV": {
          "value": 3
        }
      }
    },
    "maneuverableFlag": {
