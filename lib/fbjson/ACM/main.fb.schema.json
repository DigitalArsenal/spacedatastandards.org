        },
        "ANGLE_3": {
          "type": "number",
          "description": "Euler angle Z in degrees",
          "x-flatbuffer-type": "double"
        },
        "EULER_ROT_SEQ": {
          "type": "string",
          "description": "Euler rotation sequence (e.g., 321, 313)",
          "x-flatbuffer-type": "string"
        },
        "ANGVEL_X": {
          "type": "number",
          "description": "Angular velocity X in deg/s",
          "x-flatbuffer-type": "double"
        },
        "ANGVEL_Y": {
          "type": "number",
          "description": "Angular velocity Y in deg/s",
          "x-flatbuffer-type": "double"
        },
        "ANGVEL_Z": {
          "type": "number",
          "description": "Angular velocity Z in deg/s",
          "x-flatbuffer-type": "double"
        },
        "SPIN_ALPHA": {
          "type": "number",
          "description": "Spin alpha in degrees",
          "x-flatbuffer-type": "double"
        },
        "SPIN_DELTA": {
          "type": "number",
          "description": "Spin delta in degrees",
          "x-flatbuffer-type": "double"
        },
        "SPIN_ANGLE": {
          "type": "number",
          "description": "Spin angle in degrees",
          "x-flatbuffer-type": "double"
        },
        "SPIN_ANGLE_VEL": {
          "type": "number",
          "description": "Spin angle velocity in deg/s",
          "x-flatbuffer-type": "double"
        },
        "NUTATION": {
          "type": "number",
          "description": "Nutation angle in degrees",
          "x-flatbuffer-type": "double"
        },
        "NUTATION_PERIOD": {
          "type": "number",
          "description": "Nutation period in seconds",
          "x-flatbuffer-type": "double"
        },
        "NUTATION_PHASE": {
          "type": "number",
          "description": "Nutation phase in degrees",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "attPhysicalProperties": {
      "type": "object",
      "description": "Attitude Physical Characteristics",
      "properties": {
        "DRAG_COEFF": {
          "type": "number",
          "description": "Drag coefficient",
          "x-flatbuffer-type": "double"
        },
        "WET_MASS": {
          "type": "number",
          "description": "Wet mass in kg",
          "x-flatbuffer-type": "double"
        },
        "DRY_MASS": {
          "type": "number",
          "description": "Dry mass in kg",
          "x-flatbuffer-type": "double"
        },
        "CP_REF_FRAME": {
          "type": "string",
          "description": "Center of pressure reference frame",
          "x-flatbuffer-type": "string"
        },
        "CP_X": {
          "type": "number",
          "description": "Center of pressure X in m",
          "x-flatbuffer-type": "double"
        },
        "CP_Y": {
          "type": "number",
          "description": "Center of pressure Y in m",
          "x-flatbuffer-type": "double"
        },
        "CP_Z": {
          "type": "number",
          "description": "Center of pressure Z in m",
          "x-flatbuffer-type": "double"
        },
        "INERTIA_REF_FRAME": {
          "type": "string",
          "description": "Inertia reference frame",
          "x-flatbuffer-type": "string"
        },
        "IXX": {
          "type": "number",
          "description": "Moment of inertia about X axis in kg*m^2",
          "x-flatbuffer-type": "double"
        },
        "IYY": {
          "type": "number",
          "description": "Moment of inertia about Y axis in kg*m^2",
          "x-flatbuffer-type": "double"
        },
        "IZZ": {
          "type": "number",
          "description": "Moment of inertia about Z axis in kg*m^2",
          "x-flatbuffer-type": "double"
        },
        "IXY": {
          "type": "number",
          "description": "Product of inertia XY in kg*m^2",
          "x-flatbuffer-type": "double"
        },
        "IXZ": {
          "type": "number",
          "description": "Product of inertia XZ in kg*m^2",
          "x-flatbuffer-type": "double"
        },
        "IYZ": {
          "type": "number",
          "description": "Product of inertia YZ in kg*m^2",
          "x-flatbuffer-type": "double"
        },
        "COMMENT": {
          "type": "string",
          "description": "COMMENT lines of the physical characteristics block (CCSDS 504.0-B-2),\njoined by a line feed.",
          "x-flatbuffer-type": "string"
        }
      },
      "additionalProperties": false
    },
    "attCovariance": {
      "type": "object",
      "description": "Attitude Covariance",
      "properties": {
        "COV_TYPE": {
          "$ref": "#/definitions/attCovType",
          "description": "Covariance type",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "ANGLE": {
              "value": 0
            },
            "ANGLE_GYROBIAS": {
              "value": 1
            },
            "ANGLE_ANGVEL": {
              "value": 2
            },
            "QUATERNION_COV": {
              "value": 3
            }
          }
        },
        "COV_REF_FRAME": {
          "type": "string",
          "description": "Reference frame",
          "x-flatbuffer-type": "string"
        },
        "EPOCH": {
          "type": "string",
          "description": "Epoch (ISO 8601)",
          "x-flatbuffer-type": "string"
        },
        "COV": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Upper-triangular covariance matrix elements (row-major)",
          "x-flatbuffer-type": "[double]"
        }
      },
      "additionalProperties": false
    },
    "attManeuver": {
      "type": "object",
      "description": "Attitude Maneuver",
      "properties": {
        "MAN_EPOCH_START": {
          "type": "string",
          "description": "Maneuver epoch start (ISO 8601)",
          "x-flatbuffer-type": "string"
        },
        "DURATION": {
          "type": "number",
          "description": "Duration in seconds",
          "x-flatbuffer-type": "double"
        },
        "REF_FRAME": {
          "type": "string",
          "description": "Reference frame",
          "x-flatbuffer-type": "string"
        },
        "TOR_1": {
          "type": "number",
          "description": "Torque about body X in N*m",
          "x-flatbuffer-type": "double"
        },
        "TOR_2": {
          "type": "number",
          "description": "Torque about body Y in N*m",
          "x-flatbuffer-type": "double"
        },
        "TOR_3": {
          "type": "number",
          "description": "Torque about body Z in N*m",
          "x-flatbuffer-type": "double"
        }
      },
      "additionalProperties": false
    },
    "ACM": {
      "type": "object",
      "description": "Attitude Comprehensive Message",
      "properties": {
        "CCSDS_ACM_VERS": {
          "type": "string",
          "description": "CCSDS ACM version",
          "x-flatbuffer-type": "string"
        },
        "CREATION_DATE": {
          "type": "string",
          "description": "Message creation date (ISO 8601)",
          "x-flatbuffer-type": "string"
        },
        "ORIGINATOR": {
          "type": "string",
          "description": "Creating organization",
          "x-flatbuffer-type": "string"
        },
        "OBJECT_NAME": {
          "type": "string",
          "description": "Object name",
          "x-flatbuffer-type": "string"
        },
        "OBJECT_ID": {
          "type": "string",
          "description": "International designator",
          "x-flatbuffer-type": "string"
        },
        "CATALOG_NAME": {
          "type": "string",
          "description": "Catalog name",
          "x-flatbuffer-type": "string"
        },
        "EPOCH": {
          "type": "string",
          "description": "Epoch of state (ISO 8601)",
          "x-flatbuffer-type": "string"
        },
        "TIME_SYSTEM": {
          "type": "string",
          "description": "Time system",
          "x-flatbuffer-type": "string"
        },
        "ATT_STATES": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attitudeState"
          },
          "description": "Attitude states",
          "x-flatbuffer-type": "[attitudeState]"
        },
        "PHYS_PROPERTIES": {
          "$ref": "#/definitions/attPhysicalProperties",
          "description": "Physical properties",
          "x-flatbuffer-type": "attPhysicalProperties"
        },
        "COV_DATA": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attCovariance"
          },
          "description": "Attitude covariance data",
          "x-flatbuffer-type": "[attCovariance]"
        },
        "MANEUVERS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attManeuver"
          },
          "description": "Attitude maneuvers",
          "x-flatbuffer-type": "[attManeuver]"
        },
        "MANEUVERABLE": {
          "$ref": "#/definitions/maneuverableFlag",
          "description": "Maneuverability status",
          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "byte",
          "x-flatbuffer-enum-values": {
            "YES": {
              "value": 0
            },
            "NO": {
              "value": 1
            },
            "UNKNOWN": {
              "value": 2
            }
          }
        },
        "COMMENT": {
          "type": "string",
          "description": "COMMENT lines of the message header, metadata and user-defined data\n(CCSDS 504.0-B-2), in message order, joined by a line feed. A time history,\ncovariance, maneuver or determination block's own comments stay with it.",
          "x-flatbuffer-type": "string"
        },
        "CLASSIFICATION": {
          "type": "string",
          "description": "CLASSIFICATION of the message: the optional header keyword stating its\nsecurity classification or handling caveat.",
          "x-flatbuffer-type": "string"
        },
        "MESSAGE_ID": {
          "type": "string",
          "description": "MESSAGE_ID: the optional header keyword, an identifier the originator makes\nunique for this message.",
          "x-flatbuffer-type": "string"
        },
        "OBJECT_DESIGNATOR": {
          "type": "string",
          "description": "OBJECT_DESIGNATOR (CCSDS 504.0-B-2): the object's identifier in CATALOG_NAME.\nOBJECT_ID above holds the INTERNATIONAL_DESIGNATOR of the message and EPOCH\nabove its EPOCH_TZERO, the epoch every relative time is measured from.",
          "x-flatbuffer-type": "string"
        },
        "ORIGINATOR_POC": {
          "type": "string",
          "description": "ORIGINATOR_POC: point of contact at the originator.",
          "x-flatbuffer-type": "string"
        },
        "ORIGINATOR_POSITION": {
          "type": "string",
          "description": "ORIGINATOR_POSITION: position of the point of contact.",
          "x-flatbuffer-type": "string"
        },
        "ORIGINATOR_PHONE": {
          "type": "string",
          "description": "ORIGINATOR_PHONE: telephone number of the point of contact.",
          "x-flatbuffer-type": "string"
        },
        "ORIGINATOR_EMAIL": {
          "type": "string",
          "description": "ORIGINATOR_EMAIL: email address of the point of contact.",
          "x-flatbuffer-type": "string"
        },
        "ORIGINATOR_ADDRESS": {
          "type": "string",
          "description": "ORIGINATOR_ADDRESS: postal address of the point of contact.",
          "x-flatbuffer-type": "string"
        },
        "ODM_MSG_LINK": {
          "type": "string",
          "description": "ODM_MSG_LINK: the identifier of the Orbit Data Message this attitude goes with.",
          "x-flatbuffer-type": "string"
        },
        "CENTER_NAME": {
          "type": "string",
          "description": "CENTER_NAME: the orbit center, when the message states one.",
          "x-flatbuffer-type": "string"
        },
        "ACM_DATA_ELEMENTS": {
          "type": "string",
          "description": "ACM_DATA_ELEMENTS: comma-separated list of the data blocks the message holds.",
          "x-flatbuffer-type": "string"
        },
        "START_TIME": {
          "type": "string",
          "description": "START_TIME: start of the total time span the message covers.",
          "x-flatbuffer-type": "string"
        },
        "STOP_TIME": {
          "type": "string",
          "description": "STOP_TIME: end of the total time span the message covers.",
          "x-flatbuffer-type": "string"
        },
        "TAIMUTC_AT_TZERO": {
          "type": "number",
          "description": "TAIMUTC_AT_TZERO in seconds, NaN when not stated.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "NEXT_LEAP_EPOCH": {
          "type": "string",
          "description": "NEXT_LEAP_EPOCH: epoch of the next leap second after EPOCH_TZERO.",
          "x-flatbuffer-type": "string"
        },
        "NEXT_LEAP_TAIMUTC": {
          "type": "number",
          "description": "NEXT_LEAP_TAIMUTC in seconds, NaN when not stated.",
          "x-flatbuffer-type": "double",
          "x-flatbuffer-default": "nan"
        },
        "ATT_BLOCKS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ACMAttitudeBlock"
          },
          "description": "Attitude state time histories (ATT_START blocks), in message order.",
          "x-flatbuffer-type": "[ACMAttitudeBlock]"
        },
        "COV_BLOCKS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ACMCovarianceBlock"
          },
          "description": "Covariance time histories (COV_START blocks), in message order.",
          "x-flatbuffer-type": "[ACMCovarianceBlock]"
        },
        "MAN_BLOCKS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ACMManeuverBlock"
          },
          "description": "Maneuver specifications (MAN_START blocks), in message order.",
          "x-flatbuffer-type": "[ACMManeuverBlock]"
        },
        "DETERMINATION": {
          "$ref": "#/definitions/ACMDetermination",
          "description": "The attitude determination data (AD_START block), when the message has them.",
          "x-flatbuffer-type": "ACMDetermination"
        },
        "USER_DEFINED_PARAMETERS": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ACMUserDefinedParameter"
          },
          "description": "Every USER_DEFINED parameter of the message, in message order.",
          "x-flatbuffer-type": "[ACMUserDefinedParameter]"
        }
      },
      "additionalProperties": false
    },
    "ACMAttitudeBlock": {
      "type": "object",
      "description": "One attitude state time history of an ACM (CCSDS 504.0-B-2 Table 5-4): the\nblock's keywords, then its data lines as TIMES (the first column of each line,\nelapsed seconds from EPOCH_TZERO or an epoch, as written) and VALUES (the other\ncolumns, NUMBER_STATES per line, row by row).",
      "properties": {
        "COMMENT": {
          "type": "string",
          "description": "COMMENT lines of this block, joined by a line feed.",
          "x-flatbuffer-type": "string"
        },
        "ATT_ID": {
          "type": "string",
          "description": "ATT_ID.",
          "x-flatbuffer-type": "string"
        },
        "ATT_PREV_ID": {
          "type": "string",
          "description": "ATT_PREV_ID.",
          "x-flatbuffer-type": "string"
        },
        "ATT_BASIS": {
          "type": "string",
          "description": "ATT_BASIS: PREDICTED, DETERMINED_GND, DETERMINED_OBC or SIMULATED.",
          "x-flatbuffer-type": "string"
        },
        "ATT_BASIS_ID": {
          "type": "string",
          "description": "ATT_BASIS_ID.",
          "x-flatbuffer-type": "string"
        },
        "REF_FRAME_A": {
          "type": "string",
          "description": "REF_FRAME_A: the frame the transformation starts from.",
          "x-flatbuffer-type": "string"
        },
        "REF_FRAME_B": {
          "type": "string",
          "description": "REF_FRAME_B: the frame the transformation ends in.",
          "x-flatbuffer-type": "string"
        },
        "NUMBER_STATES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "NUMBER_STATES: the data columns on each line (attitude, then rate).",
          "x-flatbuffer-type": "uint"
        },
        "ATT_TYPE": {
          "type": "string",
          "description": "ATT_TYPE: QUATERNION, EULER_ANGLES, DCM or ANGVEL.",
          "x-flatbuffer-type": "string"
        },
        "EULER_ROT_SEQ": {
          "type": "string",
          "description": "EULER_ROT_SEQ, when ATT_TYPE is EULER_ANGLES.",
          "x-flatbuffer-type": "string"
        },
        "RATE_TYPE": {
          "type": "string",
          "description": "RATE_TYPE: ANGVEL, Q_DOT, EULER_RATE or GYRO_BIAS, when the lines carry rates.",
          "x-flatbuffer-type": "string"
        },
        "TIMES": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The first column of each data line, as written.",
          "x-flatbuffer-type": "[string]"
        },
        "VALUES": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The other columns of the data lines, NUMBER_STATES per line.",
          "x-flatbuffer-type": "[double]"
        }
      },
      "additionalProperties": false
    },
    "ACMCovarianceBlock": {
      "type": "object",
      "description": "One covariance time history of an ACM (Table 5-6): the diagonal terms of the\ncovariance on each line, as TIMES and VALUES like ACMAttitudeBlock; every line\nhas the same number of values.",
      "properties": {
        "COMMENT": {
          "type": "string",
          "description": "COMMENT lines of this block, joined by a line feed.",
          "x-flatbuffer-type": "string"
        },
        "COV_ID": {
          "type": "string",
          "description": "COV_ID.",
          "x-flatbuffer-type": "string"
        },
        "COV_PREV_ID": {
          "type": "string",
          "description": "COV_PREV_ID.",
          "x-flatbuffer-type": "string"
        },
        "COV_BASIS": {
          "type": "string",
          "description": "COV_BASIS.",
          "x-flatbuffer-type": "string"
        },
        "COV_BASIS_ID": {
          "type": "string",
          "description": "COV_BASIS_ID.",
          "x-flatbuffer-type": "string"
        },
        "COV_REF_FRAME": {
          "type": "string",
          "description": "COV_REF_FRAME.",
          "x-flatbuffer-type": "string"
        },
        "COV_TYPE": {
          "type": "string",
          "description": "COV_TYPE: ANGLE, ANGLE_GYROBIAS, ANGLE_ANGVEL, QUATERNION, QUATERNION_GYROBIAS\nor QUATERNION_ANGVEL.",
          "x-flatbuffer-type": "string"
        },
        "TIMES": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The first column of each data line, as written.",
          "x-flatbuffer-type": "[string]"
        },
        "VALUES": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The diagonal terms of each line, row by row.",
          "x-flatbuffer-type": "[double]"
        }
      },
      "additionalProperties": false
    },
    "ACMManeuverBlock": {
      "type": "object",
      "description": "One maneuver specification of an ACM (Table 5-7).",
      "properties": {
        "COMMENT": {
          "type": "string",
          "description": "COMMENT lines of this block, joined by a line feed.",
          "x-flatbuffer-type": "string"
        },
        "MAN_ID": {
          "type": "string",
          "description": "MAN_ID.",
          "x-flatbuffer-type": "string"
        },
        "MAN_PREV_ID": {
          "type": "string",
          "description": "MAN_PREV_ID.",
          "x-flatbuffer-type": "string"
        },
        "MAN_PURPOSE": {
          "type": "string",
          "description": "MAN_PURPOSE: for example MOM_DESAT.",
          "x-flatbuffer-type": "string"
        },
        "MAN_BEGIN_TIME": {
          "type": "number",
          "description": "MAN_BEGIN_TIME in seconds from EPOCH_TZERO.",
          "x-flatbuffer-type": "double"
        },
        "MAN_END_TIME": {
          "type": "number",
