{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "phbSpectralRegime": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "GAMMA_RAY",
        "HARD_X_RAY",
        "SOFT_X_RAY",
        "EXTREME_ULTRAVIOLET",
        "FAR_ULTRAVIOLET",
        "NEAR_ULTRAVIOLET",
        "VISIBLE",
        "NEAR_INFRARED",
        "MID_INFRARED",
        "FAR_INFRARED",
        "SUBMILLIMETRE",
        "MICROWAVE",
        "RADIO"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0
        },
        "GAMMA_RAY": {
          "value": 1,
          "description": "Photon energy above 100 keV (wavelength below 0.0124 nm)."
        },
        "HARD_X_RAY": {
          "value": 2,
          "description": "10 keV to 100 keV (0.0124 nm to 0.124 nm)."
        },
        "SOFT_X_RAY": {
          "value": 3,
          "description": "0.1 keV to 10 keV (0.124 nm to 12.4 nm)."
        },
        "EXTREME_ULTRAVIOLET": {
          "value": 4,
          "description": "12.4 nm to 91.2 nm."
        },
        "FAR_ULTRAVIOLET": {
          "value": 5,
          "description": "91.2 nm to 200 nm."
        },
        "NEAR_ULTRAVIOLET": {
          "value": 6,
          "description": "200 nm to 380 nm."
        },
        "VISIBLE": {
          "value": 7,
          "description": "380 nm to 750 nm."
        },
        "NEAR_INFRARED": {
          "value": 8,
          "description": "0.75 um to 5 um."
        },
        "MID_INFRARED": {
          "value": 9,
          "description": "5 um to 40 um."
        },
        "FAR_INFRARED": {
          "value": 10,
          "description": "40 um to 350 um."
        },
        "SUBMILLIMETRE": {
          "value": 11,
          "description": "350 um to 1 mm."
        },
        "MICROWAVE": {
          "value": 12,
          "description": "1 mm to 10 cm (3 GHz to 300 GHz)."
        },
        "RADIO": {
          "value": 13,
          "description": "Longer than 10 cm (below 3 GHz)."
        }
      }
    },
    "phbMagnitudeSystem": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "VEGA",
        "AB",
        "ST",
        "INSTRUMENTAL",
        "NOT_A_MAGNITUDE"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0
        },
        "VEGA": {
          "value": 1,
          "description": "Zero magnitude is the flux of the standard A0 V reference star."
        },
        "AB": {
          "value": 2,
          "description": "Zero magnitude is a flux density of 3631 Jy per unit frequency."
        },
        "ST": {
          "value": 3,
          "description": "Zero magnitude is a flux density of 3.631e-9 erg s-1 cm-2 A-1 per unit wavelength."
        },
        "INSTRUMENTAL": {
          "value": 4,
          "description": "Instrument-specific system; ZERO_POINT_JY states the calibration."
        },
        "NOT_A_MAGNITUDE": {
          "value": 5,
          "description": "The value is not a magnitude (a flux, a count rate, a temperature)."
        }
      }
    },
    "phbQuantity": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "MAGNITUDE",
        "FLUX_DENSITY_JY",
        "ENERGY_FLUX_W_PER_M2",
        "PHOTON_FLUX_PER_M2_S",
        "COUNT_RATE_PER_S",
        "BRIGHTNESS_TEMPERATURE_K"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0
        },
        "MAGNITUDE": {
          "value": 1,
          "description": "Magnitude in the band's SYSTEM."
        },
        "FLUX_DENSITY_JY": {
          "value": 2,
          "description": "Spectral flux density per unit frequency, janskys (1e-26 W m-2 Hz-1)."
        },
        "ENERGY_FLUX_W_PER_M2": {
          "value": 3,
          "description": "Band-integrated energy flux, W m-2."
        },
        "PHOTON_FLUX_PER_M2_S": {
          "value": 4,
          "description": "Band-integrated photon flux, photons m-2 s-1."
        },
        "COUNT_RATE_PER_S": {
          "value": 5,
          "description": "Detected count rate of the stated instrument, counts s-1."
        },
        "BRIGHTNESS_TEMPERATURE_K": {
          "value": 6,
          "description": "Brightness temperature, kelvin."
        }
      }
    },
    "phbDerivation": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "MEASURED",
        "TRANSFORMED",
        "MODELLED"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "UNSPECIFIED": {
          "value": 0
        },
        "MEASURED": {
          "value": 1,
          "description": "Observed in this band."
        },
        "TRANSFORMED": {
          "value": 2,
          "description": "Converted from a measurement in another band or system by a stated transformation."
        },
        "MODELLED": {
          "value": 3,
          "description": "Synthesised from a spectral energy distribution or a model atmosphere; never observed in this band."
        }
      }
    },
    "phbBoundKind": {
      "type": "string",
      "enum": [
        "DETECTION",
        "UPPER_LIMIT",
        "LOWER_LIMIT"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "DETECTION": {
          "value": 0,
          "description": "A detection: VALUE is the measured brightness."
        },
        "UPPER_LIMIT": {
          "value": 1,
          "description": "Not detected: the source is fainter than VALUE (a flux upper limit, a magnitude lower bound)."
        },
        "LOWER_LIMIT": {
          "value": 2,
          "description": "Saturated or confused: the source is at least as bright as VALUE."
        }
      }
    },
    "csoSourceClass": {
      "type": "string",
      "enum": [
        "UNSPECIFIED",
        "UNIDENTIFIED",
        "X_RAY_BINARY",
        "CATACLYSMIC_VARIABLE",
