    "csoAlertStage": {
      "type": "string",
      "enum": [
        "NONE",
        "PRELIMINARY",
        "INITIAL",
        "UPDATE",
        "RETRACTED"
      ],
      "x-flatbuffer-type": "enum",
      "x-flatbuffer-enum-type": "ubyte",
      "x-flatbuffer-enum-values": {
        "NONE": {
          "value": 0,
          "description": "Not an alert: a catalogue entry."
