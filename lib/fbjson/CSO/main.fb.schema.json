        "MAGNETAR",
        "SUPERNOVA_REMNANT",
        "PULSAR_WIND_NEBULA",
        "ACTIVE_GALACTIC_NUCLEUS",
        "BLAZAR",
        "QUASAR",
        "GALAXY",
        "GALAXY_CLUSTER",
        "GLOBULAR_CLUSTER",
        "OPEN_CLUSTER",
        "EMISSION_NEBULA",
        "PLANETARY_NEBULA",
        "MOLECULAR_CLOUD",
        "GAMMA_RAY_BURST",
        "SUPERNOVA",
        "NOVA",
        "KILONOVA",
