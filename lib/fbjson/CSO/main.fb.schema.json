            },
            "FAR_ULTRAVIOLET": {
              "value": 5,
              "description": "91.2 nm to 200 nm."
            },
            "NEAR_ULTRAVIOLET": {
              "value": 6,
              "description": "200 nm to 380 nm."
            },
            "VISIBLE": {
              "value": 7,
              "description": "380 nm to 750 nm."
            },
            "NEAR_INFRARED": {
              "value": 8,
              "description": "0.75 um to 5 um."
