          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "MEASURED": {
              "value": 1,
              "description": "Observed in this band."
            },
            "TRANSFORMED": {
              "value": 2,
