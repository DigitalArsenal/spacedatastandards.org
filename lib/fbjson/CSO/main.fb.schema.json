          "x-flatbuffer-type": "enum",
          "x-flatbuffer-enum-type": "ubyte",
          "x-flatbuffer-enum-values": {
            "UNSPECIFIED": {
              "value": 0
            },
            "VEGA": {
              "value": 1,
              "description": "Zero magnitude is the flux of the standard A0 V reference star."
            },
            "AB": {
              "value": 2,
              "description": "Zero magnitude is a flux density of 3631 Jy per unit frequency."
