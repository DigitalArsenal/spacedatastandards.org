# Refuse to commit an unresolved merge conflict block or an unparseable JSON
# file. 2026-08-27: a stash pop during a merge put conflict markers into
# dist/manifest.json and 54 other tracked files; Pages served it and the schema
# registry rendered nothing for hours.
node scripts/check-release-integrity.mjs --staged

# Detect case-insensitive name collisions in FlatBuffer schemas
node scripts/checkSchemaCasing.js

# Refuse any non-append change to the wire-frozen RecordType union ordinals
node scripts/checkRecordTypeOrdinals.mjs

# Refuse enum/union members named MIN or MAX (flatc sentinel collision)
node scripts/checkReservedEnumNames.mjs

# Update schema list and count in index.html from manifest
node scripts/updateSchemaList.cjs
node scripts/updateSchemaCount.cjs

# If index.html was modified, add it to the commit
git diff --quiet index.html || git add index.html
