// Hash: b4e03e434a6d3e5d9b864939985996c05a742bb5efa7ee6f53f847592011b64a
// Version: 0.0.6
// -----------------------------------END_HEADER
include "../PHB/main.fbs";

/// How a star's distance was estimated.
/// Append new values only; never reorder or reuse existing values.
enum strDistanceEstimator : ubyte {
  /// No distance; DISTANCE_PC, DISTANCE_LO_PC and DISTANCE_HI_PC are NaN.
  UNSPECIFIED = 0,
  /// Geometric distance: the median of the posterior from the parallax under a
  /// direction-dependent prior (Bailer-Jones et al. 2021, AJ 161, 147).
  BAILER_JONES_2021_GEO = 1,
  /// Photogeometric distance: the geometric posterior further constrained by the
  /// star's color and magnitude (Bailer-Jones et al. 2021, AJ 161, 147).
  BAILER_JONES_2021_PHOTOGEO = 2,
  /// Mode of the posterior from the parallax under the exponentially decreasing
  /// space density prior with its length scale (Bailer-Jones 2015, PASP 127, 994).
  EDSD_POSTERIOR = 3,
  /// Inverse parallax, DISTANCE_PC = 1000 / PARALLAX; meaningful only when the
  /// fractional parallax uncertainty is small.
  PARALLAX_INVERSE = 4
}

/// Star Catalog Entry
table STR {
  /// Unique internal identifier
  ID:string;
  /// Community satellite-tracking star catalog identifier
  CS_ID:long;
  /// GNC star catalog identifier
  GNC_CAT_ID:uint32;
  /// Source identifier (source_id) in the third data release of the all-sky space astrometry
  /// survey; 0 when the star has no match in that release
  GAIA_DR3_SOURCE_ID:ulong;
  /// Identifier in the first space astrometry mission's main catalog
  HIP_CAT_ID:uint32;
  /// Catalog version string
  CAT_VERSION:string;
  /// Astrometry source description
  ASTROMETRY_ORIGIN:string;
  /// Epoch of stellar position (Julian years)
  STAR_EPOCH:double;
  /// Right ascension (degrees, ICRS)
  RA:double;
  /// Right ascension uncertainty (arcseconds)
  RA_UNC:double;
  /// Declination (degrees, ICRS)
  DEC:double;
  /// Declination uncertainty (arcseconds)
  DEC_UNC:double;
  /// True if position uncertainty is flagged
  POS_UNC_FLAG:bool;
  /// Parallax (milliarcseconds)
  PARALLAX:double;
  /// Parallax uncertainty (milliarcseconds)
  PARALLAX_UNC:double;
  /// Proper motion in RA (milliarcseconds/year)
  PMRA:double;
  /// Proper motion in RA uncertainty (milliarcseconds/year)
  PMRA_UNC:double;
  /// Proper motion in DEC (milliarcseconds/year)
  PMDEC:double;
  /// Proper motion in DEC uncertainty (milliarcseconds/year)
  PMDEC_UNC:double;
  /// True if proper motion uncertainty is flagged
  PM_UNC_FLAG:bool;
  /// Broad-band G magnitude of the space astrometry photometric system
  GMAG:double;
  /// G-band magnitude uncertainty
  GMAG_UNC:double;
  /// BP-band magnitude (blue prism photometer of the space astrometry system)
  BPMAG:double;
  /// BP-band magnitude uncertainty
  BPMAG_UNC:double;
  /// RP-band magnitude (red prism photometer of the space astrometry system)
  RPMAG:double;
  /// RP-band magnitude uncertainty
  RPMAG_UNC:double;
  /// Near-infrared J-band magnitude (1.25 um)
  JMAG:double;
  /// J-band magnitude uncertainty
  JMAG_UNC:double;
  /// Near-infrared Ks-band magnitude (2.17 um)
  KMAG:double;
  /// K-band magnitude uncertainty
  KMAG_UNC:double;
  /// Near-infrared H-band magnitude (1.65 um)
  HMAG:double;
  /// H-band magnitude uncertainty
  HMAG_UNC:double;
  /// True if star is variable
  VAR_FLAG:bool;
  /// True if star is in a multiple system
  MULT_FLAG:bool;
  /// Nearest neighbor catalog identifier
  NEIGHBOR_ID:uint32;
  /// True if nearest neighbor is within confusion radius
  NEIGHBOR_FLAG:bool;
  /// Distance to nearest neighbor (arcseconds)
  NEIGHBOR_DISTANCE:double;
  /// True if position shift detected between catalogs
  SHIFT_FLAG:bool;
  /// Position shift magnitude (arcseconds)
  SHIFT:double;

  // Appended 2026-09-25: physical parameters, names and multi-band photometry.
  // Every scalar below defaults to NaN: absent means unknown, never zero.

  /// Effective temperature (kelvin)
  TEFF:double = nan;
  /// Effective temperature uncertainty (kelvin)
  TEFF_UNC:double = nan;
  /// Surface gravity, log10 of g in cm s^-2
  LOGG:double = nan;
  /// Surface gravity uncertainty (dex)
  LOGG_UNC:double = nan;
  /// Metallicity [M/H] (dex)
  METALLICITY:double = nan;
  /// Interstellar extinction at 541.4 nm, A0 (magnitudes)
  EXTINCTION_A0:double = nan;
  /// Radial velocity, positive receding (km/s)
  RADIAL_VELOCITY:double = nan;
  /// Radial velocity uncertainty (km/s)
  RADIAL_VELOCITY_UNC:double = nan;
  /// Spectral type in the MK system, e.g. "A1 V"
  SPECTRAL_TYPE:string;
  /// Proper name as recognized by the astronomical naming authority
  PROPER_NAME:string;
  /// Bayer or Flamsteed designation with its constellation, e.g. "alf CMa" or "9 CMa"
  BAYER_FLAMSTEED:string;
  /// Constellation containing the star, three-letter abbreviation
  CONSTELLATION:string;
  /// Bright-star catalog number (HR); 0 when not in that catalog
  HR_CAT_ID:uint32;
  /// Spectral-type catalog number (HD); 0 when not in that catalog
  HD_CAT_ID:uint32;
  /// Other designations, each in the form its catalog uses
  DESIGNATIONS:[string];
  /// Variability type in the standard variable-star classification, e.g. "DSCT" or "EA"
  VARIABILITY_CLASS:string;
  /// Period of variability (days)
  VARIABILITY_PERIOD:double = nan;
  /// Peak-to-peak variability amplitude (magnitudes)
  VARIABILITY_AMPLITUDE:double = nan;
  /// Epoch of maximum light (or minimum, for eclipsing systems), Modified Julian Date (TT)
  VARIABILITY_EPOCH:double = nan;
  /// Brightness in every band the star was measured or modeled in
  PHOTOMETRY:[PHBMeasurement];

  // Appended 2026-10-18: distance. DISTANCE_METHOD names the estimator; a
  // distance is never derived from PARALLAX unless it says PARALLAX_INVERSE.

  /// Distance from the Sun (parsecs): the posterior median, or the mode for
  /// EDSD_POSTERIOR, as DISTANCE_METHOD states
  DISTANCE_PC:double = nan;
  /// Lower bound of the distance (parsecs): the 16th percentile of the posterior
  /// for BAILER_JONES_2021_GEO and BAILER_JONES_2021_PHOTOGEO, the lower edge of
  /// the 68% highest-density interval for EDSD_POSTERIOR, and
  /// 1000 / (PARALLAX + PARALLAX_UNC) for PARALLAX_INVERSE
  DISTANCE_LO_PC:double = nan;
  /// Upper bound of the distance (parsecs): the 84th percentile, the upper edge of
  /// the 68% highest-density interval, or 1000 / (PARALLAX - PARALLAX_UNC), as for
  /// DISTANCE_LO_PC; NaN when unbounded
  DISTANCE_HI_PC:double = nan;
  /// Estimator that produced DISTANCE_PC, DISTANCE_LO_PC and DISTANCE_HI_PC
  DISTANCE_METHOD:strDistanceEstimator = UNSPECIFIED;
  /// Bibliographic code of the distance catalog or method, e.g. "2021AJ....161..147B"
  DISTANCE_REF:string;
}

root_type STR;
file_identifier "$STR";