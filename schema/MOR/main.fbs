// Hash: f2e20234ccf2862f9ccaeb7bb0bf5c5cea4d6581ea15825bff53358fc20d26e9
// Version: 1.285.0
// -----------------------------------END_HEADER
include "../MET/main.fbs";
include "../CVR/main.fbs";
include "../MPE/main.fbs";

// Minimum Orbit Record (MOR)
// Description
// One mean element set with only what a propagator needs to fly it: the minimum $OCM, as $MPE is the
// minimum $OMM. Numbers and enums, no text a reader compares; the fixed parts of an $OCM element set
// (center, frames, averaging, units, covariance labels) follow from the fields below and are stated by
// the expansion rule, never repeated per record.
//
// Validity: WINDOWS are in time order, do not overlap, and every EPOCH_HALF_SPAN is above 0; a record carries
// COV_REALISM_ID or COV_REALISM, never both; FALLBACK has no ENTITY_ID and no TARGETER. A reader refuses a
// record that breaks these.
//
// Record kinds (RECORD_KIND): FULL, a whole set; ROWS_ONLY, new rows for a held set. A reader that meets a
// kind it does not know ignores that record entirely and changes nothing it holds; it never reads it as FULL.
//
// Expansion: every FULL record expands to exactly one $OCM; no other kind has an expansion.
//   HEADER: CCSDS_OCM_VERS "3.0"; ORIGINATOR and MESSAGE_STATUS as here (absent when absent).
//   METADATA: OBJECT_NAME and INTERNATIONAL_DESIGNATOR as here; with NORAD_CAT_ID > 0 the NORAD_CAT_ID,
//     CATALOG_NAME "NORAD" and OBJECT_DESIGNATOR its decimal digits; TIME_SYSTEM "UTC".
//   CENTER_NAME "EARTH". ORB_AVERAGING "KOZAI" for SGP4, "BROUWER" for SGP4XP and AP.
//   TRAJ_REF_FRAME, and COV_REF_FRAME when COVARIANCE_DATA is present: for AP with a degree cap above 0,
//     RFM CustomFrameWrapper TEMEOFEPOCH with NAME "TEMEOFEPOCH", and TRAJ_FRAME_EPOCH the EPOCH text;
//     otherwise RFM CelestialFrameWrapper TEMEOFDATE with NAME "TEMEOFDATE" and no TRAJ_FRAME_EPOCH.
//   MEAN_ELEMENTS: MEAN_ELEMENT_THEORY, the elements and their drag and radiation terms as here; EPOCH
//     the text of EPOCH_UNIX_US, "YYYY-MM-DDTHH:MM:SS.ffffff" (26 characters, six fraction digits, no zone).
//   PERTURBATIONS: GRAVITY_MODEL the text of GRAVITY_FIELD; SOLID_TIDES_MODEL and SOLAR_RAD_PRESSURE the
//     texts of theirs (absent for NONE and UNSTATED); DENSITY_CORRECTION NONE. SGP4: WEATHER_SOURCE NONE,
//     no ATMOSPHERIC_MODEL, no degree caps. SGP4XP and AP: ATMOSPHERIC_MODEL {JXX, 1970}, WEATHER_SOURCE
//     THEORY_FLUX_MODEL, MAXIMUM_TESSERAL_DEGREE and MAXIMUM_ZONAL_DEGREE as here.
//   ORBIT_DETERMINATION, present when ACTUAL_OD_SPAN is a number, OD_PARAMETERS is not 0 or any of the five
//     values below is stated: ACTUAL_OD_SPAN; OD_OBSERVATIONS_USED and OD_TRACKS_USED (0 when not stated);
//     WEIGHTED_RMS (0 when not stated); OD_EPOCH the text of OD_EPOCH_UNIX_US (absent when not stated);
//     DAYS_SINCE_LAST_OBS;
//     OD_DYNAMIC_PARAMETERS one entry per bit of OD_PARAMETERS, ascending: PARAMETER the bit's
//     prwDynamicParameter, NAME its enum name, SOLVED_FOR its bit in OD_SOLVED_FOR, and VALUE and UNITS
//     BTERM "m**2/kg" (DRAG_AREA_OVER_MASS), AGOM "m**2/kg" (SRP_AREA_OVER_MASS), ECOM2_Y0 "m/s**2" (ECOM2_Y0).
//   The covariance, when COVARIANCE_DATA is present: COV_TYPE "CARTPV", COV_ORDERING LTM, COV_SIZE N,
//     COV_PARAMETER_KINDS the solved covariance parameters, ascending: DRAG_AREA_OVER_MASS and
//     SRP_AREA_OVER_MASS are the only ones OD_PARAMETERS can carry (an $OCM with a DRAG_AREA_OVER_MASS_RATE,
//     IN_TRACK_ACCELERATION or OUTGASSING_ACCELERATION row is outside the reducible profile); COV_PARAMETERS
//     their names, COV_UNITS "km" x3, "km/s" x3 and "m**2/kg" for each; COV_PROPAGATION, COV_CALIBRATION and
//     COV_CALIBRATION_REFERENCE as here; COV_REALISM [COV_REALISM], or [the REALISM of the asset's
//     COV_REALISM_MODELS entry whose ID is COV_REALISM_ID], or none when that model cannot be found: the
//     model's figures are then unresolved, and an expander says so; it never invents them.
//   PROVENANCE: the RECORD_PROVENANCE of the $DPM asset that carries the record. Without one, and with
//     COV_FLOOR MEAN_ELEMENTS_TWO_BODY, a PVN whose only field is PRODUCER
//     "com.spacedatanetwork.sdn-ap-propagator 0.6.39", the text that states that floor; absent otherwise.
//     COV_FLOOR governs the covariance's numbers. A record whose COV_FLOOR differs from the floor its
//     asset's RECORD_PROVENANCE.PRODUCER would state is read by its COV_FLOOR; an expander does not write it
//     as an $OCM (the $OCM could only state the other floor), and a publisher keeps such records out of
//     that asset.
//   DERIVED_EPHEMERIS, when WINDOWS is present: a $PPE with REFERENCE_EPOCH the EPOCH text, CENTER_NAME
//     "EARTH", REFERENCE_FRAME RFM CelestialFrameWrapper TEMEOFDATE, TIME_SYSTEM UTC, DEFAULT_BASIS_TYPE
//     CHEBYSHEV; BUILD the asset's DERIVED_BUILD with RECORD_DIGEST by the rule its BUILDER_NAME publishes,
//     whose first 8 bytes must be WINDOW_RECORD_CHECK (an expander without DERIVED_BUILD, that cannot
//     compute the digest, or whose digest does not match writes no DERIVED_EPHEMERIS); per served window a
//     PPEPositionRecord: EPOCH_MID_SECONDS and EPOCH_HALF_SPAN as here, EPOCH_MID its UTC text,
//     NUM_COEFFICIENTS the larger count, the shorter series padded with +0.0, the head counts as here,
//     HAS_VELOCITY_COEFFICIENTS when VEL_COEFF_COUNT > 0; per unserved window its midpoint, half-span and
//     status in UNSERVED_MID_SECONDS, UNSERVED_HALF_SPAN and UNSERVED_STATUS.
//   FALLBACK has no place in an $OCM: it expands to its own $MPE, ENTITY_ID the decimal NORAD_CAT_ID, or the
//     INTERNATIONAL_DESIGNATOR when NORAD_CAT_ID is 0. An $MPE has no originator: the set joins its object by
//     that identifier alone, with no originator, never by name.
//
// Rows only (RECORD_KIND ROWS_ONLY): a new set of rows for a set a receiver already holds, delivered without
// republishing the set. Required: NORAD_CAT_ID, INTERNATIONAL_DESIGNATOR and ORIGINATOR exactly as the held
// set states them (absent where it has none), MEAN_ELEMENT_THEORY, EPOCH_UNIX_US (the epoch of the set the rows
// belong to), WINDOWS, their coefficient vectors and WINDOW_RECORD_CHECK. Every other field is at its default:
// no elements, force settings, orbit determination, covariance, realism, fallback or descriptive fields. Such a
// record has no expansion and is never the result of a reduction. The receiver: identity, theory and epoch
// select exactly one set it holds; the record check it computes for that set equals WINDOW_RECORD_CHECK; the
// asset's DERIVED_BUILD is present and matches its own build statement. Then the update REPLACES all the
// set's windows at once, provided the update's last window ends later than the held rows' last window (or no
// rows are held); a repeated update, or one ending no later, changes nothing. On a missing or ambiguous
// match, a wrong check or an incompatible builder, the receiver changes nothing and the set takes its normal
// build path. A rows-only record never changes elements or covariance.
//
// Reduction: an $OCM reduces to a MOR only when every field it carries is carried here, equals what the
// expansion writes from the fields here, equals its asset's RECORD_PROVENANCE, or is in this list of
// descriptive fields no propagator reads, which a reduction drops: HEADER COMMENT, CREATION_DATE and
// MESSAGE_ID; METADATA COMMENT and the ORIGINATOR_ contact fields; every ORBIT_DETERMINATION field but
// ACTUAL_OD_SPAN, OD_DYNAMIC_PARAMETERS and the five above (fit statistics, the available observation and
// track counts, the recommended span, weighting, residuals); DERIVED_EPHEMERIS MAX_POSITION_RESIDUAL,
// RMS_POSITION_RESIDUAL and NOMINAL_ fields. Anything else (a maneuver, a state or covariance history,
// physical properties, a forecast or hand-over, seed sets, WEATHER_SOURCE RECORDS with its SPACE_WEATHER
// rows, NRLMSISE-00, which reads those rows, a density correction, CLASSIFICATION, an EXERCISE,
// user-defined parameters, a second COV_REALISM entry, a model text with no value here, an epoch in a leap
// second or finer than a microsecond) means the $OCM is not reducible: it travels as an $OCM, never as a
// MOR with the field dropped.

/// The ordinals and meanings of $OCM ocmMessageStatus (an EXERCISE needs EXERCISE_NAME and is not
/// reducible).
enum morMessageStatus : ubyte {
  /// Not stated.
  UNSPECIFIED = 0,
  /// Real data.
  REAL = 1,
  /// Test data.
  TEST = 2
}

/// Where the theory floor of COV_PROPAGATION sits, which decides how a reader takes the floor off the epoch
/// covariance and puts it back: the fact $OCM states through PROVENANCE.PRODUCER. Present with
/// COVARIANCE_DATA only. Append new values only.
enum morCovarianceFloor : ubyte {
  /// No covariance.
  UNSTATED = 0,
  /// At the writer's own theory state: PRODUCER anything but the text MEAN_ELEMENTS_TWO_BODY names. A
  /// reader of AP sets does not use this covariance (its states fly).
  WRITER_THEORY_STATE = 1,
  /// At the two-body state of the set's own mean elements: PRODUCER exactly
  /// "com.spacedatanetwork.sdn-ap-propagator X.Y.Z", three decimal integers, X.Y.Z at 0.6.39 or later.
  MEAN_ELEMENTS_TWO_BODY = 2
}

/// What a record is. A reader that meets a kind it does not know ignores the record and changes nothing
/// it holds. Append new values only.
enum morRecordKind : ubyte {
  /// A whole element set, with everything this record can carry.
  FULL = 0,
  /// New rows for a set the receiver already holds (see "Rows only").
  ROWS_ONLY = 1
}

/// The gravity field a set states, PERTURBATIONS.GRAVITY_MODEL of its $OCM. Append new values only.
enum morGravityField : ubyte {
  /// The theory's own field: "WGS-72" for SGP4, "EGM-96" for SGP4XP and for AP with both degree caps 0.
  THEORY = 0,
  /// "EGM2008": an AP set with a degree cap above 0.
  EGM2008 = 1,
  /// "EGM2008; slow tesseral terms to degree 70": an AP set with a degree cap above 0 whose slow set
  /// carries terms beyond the shallow set's.
  EGM2008_SLOW_TESSERAL_70 = 2
}

/// The ordinals and meanings of $PCF pcfSolidTideModel: PERTURBATIONS.SOLID_TIDES_MODEL absent (NONE) or
/// "IERS 2010" (IERS_2010).
enum morSolidTideModel : ubyte {
  NONE = 0,
  IERS_2010 = 1
}

/// The radiation pressure model a set states, PERTURBATIONS.SOLAR_RAD_PRESSURE of its $OCM. Append new
/// values only.
enum morRadiationModel : ubyte {
  /// No text: the theory's own radiation pressure on AGOM.
  UNSTATED = 0,
  /// "SPHERE (AGOM) AND ECOM2 Y0 (ARNOLD ET AL. 2015), SPHERE'S CYLINDRICAL SHADOW".
  SPHERE_ECOM2_Y0 = 1,
  /// "SPHERE (AGOM) THROUGH THE OUTPUT MAP, CYLINDRICAL SHADOW OVER THE STEP".
  SPHERE_OUTPUT_MAP = 2,
  /// "SPHERE (AGOM) THROUGH THE OUTPUT MAP, CYLINDRICAL SHADOW OVER THE STEP, AND ECOM2 Y0 (ARNOLD ET AL.
  /// 2015)".
  SPHERE_OUTPUT_MAP_ECOM2_Y0 = 3
}

/// A window of WINDOWS: served (its coefficients follow) or one no record serves, with the ordinals of
/// $PPE ppeWindowStatus for the refusals. Append new values only.
enum morWindowStatus : ubyte {
  /// Served: the window's coefficients are in WINDOW_COEFF_HEADS and WINDOW_COEFF_TAILS.
  SERVED = 0,
  /// The theory refused the window; no coefficients.
  THEORY_REFUSED = 1,
  /// The builder could not hold its tolerance over the window; no coefficients.
  TOLERANCE_NOT_HELD = 2
}

/// What propagates COVARIANCE_DATA beyond its epoch: the values of $OCM OCMCovariancePropagation, same
/// names, units and meanings, all thirteen always present. A closed struct: a later quantity comes as a new
/// appended field of MOR, never as a change to this struct.
struct MORCovariancePropagation {
  FLOOR_UU_KM2: double;
  FLOOR_VU_KM2: double;
  FLOOR_VV_KM2: double;
  FLOOR_WU_KM2: double;
  FLOOR_WV_KM2: double;
  FLOOR_WW_KM2: double;
  NOISE_ECCENTRICITY_PER_DAY: double;
  NOISE_INCLINATION_PER_DAY: double;
  NOISE_MEAN_MOTION_RELATIVE: double;
  NOISE_NON_GRAVITATIONAL_RAD_DAY2: double;
  NOISE_START_MINUTES: double;
  NON_GRAVITATIONAL_SHARE: double;
  NON_GRAVITATIONAL_RATE_PER_DAY: double;
}

/// One window of the polynomial rows derived from this record's elements: Chebyshev series of the first
/// kind over [EPOCH_MID_SECONDS - EPOCH_HALF_SPAN, EPOCH_MID_SECONDS + EPOCH_HALF_SPAN], position in km and
/// velocity in km/s, TEME of date, about the Earth.
struct MORWindow {
  /// Middle of the window, seconds after EPOCH_UNIX_US.
  EPOCH_MID_SECONDS: double;
  /// Half the window, seconds; above 0.
  EPOCH_HALF_SPAN: double;
  /// SERVED, or why no record serves the window.
  STATUS: morWindowStatus;
  /// Position coefficients per axis, 1 or more when SERVED; the last triple is not +0.0 on all three axes.
  POS_COEFF_COUNT: ubyte;
  /// Leading position coefficients per axis held as binary64; the rest are binary32. At most
  /// POS_COEFF_COUNT.
  POS_COEFF_HEAD_COUNT: ubyte;
  /// Velocity coefficients per axis; 0 for a position-only window. The last triple is not +0.0 on all
  /// three axes.
  VEL_COEFF_COUNT: ubyte;
  /// Leading velocity coefficients per axis held as binary64. At most VEL_COEFF_COUNT.
  VEL_COEFF_HEAD_COUNT: ubyte;
}

/// Minimum Orbit Record.
table MOR {
  /// The object's NORAD catalog number, the join key to $CAT, $OMM and $OCM; 0 when it has none.
  NORAD_CAT_ID: uint32;
  /// The object's COSPAR international designator.
  INTERNATIONAL_DESIGNATOR: string;
  /// Who issued the set ($OCM HEADER.ORIGINATOR). A reader keys a series on NORAD_CAT_ID,
  /// INTERNATIONAL_DESIGNATOR and ORIGINATOR.
  ORIGINATOR: string;
  /// The theory the set is defined under: SGP4, SGP4XP or AP. A reader refuses UNSPECIFIED.
  MEAN_ELEMENT_THEORY: meanElementSource = UNSPECIFIED;
  /// Epoch of the elements: microseconds since 1970-01-01T00:00:00 UTC, every UTC day 86,400,000,000
  /// (the UNIX time scale of $MPE EPOCH). An $OCM EPOCH text with up to six fraction digits converts both
  /// ways without loss; an instant inside a leap second has no value here.
  EPOCH_UNIX_US: int64;
  /// What this record is (see "Record kinds" and "Rows only" above). An unknown kind: ignore the record.
  RECORD_KIND: morRecordKind = FULL;
  /// Polynomial rows derived from this record by the builder its asset names ($DPM DPMAsset.DERIVED_BUILD),
  /// in time order, without overlap, each half-span above 0. A convenience: the elements remain authoritative and a reader may
  /// ignore the rows. Without the asset's DERIVED_BUILD a reader must not use them, nor when it cannot
  /// reproduce that statement, nor when WINDOW_RECORD_CHECK does not match.
  /// A record without WINDOWS has no rows; why is stated by the build's $DRB OUTCOMES, never in the record.
  WINDOWS: [MORWindow];
  /// The binary64 coefficients of the served windows, in window order: for each, X, Y and Z of position
  /// (POS_COEFF_HEAD_COUNT each), then X, Y and Z of velocity (VEL_COEFF_HEAD_COUNT each).
  WINDOW_COEFF_HEADS: [double];
  /// The binary32 coefficients of the served windows, in the same order: X, Y and Z of position
  /// (POS_COEFF_COUNT - POS_COEFF_HEAD_COUNT each), then of velocity.
  WINDOW_COEFF_TAILS: [float];
  /// The first 8 bytes, as a little-endian uint64, of the SHA-256 the builder named in DERIVED_BUILD
  /// publishes as its record digest (over the record's decoded inputs). A reader recomputes it from this
  /// record before using the rows: a mismatch voids the rows. With WINDOWS only.
  WINDOW_RECORD_CHECK: uint64;
  /// Mean motion, rev/day, as the theory defines it: Kozai for SGP4, Brouwer for SGP4XP and AP.
  MEAN_MOTION: double;
  /// Eccentricity.
  ECCENTRICITY: double;
  /// Inclination, deg.
  INCLINATION: double;
  /// Right ascension of the ascending node, deg.
  RA_OF_ASC_NODE: double;
  /// Argument of pericenter, deg.
  ARG_OF_PERICENTER: double;
  /// Mean anomaly, deg.
  MEAN_ANOMALY: double;
  /// Drag term Cd*A/m, m**2/kg. SGP4XP and AP; 0 for SGP4.
  BTERM: double;
  /// Radiation term Cr*A/m, m**2/kg. SGP4XP and AP; 0 for SGP4.
  AGOM: double;
  /// The gravity field the set flies on.
  GRAVITY_FIELD: morGravityField = THEORY;
  /// Highest tesseral degree of the field's terms; 0 for SGP4 and SGP4XP.
  MAXIMUM_TESSERAL_DEGREE: ubyte;
  /// Highest zonal degree of the field's terms; 0 for SGP4 and SGP4XP.
  MAXIMUM_ZONAL_DEGREE: ubyte;
  /// The dynamic parameters the orbit determination carried, bit k for prwDynamicParameter ordinal k:
  /// DRAG_AREA_OVER_MASS (bit 1, value BTERM), SRP_AREA_OVER_MASS (bit 3, value AGOM) and ECOM2_Y0
  /// (bit 6, value ECOM2_Y0). Any other bit has no value here and is refused.
  OD_PARAMETERS: uint32;
  /// Of OD_PARAMETERS, the ones the orbit determination solved for (the others were held).
  OD_SOLVED_FOR: uint32;
  /// The span of the observations the orbit determination used, days; NaN when not stated.
  ACTUAL_OD_SPAN: double = nan;
  /// Observations the orbit determination used; -1 when not stated ($OCM 0).
  OD_OBSERVATIONS_USED: int32 = -1;
  /// Weighted RMS residual ratio of the orbit determination; NaN when not stated ($OCM 0).
  WEIGHTED_RMS: double = nan;
  /// Epoch of the orbit determination, in the form of EPOCH_UNIX_US. -9223372036854775807 is a sentinel
  /// meaning not stated: the least int64 plus one, because some generated languages read the least int64
  /// itself as a floating-point literal.
  OD_EPOCH_UNIX_US: int64 = -9223372036854775807;
  /// Tracks the orbit determination used; -1 when not stated ($OCM 0).
  OD_TRACKS_USED: int32 = -1;
  /// Days from the last observation the orbit determination used to OD_EPOCH; NaN when not stated.
  DAYS_SINCE_LAST_OBS: double = nan;
  /// The epoch covariance, lower triangle row by row, N(N+1)/2 values: N = 6 plus the solved
  /// DRAG_AREA_OVER_MASS and SRP_AREA_OVER_MASS (the covariance parameters OD_PARAMETERS can carry);
  /// position and velocity in km and km/s in TRAJ_REF_FRAME of the expansion, then those parameters in
  /// ascending ordinal. Absent: no covariance.
  COVARIANCE_DATA: [double];
  /// What propagates COVARIANCE_DATA beyond its epoch; with COVARIANCE_DATA only.
  COV_PROPAGATION: MORCovariancePropagation;
  /// Where COV_PROPAGATION's floor sits; with COVARIANCE_DATA only. It governs the covariance's numbers, over
  /// any producer text: a record read alone flies the same covariance as its $OCM.
  COV_FLOOR: morCovarianceFloor = UNSTATED;
  /// The realism model of COVARIANCE_DATA among its asset's $DPM DPMAsset.COV_REALISM_MODELS, by ID; 0 when
  /// the record states its own COV_REALISM or none. The model's figures need the asset; the ID does not. An
  /// ID the asset does not list leaves the figures unresolved, and a reader says so.
  COV_REALISM_ID: uint16;
  /// Whether COVARIANCE_DATA's coverage was measured against independent reference states.
  COV_CALIBRATION: covarianceCalibration = Unspecified;
  /// The object's own element set for times beyond what this record serves (a reader's fallback
  /// propagator), as an $MPE: SGP4 with BSTAR or SGP4XP with BTERM and AGOM. Its ENTITY_ID is absent: the
  /// object is this record's. No TARGETER.
  FALLBACK: MPE;
  /// BSTAR, 1/Earth radii. SGP4 only.
  BSTAR: double;
  /// MEAN_MOTION_DOT, rev/day**2. SGP4 only.
  MEAN_MOTION_DOT: double;
  /// MEAN_MOTION_DDOT, rev/day**3. SGP4 only.
  MEAN_MOTION_DDOT: double;
  /// The solid Earth tide the set flies with.
  SOLID_TIDES_MODEL: morSolidTideModel = NONE;
  /// The radiation pressure model the set states.
  SOLAR_RAD_PRESSURE: morRadiationModel = UNSTATED;
  /// The ECOM2 Y0 radiation acceleration, m/s**2, when OD_PARAMETERS has bit 6.
  ECOM2_Y0: double;
  /// Whether the set is real or test data. A record that does not state it is an operational record of
  /// unstated status; a publisher states it only when it is TEST.
  MESSAGE_STATUS: morMessageStatus = UNSPECIFIED;
  /// The object's name; absent unless a reader copies it into what it writes.
  OBJECT_NAME: string;
  /// The realism of COVARIANCE_DATA when it is the record's own (it differs from record to record), the
  /// single entry of $OCM COV_REALISM. Never with COV_REALISM_ID.
  COV_REALISM: CVR;
  /// Identifier of that calibration evidence (a report or record).
  COV_CALIBRATION_REFERENCE: string;
}

root_type MOR;
file_identifier "$MOR";