// Hash: 73bba4c2f0d3213dbb2fb72058c6cc769de496cd9b2ef291feb5dafd1451c935
// Version: 0.0.5
// -----------------------------------END_HEADER
enum gnssConstellation : byte {
  GPS,
  GLONASS,
  GALILEO,
  BEIDOU,
  QZSS,
  IRNSS,
  SBAS,
  MIXED
}

enum gnssObsType : byte {
  PSEUDORANGE,
  CARRIER_PHASE,
  /// One-way Doppler of the received carrier (Hz), positive when the
  /// satellite is approaching (the RINEX convention).
  DOPPLER,
  SNR,
  RAW_IF,
  /// Ionosphere phase delay (RINEX observation type I), as the file states it.
  IONOSPHERE_PHASE_DELAY,
  /// Receiver channel number (RINEX observation type X), as the receiver reports it.
  CHANNEL_NUMBER
}

/// GNSS Observation Data Point
table gnssObsData {
  /// Signal type code (e.g., L1C, L2P, L5Q, E1B)
  SIGNAL:string;
  /// Observation type
  OBS_TYPE:gnssObsType;
  /// Observation value (units depend on type: m, cycles, Hz, dB-Hz)
  VALUE:double;
  /// Loss of lock indicator
  LLI:uint8;
  /// Signal strength indicator (1-9)
  SSI:uint8;
}

/// GNSS Satellite Observation
table gnssSatObs {
  /// GNSS satellite identifier (e.g., G01, R24, E05, C03)
  GNSS_SAT_ID:string;
  /// Constellation
  CONSTELLATION:gnssConstellation;
  /// Elevation angle in degrees
  ELEVATION:double;
  /// Azimuth angle in degrees
  AZIMUTH:double;
  /// Tracking status (0=not tracked, 1=tracking, 2=locked)
  TRACKING_STATUS:int;
  /// AGC state
  AGC_STATE:int;
  /// Observations for this satellite
  OBSERVATIONS:[gnssObsData];
  /// GLONASS frequency channel number k of this satellite (RINEX GLONASS SLOT /
  /// FRQ #), -7 to +6. Meaningful only when HAS_GLONASS_FREQUENCY_NUMBER.
  GLONASS_FREQUENCY_NUMBER:byte;
  /// True when GLONASS_FREQUENCY_NUMBER carries a value (channel 0 is a real
  /// channel); false (the default) means absent.
  HAS_GLONASS_FREQUENCY_NUMBER:bool = false;
}

/// GNSS Observation
table GNO {
  /// Unique identifier
  ID:string;
  /// Receiver identifier
  RECEIVER_ID:string;
  /// Receiver type/model
  RECEIVER_TYPE:string;
  /// Antenna identifier
  ANTENNA_ID:string;
  /// Antenna type/model
  ANTENNA_TYPE:string;
  /// Receiver firmware version
  FIRMWARE_VERSION:string;
  /// Observation epoch (ISO 8601)
  EPOCH:string;
  /// Receiver clock offset in seconds
  CLOCK_OFFSET:double;
  /// Receiver clock drift in seconds/second
  CLOCK_DRIFT:double;
  /// Receiver geodetic latitude in degrees
  LATITUDE:double;
  /// Receiver geodetic longitude in degrees
  LONGITUDE:double;
  /// Receiver altitude in meters above WGS-84
  ALTITUDE:double;
  /// Approximate position X in meters (ECEF)
  APPROX_X:double;
  /// Approximate position Y in meters (ECEF)
  APPROX_Y:double;
  /// Approximate position Z in meters (ECEF)
  APPROX_Z:double;
  /// Observation interval in seconds
  INTERVAL:double;
  /// Number of satellites observed
  NUM_SATS:uint;
  /// PDOP
  PDOP:double;
  /// HDOP
  HDOP:double;
  /// VDOP
  VDOP:double;
  /// Satellite observations
  SAT_OBS:[gnssSatObs];
  /// Observation code set identifiers
  OBS_CODE_SET:[string];
  /// Additional notes
  NOTES:string;
  /// Time scale of EPOCH as the file names it: GPS, GLO, GAL, QZS, BDT or IRN.
  /// Default empty (not stated).
  TIME_SYSTEM:string;
  /// RINEX epoch flag: 0 OK, 1 power failure since the previous epoch, 2 start of
  /// a moving antenna, 3 new site occupation, 4 header information follows, 5
  /// external event, 6 cycle slip records follow. Default 0.
  EPOCH_FLAG:ubyte;
  /// Marker name from the header. Default empty.
  MARKER_NAME:string;
  /// Marker number from the header. Default empty.
  MARKER_NUMBER:string;
  /// Marker type from the header. Default empty.
  MARKER_TYPE:string;
  /// Observer from the header. Default empty.
  OBSERVER:string;
  /// Agency from the header. Default empty.
  AGENCY:string;
  /// Antenna delta from the marker to the antenna reference point: height, east,
  /// north, meters, as [H, E, N]. Default empty.
  ANTENNA_DELTA_HEN:[double];
  /// Phase shift records as the header writes them, one per line, for example
  /// "G L2S -0.25000". Default empty.
  PHASE_SHIFTS:[string];
  /// Unit of the signal strength observations as the header states it. Default
  /// empty.
  SIGNAL_STRENGTH_UNIT:string;
  /// Leap seconds of the header (RINEX LEAP SECONDS), seconds. Meaningful only
  /// when HAS_LEAP_SECONDS.
  LEAP_SECONDS:int;
  /// True when LEAP_SECONDS carries a value; false (the default) means absent.
  HAS_LEAP_SECONDS:bool = false;
}

root_type GNO;
file_identifier "$GNO";