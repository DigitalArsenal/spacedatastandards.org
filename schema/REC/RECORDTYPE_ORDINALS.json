  "history": [
    {
      "date": "2026-07-10",
      "event": "Third known ordinal generation observed in the wild. Artifact com.digitalarsenal.examples.remote-sdn-live-e2e carries MBL=67, ENC=34, PNM=98 -- an older, differently numbered union. Records from this generation are decodable only via Record.standard."
    },
    {
      "date": "2026-07-02",
      "event": "Header generation carrying MBL=80, ENC=39, PNM=113. The readers built from it were still deployed when the union moved under them."
    },
    {
      "date": "2026-07-08",
      "commit": "c1580d4700",
      "event": "WIRE BREAK. $PGM inserted into the middle of the union; PIV, PLD, PLG, PLK, PNM, PPE, PRG and PRW each moved +1 and PNM went 113 -> 114. Readers built before this commit decoded PNM records as PPE, PPE::Verify failed, and every protected-module publication trailer was rejected as malformed. 42 protected plugins, including all 11 com.orbpro.rf-* modules, were undeliverable for three weeks."
    },
    {
      "date": "2026-08-07",
      "event": "ORDINAL FREEZE ENACTED. Ordinals 1..202 frozen by this contract and enforced by scripts/checkRecordTypeOrdinals.mjs in build:flatbuffers, npm test and the pre-commit hook. Append-only from here: no insertion, no reorder, no removal, no reuse."
    }
