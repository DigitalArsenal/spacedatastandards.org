// Hash: 4099c007aaf6ee2f57b6762decbd1ad8c73d973208ec08ae9792822d987ea330
// Version: 0.0.6
// -----------------------------------END_HEADER
include "../MEM/main.fbs";
include "../EOP/main.fbs";
include "../RFM/main.fbs";

// Access-window request/result records for ground-station visibility analysis.


/// Immutable reference. STANDARD matches REC.standard (e.g. "DTT", no "$"),
/// or "MODEL" for a manifest. SHA256 is 64 lowercase hexadecimal characters.
/// Hash exact standalone root bytes WITHOUT size prefix, WITH file identifier;
/// MODEL hashes exact supplied manifest bytes. Never hash a REC wrapper.
/// RECORD_ID is the selector specified in docs/clg-contract.md section 2; "root" selects
/// the complete root. URI is advisory and never fetched by a module.
table BodyRecordRef {
  STANDARD:string (required);
  RECORD_ID:string (required);
  SHA256:string (required);
  URI:string;
}

/// Shared body descriptor, usable by ACW, CLG and future SCV revisions.
/// No absence means Earth. Axes retain their FIXED_FRAME X/Y/Z order.
/// SCVEllipsoid and DTT mapping is normative in docs/clg-contract.md section 2.
table BodyDescriptor {
  /// Physical NAIF body, not barycenter; HAS_NAIF_ID required, zero invalid.
  NAIF_ID:int = 0;
  FIXED_FRAME:RFMCoordinateSystem (required);
  /// Each axis requires its HAS flag and a finite positive value.
  SEMI_AXIS_X_M:double = nan;
  SEMI_AXIS_Y_M:double = nan;
  SEMI_AXIS_Z_M:double = nan;
  MODEL_ID:string (required);
  /// Exact model-manifest bytes, 64 lowercase hexadecimal characters.
  MODEL_SHA256:string (required);
  /// Required explicit assertion, "NONE" or a supported model identifier.
  ATMOSPHERE_MODEL_ID:string (required);
  /// Absent means no terrain supplied; elevation remains mandatory for sites.
  TERRAIN:BodyRecordRef;
  /// Optional SHC or MODEL reference; its radius is not the shape radius.
  GRAVITY:BodyRecordRef;
  /// True HAS flag, positive radius and name required for non-ANY lighting.
  /// This is a named spherical-shadow approximation, not ellipsoidal lighting.
  LIGHTING_SPHERE_RADIUS_M:double = nan;
  LIGHTING_MODEL_ID:string;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_NAIF_ID:bool = false;
  HAS_SEMI_AXIS_X_M:bool = false;
  HAS_SEMI_AXIS_Y_M:bool = false;
  HAS_SEMI_AXIS_Z_M:bool = false;
  HAS_LIGHTING_SPHERE_RADIUS_M:bool = false;
}

/// ACW enum domains and individual HAS flags are specified in docs/clg-scalar-presence.md.
/// Existing zero values retain their meanings; the CLG UNSPECIFIED rule
/// does not apply to ACW enumerations as a group.
enum acwOperationCode : byte {
  UNKNOWN = 0,
  /// Compute access windows from pre-sampled target Cartesian states.
  COMPUTE_ACCESS_WINDOWS = 1,
  /// Simulate sensor observations of TARGETS by SENSORS: schedule tracks
  /// inside the ACCESS windows (computed per sensor and target by
  /// COMPUTE_ACCESS_WINDOWS with that sensor's constraints), generate each
  /// measurement from the
  /// truth states with its MEMErrorModel noise and bias, apply the detection
  /// test, and add false alarms. The observations are emitted as separate
  /// $RDO (RADAR), $EOO (OPTICAL, LASER_RANGING) and $RFO (PASSIVE_RF)
  /// records; the result lists the tracks.
  SIMULATE_OBSERVATIONS = 2,
  /// Only runtime access operation in body-aware modules; CENTRAL_BODY required.
  COMPUTE_ACCESS_WINDOWS_EXPLICIT_BODY = 3,
  /// Only runtime simulation operation in body-aware modules; body required.
  SIMULATE_OBSERVATIONS_EXPLICIT_BODY = 4
}

enum acwResultStatus : byte {
  /// Operation completed.
  OK = 0,
  /// Request fields are missing, non-finite, or numerically invalid.
  INVALID_INPUT = 1,
  /// The requested operation is not supported by the module.
  UNSUPPORTED_OPERATION = 2
}

enum acwRefractionModelKind : byte {
  NONE = 0,
  /// Orekit-compatible EarthStandardAtmosphereRefraction correction.
  EARTH_STANDARD_ATMOSPHERE = 1
}

/// Target Cartesian state sample in the required CENTRAL_BODY.FIXED_FRAME.
table ACWStateSample {
  /// Sample epoch as Julian Date in TT.
  JULIAN_DATE_TT:double;
  /// Fixed-frame X position, meters.
  POSITION_X_M:double;
  /// Fixed-frame Y position, meters.
  POSITION_Y_M:double;
  /// Fixed-frame Z position, meters.
  POSITION_Z_M:double;
  /// Fixed-frame velocity, meters per second. Required for range-rate,
  /// Doppler and frequency measurements (SIMULATE_OBSERVATIONS).
  VELOCITY_X_MPS:double;
  VELOCITY_Y_MPS:double;
  VELOCITY_Z_MPS:double;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_JULIAN_DATE_TT:bool = false;
  HAS_POSITION_X_M:bool = false;
  HAS_POSITION_Y_M:bool = false;
  HAS_POSITION_Z_M:bool = false;
  HAS_VELOCITY_X_MPS:bool = false;
  HAS_VELOCITY_Y_MPS:bool = false;
  HAS_VELOCITY_Z_MPS:bool = false;
}

/// Azimuth-dependent minimum elevation mask point.
table ACWElevationMaskPoint {
  /// Azimuth, radians in the TopocentricFrame convention.
  AZIMUTH_RAD:double;
  /// Minimum visible elevation at the azimuth, radians.
  ELEVATION_RAD:double;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_AZIMUTH_RAD:bool = false;
  HAS_ELEVATION_RAD:bool = false;
}

/// Atmospheric refraction model for apparent-elevation access checks.
table ACWRefractionModel {
  MODEL_KIND:acwRefractionModelKind;
  /// Local pressure in pascals.
  PRESSURE_PA:double = 101000.0;
  /// Local temperature in kelvin.
  TEMPERATURE_K:double = 283.0;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_MODEL_KIND:bool = false;
  HAS_PRESSURE_PA:bool = false;
  HAS_TEMPERATURE_K:bool = false;
}

/// Ground-station blackout interval.
table ACWBlackoutWindow {
  /// Interval start as Julian Date in TT.
  START_JULIAN_DATE_TT:double;
  /// Interval end as Julian Date in TT.
  END_JULIAN_DATE_TT:double;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_START_JULIAN_DATE_TT:bool = false;
  HAS_END_JULIAN_DATE_TT:bool = false;
}

/// Ground-station geodetic definition and scheduling constraints.
table ACWGroundStation {
  STATION_ID:string;
  NAME:string;
  /// Geodetic latitude, radians.
  LATITUDE_RAD:double;
  /// Geodetic longitude, radians.
  LONGITUDE_RAD:double;
  /// Height along the outward normal of CENTRAL_BODY ellipsoid, meters.
  /// docs/clg-contract.md section 4: at height > 0, own-body interior penetration of the
  /// finite segment blocks; tangent contact is clear. At height <= 0, including
  /// zero, use the supporting plane, without an own-ellipsoid intersection test.
  /// The user elevation mask and supplied terrain apply separately at all heights.
  ALTITUDE_M:double;
  /// Explicit minimum visible elevation, radians; HAS flag required.
  MIN_ELEVATION_RAD:double;
  /// Number of simultaneous contacts this station can schedule.
  CHANNEL_CAPACITY:uint32;
  /// Station-specific unavailable intervals.
  BLACKOUT_WINDOWS:[ACWBlackoutWindow];
  /// Value presence: false means omitted; true precedes value validation.
  HAS_LATITUDE_RAD:bool = false;
  HAS_LONGITUDE_RAD:bool = false;
  HAS_ALTITUDE_M:bool = false;
  HAS_MIN_ELEVATION_RAD:bool = false;
  HAS_CHANNEL_CAPACITY:bool = false;
}

/// Kind of access constraint. Append only.
enum acwConstraintKind : byte {
  UNSPECIFIED = 0,
  /// Observer-to-target elevation at or above THRESHOLD_RAD (ground observers).
  MIN_ELEVATION = 1,
  /// Azimuth-dependent minimum elevation from MASK.
  ELEVATION_MASK = 2,
  /// Observer-to-target range at or below MAX_RANGE_M.
  MAX_RANGE = 3,
  /// Observer-to-target range at or above MIN_RANGE_M.
  MIN_RANGE = 4,
  /// Angle between the observer-to-target and observer-to-Sun directions at
  /// or above THRESHOLD_RAD (solar exclusion).
  SUN_EXCLUSION = 5,
  /// Angle between the observer-to-target and observer-to-Moon directions at
  /// or above THRESHOLD_RAD (lunar exclusion).
  MOON_EXCLUSION = 6,
  /// Target illumination state matches LIGHTING.
  TARGET_LIGHTING = 7,
  /// Straight-line visibility between observer and target not occulted by the
  /// central body raised by OCCULTATION_ATMOSPHERE_HEIGHT_M (satellite-to-satellite).
  LINE_OF_SIGHT = 8,
  /// Outside every observer blackout window.
  BLACKOUT = 9
}

/// How the members of a constraint set combine.
enum acwConstraintOperator : byte {
  /// Every member must hold (AND).
  ALL_OF = 0,
  /// At least one member must hold (OR).
  ANY_OF = 1
}

/// Whether windows are evaluated only at the supplied samples or refined to
/// the epochs where the aggregate condition changes.
enum acwEvaluationMode : byte {
  /// Evaluate at the supplied sample epochs only; window edges are samples.
  DISCRETE = 0,
  /// Bracket between samples and refine each edge to ROOT_TOLERANCE_S.
  CONTINUOUS = 1
}

/// Illumination state of the target required by a TARGET_LIGHTING constraint.
enum acwLightingCondition : byte {
  ANY = 0,
  SUNLIT = 1,
  PENUMBRA = 2,
  UMBRA = 3,
  /// Sunlit or penumbra.
  NOT_UMBRA = 4
}

/// One access constraint. Fields not used by KIND are ignored.
table ACWConstraint {
  KIND:acwConstraintKind;
  /// Angular threshold, radians (MIN_ELEVATION, SUN_EXCLUSION, MOON_EXCLUSION).
  THRESHOLD_RAD:double;
  /// Range bounds, meters (MIN_RANGE, MAX_RANGE).
  MIN_RANGE_M:double;
  MAX_RANGE_M:double;
  /// Required target lighting (TARGET_LIGHTING).
  LIGHTING:acwLightingCondition;
  /// Nonnegative meters added to EACH ellipsoid semiaxis for space-to-space
  /// LOS only; not geodetic altitude. Never applied to a surface-station pair.
  OCCULTATION_ATMOSPHERE_HEIGHT_M:double;
  /// Azimuth-dependent mask (ELEVATION_MASK).
  MASK:[ACWElevationMaskPoint];
  /// Producer label echoed in window attribution.
  LABEL:string;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_KIND:bool = false;
  HAS_THRESHOLD_RAD:bool = false;
  HAS_MIN_RANGE_M:bool = false;
  HAS_MAX_RANGE_M:bool = false;
  HAS_LIGHTING:bool = false;
  HAS_OCCULTATION_ATMOSPHERE_HEIGHT_M:bool = false;
}

/// A boolean composition of constraints and nested sets.
table ACWConstraintSet {
  OPERATOR:acwConstraintOperator;
  CONSTRAINTS:[ACWConstraint];
  /// Nested sets, combined with the same OPERATOR.
  SETS:[ACWConstraintSet];
  LABEL:string;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_OPERATOR:bool = false;
}

/// A moving observer (spacecraft) given as pre-sampled central-body-fixed states, in
/// the same frame and time scale as ACWRequest.STATES.
table ACWObserverTrajectory {
  OBSERVER_ID:string;
  NAME:string;
  STATES:[ACWStateSample];
  /// Observer-specific unavailable intervals.
  BLACKOUT_WINDOWS:[ACWBlackoutWindow];
}

/// Sensing phenomenology of a simulated sensor.
enum acwSensorPhenomenology : ubyte {
  UNSPECIFIED = 0,
  /// Monostatic radar: range, range rate, two-way Doppler, azimuth,
  /// elevation.
  RADAR = 1,
  /// Passive optical: right ascension and declination, magnitude.
  OPTICAL = 2,
  /// Passive RF: angles and the received (one-way) frequency of a target's
  /// emitter.
  PASSIVE_RF = 3,
  /// Satellite laser ranging: two-way range.
  LASER_RANGING = 4
}
/// Observable signature of a simulated target.
table ACWTargetSignature {
  /// Radar cross-section, square meters (RADAR).
  RCS_M2:double;
  /// Diameter, meters, and geometric albedo of the diffuse sphere that sets
  /// the magnitude, in the band of EOO.MAG (OPTICAL).
  DIAMETER_M:double;
  GEOMETRIC_ALBEDO:double;
  /// Emitter carrier frequency, hertz, and EIRP toward the sensor, dBW
  /// (PASSIVE_RF). A frequency of 0 means the target does not emit.
  EMITTER_FREQUENCY_HZ:double;
  EMITTER_EIRP_DBW:double;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_RCS_M2:bool = false;
  HAS_DIAMETER_M:bool = false;
  HAS_GEOMETRIC_ALBEDO:bool = false;
  HAS_EMITTER_FREQUENCY_HZ:bool = false;
  HAS_EMITTER_EIRP_DBW:bool = false;
}
/// One simulated target: truth states and signature.
table ACWTarget {
  TARGET_ID:string;
  NORAD_CAT_ID:uint32;
  /// International designator.
  OBJECT_ID:string;
  /// Truth central-body-fixed states with velocity, in the frame and time scale of
  /// ACWRequest.STATES.
  STATES:[ACWStateSample];
  SIGNATURE:ACWTargetSignature;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_NORAD_CAT_ID:bool = false;
}
/// A simulated sensor hosted by a ground station or an observer trajectory.
table ACWSensor {
  SENSOR_ID:string;
  /// ACWGroundStation.STATION_ID or ACWObserverTrajectory.OBSERVER_ID of the
  /// host.
  HOST_ID:string;
  PHENOMENOLOGY:acwSensorPhenomenology;
  /// The measurements each observation carries, one error model per
  /// measurement type (noise, bias, bias uncertainty, correlation time,
  /// media and light-time options).
  ERROR_MODELS:[MEMErrorModel];
  /// Visibility for this sensor, the constraints its ACCESS windows were
  /// computed with. When absent, ACWRequest.CONSTRAINTS apply.
  CONSTRAINTS:ACWConstraintSet;
  /// Seconds between observations within a track.
  OBSERVATION_INTERVAL_S:double;
  /// Longest track, seconds; 0 tracks the whole access window.
  TRACK_DURATION_S:double;
  /// Shortest time between the end of one track of a target and the start
  /// of the following, seconds.
  REVISIT_INTERVAL_S:double;
  /// Targets tracked at once.
  MAX_SIMULTANEOUS_TRACKS:uint32 = 1;
  /// RADAR: signal-to-noise ratio, dB, of a REFERENCE_RCS_M2 target at
  /// REFERENCE_RANGE_M; SNR scales with RCS and with range to the -4th power.
  REFERENCE_SNR_DB:double;
  REFERENCE_RANGE_M:double;
  REFERENCE_RCS_M2:double = 1.0;
  /// RADAR and PASSIVE_RF: smallest detected signal-to-noise ratio, dB.
  DETECTION_THRESHOLD_DB:double;
  /// PASSIVE_RF: receiver figure of merit, dB/K, and noise bandwidth, hertz.
  RECEIVER_G_OVER_T_DB_PER_K:double;
  RECEIVER_BANDWIDTH_HZ:double;
  /// OPTICAL: faintest magnitude detected, in the band of EOO.MAG; 0 applies
  /// no magnitude limit.
  LIMITING_MAGNITUDE:double;
  /// OPTICAL: highest Sun elevation at the host for a detection, radians
  /// (ground-based darkness); requires SUN_STATES. Observations scheduled
  /// in brighter sky are lost.
  MAX_HOST_SUN_ELEVATION_RAD:double;
  /// Uncorrelated detections per hour of tracking, reported with UCT set.
  FALSE_ALARM_RATE_PER_HOUR:double;
  /// RADAR: transmitted carrier frequency, hertz. A DOPPLER error model
  /// measures the echo's two-way shift relative to it, reported as $RDO
  /// DOPPLER with DOPPLER_FREQUENCY set to this value.
  TRANSMIT_FREQUENCY_HZ:double;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_PHENOMENOLOGY:bool = false;
  HAS_OBSERVATION_INTERVAL_S:bool = false;
  HAS_TRACK_DURATION_S:bool = false;
  HAS_REVISIT_INTERVAL_S:bool = false;
  HAS_MAX_SIMULTANEOUS_TRACKS:bool = false;
  HAS_REFERENCE_SNR_DB:bool = false;
  HAS_REFERENCE_RANGE_M:bool = false;
  HAS_REFERENCE_RCS_M2:bool = false;
  HAS_DETECTION_THRESHOLD_DB:bool = false;
  HAS_RECEIVER_G_OVER_T_DB_PER_K:bool = false;
  HAS_RECEIVER_BANDWIDTH_HZ:bool = false;
  HAS_LIMITING_MAGNITUDE:bool = false;
  HAS_MAX_HOST_SUN_ELEVATION_RAD:bool = false;
  HAS_FALSE_ALARM_RATE_PER_HOUR:bool = false;
  HAS_TRANSMIT_FREQUENCY_HZ:bool = false;
}
/// Access windows of one sensor to one target (SIMULATE_OBSERVATIONS input).
table ACWSensorAccess {
  SENSOR_ID:string;
  TARGET_ID:string;
  WINDOWS:[ACWAccessWindow];
}
/// One simulated track: a sensor's scheduled look at a target.
table ACWTrack {
  SENSOR_ID:string;
  TARGET_ID:string;
  START_JULIAN_DATE_TT:double;
  END_JULIAN_DATE_TT:double;
  /// Observations scheduled in the track.
  SCHEDULED_COUNT:uint32;
  /// Observations that passed the detection test and were emitted.
  DETECTED_COUNT:uint32;
  /// Why scheduled observations were not detected (for example "SNR",
  /// "MAGNITUDE"); empty when all were.
  LOSS_REASON:string;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_START_JULIAN_DATE_TT:bool = false;
  HAS_END_JULIAN_DATE_TT:bool = false;
  HAS_SCHEDULED_COUNT:bool = false;
  HAS_DETECTED_COUNT:bool = false;
}
/// One access-window compute request.
table ACWRequest {
  OPERATION:acwOperationCode;
  /// Candidate ground stations.
  GROUND_STATIONS:[ACWGroundStation];
  /// Pre-sampled target Cartesian states in CENTRAL_BODY.FIXED_FRAME.
  STATES:[ACWStateSample];
  /// Optional target station id. Empty means all stations when supported.
  TARGET_STATION_ID:string;
  /// Optional caller override for minimum elevation, radians.
  MIN_ELEVATION_OVERRIDE_RAD:double;
  /// Optional trace/correlation identifier.
  TRACE_ID:string;
  /// Optional azimuth-dependent minimum elevation mask.
  ELEVATION_MASK:[ACWElevationMaskPoint];
  /// Optional apparent-elevation refraction model.
  REFRACTION_MODEL:ACWRefractionModel;
  /// Optional constraint composition. When absent the station constraints apply:
  /// every ground station's MIN_ELEVATION_RAD (or the override) plus
  /// ELEVATION_MASK, all required.
  CONSTRAINTS:ACWConstraintSet;
  /// Optional moving observers (satellite-to-satellite access). Each observer
  /// is evaluated against STATES like a ground station.
  OBSERVERS:[ACWObserverTrajectory];
  /// Sample-only or root-refined window edges.
  EVALUATION_MODE:acwEvaluationMode;
  /// Edge refinement tolerance for CONTINUOUS, seconds.
  ROOT_TOLERANCE_S:double = 0.1;
  /// Sun states in the STATES frame and time scale, required by
  /// SUN_EXCLUSION and TARGET_LIGHTING constraints; interpolated to sample epochs.
  SUN_STATES:[ACWStateSample];
  /// Moon states in the STATES frame and time scale, required by MOON_EXCLUSION.
  MOON_STATES:[ACWStateSample];
  /// Targets to observe (SIMULATE_OBSERVATIONS).
  TARGETS:[ACWTarget];
  /// Sensors that observe them (SIMULATE_OBSERVATIONS).
  SENSORS:[ACWSensor];
  /// Where each sensor can see each target (SIMULATE_OBSERVATIONS); a pair
  /// without an entry is never observed.
  ACCESS:[ACWSensorAccess];
  /// Earth orientation parameters for celestial directions (right ascension
  /// and declination). When absent, polar motion, UT1-UTC and celestial pole
  /// offsets are zero.
  EARTH_ORIENTATION:[EOP];
  /// Seed for measurement noise, biases and false alarms; one seed
  /// reproduces the same observations.
  RANDOM_SEED:uint64;
  /// Simulation span as Julian Dates in TT; 0 uses the span of the target
  /// states.
  START_JULIAN_DATE_TT:double;
  END_JULIAN_DATE_TT:double;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_OPERATION:bool = false;
  HAS_MIN_ELEVATION_OVERRIDE_RAD:bool = false;
  HAS_EVALUATION_MODE:bool = false;
  HAS_ROOT_TOLERANCE_S:bool = false;
  HAS_RANDOM_SEED:bool = false;
  HAS_START_JULIAN_DATE_TT:bool = false;
  HAS_END_JULIAN_DATE_TT:bool = false;
}

/// One computed access interval.
table ACWAccessWindow {
  STATION_ID:string;
  /// Access start as Julian Date in TT.
  START_JULIAN_DATE_TT:double;
  /// Access end as Julian Date in TT.
  END_JULIAN_DATE_TT:double;
  /// Maximum elevation sampled or interpolated during the pass, radians.
  MAX_ELEVATION_RAD:double;
  /// Number of visible input samples contributing to the window.
  SAMPLE_COUNT:uint32;
  /// Observer id when the observer is an ACWObserverTrajectory; empty for a
  /// ground station (then STATION_ID names it).
  OBSERVER_ID:string;
  /// Index into the flattened, depth-first constraint list of the constraint
  /// whose transition opens the window. A clipped start has no limiting
  /// constraint: HAS_START_LIMITING_CONSTRAINT_INDEX is false. A present
  /// index is nonnegative and in range; the retained wire default is not a sentinel.
  START_LIMITING_CONSTRAINT_INDEX:int32 = -1;
  /// Index of the constraint whose transition closes the window. A clipped end
  /// has HAS_END_LIMITING_CONSTRAINT_INDEX false. A present index is nonnegative
  /// and in range; the retained wire default is not a sentinel.
  END_LIMITING_CONSTRAINT_INDEX:int32 = -1;
  /// Labels of those constraints, when the producer set them.
  START_LIMITING_CONSTRAINT_LABEL:string;
  END_LIMITING_CONSTRAINT_LABEL:string;
  /// Range extrema over the window, meters.
  MIN_RANGE_M:double;
  MAX_RANGE_M:double;
  /// True when edges were root-refined (CONTINUOUS); false when they are samples.
  EDGES_REFINED:bool;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_START_JULIAN_DATE_TT:bool = false;
  HAS_END_JULIAN_DATE_TT:bool = false;
  HAS_MAX_ELEVATION_RAD:bool = false;
  HAS_SAMPLE_COUNT:bool = false;
  HAS_START_LIMITING_CONSTRAINT_INDEX:bool = false;
  HAS_END_LIMITING_CONSTRAINT_INDEX:bool = false;
  HAS_MIN_RANGE_M:bool = false;
  HAS_MAX_RANGE_M:bool = false;
  HAS_EDGES_REFINED:bool = false;
}

/// Result for one access-window compute request.
table ACWResult {
  STATUS:acwResultStatus;
  ERROR_MESSAGE:string;
  WINDOWS:[ACWAccessWindow];
  /// Caller trace/correlation identifier copied from the request when present.
  TRACE_ID:string;
  /// Evaluation mode actually used.
  EVALUATION_MODE:acwEvaluationMode;
  /// Flattened depth-first constraint list the window indices refer to.
  CONSTRAINT_LABELS:[string];
  /// Tracks scheduled by SIMULATE_OBSERVATIONS.
  TRACKS:[ACWTrack];
  /// Observations emitted, including false alarms.
  OBSERVATION_COUNT:uint32;
  /// Value presence: false means omitted; true precedes value validation.
  HAS_STATUS:bool = false;
  HAS_EVALUATION_MODE:bool = false;
  HAS_OBSERVATION_COUNT:bool = false;
}

/// Access-window analysis envelope.
table ACW {
  REQUEST:ACWRequest;
  RESULT:ACWResult;
  /// Appended slot 2. Mandatory in every new request and successful result.
  /// Request OPERATION must be 3 (access) or 4 (simulation); old modules reject
  /// these codes. Missing body fails acw-body-required; absence never means
  /// Earth. Operations 1/2 are archival only and are rejected by new runtimes.
  /// Result must echo the exact descriptor field values, including optional
  /// presence; requester rejects a missing/different echo. Raw table offsets
  /// are not identity. Explicit one-time archive conversion is outside runtime.
  CENTRAL_BODY:BodyDescriptor;
}

root_type ACW;
file_identifier "$ACW";