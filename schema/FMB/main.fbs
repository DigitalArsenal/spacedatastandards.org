// Hash: d3bd079453b2f133f6d4d2c01d71bdbe7951c47b5226bdb64df8525607a9fff0
// Version: 1.254.0
// -----------------------------------END_HEADER
/// FlatSQL Batch Metadata.
///
/// A FlatSQL feed (store format 5) is one linear stream of `[u32 LE size][FlatBuffer]`
/// frames. Record frames hold each record's bytes exactly as they arrived, so a
/// record is one contiguous byte range whose raw-leaf CIDv1 (sha2-256) is its
/// IPFS block. An FMB is the sibling frame that commits one commit round's rows
/// for one feed: it follows that round's record frames and never contains record
/// bytes. FMB frames, with the record frames, are everything needed to rebuild a
/// feed's index; values that can be re-extracted from the record bytes (epoch,
/// object key) are not repeated here. Offsets are local to the stream that holds
/// the frame and are never trusted across copies. Spec: flatsql
/// cpp/src/p4/FORMAT.md section 3.1.

/// Dictionary entry kinds. Ids are scoped to the feed, except TOKEN ids, which
/// are scoped to the record type.
enum fmbDictKind : ubyte {
  /// TEXT [token, peer]: a producer token of the type.
  TOKEN,
  /// TEXT [producer, peer]: a publishing node.
  NODE,
  /// TEXT [batch, producer peer, producer key]: a batch instance.
  BATCH,
  /// TEXT [content key].
  CONTENT_KEY,
  /// TEXT [url].
  URL,
  /// TEXT [object key]: written only for sealed rows (other rows' keys come
  /// from their bytes, numbered in order of first appearance in the stream).
  OBJECT_KEY
}

/// Why rows left the feed.
enum fmbRemoveReason : ubyte {
  DELETE,
  SUPERSEDE,
  CAT_SUPERSEDE,
  QUOTA,
  RETENTION,
  /// A local record moved into a source feed (the feed's FMB has MOVED_IN).
  MOVED_OUT
}

/// One delivery of one record to the feed; its rid is SEQ << 16 | ROW_J.
/// 40 bytes. Epoch and object key are not stored: they are re-extracted from
/// the record bytes (sealed rows carry theirs in FMBSealed).
struct FMBRow {
  /// Stream offset of the record frame's size prefix (this round's frame, or
  /// an earlier frame with the same bytes).
  OFFSET: ulong;
  /// The record's arrival number in the type's seq space.
  SEQ: ulong;
  /// The copy's source timestamp, as supplied with the write.
  SOURCE_TS: long;
  /// Size of the record frame's FlatBuffer (size prefix excluded).
  LENGTH: uint;
  /// Index into FMB.GROUPS.
  GROUP: ushort;
  /// The row's j within the record's rows.
  ROW_J: ushort;
  /// bit0 NEW_FRAME (the frame was written by this round), bit1 SEALED,
  /// bit2 LARGE (over 1 MiB: see FMB.LARGE), bit3 MOVED_IN (seq kept from
  /// local), bit4 COMPACTED (re-emitted by a compaction), bit5 COPY,
  /// bit6 RETAG; other bits 0.
  FLAGS: uint;
  /// 0.
  RESERVED: uint;
}

/// What one call's rows share. 24 bytes.
struct FMBGroup {
  /// When this feed delivered the rows (Unix seconds).
  DELIVERED_AT: long;
  /// NODE dictionary id; 0 none.
  NODE_ID: uint;
  /// BATCH dictionary id; 0 none.
  BATCH_ID: uint;
  /// CONTENT_KEY dictionary id; 0 none.
  CONTENT_KEY_ID: uint;
  /// URL dictionary id; 0 none.
  URL_ID: uint;
}

/// Rows that leave the feed. ROW_J 0xFFFFFFFF removes every row of SEQ.
struct FMBRemove {
  SEQ: ulong;
  ROW_J: uint;
  REASON: fmbRemoveReason;
}

/// A repeat delivery that moves a row's url.
struct FMBUrl {
  SEQ: ulong;
  ROW_J: uint;
  URL_ID: uint;
}

/// A dictionary entry first used by this round.
table FMBEntry {
  KIND: fmbDictKind;
  ID: uint;
  TEXT: [string];
}

/// A row's signature bytes.
table FMBSignature {
  /// Index into FMB.ROWS.
  ROW: uint;
  BYTES: [ubyte];
}

/// What a sealed (encrypted) row needs beyond FMBRow: its ciphertext cannot be
/// re-extracted.
table FMBSealed {
  /// Index into FMB.ROWS.
  ROW: uint;
  /// The plaintext's epoch (Unix seconds); INT64_MIN when none.
  EPOCH: long = -9223372036854775808;
  /// OBJECT_KEY dictionary id; 0 none.
  OBJECT_KEY_ID: uint;
  /// sha2-256 of the ciphertext range (32 bytes): its IPFS leaf.
  LEAF_DIGEST: [ubyte];
  /// The sealed record's extracted column values.
  COLUMNS: [ubyte];
}

/// An ingest identity registered by a row (32-byte hash).
table FMBIdentity {
  /// Index into FMB.ROWS.
  ROW: uint;
  HASH: [ubyte];
}

/// A record over 1 MiB: a UnixFS file DAG of 1 MiB raw leaves over its range.
table FMBLarge {
  /// Index into FMB.ROWS.
  ROW: uint;
  /// Binary CID of the dag-pb UnixFS root.
  ROOT_CID: [ubyte];
  /// The root node's dag-pb bytes.
  ROOT_NODE: [ubyte];
  /// sha2-256 of each leaf, 32 bytes each, in order.
  LEAF_DIGESTS: [ubyte];
}

/// FlatSQL Batch Metadata: one per feed per commit round.
table FMB {
  /// Stream offset of this frame's size prefix.
  SELF_OFFSET: ulong;
  /// Stream offset of the previous non-record frame (the commit chain).
  PREVIOUS: ulong;
  /// The feed's id in its type.
  FEED_ID: uint;
  /// The round's clock (Unix seconds).
  COMMITTED_AT: long;
  /// The type's highest seq issued so far.
  TYPE_SEQ_HIGH: ulong;
  /// The rows, in plan order; at most 65,536.
  ROWS: [FMBRow];
  /// sha2-256 of the record bytes, 32 bytes per NEW_FRAME row, in row order
  /// (for a sealed row, the plaintext's: its record CID).
  DIGESTS: [ubyte];
  GROUPS: [FMBGroup];
  DICTIONARY: [FMBEntry];
  REMOVALS: [FMBRemove];
  URLS: [FMBUrl];
  SIGNATURES: [FMBSignature];
  SEALED: [FMBSealed];
  IDENTITIES: [FMBIdentity];
  LARGE: [FMBLarge];
}

root_type FMB;
file_identifier "$FMB";