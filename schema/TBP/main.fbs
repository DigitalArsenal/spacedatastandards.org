// Hash: 738e3eb99d3035545cb62e1e7ed74a82188523d2c0f3381835eaf2868faafd49
// Version: 1.248.1
// -----------------------------------END_HEADER
include "../RFM/main.fbs";
include "../MPL/main.fbs";

/// Three-Body Problem (TBP)
/// Description
/// Solutions of the circular restricted three-body problem (CR3BP): a small
/// body moving under the gravity of two primaries that circle their common
/// barycentre. A TBP names the system (its mass ratio and the length and time
/// that scale it), and carries one kind of answer about it: a propagated
/// trajectory in the synodic (rotating) frame, the five libration (Lagrange)
/// points and their linear stability, the Jacobi constant of a state,
/// periodic orbits (planar and vertical Lyapunov, northern and southern halo,
/// near-rectilinear halo, distant retrograde, butterfly) with their period,
/// Jacobi constant, monodromy matrix and stability, members of a family of
/// such orbits, transfers into the system (with their burns), station-keeping
/// budgets, and states converted between the synodic and inertial frames.
///
/// Mission designers, cislunar and Sun-Earth libration-point analysts, and
/// catalogues of periodic orbits (such as the JPL three-body periodic-orbit
/// database) use it. The synodic frame is an $RFM coordinate system: origin
/// at the primaries' barycentre, X from the larger primary toward the
/// smaller, Z along the system's angular momentum, Y completing the
/// right-handed set; libration points use $RFM's rfmLibrationPoint. Transfer
/// burns are $MPL burns, so a three-body transfer plan reads like any other
/// maneuver plan and its burns can become $MNV records.
///
/// Units: synodic states, times and periods are non-dimensional (length in
/// units of CHARACTERISTIC_LENGTH_KM, time in units of
/// CHARACTERISTIC_TIME_S, so the primaries' angular rate is 1); dimensional
/// fields say km, km/s or s in their names.

/// The question a record answers. Append new values only; never reorder or
/// reuse existing values.
enum tbpProblem : ubyte {
  /// Not stated.
  Unspecified,
  /// Propagate a synodic state (optionally with its state transition matrix).
  Propagation,
  /// The five libration points.
  LibrationPoints,
  /// Jacobi constant of a state.
  JacobiConstant,
  /// Differentially corrected periodic orbit.
  PeriodicOrbit,
  /// Analytic first guess of a halo orbit (Richardson third order).
  HaloFirstGuess,
  /// Near-rectilinear halo orbit from perilune and apolune altitudes.
  NearRectilinearHalo,
  /// Transfer from a parking orbit about the larger primary.
  Transfer,
  /// Station-keeping budget for a periodic orbit.
  StationKeeping,
  /// State conversion between the synodic and inertial frames.
  FrameConversion,
  /// Members of a periodic-orbit family.
  Family,
  /// Pseudo-arclength or natural-parameter continuation from a seed orbit.
  Continuation,
  /// Stable and unstable invariant manifolds of an unstable periodic orbit.
  Manifolds,
  /// Diagnostic properties of a periodic orbit (apsides, stability, occultations).
  OrbitProperties,
  /// Time-phased multi-spacecraft constellation along a periodic CR3BP orbit.
  Constellation,
  /// Primary-body surface coverage gaps, elevation, occultations, and DOP.
  SurfaceAnalysis
}

/// Family of a periodic orbit. Append new values only; never reorder or reuse
/// existing values.
enum tbpOrbitFamily : ubyte {
  Unspecified,
  /// Halo orbit whose largest out-of-plane excursion is north (+Z).
  HaloNorthern,
  /// Halo orbit whose largest out-of-plane excursion is south (-Z).
  HaloSouthern,
  /// Planar Lyapunov orbit.
  PlanarLyapunov,
  /// Vertical Lyapunov orbit.
  VerticalLyapunov,
  /// Near-rectilinear halo orbit (the high-amplitude end of the halo family).
  NearRectilinearHalo,
  /// Distant retrograde orbit about the smaller primary.
  DistantRetrograde,
  /// Butterfly orbit.
  Butterfly,
  /// Axial orbit.
  Axial,
  /// Short- or long-period orbit about L4 or L5.
  LongShortPeriod,
  /// Northern-hemisphere sidereal-resonant tulip-shaped CR3BP orbit.
  TulipNorthern,
  /// Southern-hemisphere sidereal-resonant tulip-shaped CR3BP orbit.
  TulipSouthern,
  /// Northern-hemisphere multi-petal pumpkin-shaped CR3BP orbit.
  PumpkinNorthern,
  /// Southern-hemisphere multi-petal pumpkin-shaped CR3BP orbit.
  PumpkinSouthern
}

/// How a transfer is built. Append new values only; never reorder or reuse
/// existing values.
enum tbpTransferKind : ubyte {
  Unspecified,
  /// Direct two-body patched-conic transfer.
  HohmannLike,
  /// Low-energy (ballistic capture) transfer.
  LowEnergy,
  /// Free-return trajectory about the smaller primary.
  FreeReturn,
  /// Powered flyby of the smaller primary.
  PoweredFlyby,
  /// Weak-stability-boundary transfer.
  WeakStabilityBoundary,
  /// Direct insertion into an orbit about the smaller primary.
  DirectInsertion,
  /// Insertion into a periodic orbit (TARGET_ORBIT).
  PeriodicOrbitInsertion,
  /// Theoretical minimum Jacobi-energy delta-v between states or to surface.
  MinEnergy,
  /// Single-revolution STM-targeted direct CR3BP Lambert transfer.
  DirectLambert,
  /// Minimum-delta-v CR3BP Lambert across prograde/retrograde and primaries.
  MinLambert,
  /// Minimum-time low-thrust optimal control (Pontryagin Minimum Principle).
  LowThrustMinTime
}

/// When station-keeping burns are placed. Append new values only; never
/// reorder or reuse existing values.
enum tbpStationKeepingStrategy : ubyte {
  /// Correct at each crossing of the synodic XZ plane.
  PlaneCrossing,
  /// Target a reference point on the periodic orbit.
  TargetPoint,
  /// Suppress the unstable Floquet mode.
  FloquetMode,
  /// Linear stability lower/upper annual delta-v bounds across intervals.
  LinearStabilityBounds
}

/// Direction of a frame conversion. Append new values only; never reorder or
/// reuse existing values.
enum tbpConversionDirection : ubyte {
  SynodicToInertial,
  InertialToSynodic,
  SynodicToJ2000,
  J2000ToSynodic,
  SynodicToPrimaryInertial,
  PrimaryInertialToSynodic,
  SynodicToLla,
  LlaToSynodic,
  SynodicToOrbitalElements,
  OrbitalElementsToSynodic
}

/// Which invariant manifold branches to compute. Append new values only;
/// never reorder or reuse existing values.
enum tbpManifoldBranchKind : ubyte {
  /// Both stable and unstable branches (interior and exterior).
  Both,
  /// Stable invariant manifold branches only (backward propagation).
  StableOnly,
  /// Unstable invariant manifold branches only (forward propagation).
  UnstableOnly
}

/// Outcome. Append new values only; never reorder or reuse existing values.
enum tbpStatus : ubyte {
  /// A request, not yet answered.
  Pending,
  Solved,
  /// The corrector or targeter did not converge; the result is its last
  /// iterate.
  NotConverged,
  InvalidRequest,
  Failed
}

/// The two-primary system.
table tbpSystem {
  /// Name, e.g. "Earth-Moon", "Sun-Earth".
  NAME: string;
  /// Ephemeris body codes of the larger and smaller primary (e.g. 399, 301);
  /// 0 = not stated.
  PRIMARY_BODY_ID: int;
  SECONDARY_BODY_ID: int;
  /// Mass ratio mu = m2 / (m1 + m2), dimensionless. The larger primary sits
  /// at x = -mu and the smaller at x = 1 - mu.
  MASS_RATIO: double;
  /// Masses of the primaries, kg; 0 = not stated.
  PRIMARY_MASS_KG: double;
  SECONDARY_MASS_KG: double;
  /// Characteristic length: the distance between the primaries, km.
  CHARACTERISTIC_LENGTH_KM: double;
  /// Characteristic time: 1 / (the primaries' angular rate), s.
  CHARACTERISTIC_TIME_S: double;
  /// The synodic frame as an $RFM coordinate system; empty = the convention
  /// above, barycentre origin.
  SYNODIC_FRAME: RFM;
}

/// One synodic state, non-dimensional.
table tbpState {
  X: double;
  Y: double;
  Z: double;
  VX: double;
  VY: double;
  VZ: double;
  /// Non-dimensional time of the state from the trajectory's start.
  TIME: double;
}

/// A trajectory, column-major: TIMES has one entry per sample, STATES six,
/// STATE_TRANSITION 36 (row-major 6x6) when it was propagated.
table tbpTrajectory {
  /// True when TIMES and STATES are dimensional (s, km, km/s) in FRAME;
  /// false = non-dimensional synodic.
  DIMENSIONAL: bool;
  /// Frame of a dimensional trajectory; empty for synodic.
  FRAME: RFM;
  /// Unix milliseconds of time 0 of a dimensional trajectory; 0 = relative.
  EPOCH_MS: int64;
  TIMES: [double];
  /// x, y, z, vx, vy, vz per sample.
  STATES: [double];
  /// State transition matrix from time 0, 36 values per sample; empty = not
  /// propagated.
  STATE_TRANSITION: [double];
  /// Jacobi constant of the trajectory (conserved in the CR3BP).
  JACOBI: double;
}

/// One libration point and its linear stability.
table tbpLibrationPoint {
  POINT: rfmLibrationPoint = UNSPECIFIED;
  /// Synodic position, non-dimensional.
  X: double;
  Y: double;
  Z: double;
  /// Jacobi constant at the point.
  JACOBI: double;
  /// Eigenvalues of the linearised dynamics at the point (6 each); empty =
  /// not computed.
  EIGENVALUES_REAL: [double];
  EIGENVALUES_IMAGINARY: [double];
  /// True when every eigenvalue has a non-positive real part.
  STABLE: bool;
}

/// A periodic orbit, or a first guess of one.
table tbpPeriodicOrbit {
  FAMILY: tbpOrbitFamily = Unspecified;
  /// Libration point the orbit is about; UNSPECIFIED for orbits about a
  /// primary (distant retrograde).
  LIBRATION_POINT: rfmLibrationPoint = UNSPECIFIED;
  /// Amplitude that selects the member of the family, non-dimensional (the
  /// out-of-plane amplitude Az for halo orbits, the in-plane amplitude Ax
  /// for planar Lyapunov orbits).
  AMPLITUDE: double;
  /// NRHO: perilune and apolune altitudes above the smaller primary, km; 0 =
  /// not an NRHO request.
  PERILUNE_ALTITUDE_KM: double;
  APOLUNE_ALTITUDE_KM: double;
  /// The orbit's state at time 0 (on the XZ-plane crossing for symmetric
  /// families).
  INITIAL_STATE: tbpState;
  /// Period, non-dimensional, and the same in seconds.
  PERIOD: double;
  PERIOD_S: double;
  /// Jacobi constant.
  JACOBI: double;
  /// True when the orbit was differentially corrected; false = an analytic
  /// first guess.
  CORRECTED: bool;
  /// Corrector convergence.
  CONVERGED: bool;
  ITERATIONS: uint32;
  /// Corrector tolerance and iteration limit used (or requested); 0 =
  /// default.
  TOLERANCE: double;
  MAX_ITERATIONS: uint32;
  /// Monodromy matrix (state transition over one period), row-major 6x6;
  /// empty = not computed.
  MONODROMY: [double];
  /// Floquet multipliers (eigenvalues of the monodromy matrix), 6 each.
  FLOQUET_REAL: [double];
  FLOQUET_IMAGINARY: [double];
  /// Stability index (|lambda_max| + 1/|lambda_max|) / 2; 1 = marginally
  /// stable; 0 = not computed.
  STABILITY_INDEX: double;
  /// True when the orbit is linearly stable (STABILITY_INDEX <= 1).
  STABLE: bool;
  /// One period of the orbit; empty = not sampled.
  TRAJECTORY: tbpTrajectory;
  /// Tulip/pumpkin petal count Np; 0 = not applicable.
  PETALS: uint32;
  /// Sidereal resonance denominator p (period = q * 2*pi / p); 0 = not stated.
  RESONANCE_P: uint32;
  /// Sidereal resonance numerator q; 0 = not stated.
  RESONANCE_Q: uint32;
  /// CR3BP pseudo-potential U* at the initial state.
  PSEUDO_POTENTIAL: double;
  /// Minimum distance from the larger primary (P1), km; 0 = not computed.
  PERIGEE_KM: double;
  /// Maximum distance from the larger primary (P1), km; 0 = not computed.
  APOGEE_KM: double;
  /// Instability doubling time, non-dimensional; 0 = stable or not computed.
  DOUBLING_TIME: double;
  /// Floquet/Lyapunov characteristic exponent, non-dimensional; 0 = not computed.
  CHARACTERISTIC_EXPONENT: double;
  /// Longest continuous P2 (lunar) occultation per period, s.
  MAX_LUNAR_OCCULTATION_S: double;
  /// Total P2 (lunar) occultation duration per period, s.
  TOTAL_LUNAR_OCCULTATION_S: double;
  /// Longest continuous P1 (Earth) occultation per period, s.
  MAX_EARTH_OCCULTATION_S: double;
  /// Total P1 (Earth) occultation duration per period, s.
  TOTAL_EARTH_OCCULTATION_S: double;
  /// Unit stable eigenvector of the monodromy matrix (6 values); empty = none.
  STABLE_EIGENVECTOR: [double];
  /// Unit unstable eigenvector of the monodromy matrix (6 values); empty = none.
  UNSTABLE_EIGENVECTOR: [double];
}

/// Options for a propagation.
table tbpPropagationRequest {
  INITIAL_STATE: tbpState;
  /// Non-dimensional duration (negative = backwards).
  DURATION: double;
  /// Non-dimensional integration step; 0 = default.
  STEP: double;
  /// Samples in the answer, endpoints included; 0 = default.
  OUTPUT_POINTS: uint32;
  /// Also propagate the state transition matrix.
  STATE_TRANSITION: bool;
}

/// A transfer into the system.
table tbpTransfer {
  KIND: tbpTransferKind = Unspecified;
  /// Altitude of the circular parking orbit about the larger primary, km.
  PARKING_ALTITUDE_KM: double;
  /// Altitude of the final orbit about the smaller primary, km.
  TARGET_ALTITUDE_KM: double;
  /// Inclination of the transfer plane, deg.
  INCLINATION_DEG: double;
  /// PeriodicOrbitInsertion: the orbit to insert into.
  TARGET_ORBIT: tbpPeriodicOrbit;
  /// Targeter limits; 0 = default.
  MAX_ITERATIONS: uint32;
  TOLERANCE: double;
  /// Result: convergence of the targeter.
  CONVERGED: bool;
  /// Result: departure and arrival burns (their DELTA_V in the axes they
  /// state, km/s; offsets in seconds from departure).
  BURNS: [mplBurn];
  /// Result: total delta-v, km/s, and time of flight, s.
  TOTAL_DELTA_V_KM_S: double;
  TIME_OF_FLIGHT_S: double;
  /// Result: the transfer trajectory; empty = not sampled.
  TRAJECTORY: tbpTrajectory;
  /// Departure state in synodic frame (MinEnergy, DirectLambert, MinLambert, LowThrustMinTime).
  INITIAL_STATE: tbpState;
  /// Arrival state in synodic frame.
  FINAL_STATE: tbpState;
  /// False = prograde (default), true = retrograde (DirectLambert).
  RETROGRADE: bool;
  /// Reference primary body for Lambert seeding: 0 = auto, 1 = P1, 2 = P2.
  REFERENCE_PRIMARY: ubyte;
  /// Low-thrust maximum thrust, N (LowThrustMinTime).
  MAX_THRUST_N: double;
  /// Engine specific impulse Isp, s (LowThrustMinTime).
  SPECIFIC_IMPULSE_S: double;
  /// Initial wet spacecraft mass, kg.
  INITIAL_MASS_KG: double;
  /// Result: final spacecraft mass at arrival, kg.
  FINAL_MASS_KG: double;
  /// Result: propellant consumed, kg.
  PROPELLANT_MASS_KG: double;
  /// Initial costates [lambda_rx, ry, rz, vx, vy, vz, m] guess or solved.
  INITIAL_COSTATES: [double];
  /// Result: normalized throttle [0..1] per trajectory sample.
  THROTTLE_HISTORY: [double];
  /// Result: theoretical minimum Jacobi-energy delta-v, km/s (MinEnergy).
  MIN_ENERGY_DELTA_V_KM_S: double;
}

/// Station-keeping budget for a periodic orbit.
table tbpStationKeeping {
  /// The orbit kept (its INITIAL_STATE, PERIOD and JACOBI at least).
  ORBIT: tbpPeriodicOrbit;
  STRATEGY: tbpStationKeepingStrategy = PlaneCrossing;
  /// Navigation (orbit knowledge) error, km, 1 sigma.
  NAVIGATION_ERROR_KM: double;
  /// Maneuver execution error, fraction of each burn, 1 sigma.
  EXECUTION_ERROR_FRACTION: double;
  /// Station-keeping cycles simulated.
  CYCLES: uint32;
  /// Result: delta-v per year, km/s.
  ANNUAL_DELTA_V_KM_S: double;
  /// Result: mean and largest delta-v per cycle, km/s.
  MEAN_CYCLE_DELTA_V_KM_S: double;
  MAX_CYCLE_DELTA_V_KM_S: double;
  /// Result: delta-v of each cycle, km/s.
  CYCLE_DELTA_V_KM_S: [double];
  /// Result: true when the orbit stays bounded over the simulation.
  BOUNDED: bool;
  /// Time between correction maneuvers, s (LinearStabilityBounds).
  CORRECTION_INTERVAL_S: double;
  /// 3-axis velocity execution error magnitude, km/s (LinearStabilityBounds).
  DELTA_V_EXECUTION_ERROR_KM_S: double;
  /// Result: linear-stability lower bound annual delta-v, km/s/yr.
  LOWER_BOUND_ANNUAL_DELTA_V_KM_S: double;
  /// Result: linear-stability upper bound annual delta-v, km/s/yr.
  UPPER_BOUND_ANNUAL_DELTA_V_KM_S: double;
}

/// A state converted between the synodic and inertial frames. The inertial
/// frame is centred on the barycentre with its X axis along the synodic X
/// axis at REFERENCE_EPOCH_MS (elapsed time 0) and Z along the system's
/// angular momentum.
table tbpFrameConversion {
  DIRECTION: tbpConversionDirection = SynodicToInertial;
  /// Unix milliseconds when the two frames are aligned; 0 = relative time
  /// only.
  REFERENCE_EPOCH_MS: int64;
  /// Seconds from the alignment to the state.
  ELAPSED_S: double;
  /// The synodic state (input or result), non-dimensional.
  SYNODIC: tbpState;
  /// The inertial state (input or result): km and km/s, 6 values.
  INERTIAL: [double];
  /// Reference primary body: 0 = barycenter, 1 = P1 (Earth), 2 = P2 (Moon).
  REFERENCE_PRIMARY: ubyte;
  /// Epoch Julian date (days) for J2000/ephemeris conversions; 0 = from REFERENCE_EPOCH_MS.
  JULIAN_DATE: double;
  /// Geodetic/selenodetic coordinates [lat_deg, lon_deg, alt_km] (3 values).
  LLA_DEG_KM: [double];
  /// Classical Keplerian elements [a_km, e, inc_deg, raan_deg, argp_deg, nu_deg] (6 values).
  ORBITAL_ELEMENTS: [double];
  /// Batch synodic states (N * 6 values, non-dimensional) for vectorized conversion.
  BATCH_SYNODIC_STATES: [double];
  /// Batch inertial/target states (N * 6 values, km and km/s) for vectorized conversion.
  BATCH_INERTIAL_STATES: [double];
}

/// Request parameters for pseudo-arclength or natural-parameter continuation.
table tbpContinuationRequest {
  /// Seed periodic orbit (INITIAL_STATE and PERIOD required).
  SEED_ORBIT: tbpPeriodicOrbit;
  /// Arclength step size ds (signed); 0 = natural-parameter fixed-period refinement.
  STEP_SIZE: double;
  /// Number of continuation steps to generate; 0 = 1.
  STEPS: uint32;
  /// True = fixed-period natural parameter continuation (cont_np); false = pseudo-arclength (cont).
  FIXED_PERIOD: bool;
  /// Optional 7-element previous null-vector tangent for directional continuation.
  NULL_VECTOR: [double];
  /// Convergence tolerance on periodicity residual; 0 = default (1e-10).
  TOLERANCE: double;
  /// Maximum corrector iterations per step; 0 = default.
  MAX_ITERATIONS: uint32;
}

/// One stable or unstable invariant manifold branch emanating from a periodic orbit.
table tbpManifoldBranch {
  /// True = stable branch (integrated backward), false = unstable branch (forward).
  STABLE: bool;
  /// True = exterior (+eigenvector), false = interior (-eigenvector).
  EXTERIOR: bool;
  /// Index of the seed point along the periodic orbit.
  SEED_INDEX: uint32;
  /// Perturbed initial state on the manifold, non-dimensional.
  INITIAL_STATE: tbpState;
  /// Propagated manifold trajectory.
  TRAJECTORY: tbpTrajectory;
}

/// Invariant manifold request and computed branches for an unstable periodic orbit.
table tbpManifolds {
  /// Periodic orbit to perturb (INITIAL_STATE and PERIOD required).
  ORBIT: tbpPeriodicOrbit;
  /// Perturbation distance epsilon (non-dimensional); 0 = default (1e-5).
  PERTURBATION: double;
  /// Propagation duration per branch, non-dimensional; 0 = one orbit period.
  DURATION: double;
  /// Number of seed points along the periodic orbit; 0 = default (12).
  SAMPLE_POINTS: uint32;
  /// Which manifold branches to generate.
  BRANCH_KIND: tbpManifoldBranchKind = Both;
  /// Computed manifold branches.
  BRANCHES: [tbpManifoldBranch];
}

/// Multi-spacecraft time-phased CR3BP constellation along a periodic orbit.
table tbpConstellation {
  /// Generating periodic orbit (FAMILY + PETALS + PERIOD or explicit INITIAL_STATE).
  ORBIT: tbpPeriodicOrbit;
  /// Number of spacecraft in the constellation.
  SATELLITE_COUNT: uint32;
  /// Number of orbit revolutions to propagate; 0 = 1.
  REVOLUTIONS: uint32;
  /// Non-dimensional phase offsets (length SATELLITE_COUNT); empty = evenly spaced.
  PHASE_OFFSETS: [double];
  /// Uniform time samples per spacecraft trajectory; 0 = default.
  OUTPUT_POINTS: uint32;
  /// Result: propagated trajectory for each spacecraft in the constellation.
  TRAJECTORIES: [tbpTrajectory];
}

/// Surface coverage gap, elevation angle, occultation, and DOP analysis on a primary body.
table tbpSurfaceAnalysis {
  /// Target primary body: 0 or 2 = smaller primary (Moon), 1 = larger primary (Earth).
  REFERENCE_PRIMARY: ubyte;
  /// Radius of target primary body, km; 0 = default body radius.
  PRIMARY_RADIUS_KM: double;
  /// Minimum elevation mask angle above local horizon, deg; 0 = horizon (0 deg).
  MIN_ELEVATION_DEG: double;
  /// Minimum simultaneous satellites in view for coverage; 0 = 1.
  MIN_SATELLITES: uint32;
  /// Surface observer positions in synodic frame (P * 3 non-dimensional values); empty = auto Fibonacci sphere.
  SURFACE_POINTS_SYNODIC: [double];
  /// Surface observer lat/lon pairs [lat0, lon0, ...] in deg (P * 2 values).
  SURFACE_LAT_LON_DEG: [double];
  /// Number of Fibonacci surface grid points when SURFACE_POINTS_SYNODIC is empty; 0 = default.
  GRID_POINT_COUNT: uint32;
  /// Result: non-dimensional sample times (T values).
  SAMPLE_TIMES: [double];
  /// Result: maximum uncovered gap duration per surface point, s (P values).
  MAX_GAP_S: [double];
  /// Result: geometric dilution of precision (T * P values, NaN/0 when <4 sats visible).
  GDOP: [double];
  /// Result: position dilution of precision (T * P values).
  PDOP: [double];
  /// Result: time dilution of precision (T * P values).
  TDOP: [double];
  /// Result: maximum elevation angle per sample and surface point, deg (T * P values).
  ELEVATION_DEG: [double];
  /// Result: occultation interval start times, s (M values).
  OCCULTATION_START_S: [double];
  /// Result: occultation interval end times, s (M values).
  OCCULTATION_END_S: [double];
  /// Result: occulting body index per interval (1 = P1, 2 = P2; M values).
  OCCULTING_PRIMARY: [ubyte];
}

/// Three-Body Problem - a CR3BP system and one answer about it.
table TBP {
  /// Identifier of the record; empty = not assigned.
  ID: string;
  /// Unix milliseconds the record was produced.
  CREATED_AT_MS: int64;
  /// Identifier of the producing service or tool.
  PRODUCER: string;
  PROBLEM: tbpProblem = Unspecified;
  SYSTEM: tbpSystem;
  STATUS: tbpStatus = Pending;
  /// Stable machine-readable reason when STATUS is not Solved.
  ERROR_CODE: string;
  ERROR_MESSAGE: string;
  /// Propagation: the request, and the propagated trajectory.
  PROPAGATION: tbpPropagationRequest;
  TRAJECTORY: tbpTrajectory;
  /// LibrationPoints: L1 to L5.
  LIBRATION_POINTS: [tbpLibrationPoint];
  /// JacobiConstant: the state, and its Jacobi constant.
  STATE: tbpState;
  JACOBI: double;
  /// PeriodicOrbit, HaloFirstGuess, NearRectilinearHalo, OrbitProperties: the
  /// request fields (FAMILY, LIBRATION_POINT, AMPLITUDE, PETALS, or
  /// perilune/apolune, TOLERANCE, MAX_ITERATIONS) and the result. Family and
  /// Continuation: the members ordered along the continuation parameter.
  ORBITS: [tbpPeriodicOrbit];
  TRANSFER: tbpTransfer;
  STATION_KEEPING: tbpStationKeeping;
  FRAME_CONVERSION: tbpFrameConversion;
  /// Continuation: pseudo-arclength or natural-parameter continuation request.
  CONTINUATION: tbpContinuationRequest;
  /// Manifolds: invariant stable/unstable manifold request and branches.
  MANIFOLDS: tbpManifolds;
  /// Constellation: time-phased multi-spacecraft CR3BP constellation.
  CONSTELLATION: tbpConstellation;
  /// SurfaceAnalysis: surface coverage gaps, elevation, occultations, and DOP.
  SURFACE_ANALYSIS: tbpSurfaceAnalysis;
}

root_type TBP;
file_identifier "$TBP";