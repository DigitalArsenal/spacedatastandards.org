// Hash: 7698d54cba61bbb638104d37211cc2dbb15e446aefcfedfb4a66d0c46c70b90f
// Version: 1.164.0
// -----------------------------------END_HEADER
attribute "aligned_max_count";
attribute "aligned_max_length";

/// FlatSQL node operation selected by an FSO control frame. These operations
/// execute inside the independently instantiated FlatSQL WASM node; a host
/// routes the bytes but never implements an operation.
enum flatSqlNodeOperation : ubyte {
  NONE,
  APPEND_RECORDS,
  QUERY_RECORDS,
  CONFIGURE_INDEX,
  UPSERT_VIEW,
  COMPACT,
  CONFIGURE_RETENTION,
  SNAPSHOT,
  RELOAD
}

/// FlatSQL operation outcome carried on the typed output port. Invocation ABI
/// errors remain in PIV; this status reports database-operation semantics.
enum flatSqlNodeStatus : ubyte {
  UNSPECIFIED,
  OK,
  ACCEPTED,
  YIELDED,
  COMPLETE,
  INVALID_ARGUMENT,
  NOT_CONFIGURED,
  NOT_FOUND,
  CONFLICT,
  RESOURCE_EXHAUSTED,
  INTERNAL_ERROR
}

/// One canonical SDS file-identifier to FlatSQL table binding. A configured
/// node rebuilds these bindings before replaying durable record bytes.
table FSOTableBinding {
  FILE_IDENTIFIER:string (aligned_max_length: 4);
  TABLE_NAME:string (aligned_max_length: 128);
}

/// FlatSQL Operation — generic control, policy, and status record for the
/// independently packaged FlatSQL WASM node.
///
/// Bulk records, query results, snapshots, and WAL chunks travel separately as
/// FSB frames so operations remain streamable and no host needs to interpret a
/// database payload. SCHEMA_IDL is canonical SDS/FlatBuffers IDL supplied to
/// the node for schema-derived table/index construction.
table FSO {
  OPERATION:flatSqlNodeOperation = NONE;
  REQUEST_ID:ulong;

  DATABASE_NAME:string (aligned_max_length: 128);
  /// UTF-8 FlatBuffers IDL bytes. A byte vector is used because the aligned
  /// compiler intentionally limits fixed inline strings to 255 bytes.
  SCHEMA_IDL:[ubyte] (aligned_max_count: 262144);
  TABLE_BINDINGS:[FSOTableBinding] (aligned_max_count: 64);

  TABLE_NAME:string (aligned_max_length: 128);
  INDEX_NAME:string (aligned_max_length: 128);
  /// UTF-8 index expression bytes.
  INDEX_EXPRESSION:[ubyte] (aligned_max_count: 2048);
  VIEW_NAME:string (aligned_max_length: 128);
  /// UTF-8 SQL/query bytes.
  QUERY:[ubyte] (aligned_max_count: 16384);
  PARAMETERS:[ubyte] (aligned_max_count: 65536);
  PARAMETER_COUNT:uint;
  /// UTF-8 upsert-key expression bytes.
  UPSERT_KEY_EXPRESSION:[ubyte] (aligned_max_count: 2048);

  RETENTION_MAX_RECORDS:ulong;
  RETENTION_MAX_AGE_MILLIS:ulong;
  COMPACTION_TARGET_BYTES:ulong;

  STATUS:flatSqlNodeStatus = UNSPECIFIED;
  AFFECTED_RECORDS:ulong;
  RESULT_BYTES:ulong;
  ERROR_CODE:string (aligned_max_length: 128);
  /// UTF-8 diagnostic bytes.
  MESSAGE:[ubyte] (aligned_max_count: 4096);
}

root_type FSO;
file_identifier "$FSO";