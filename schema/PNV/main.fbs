// Hash: fb840b05a3245c0665f11434c917b9400af4412487b8725c03644aa37d7aa23e
// Version: 1.248.1
// -----------------------------------END_HEADER
/// Publication Verification (PNV)
/// Description
/// What one node established about a publication notice ($PNM) it received:
/// who published it, which peer relayed it, whether its signature verified,
/// against which key and where that key came from, and whether the network
/// attribution of the publication could be confirmed. A $PNM is the
/// publisher's own signed statement; a PNV is a receiver's verdict on it, so
/// the two never share a record. A set carries the verdicts of one read, for
/// example the latest notice per standard, or the history of notices from one
/// peer.
/// How the receiving node attributes the publication. Append new values only;
/// never reorder or reuse existing values.
enum pnvAttribution : ubyte {
  /// Not determined.
  Unknown,
  /// Published by the peer the notice arrived from.
  Direct,
  /// Relayed: the publisher is a different peer from the one it arrived from.
  Relayed,
  /// Published by the receiving node itself.
  OwnNode,
  /// The publisher could not be established.
  Unattributed
}
/// Where the key that checked the signature came from. Append new values only;
/// never reorder or reuse existing values.
enum pnvKeySource : ubyte {
  /// No key was available.
  None,
  /// The publisher's signed identity record ($EPM).
  IdentityRecord,
  /// The key embedded in the publisher's peer identifier.
  PeerIdentifier,
  /// A key the operator configured as trusted.
  OperatorTrust,
  /// A key carried in the notice itself (proves integrity, not identity).
  SelfAsserted
}
/// One received notice and the verdict on it.
table PNVEntry {
  /// Content identifier of the $PNM the verdict is about.
  PNM_CID: string;
  /// Peer that signed and published the notice.
  PUBLISHER_PEER_ID: string;
  /// Peer the notice arrived from (gossip or direct).
  RECEIVED_FROM_PEER_ID: string;
  /// Standard the publication is in, as its code, e.g. "OMM".
  STANDARD: string;
  /// Schema file name of the published records, e.g. "OMM.fbs".
  SCHEMA_NAME: string;
  /// The notice's FILE_ID (publication or update identity).
  FILE_ID: string;
  /// The notice's FILE_NAME.
  FILE_NAME: string;
  /// The notice's CID (the published content or its manifest).
  CID: string;
  /// Unix milliseconds of publication, from the notice.
  PUBLISHED_AT_MS: int64;
  /// Unix milliseconds the receiving node received the notice.
  RECEIVED_AT_MS: int64;
  /// Signature scheme of the notice, verbatim from the $PNM, e.g. "Ed25519",
  /// "Secp256k1". The signature is over the notice's signed bytes, hashed
  /// once: Ed25519 signs the bytes themselves; Secp256k1 is a DER ECDSA
  /// signature over ONE SHA-256 of the bytes (the libp2p secp256k1 key form).
  /// A signature over SHA-256(SHA-256(bytes)) does not verify.
  SIGNATURE_TYPE: string;
  /// The notice's signature, verbatim.
  SIGNATURE: [ubyte];
  /// True when the signature verified against PUBLISHER_KEY.
  SIGNATURE_VERIFIED: bool;
  ATTRIBUTION: pnvAttribution = Unknown;
  /// The public key the signature was checked against.
  PUBLISHER_KEY: [ubyte];
  KEY_SOURCE: pnvKeySource = None;
  /// Why verification failed or was not attempted; empty when it verified.
  REASON: string;
  /// The notice itself as received, a size-prefixed $PNM, so a reader can
  /// verify the signature on its own instead of trusting this verdict.
  PNM_BYTES: [ubyte];
}
/// Publication Verification - one node's verdicts on received notices.
table PNV {
  /// Identifier of the node that verified.
  VERIFIER_PEER_ID: string;
  /// Unix milliseconds when this set was generated.
  GENERATED_AT_MS: int64;
  ENTRIES: [PNVEntry];
  /// Entity tag of this set, for conditional requests.
  ETAG: string;
}
root_type PNV;
file_identifier "$PNV";