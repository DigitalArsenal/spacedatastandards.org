// Hash: 36dac7b1868da8150d27dc396d3823746c1f58721bb0c879dae101e6730f0bef
// Version: 0.0.5
// -----------------------------------END_HEADER
enum GravityModelType : byte {
  POINT_MASS,
  J2_ONLY,
  J2_J4,
  J2_J6,
  SPHERICAL_HARMONICS,
  CUSTOM
}

enum GravityModelName : byte {
  WGS84,
  EGM96,
  EGM2008,
  GGM05C,
  JGM3,
  EIGEN_6C4,
  GOCO06S,
  XGM2019E,
  CUSTOM_MODEL,
  // Appended: widely distributed coefficient sets carried by open
  // astrodynamics toolchains. Append only; never reorder.
  GGM02C,
  GGM02S,
  GOCO05C,
  // Moon
  GLGM3150,
  LPE200,
  GGGRX1200,
  // Mars
  JGMRO120D,
  // Mercury
  JGMESS160A,
  // Venus
  SHGJ180U
}

enum CentralBody : byte {
  EARTH,
  MOON,
  SUN,
  MARS,
  JUPITER,
  SATURN,
  VENUS,
  MERCURY,
  CUSTOM_BODY
}

/// Gravity Models
table GRV {
  MODEL_TYPE:GravityModelType = J2_J4;
  MODEL_NAME:GravityModelName = EGM2008;
  CENTRAL_BODY:CentralBody = EARTH;
  MAX_DEGREE:uint16 = 70;
  MAX_ORDER:uint16 = 70;
  // Third body perturbations
  INCLUDE_SUN:bool = true;
  INCLUDE_MOON:bool = true;
  INCLUDE_PLANETS:bool = false;
  // Tidal effects
  SOLID_TIDES:bool = false;
  OCEAN_TIDES:bool = false;
  POLE_TIDES:bool = false;
  // Numeric gravity context for model-backed propagation and element maps.
  EQUATORIAL_RADIUS:double;
  J2:double;
  MU:double;
  J3:double;
  J4:double;
  J5:double;
  J6:double;
}

root_type GRV;
file_identifier "$GRV";