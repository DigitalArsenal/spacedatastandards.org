// Hash: 76778cd648fbf017b06aab6f853960e6166919364dd629eb2ffff6bd3cb17c3e
// Version: 0.0.5
// -----------------------------------END_HEADER
enum radarObsType : byte {
  DETECTION,
  TRACK,
  METRIC,
  SIGNATURE,
  SEARCH_FENCE,
  UNKNOWN
}

/// Radar Observation
table RDO {
  /// Unique identifier
  ID:string;
  /// Observation time (ISO 8601)
  OB_TIME:string;
  /// Sensor identifier
  ID_SENSOR:string;
  /// Original sensor identifier
  ORIG_SENSOR_ID:string;
  /// Satellite catalog number
  SAT_NO:uint32;
  /// International designator
  ORIG_OBJECT_ID:string;
  /// On-orbit reference
  ON_ORBIT:string;
  /// True if uncorrelated target
  UCT:bool;
  /// Observation type
  OBS_TYPE:radarObsType;
  /// Task identifier
  TASK_ID:string;
  /// Transaction identifier
  TRANSACTION_ID:string;
  /// Track identifier
  TRACK_ID:string;
  /// Observation position identifier
  OB_POSITION:string;
  /// Sensor reference frame
  SEN_REFERENCE_FRAME:string;
  /// Azimuth angle (degrees)
  AZIMUTH:double;
  /// Azimuth uncertainty (degrees, 1-sigma)
  AZIMUTH_UNC:double;
  /// Azimuth bias (degrees)
  AZIMUTH_BIAS:double;
  /// Azimuth rate (degrees/s)
  AZIMUTH_RATE:double;
  /// Elevation angle (degrees)
  ELEVATION:double;
  /// Elevation uncertainty (degrees, 1-sigma)
  ELEVATION_UNC:double;
  /// Elevation bias (degrees)
  ELEVATION_BIAS:double;
  /// Elevation rate (degrees/s)
  ELEVATION_RATE:double;
  /// Slant range (km)
  RANGE:double;
  /// Range uncertainty (km, 1-sigma)
  RANGE_UNC:double;
  /// Range bias (km)
  RANGE_BIAS:double;
  /// Range rate, the time derivative of RANGE (km/s): positive when the range
  /// is opening, negative when it is closing.
  RANGE_RATE:double;
  /// Range rate uncertainty (km/s, 1-sigma)
  RANGE_RATE_UNC:double;
  /// Range acceleration (km/s^2)
  RANGE_ACCEL:double;
  /// Range acceleration uncertainty (km/s^2, 1-sigma)
  RANGE_ACCEL_UNC:double;
  /// Two-way (monostatic radar) Doppler shift (Hz): the received echo's
  /// frequency minus the transmitted carrier DOPPLER_FREQUENCY. Positive when
  /// the range is closing. To first order in RANGE_RATE / c,
  /// RANGE_RATE = -c * DOPPLER / (2 * DOPPLER_FREQUENCY), c = 299792.458 km/s.
  DOPPLER:double;
  /// Uncertainty of DOPPLER (Hz, 1-sigma). The range-rate uncertainty is
  /// c * DOPPLER_UNC / (2 * DOPPLER_FREQUENCY).
  DOPPLER_UNC:double;
  /// Right ascension (degrees)
  RA:double;
  /// Declination (degrees)
  DECLINATION:double;
  /// Target position X (km, ECI)
  X:double;
  /// Target position Y (km, ECI)
  Y:double;
  /// Target position Z (km, ECI)
  Z:double;
  /// Target velocity X (km/s, ECI)
  XVEL:double;
  /// Target velocity Y (km/s, ECI)
  YVEL:double;
  /// Target velocity Z (km/s, ECI)
  ZVEL:double;
  /// Sensor position X (km, ECEF)
  SENX:double;
  /// Sensor position Y (km, ECEF)
  SENY:double;
  /// Sensor position Z (km, ECEF)
  SENZ:double;
  /// Radar cross-section (dBsm)
  RCS:double;
  /// RCS uncertainty (dBsm, 1-sigma)
  RCS_UNC:double;
  /// Orthogonal polarization RCS (dBsm)
  ORTHOGONAL_RCS:double;
  /// Orthogonal RCS uncertainty (dBsm, 1-sigma)
  ORTHOGONAL_RCS_UNC:double;
  /// Signal-to-noise ratio (dB)
  SNR:double;
  /// Beam identifier
  BEAM:double;
  /// Timing bias (seconds)
  TIMING_BIAS:double;
  /// Reference to raw data file
  RAW_FILE_URI:string;
  /// Event descriptor
  DESCRIPTOR:string;
  /// Associated tags
  TAGS:[string];
  /// Association: squared Mahalanobis distance of the observation's
  /// innovation against its predicted value, d^2 = v^T (H P H^T + R)^-1 v.
  CORR_MAHALANOBIS_SQ:double;
  /// Association: degrees of freedom of d^2 (measurement dimension).
  CORR_DOF:ubyte;
  /// Association: the chi-square gate d^2 was tested against.
  CORR_GATE:double;
  /// Association: p-value of d^2, Q(dof/2, d^2/2).
  CORR_P_VALUE:double;
  /// Association: true when the assignment was ambiguous.
  CORR_AMBIGUOUS:bool;
  /// Association: posterior probability of the association.
  CORR_QUALITY:double;
  /// Transmitted carrier frequency (Hz) that the two-way DOPPLER shift is
  /// relative to. Set whenever DOPPLER is: without it DOPPLER cannot be
  /// converted to range rate.
  DOPPLER_FREQUENCY:double;
}

root_type RDO;
file_identifier "$RDO";